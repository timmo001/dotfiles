{
  "manifest_version": 3,
  "name": "dot links",
  "version": "1.0.0",
  "description": "Open GitHub issues and pull requests in the Git panel through dot.",
  "permissions": ["contextMenus", "nativeMessaging", "tabs"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open in the Git panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "key": ""
}
