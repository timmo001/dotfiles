{
  "name": "dot-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile ../scripts/.local/bin/dot-tui",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.14.48",
    "@opentui/core": "^0.2.7",
    "effect": "^3.21.2",
    "fuse.js": "^7.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "prettier": "^3.5.3"
  }
}
