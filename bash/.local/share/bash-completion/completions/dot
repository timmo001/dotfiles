        return
        ;;
      workspace-capture)
        _dot_workspace_capture "$i"
        return
        ;;
      workspace-restore)
        _dot_workspace_restore "$i"
        return
        ;;
      usage)
        _dot_usage "$i"
        return
        ;;
      help)
        _dot_help "$i"
        return
        ;;
    esac
  done

  local _used_0=""
  for ((i = 1; i < cword; i++)); do
    case "${words[i]%%=*}" in
      --help|-h) _used_0=1 ;;
    esac
  done
  local _filtered_flags=""
  [[ -n "$_used_0" ]] || _filtered_flags+=" --help -h"

  # Complete flags (filtered) and subcommands
  if [[ "$cur" == -* ]]; then
    COMPREPLY=( $(compgen -W "$_filtered_flags" -- "$cur") )
    return
  fi

  COMPREPLY=( $(compgen -W 'init install update up stow omarchy-plugin omarchy-shell-config firewall doctor clean agents-sync notes-capture-sync setup-private-repo setup-public-repo git-diff diff git-commit git-notifications mcp-sync private-pkg-publish skill-updates skill-check skill-updates-agent completions is-agent agent-oxlint launch-floating-webapp herdr-repo-open workspace-relayout workspace-capture workspace-restore usage help' -- "$cur") )
}

