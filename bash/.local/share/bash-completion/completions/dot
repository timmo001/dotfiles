_dot_omarchy_plugin_add()
{
  local cur prev words cword i
  local _command_index="$1"
  _init_completion -n "$COMP_WORDBREAKS" || return

  # Flag value completions
  case "$prev" in
    --section)
      _dot--choices "$cur" "$_comp_word" 'left' 'center' 'right'
      return
      ;;
  esac

  local _used_0="" _used_1="" _used_2="" _used_3=""
  for ((i = 1; i < cword; i++)); do
    case "${words[i]%%=*}" in
      --section) _used_0=1 ;;
      --before) _used_1=1 ;;
      --after) _used_2=1 ;;
      --help|-h) _used_3=1 ;;
    esac
  done
  local _filtered_flags=""
  [[ -n "$_used_0" ]] || _filtered_flags+=" --section"
  [[ -n "$_used_1" ]] || _filtered_flags+=" --before"
  [[ -n "$_used_2" ]] || _filtered_flags+=" --after"
  [[ -n "$_used_3" ]] || _filtered_flags+=" --help -h"

  # Complete flags (filtered) and subcommands
  if [[ "$cur" == -* ]]; then
    COMPREPLY=( $(compgen -W "$_filtered_flags" -- "$cur") )
    return
  fi

  # Positional argument completions
  local _position=0 _skip_next=0 _end_of_options=0
  for ((i = _command_index + 1; i < cword; i++)); do
    if (( _skip_next )); then
      _skip_next=0
      continue
    fi
    if (( _end_of_options )); then
      ((_position += 1))
      continue
    fi
    case "${words[i]}" in
      --) _end_of_options=1 ;;
      --section) _skip_next=1 ;;
      --section=*) ;;
      --before) _skip_next=1 ;;
      --before=*) ;;
      --after) _skip_next=1 ;;
      --after=*) ;;
      --help|-h) ;;
      -*) ;;
      *) ((_position += 1)) ;;
    esac
  done
  case "$_position" in
    2)
      COMPREPLY=( $(compgen -f -- "$cur") )
      return
      ;;
  esac
}

