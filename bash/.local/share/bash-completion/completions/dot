        _dot_firewall "$i"
        return
        ;;
      doctor)
        _dot_doctor "$i"
        return
        ;;
      clean)
        _dot_clean "$i"
        return
        ;;
      agents-sync)
        _dot_agents_sync "$i"
        return
        ;;
      notes-capture-sync)
        _dot_notes_capture_sync "$i"
        return
        ;;
      setup-private-repo)
        _dot_setup_private_repo "$i"
        return
        ;;
      setup-public-repo)
        _dot_setup_public_repo "$i"
        return
        ;;
      git-diff)
        _dot_git_diff "$i"
        return
        ;;
      diff)
        _dot_diff "$i"
        return
        ;;
      git-commit)
        _dot_git_commit "$i"
        return
        ;;
      git-notifications)
        _dot_git_notifications "$i"
        return
        ;;
      mcp-sync)
        _dot_mcp_sync "$i"
        return
        ;;
      private-pkg-publish)
        _dot_private_pkg_publish "$i"
        return
        ;;
      skill-updates)
        _dot_skill_updates "$i"
        return
        ;;
      skill-check)
        _dot_skill_check "$i"
        return
        ;;
      skill-updates-agent)
        _dot_skill_updates_agent "$i"
        return
        ;;
      completions)
        _dot_completions "$i"
        return
        ;;
      is-agent)
        _dot_is_agent "$i"
        return
        ;;
      agent-oxlint)
        _dot_agent_oxlint "$i"
        return
        ;;
      launch-floating-webapp)
        _dot_launch_floating_webapp "$i"
        return
        ;;
      herdr-repo-open)
        _dot_herdr_repo_open "$i"
        return
