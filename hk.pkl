// Pre-push checks: the shared base from timmo001/workflows, with its lint steps
// running this repository's own tasks so the scopes match CI, plus the dot
// type check and format check. There is no pre-commit hook: `dot git commit`
// owns commit-time checks. Run them by hand with `hk check`.
amends "package://github.com/timmo001/workflows/releases/download/20261114.0/hk-base@20261114.0.0#/base.pkl"

local repoSteps = new Mapping<String, Step> {
  ["oxlint"] {
    glob = List("**/*.{ts,mts,cts,js,mjs,cjs}")
    check = "mise run lint:oxlint"
  }
  ["markdownlint"] {
    glob = List("**/*.md")
    check = "mise run lint:markdown"
  }
  ["yamllint"] {
    glob = List("**/*.{yml,yaml}")
    check = "mise run lint:yaml"
  }
  ["actionlint"] {
    glob = List(".github/workflows/*.{yml,yaml}")
    check = "mise run lint:actions"
  }
  ["shellcheck"] {
    types = List("shell")
    check = "mise run lint:shell"
  }
  ["json"] {
    glob = List("**/*.json")
    check = "mise run lint:json"
  }
  ["dot-typecheck"] {
    glob = List("dot/**/*.ts")
    check = "mise run dot:typecheck"
  }
  ["dot-format"] {
    glob = List("dot/**/*.ts")
    check = "mise run dot:format:check"
  }
}

hooks {
  ["pre-push"] {
    steps {
      ...repoSteps
    }
  }
  ["check"] {
    steps {
      ...repoSteps
    }
  }
}
