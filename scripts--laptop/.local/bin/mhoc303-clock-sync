#!/usr/bin/env bash
set -euo pipefail

MAC_ADDRESS_FILE="$HOME/.mho-c303-mac-address"

if [[ ! -r "$MAC_ADDRESS_FILE" ]]; then
  printf 'mhoc303-clock-sync: missing MAC address file: %s\n' "$MAC_ADDRESS_FILE" >&2
  exit 1
fi

MAC_ADDRESS=$(<"$MAC_ADDRESS_FILE")
MAC_ADDRESS=${MAC_ADDRESS//$'\n'/}
MAC_ADDRESS=${MAC_ADDRESS//$'\r'/}

cd "$HOME/repos/mhoc303-clock-sync"
exec uv run mhoc303-clock-sync sync "$MAC_ADDRESS" --timeout 10 --attempts 60 --retry-delay 5
