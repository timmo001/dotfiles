#!/usr/bin/env bash
# night-suspend: put the laptop to sleep at midnight; night-wake.timer (a
# system timer, see systemd-system/) wakes it at 07:00.
#
# Gives a minute's notice, then waits for the Upkeep worker to finish a run it
# has going, for up to half an hour, so a job isn't cut off and left lost.
# Cancel tonight's with: systemctl --user stop night-suspend.service
set -euo pipefail

NOTICE_SECONDS=60
WORKER_WAIT_SECONDS=1800
WORKER_POLL_SECONDS=30

worker_status="${XDG_STATE_HOME:-$HOME/.local/state}/upkeep/worker-status.json"

notify() {
  command -v omarchy >/dev/null 2>&1 &&
    omarchy notification send -g "󰒲" --app-name "Night" "$@" >/dev/null 2>&1 || true
}

worker_running() {
  [[ -r $worker_status ]] || return 1
  [[ $(<"$worker_status") == *'"summary":"Running '* ]]
}

notify "Suspending for the night" \
  "In ${NOTICE_SECONDS} seconds, waking at 07:00. Cancel: systemctl --user stop night-suspend" \
  -t "$((NOTICE_SECONDS * 1000))"
sleep "$NOTICE_SECONDS"

waited=0
while worker_running && ((waited < WORKER_WAIT_SECONDS)); do
  sleep "$WORKER_POLL_SECONDS"
  waited=$((waited + WORKER_POLL_SECONDS))
done

systemctl suspend
