# Installed root-owned by dot up (System) and dot init on machines whose root is
# btrfs. Compacts mostly empty data chunks so their space returns to the
# unallocated pool, where metadata can grow. Without it, deletes leave free
# space scattered inside data chunks, unallocated runs out, and writes fail
# with "no space left" while df still shows plenty free.
[Unit]
Description=Compact mostly empty btrfs data chunks on /
Documentation=man:btrfs-balance(8)

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/btrfs balance start -dusage=5 /
ExecStart=/usr/bin/btrfs balance start -dusage=10 /
