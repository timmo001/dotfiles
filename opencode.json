{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "skills": [".agents/skills"],
  "references": {
    "effect": {
      "repository": "Effect-TS/effect",
      "description": "Use for Effect v4 APIs when working in dot/"
    },
    "omarchy": {
      "repository": "basecamp/omarchy",
      "branch": "quattro",
      "description": "Use for Omarchy desktop, Hyprland, and Quickshell shell customisation details"
    },
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "v2.0.18",
      "description": "Use for OpenCode config, agents, commands, skills, and plugin behaviour"
    },
    "skills": {
      "path": "~/repos/skills",
      "description": "Use for portable agent skills pinned into this repo and opencode-config"
    },
    "quickshell": {
      "repository": "quickshell-mirror/quickshell",
      "description": "Use for upstream Quickshell QML types, WlrLayershell/layer-shell, IpcHandler, reloadable config, and the qs CLI when customising the Omarchy shell bar widgets"
    }
  },
