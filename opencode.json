{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "skills": {
    "paths": [".agents/skills"]
  },
  "permission": {
    "notes_note_delete": "ask",
    "read": {
      "~/.agents": "allow",
      "~/.agents/skills/**": "allow",
      "~/.config": "allow",
      "~/.config/fastfetch/**": "allow",
      "~/.config/fish/**": "allow",
      "~/.config/ghostty/**": "allow",
      "~/.config/herdr/**": "allow",
      "~/.config/hunk/**": "allow",
      "~/.config/hypr/**": "allow",
      "~/.config/mise/**": "allow",
      "~/.config/nvim/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.config/ripgrep/**": "allow",
      "~/.config/starship/**": "allow",
      "~/.config/systemd": "allow",
      "~/.config/systemd/user/**": "allow",
      "~/.config/tmux/**": "allow",
      "~/.config/topgrade/**": "allow",
      "~/.config/yazi/**": "allow",
      "~/.local": "allow",
      "~/.local/bin/**": "allow",
      "~/.local/libexec/**": "allow",
      "~/.local/share": "allow",
      "~/.local/share/applications/**": "allow",
      "~/.local/share/bash-completion": "allow",
      "~/.local/share/bash-completion/completions/**": "allow",
      "~/.local/share/omarchy": "allow",
      "~/.local/share/omarchy/bin/**": "allow",
      "~/.local/share/opencode/repos/**": "allow",
      "~/.local/share/workspace-relayout/**": "allow",
      "~/.local/share/zsh": "allow",
      "~/.local/share/zsh/site-functions/**": "allow",
      "~/.plannotator/**": "allow",
      "~/repos/skills": "allow",
      "~/repos/skills/**": "allow"
    },
    "edit": {
      "~/.agents/skills/**": "deny",
      "~/.config/fastfetch/**": "deny",
      "~/.config/fish/**": "deny",
      "~/.config/ghostty/**": "deny",
      "~/.config/herdr/**": "deny",
      "~/.config/hunk/**": "deny",
      "~/.config/hypr/**": "deny",
      "~/.config/mise/**": "deny",
      "~/.config/nvim/**": "deny",
      "~/.config/opencode/**": "deny",
      "~/.config/ripgrep/**": "deny",
      "~/.config/starship/**": "deny",
      "~/.config/systemd/user/**": "deny",
      "~/.config/tmux/**": "deny",
      "~/.config/topgrade/**": "deny",
      "~/.config/yazi/**": "deny",
      "~/.local/bin/**": "deny",
      "~/.local/libexec/**": "deny",
      "~/.local/share/applications/**": "deny",
      "~/.local/share/bash-completion/completions/**": "deny",
      "~/.local/share/omarchy/bin/**": "deny",
      "~/.local/share/workspace-relayout/**": "deny",
      "~/.local/share/zsh/site-functions/**": "deny",
      "~/.plannotator/**": "deny",
      "~/repos/skills/**": "allow"
    },
    "external_directory": {
      "~/.agents/*": "allow",
      "~/.cache/opencode/*": "allow",
      "~/.config/*": "allow",
      "~/.config/fastfetch/**": "allow",
      "~/.config/fish/**": "allow",
      "~/.config/ghostty/**": "allow",
      "~/.config/herdr/**": "allow",
      "~/.config/hunk/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.config/hypr/**": "allow",
      "~/.config/mise/**": "allow",
      "~/.config/nvim/**": "allow",
      "~/.config/ripgrep/**": "allow",
      "~/.config/starship/**": "allow",
      "~/.config/systemd/user/**": "allow",
      "~/.config/tmux/**": "allow",
      "~/.config/topgrade/**": "allow",
      "~/.config/yazi/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.local/*": "allow",
      "~/.local/bin/**": "allow",
      "~/.local/libexec/**": "allow",
      "~/.local/share/*": "allow",
      "~/.local/share/applications/**": "allow",
      "~/.local/share/bash-completion/*": "allow",
      "~/.local/share/bash-completion/completions/**": "allow",
      "~/.local/share/omarchy/*": "allow",
      "~/.local/share/omarchy/bin/**": "allow",
      "~/.local/share/opencode/repos/github.com/anomalyco/opencode/**": "allow",
      "~/.local/share/omarchy/**": "allow",
      "~/.local/share/workspace-relayout/**": "allow",
      "~/.local/share/zsh/*": "allow",
      "~/.local/share/zsh/site-functions/**": "allow",
      "~/.plannotator/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "references": {
    "effect": {
      "repository": "Effect-TS/effect",
      "description": "Use for Effect v4 APIs when working in dot/"
    },
    "omarchy": {
      "repository": "basecamp/omarchy",
      "branch": "quattro",
      "description": "Use for Omarchy desktop, Hyprland, and Quickshell shell customisation details"
    },
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "v1.18.19",
      "description": "Use for OpenCode config, agents, commands, skills, and plugin behaviour"
    },
    "skills": {
      "path": "~/repos/skills",
      "description": "Use for portable agent skills pinned into this repo and opencode-config"
    },
    "opentui": {
      "repository": "anomalyco/opentui",
      "description": "Use for OpenTUI core, renderables, and keyboard handling when working in dot/"
    },
    "quickshell": {
      "repository": "quickshell-mirror/quickshell",
      "description": "Use for upstream Quickshell QML types, WlrLayershell/layer-shell, IpcHandler, reloadable config, and the qs CLI when customising the Omarchy shell bar widgets"
    }
  },
  "mcp": {
    "context": {
      "type": "local",
      "command": ["context", "mcp"],
      "enabled": true
    },
    "notes": {
      "type": "local",
      "command": ["notes", "mcp"],
      "enabled": true
    }
  }
}
