{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "skills": {
    "paths": [".agents/skills"]
  },
  "permission": {
    "notes_note_delete": "ask",
    "read": {
      "~/.agents": "allow",
      "~/.agents/skills/**": "allow",
      "~/.config": "allow",
      "~/.config/fastfetch/**": "allow",
      "~/.config/fish/**": "allow",
      "~/.config/ghostty/**": "allow",
      "~/.config/herdr/**": "allow",
      "~/.config/hunk/**": "allow",
      "~/.config/hypr/**": "allow",
      "~/.config/mise/**": "allow",
      "~/.config/nvim/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.config/ripgrep/**": "allow",
      "~/.config/starship/**": "allow",
      "~/.config/systemd": "allow",
      "~/.config/systemd/user/**": "allow",
      "~/.config/tmux/**": "allow",
      "~/.config/topgrade/**": "allow",
      "~/.config/yazi/**": "allow",
      "~/.local": "allow",
      "~/.local/bin/**": "allow",
      "~/.local/libexec/**": "allow",
      "~/.local/share": "allow",
      "~/.local/share/applications/**": "allow",
      "~/.local/share/bash-completion": "allow",
      "~/.local/share/bash-completion/completions/**": "allow",
      "~/.local/share/omarchy": "allow",
      "~/.local/share/omarchy/bin/**": "allow",
      "~/.local/share/opencode/repos/**": "allow",
      "~/.local/share/workspace-relayout/**": "allow",
      "~/.local/share/zsh": "allow",
      "~/.local/share/zsh/site-functions/**": "allow",
      "~/.plannotator/**": "allow"
    },
    "edit": {
      "~/.agents/skills/**": "deny",
      "~/.config/fastfetch/**": "deny",
      "~/.config/fish/**": "deny",
      "~/.config/ghostty/**": "deny",
      "~/.config/herdr/**": "deny",
      "~/.config/hunk/**": "deny",
      "~/.config/hypr/**": "deny",
      "~/.config/mise/**": "deny",
      "~/.config/nvim/**": "deny",
      "~/.config/opencode/**": "deny",
      "~/.config/ripgrep/**": "deny",
      "~/.config/starship/**": "deny",
      "~/.config/systemd/user/**": "deny",
      "~/.config/tmux/**": "deny",
      "~/.config/topgrade/**": "deny",
      "~/.config/yazi/**": "deny",
      "~/.local/bin/**": "deny",
      "~/.local/libexec/**": "deny",
      "~/.local/share/applications/**": "deny",
      "~/.local/share/bash-completion/completions/**": "deny",
      "~/.local/share/omarchy/bin/**": "deny",
      "~/.local/share/workspace-relayout/**": "deny",
      "~/.local/share/zsh/site-functions/**": "deny",
      "~/.plannotator/**": "deny"
    },
    "external_directory": {
      "~/.agents/*": "allow",
      "~/.cache/opencode/*": "allow",
      "~/.config/*": "allow",
      "~/.config/fastfetch/**": "allow",
      "~/.config/fish/**": "allow",
      "~/.config/ghostty/**": "allow",
      "~/.config/herdr/**": "allow",
      "~/.config/hunk/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.config/hypr/**": "allow",
      "~/.config/hypr-desktop/**": "allow",
      "~/.config/hypr-laptop/**": "allow",
      "~/.config/mise/**": "allow",
      "~/.config/nvim/**": "allow",
      "~/.config/ripgrep/**": "allow",
      "~/.config/starship/**": "allow",
      "~/.config/systemd/user/**": "allow",
      "~/.config/tmux/**": "allow",
      "~/.config/topgrade/**": "allow",
      "~/.config/waybar/**": "allow",
      "~/.config/yazi/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.local/*": "allow",
      "~/.local/bin/**": "allow",
      "~/.local/libexec/**": "allow",
      "~/.local/share/*": "allow",
      "~/.local/share/applications/**": "allow",
      "~/.local/share/bash-completion/*": "allow",
      "~/.local/share/bash-completion/completions/**": "allow",
      "~/.local/share/omarchy/*": "allow",
      "~/.local/share/omarchy/bin/**": "allow",
      "~/.local/share/opencode/repos/github.com/anomalyco/opencode/**": "allow",
      "~/.local/share/workspace-relayout/**": "allow",
      "~/.local/share/zsh/*": "allow",
      "~/.local/share/zsh/site-functions/**": "allow",
      "~/.plannotator/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "references": {
    "chromium-relaunch-as-app": {
      "repository": "timmo001/chromium-relaunch-as-app",
      "description": "Use for the Chromium relaunch-as-app extension behind the omarchy-launch-webapp binds"
    },
    "context": {
      "repository": "timmo001/context",
      "description": "Use for the standalone context CLI and MCP server for branch and stack context"
    },
    "effect": {
      "repository": "Effect-TS/effect",
      "description": "Use for Effect v4 APIs when working in dot/"
    },
    "go-automate": {
      "repository": "timmo001/go-automate",
      "description": "Use for the go-automate CLI and HA bridge invoked by Waybar, Hypr binds, and dotfiles scripts"
    },
    "notes": {
      "repository": "timmo001/notes",
      "description": "Use for the standalone notes CLI and MCP server for repo notes and handoffs"
    },
    "omarchy": {
      "repository": "basecamp/omarchy",
      "branch": "master",
      "description": "Use for Omarchy desktop, Hyprland, and Waybar customisation details"
    },
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "v1.18.16",
      "description": "Use for OpenCode config, agents, commands, skills, and plugin behaviour"
    },
    "opencode-config": {
      "repository": "timmo001/opencode-config",
      "description": "Use for the published OpenCode config mirrored from this repo"
    },
    "skills": {
      "repository": "timmo001/skills",
      "description": "Use for portable agent skills pinned into this repo and opencode-config"
    },
    "opentui": {
      "repository": "anomalyco/opentui",
      "description": "Use for OpenTUI core, renderables, and keyboard handling when working in dot/"
    },
    "system-bridge": {
      "repository": "timmo001/system-bridge",
      "description": "Use for the system-bridge backend autostarted via Hypr and its API/WebSocket behaviour"
    }
  },
  "mcp": {
    "context": {
      "type": "local",
      "command": ["context", "mcp"],
      "enabled": true
    },
    "notes": {
      "type": "local",
      "command": ["notes", "mcp"],
      "enabled": true
    }
  }
}
