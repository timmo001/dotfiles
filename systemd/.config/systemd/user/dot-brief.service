[Unit]
Description=Post the daily brief to the Plannotator Inbox
After=network-online.target
Wants=network-online.target
OnFailure=dot-service-failed@%n.service
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
# A missed run catches up as soon as you log in, before the network is up
ExecStartPre=/bin/sh -c 'up=$$(cut -d. -f1 /proc/uptime); [ "$$up" -ge 120 ] || sleep $$((120 - up))'
ExecStart=%h/.local/bin/mise exec -- %h/.local/bin/dot brief run
TimeoutStartSec=30min
TimeoutStopSec=30s
Restart=on-failure
RestartSec=2min
KillMode=control-group
