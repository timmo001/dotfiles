[Unit]
Description=Ollama model server
Documentation=https://github.com/ollama/ollama
After=network-online.target
Wants=network-online.target
OnFailure=dot-service-failed@%n.service

[Service]
# Runs the mise ollama as this user, replacing the system ollama.service from
# Ollama's install script. Models live in ~/.ollama/models.
Type=simple
Environment=OLLAMA_HOST=0.0.0.0
ExecStart=%h/.local/share/mise/shims/ollama serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
