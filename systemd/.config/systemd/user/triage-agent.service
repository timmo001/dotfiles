[Unit]
Description=triage agent, collecting crashes and errors from the journal
Documentation=https://github.com/timmo001/triage
After=network-online.target
Wants=network-online.target
# Needs TRIAGE_SERVER and TRIAGE_TOKEN, from `triage hosts add` on the server.
ConditionPathExists=%h/.config/triage/agent.env

[Service]
Type=simple
EnvironmentFile=%h/.config/triage/agent.env
ExecStart=%h/.local/share/mise/shims/triage collect --follow --upload
# The Effect runtime exits 130 when systemd stops it.
SuccessExitStatus=130
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
