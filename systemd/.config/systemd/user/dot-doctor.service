[Unit]
Description=Run dot doctor after boot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The desktop wraps this in dot-doctor-notify for a desktop notification. On
# the server a failed run stays in the journal, where the triage agent picks
# it up: journalctl --user -u dot-doctor
ExecStart=%h/.local/bin/dot doctor
