[Unit]
Description=Process queued notes captures with local OpenCode
After=network-online.target
Wants=network-online.target
OnFailure=dot-service-failed@%n.service

[Service]
Type=simple
ExecStart=%h/.local/bin/notes-capture-daemon
# The Effect runtime exits 130 when systemd stops it.
SuccessExitStatus=130
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
