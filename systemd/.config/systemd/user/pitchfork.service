[Unit]
Description=pitchfork
After=default.target

[Service]
Type=simple
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
# A literal path, not %h: pitchfork compares it with boot.executable in
# ~/.config/pitchfork/config.toml and rewrites the unit when they differ.
ExecStart=/home/aidan/.local/share/mise/shims/pitchfork supervisor run --boot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target