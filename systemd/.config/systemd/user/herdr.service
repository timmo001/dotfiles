[Unit]
Description=Herdr server for remote clients
After=network-online.target
Wants=network-online.target
OnFailure=dot-service-failed@%n.service

[Service]
# The desktop starts Herdr through uwsm-app from dot herdr start. The server
# has no graphical session, so systemd owns it instead. Enable lingering
# (loginctl enable-linger) so it runs without anyone logged in, then attach
# from another machine with herdr --remote <host>. herdr server stays in the
# foreground.
Type=simple
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h
ExecStart=/usr/bin/env herdr server
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
