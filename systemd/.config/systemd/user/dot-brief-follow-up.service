[Unit]
Description=Start agents for notes left on the daily brief
After=network-online.target
Wants=network-online.target
OnFailure=dot-service-failed@%n.service

[Service]
Type=simple
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/mise exec -- %h/.local/bin/dot brief follow-up --watch
# The Effect runtime exits 130 when systemd stops it.
SuccessExitStatus=130
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
