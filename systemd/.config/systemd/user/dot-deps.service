[Unit]
Description=Run coordinated dependency updates
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/dot/dependency-service.json
OnFailure=dot-service-failed@%n.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/mise exec -- %h/.local/bin/dot deps service
TimeoutStartSec=3h
TimeoutStopSec=30s
KillMode=control-group
