[Unit]
Description=Ollaya decision model server
Documentation=https://github.com/ollaya-dev/ollaya
After=network-online.target
Wants=network-online.target
OnFailure=dot-service-failed@%n.service

[Service]
# Runs the mise ollaya as this user. Models live in ~/.ollaya/models.
Type=simple
Environment=OLLAYA_HOST=0.0.0.0:11435
ExecStart=%h/.local/share/mise/shims/ollaya serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
