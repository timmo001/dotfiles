[Unit]
Description=Cloudflare tunnel %i, on one machine at a time
OnFailure=dot-service-failed@%n.service

[Service]
Type=simple
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
ExecStartPre=%h/.local/bin/wait-online-login
TimeoutStartSec=11min
ExecStart=%h/.local/bin/dot tunnel run %i
Restart=always
RestartSec=5s
RestartSteps=6
RestartMaxDelaySec=2min

[Install]
WantedBy=default.target
