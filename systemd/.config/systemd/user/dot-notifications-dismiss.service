[Unit]
Description=Mark merged dependency notifications done on GitHub
After=network-online.target
Wants=network-online.target
OnFailure=dot-service-failed@%n.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/mise exec -- %h/.local/bin/dot git notifications dismiss dependencies --mode all
TimeoutStartSec=30min
TimeoutStopSec=30s
KillMode=control-group
