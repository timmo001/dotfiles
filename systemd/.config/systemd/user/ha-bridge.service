[Unit]
Description=ha-bridge shared Home Assistant connection
Documentation=https://github.com/timmo001/ha-bridge
After=network-online.target
Wants=network-online.target

[Service]
# mise installs the release binary, which has no unit of its own. This is the
# packaged unit with ExecStart pointed at the mise shim.
Type=simple
Environment=XDG_RUNTIME_DIR=%t
ExecStart=%h/.local/share/mise/shims/ha-bridge serve
# The Effect runtime exits 130 when systemd stops it.
SuccessExitStatus=130
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
