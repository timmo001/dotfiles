[Unit]
Description=dot daemon, serving status checks to the bar, OpenCode and the CLI
OnFailure=dot-service-failed@%n.service

[Service]
Type=simple
# A login shell sets OMARCHY_PATH and the mise and ~/.local/bin PATH the
# checks need, as the bar's commands get them, even before the graphical
# session imports its environment.
ExecStart=/usr/bin/bash -lc 'exec %h/.local/bin/dot daemon'
# The status files mean the daemon is running; readers fall back to checking
# for themselves once they are gone, including after a crash.
ExecStopPost=/usr/bin/rm -rf %t/dot/status
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
