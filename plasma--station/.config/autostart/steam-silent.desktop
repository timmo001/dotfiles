[Desktop Entry]
Type=Application
Name=Steam (background)
Comment=Run Steam quietly on the desktop, so its desktop layout makes the controller a mouse and keyboard, as on SteamOS, keeping the beta chosen in gaming mode
Exec=sh -c "dot screen steam-beta desktop; exec steam -silent"
Icon=steam
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
NoDisplay=true
