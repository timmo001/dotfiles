{
  "remove": ["omarchy.weather"],
  "disable": [{ "id": "omarchy.notifications", "onlyHosts": ["laptop"] }],
  "plugins": [
    { "id": "timmo.workspace-context" },
    {
      "id": "omarchy.keyboard-layout",
      "placement": { "section": "right", "before": "omarchy.bluetooth" }
    },
    { "id": "omarchy.system-update", "placement": { "section": "center" } },
    {
      "id": "timmo.workspaces",
      "replace": "omarchy.workspaces",
      "inheritSettings": false,
      "placement": { "section": "left", "index": 1 },
      "settings": {
        "activeOpacity": 1,
        "inactiveOpacity": 0.5,
        "labels": "focused",
        "revealOnHover": true
      }
    },
    {
      "id": "omarchy.indicators",
      "placement": { "section": "left", "after": "timmo.workspaces" }
    },
    {
      "id": "timmo.upnext",
      "managed": true,
      "repository": "timmo001/upnext",
      "path": "omarchy-plugin",
      "placement": { "section": "center", "index": 0 },
      "settings": { "revealOnHover": true, "primaryOnly": true },
      "hosts": {
        "desktop": { "primaryOutput": "HDMI-A-2" },
        "laptop": { "primaryOutput": "eDP-1" }
      }
    },
    {
      "id": "timmo.git",
      "placement": { "section": "center", "after": "timmo.upnext" },
      "settings": {
        "revealOnHover": true,
        "primaryOnly": true,
        "hideWhenQuiet": true
      },
      "hosts": {
        "desktop": { "primaryOutput": "HDMI-A-2" },
        "laptop": { "primaryOutput": "eDP-1" }
      }
    },
    {
      "id": "timmo.command",
      "placement": { "section": "center", "before": "omarchy.system-update" },
      "settings": {
        "primaryOnly": true,
        "hideWhenQuiet": true,
        "hideWhenDetached": true,
        "run": "dot updates status",
        "interval": 60000,
        "refreshTarget": "timmo.updates",
        "loadingText": "\uF4B5 ..",
        "loadingClass": "updates-unknown",
        "onClick": "dot herdr repo open dotfiles \"${DOTFILES_PUBLIC_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles}\" Update \"dot up\"",
        "herdrLaunch": true,
        "onClickRight": "dot updates refresh",
        "classColors": {
          "updates-current": "#9b9b9b",
          "updates-unknown": "#9b9b9b",
          "updates": "#e5c07b",
          "updates-missing": "#e06c75"
        }
      },
      "hosts": {
        "desktop": { "primaryOutput": "HDMI-A-2" },
        "laptop": { "primaryOutput": "eDP-1" }
      }
    },
    {
      "id": "timmo.upkeep",
      "placement": { "section": "center", "after": "timmo.command" },
      "settings": {
        "primaryOnly": true,
        "hideWhenQuiet": true,
        "hideWhenDetached": true,
        "url": "http://homeassistant.local:7272"
      },
      "hosts": {
        "desktop": { "primaryOutput": "HDMI-A-2" },
        "laptop": { "primaryOutput": "eDP-1" }
      }
    },
    {
      "id": "timmo.home-assistant",
      "placement": { "section": "right", "before": "omarchy.bluetooth" },
      "settings": { "primaryOnly": true },
      "hosts": {
        "desktop": { "host": "desktop", "primaryOutput": "HDMI-A-2" },
        "laptop": { "host": "laptop", "primaryOutput": "eDP-1" }
      }
    },
    {
      "id": "timmo.system-bridge",
      "managed": true,
      "repository": "timmo001/system-bridge",
      "path": "omarchy-plugin",
      "placement": { "section": "right", "after": "timmo.home-assistant" },
      "settings": { "primaryOnly": true },
      "hosts": {
        "desktop": { "primaryOutput": "HDMI-A-2" },
        "laptop": { "primaryOutput": "eDP-1" }
      }
    },
    {
      "id": "timmo.notes",
      "managed": true,
      "repository": "timmo001/notes",
      "path": "omarchy-plugin",
      "placement": { "section": "center", "after": "timmo.git" },
      "settings": {
        "primaryOnly": true,
        "workspaceContextFile": "dot-herdr-context.json",
        "workspaceContextRefreshCommand": "omarchy-shell timmo.workspace-context refresh"
      },
      "hosts": {
        "desktop": { "primaryOutput": "HDMI-A-2" },
        "laptop": { "primaryOutput": "eDP-1" }
      }
    },
    {
      "id": "timmo.services",
      "placement": { "section": "center", "after": "timmo.notes" },
      "settings": { "primaryOnly": true, "hideWhenQuiet": true },
      "hosts": {
        "desktop": { "primaryOutput": "HDMI-A-2" },
        "laptop": { "primaryOutput": "eDP-1" }
      }
    },
    {
      "id": "timmo.momentumctl",
      "managed": true,
      "repository": "timmo001/omarchy-momentumctl"
    },
    { "id": "timmo.games" },
    { "id": "timmo.workspace-relayout" },
    { "id": "timmo.popup-loading" },
    {
      "id": "timmo.clock",
      "managed": true,
      "repository": "timmo001/omarchy-clock",
      "replace": "omarchy.clock",
      "placement": { "section": "right" },
      "settings": { "format": "HH:mm d MMM" }
    },
    {
      "id": "omarchy.elsewhen",
      "placement": { "section": "right", "after": "timmo.clock" },
      "settings": {
        "cities": [
          { "name": "London", "zone": "Europe/London" },
          { "name": "Los Angeles", "zone": "America/Los_Angeles" },
          { "name": "Denver", "zone": "America/Denver" },
          { "name": "Chicago", "zone": "America/Chicago" },
          { "name": "New York", "zone": "America/New_York" }
        ]
      }
    },
    {
      "id": "sceny.devices",
      "managed": true,
      "placement": { "section": "right", "before": "omarchy.bluetooth" },
      "settings": { "showPhotos": false, "screenFeature": false }
    },
    {
      "id": "omarchy.agents",
      "placement": { "section": "right", "before": "omarchy.bluetooth" }
    },
    {
      "id": "timmo.agent-checks",
      "managed": true,
      "repository": "timmo001/agent-checks",
      "placement": { "section": "center", "before": "timmo.git" },
      "settings": { "primaryOnly": true },
      "hosts": {
        "desktop": { "primaryOutput": "HDMI-A-2" },
        "laptop": { "primaryOutput": "eDP-1" }
      }
    },
    {
      "id": "timmo.plannotator-inbox",
      "placement": { "section": "center", "after": "timmo.git" },
      "settings": {
        "primaryOnly": true,
        "showWhenEmpty": false,
        "hideWhenQuiet": true
      },
      "hosts": {
        "desktop": { "primaryOutput": "HDMI-A-2" },
        "laptop": { "primaryOutput": "eDP-1" }
      }
    }
  ]
}
