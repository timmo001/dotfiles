#!/bin/bash

set -euo pipefail

STATE_DIR_DEFAULT="$HOME/.local/state/workspace-sessions"
STATE_DIR="$STATE_DIR_DEFAULT"
SESSION_FILE=""
DRY_RUN=false
LAUNCH_MISSING=true
MOVE_EXISTING=true

BROWSER_PERSONAL_CMD='uwsm app -- chromium --new-window --ozone-platform=wayland --profile-directory="Default" --force-device-scale-factor=0.8'
WORK_CHROME_BASE='uwsm app -- google-chrome-stable --new-window --ozone-platform=wayland --force-device-scale-factor=0.8 --profile-directory=Profile\ 1 --user-data-dir=$HOME/.config/google-chrome-work'
WORK_SLACK_CMD="$WORK_CHROME_BASE --app=https://app.slack.com/client"
WORK_DISCORD_CMD="$WORK_CHROME_BASE --app=https://discord.com/app"
WORK_BROWSER_CMD="$WORK_CHROME_BASE --class=work-browser"
TERM_DEFAULT_CMD='uwsm app -- ghostty'

USED_ADDRS=""

usage() {
  cat <<'EOF'
Usage: workspace-restore [--dry-run] [--file=FILE] [--state-dir=DIR] [--no-launch] [--no-move]

Restore a workspace session captured by workspace-capture.

Options:
  --dry-run        Print the restore plan without launching or moving windows.
  --file=FILE     Restore FILE. Defaults to the newest capture in the state dir.
  --state-dir=DIR Directory to search for default captures.
  --no-launch     Do not launch missing supported apps.
  --no-move       Do not move matched/restored windows to saved workspaces.
  -h, --help      Show this help.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run|--dryrun)
      DRY_RUN=true
      ;;
    --file=*)
      SESSION_FILE="${1#*=}"
      ;;
    --state-dir=*)
      STATE_DIR="${1#*=}"
      ;;
    --no-launch)
      LAUNCH_MISSING=false
      ;;
    --no-move)
      MOVE_EXISTING=false
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'workspace-restore: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'workspace-restore: required command not found: %s\n' "$1" >&2
    exit 1
  fi
}

require_command hyprctl
require_command jq
require_command base64

if [ -z "$SESSION_FILE" ]; then
  SESSION_FILE="$(find "$STATE_DIR" -maxdepth 1 -type f -name 'workspace-*.json' -printf '%T@ %p\n' 2>/dev/null | sort -nr | sed -n '1s/^[^ ]* //p')"
fi

if [ -z "$SESSION_FILE" ] || [ ! -f "$SESSION_FILE" ]; then
  printf 'workspace-restore: no session file found\n' >&2
  exit 1
fi

log_action() {
  if $DRY_RUN; then
    printf '[dry-run] %s\n' "$1"
  else
    printf '%s\n' "$1"
  fi
}

line_in_list() {
  local list="$1"
  local line="$2"
  [ -n "$line" ] || return 1
  grep -Fqx "$line" <<< "$list"
}

is_used() {
  line_in_list "$USED_ADDRS" "$1"
}

mark_used() {
  local addr="$1"
  [ -n "$addr" ] || return
  if ! is_used "$addr"; then
    if [ -n "$USED_ADDRS" ]; then
      USED_ADDRS+=$'\n'
    fi
    USED_ADDRS+="$addr"
  fi
}

matching_addresses() {
  local class_regex="$1"
  hyprctl -j clients | jq -r --arg re "$class_regex" '
    .[]
    | select(((.class // "") | test($re)) or ((.initialClass // "") | test($re)))
    | .address
  '
}

first_unused_new_address() {
  local before="$1"
  local after="$2"
  local addr

  while IFS= read -r addr; do
    [ -n "$addr" ] || continue
    if ! line_in_list "$before" "$addr" && ! is_used "$addr"; then
      printf '%s\n' "$addr"
      return 0
    fi
  done <<< "$after"

  return 1
}

find_existing_address() {
  local class_regex="$1"
  local workspace="$2"
  local addr

  addr="$(hyprctl -j clients | jq -r \
    --arg re "$class_regex" \
    --argjson ws "$workspace" \
    --arg used "$USED_ADDRS" '
      def used_addr($addr): ($used | split("\n") | index($addr)) != null;
      [.[]
        | select(((.class // "") | test($re)) or ((.initialClass // "") | test($re)))
        | select(.workspace.id == $ws)
        | select(used_addr(.address) | not)
      ]
      | sort_by(.focusHistoryID // 999999)
      | first.address // empty
    ')"

  if [ -n "$addr" ]; then
    printf '%s\n' "$addr"
    return 0
  fi

  hyprctl -j clients | jq -r \
    --arg re "$class_regex" \
    --arg used "$USED_ADDRS" '
      def used_addr($addr): ($used | split("\n") | index($addr)) != null;
      [.[]
        | select(((.class // "") | test($re)) or ((.initialClass // "") | test($re)))
        | select(used_addr(.address) | not)
      ]
      | sort_by(.focusHistoryID // 999999)
      | first.address // empty
    '
}

quote_arg() {
  printf '%q' "$1"
}

command_for_client() {
  local client_json="$1"
  local class initial_class title cwd quoted_cwd

  class="$(jq -r '.class // ""' <<< "$client_json")"
  initial_class="$(jq -r '.initialClass // ""' <<< "$client_json")"
  title="$(jq -r '.title // ""' <<< "$client_json")"
  cwd="$(jq -r '.process.cwd // ""' <<< "$client_json")"

  case "$class:$initial_class" in
    chrome-app.slack.com__client:*|*:chrome-app.slack.com__client)
      RESTORE_LABEL="Slack"
      RESTORE_CLASS_RE='^chrome-app\.slack\.com__client'
      RESTORE_COMMAND="$WORK_SLACK_CMD"
      return 0
      ;;
    chrome-discord.com__app:*|*:chrome-discord.com__app)
      RESTORE_LABEL="Discord"
      RESTORE_CLASS_RE='^chrome-discord\.com__app'
      RESTORE_COMMAND="$WORK_DISCORD_CMD"
      return 0
      ;;
    work-browser:*|*:work-browser)
      RESTORE_LABEL="Work browser"
      RESTORE_CLASS_RE='^(work-browser|google-chrome)$'
      RESTORE_COMMAND="$WORK_BROWSER_CMD"
      return 0
      ;;
    chromium:*|*:chromium)
      RESTORE_LABEL="Chromium"
      RESTORE_CLASS_RE='^chromium$'
      RESTORE_COMMAND="$BROWSER_PERSONAL_CMD"
      return 0
      ;;
    com.mitchellh.ghostty:*|*:com.mitchellh.ghostty)
      RESTORE_LABEL="Ghostty"
      RESTORE_CLASS_RE='^com\.mitchellh\.ghostty$'
      if [ -n "$cwd" ] && [ -d "$cwd" ]; then
        quoted_cwd="$(quote_arg "$cwd")"
        RESTORE_COMMAND="uwsm app -- ghostty --working-directory=$quoted_cwd"
      else
        RESTORE_COMMAND="$TERM_DEFAULT_CMD"
      fi
      return 0
      ;;
    *)
      RESTORE_LABEL="${class:-${initial_class:-unknown}}"
      RESTORE_CLASS_RE=""
      RESTORE_COMMAND=""
      RESTORE_REASON="unsupported class for automatic relaunch"
      [ -n "$title" ] && RESTORE_LABEL="$RESTORE_LABEL ($title)"
      return 1
      ;;
  esac
}

launch_and_wait() {
  local class_regex="$1"
  local command="$2"
  local before after addr

  if ! $LAUNCH_MISSING; then
    return 1
  fi

  before="$(matching_addresses "$class_regex" || true)"
  hyprctl dispatch exec "$command" >/dev/null 2>&1 || true

  for _ in {1..80}; do
    after="$(matching_addresses "$class_regex" || true)"
    addr="$(first_unused_new_address "$before" "$after" || true)"
    if [ -n "$addr" ]; then
      printf '%s\n' "$addr"
      return 0
    fi
    sleep 0.1
  done

  return 1
}

restore_window_shape() {
  local client_json="$1"
  local addr="$2"
  local floating x y width height

  floating="$(jq -r '.floating // false' <<< "$client_json")"

  if [ "$floating" != "true" ]; then
    return 0
  fi

  x="$(jq -r '.at[0] // empty' <<< "$client_json")"
  y="$(jq -r '.at[1] // empty' <<< "$client_json")"
  width="$(jq -r '.size[0] // empty' <<< "$client_json")"
  height="$(jq -r '.size[1] // empty' <<< "$client_json")"

  [ -n "$x" ] && [ -n "$y" ] && [ -n "$width" ] && [ -n "$height" ] || return 0

  log_action "Restoring floating geometry for $addr to ${width}x${height}+${x}+${y}"
  if ! $DRY_RUN; then
    hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1 || true
    hyprctl dispatch setfloating "address:$addr" >/dev/null 2>&1 || true
    hyprctl dispatch resizeactive exact "$width" "$height" >/dev/null 2>&1 || true
    hyprctl dispatch moveactive exact "$x" "$y" >/dev/null 2>&1 || true
  fi
}

printf 'Restoring workspace session: %s\n' "$SESSION_FILE"

while IFS= read -r client_b64; do
  client_json="$(printf '%s' "$client_b64" | base64 -d)"
  workspace="$(jq -r '.workspace.id // empty' <<< "$client_json")"
  saved_addr="$(jq -r '.address // empty' <<< "$client_json")"
  title="$(jq -r '.title // ""' <<< "$client_json")"

  [ -n "$workspace" ] || continue

  RESTORE_LABEL=""
  RESTORE_CLASS_RE=""
  RESTORE_COMMAND=""
  RESTORE_REASON=""

  if ! command_for_client "$client_json"; then
    log_action "Skipping $RESTORE_LABEL from workspace $workspace: $RESTORE_REASON"
    continue
  fi

  addr="$(find_existing_address "$RESTORE_CLASS_RE" "$workspace" || true)"

  if [ -n "$addr" ]; then
    log_action "Reusing $RESTORE_LABEL window $addr for saved $saved_addr on workspace $workspace"
  elif $DRY_RUN; then
    log_action "Would launch $RESTORE_LABEL for workspace $workspace: $RESTORE_COMMAND"
    addr="dry-run"
  else
    log_action "Launching $RESTORE_LABEL for workspace $workspace"
    addr="$(launch_and_wait "$RESTORE_CLASS_RE" "$RESTORE_COMMAND" || true)"
    if [ -z "$addr" ]; then
      printf 'workspace-restore: failed to resolve launched window for %s (%s)\n' "$RESTORE_LABEL" "$title" >&2
      continue
    fi
  fi

  if [ "$addr" != "dry-run" ]; then
    mark_used "$addr"
  fi

  if $MOVE_EXISTING; then
    log_action "Moving $RESTORE_LABEL to workspace $workspace"
    if ! $DRY_RUN && [ "$addr" != "dry-run" ]; then
      hyprctl dispatch movetoworkspace "$workspace,address:$addr" >/dev/null 2>&1 || true
      restore_window_shape "$client_json" "$addr"
    fi
  fi
done < <(jq -r '.clients | sort_by(.workspace.id, .at[1], .at[0])[] | @base64' "$SESSION_FILE")

active_workspace="$(jq -r '.active_workspace.id // empty' "$SESSION_FILE")"
if [ -n "$active_workspace" ]; then
  log_action "Switching to saved active workspace $active_workspace"
  if ! $DRY_RUN; then
    hyprctl dispatch workspace "$active_workspace" >/dev/null 2>&1 || true
  fi
fi

printf 'Workspace restore complete%s\n' "$($DRY_RUN && printf ' (dry run)' || true)"
