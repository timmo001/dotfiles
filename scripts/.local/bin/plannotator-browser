#!/bin/bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  printf 'Usage: %s <url>\n' "$0" >&2
  exit 2
fi

exec herdr plugin pane open \
  --plugin official.browser \
  --entrypoint browser \
  --placement zoomed \
  --env "HERDR_BROWSER_INITIAL_URL=$1" \
  --env HERDR_BROWSER_TRANSPORT=direct-kitty \
  --focus
