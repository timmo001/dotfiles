#!/usr/bin/env bash

set -euo pipefail

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

OUTPUT_DIR="${DOT_SYSTEM_HEALTH_OUTPUT_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/system-health-check}"
OUTPUT_FILE=""
HAS_INTERACTIVE_TTY=0

SAMPLES=5
INTERVAL=15
KNOWN_LOGS_MINUTES=15
KNOWN_LOG_MAX_LINES=200
OPEN_OPENCODE=0
SELF_UNIT=''
declare -a ONLY_SECTIONS=()

if has_cmd systemctl; then
  SELF_UNIT="$(systemctl --user show --property=Id --value 2>/dev/null || true)"
fi

KNOWN_LOG_PATTERN='error|failed|fatal|segfault|oom|out of memory|watchdog|hang|freeze|timeout|timed out|connection reset|i/o error|network.*down|link is down|amdgpu.*(error|fail|timeout|hang|reset)|nvidia.*(error|fail|timeout|hang|xid)|drm.*(error|fail|timeout|hang|reset)|gpu.*(error|fail|timeout|hang|reset)|throttl|thermal|overheat|critical temperature|cpu.*hot'

C_RESET=$'\033[0m'
C_BOLD=$'\033[1m'
C_RED=$'\033[31m'
C_YELLOW=$'\033[33m'
C_BLUE=$'\033[34m'
C_MAGENTA=$'\033[35m'
C_CYAN=$'\033[36m'
C_DIM=$'\033[2m'

if [[ -n "${NO_COLOR:-}" ]] || { [[ ! -t 1 ]] && [[ -z "${FORCE_COLOR:-}" ]]; }; then
  C_RESET=''
  C_BOLD=''
  C_RED=''
  C_YELLOW=''
  C_BLUE=''
  C_MAGENTA=''
  C_CYAN=''
  C_DIM=''
fi

term_width() {
  local width="${COLUMNS:-88}"

  if ! [[ "$width" =~ ^[0-9]+$ ]]; then
    width=88
  fi

  if [[ "$width" -lt 48 ]]; then
    width=48
  elif [[ "$width" -gt 120 ]]; then
    width=120
  fi

  printf '%s\n' "$width"
}

log_divider() {
  local char="${1:--}"
  local color="${2:-$C_DIM}"
  local width="${3:-$(term_width)}"
  local line

  line=$(printf '%*s' "$width" '')
  line=${line// /$char}
  printf '%b%s%b\n' "$color" "$line" "$C_RESET"
}

log_label() {
  local color="$1"
  local level="$2"
  local message="$3"
  local stream="${4:-stdout}"

  if [[ "$stream" == 'stderr' ]]; then
    printf '%b%-8s%b %s\n' "${C_BOLD}${color}" "[$level]" "$C_RESET" "$message" >&2
  else
    printf '%b%-8s%b %s\n' "${C_BOLD}${color}" "[$level]" "$C_RESET" "$message"
  fi
}

log_header() {
  local title="$1"

  printf '\n'
  log_divider '=' "$C_BLUE"
  printf '%b%s%b\n' "${C_BOLD}${C_BLUE}" "  $title" "$C_RESET"
  log_divider '=' "$C_BLUE"
}

log_section() {
  printf '\n'
  log_divider '-' "$C_DIM" 72
  printf '%b%s%b\n' "${C_BOLD}${C_MAGENTA}" "  $*" "$C_RESET"
}

log_info() {
  log_label "$C_CYAN" 'INFO' "$*"
}

log_warn() {
  log_label "$C_YELLOW" 'WARN' "$*" 'stderr'
}

log_error() {
  log_label "$C_RED" 'ERROR' "$*" 'stderr'
}

usage() {
  cat <<'EOF'
Usage: system-health-check [options]

Options:
  --only <sections>          Run only the listed sections (comma-separated,
                             repeatable). When omitted, all sections run.
                             Sections: cpu, memory, psi, network, disk,
                             thermal, logs
  --samples <n>              Number of snapshots (default: 5)
  --interval <seconds>       Seconds between snapshots (default: 15)
  --known-logs-minutes <n>   Journal lookback window (default: 15)
  --open-opencode            Run opencode analysis and open full interactive session
  --output <path>            Output report file path
  --help                     Show this help
EOF
}

validate_positive_int() {
  local name="$1"
  local value="$2"

  if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < 1 )); then
    printf 'system-health-check: %s must be a positive integer\n' "$name" >&2
    exit 1
  fi
}

format_mb_from_kb() {
  local kb="$1"
  awk -v value="$kb" 'BEGIN { printf "%.1f", value / 1024.0 }'
}

format_tenths() {
  local value="$1"
  awk -v v="$value" 'BEGIN { printf "%.1f", v / 10.0 }'
}

format_millideg() {
  local millideg="$1"
  awk -v t="$millideg" 'BEGIN { printf "%.1f", t / 1000.0 }'
}

summarize_array() {
  if (( $# == 0 )); then
    printf 'n/a n/a n/a\n'
    return
  fi

  printf '%s\n' "$@" | awk '
    NR == 1 { min = $1; max = $1; sum = $1 }
    NR > 1 {
      if ($1 < min) min = $1
      if ($1 > max) max = $1
      sum += $1
    }
    END {
      avg = sum / NR
      printf "%d %d %.0f\n", min, max, avg
    }
  '
}

read_mem_available_kb() {
  awk '/MemAvailable:/ { print $2 }' /proc/meminfo
}

read_swap_used_kb() {
  awk '/SwapTotal:/ { total=$2 } /SwapFree:/ { free=$2 } END { print total - free }' /proc/meminfo
}

read_load1_tenths() {
  awk '{ printf "%.0f", $1 * 10 }' /proc/loadavg
}

read_pressure_tenths() {
  local file="$1"
  awk '/^some / { for (i=1; i<=NF; i++) if ($i ~ /^avg60=/) { split($i, a, "="); printf "%.0f", a[2] * 10; exit } }' "$file"
}

read_tcp_sockets() {
  if ! has_cmd ss; then
    printf '0\n'
    return
  fi

  ss -s | awk '/^TCP:/ { gsub(/[^0-9]/, "", $2); print $2; exit }'
}

detect_primary_iface() {
  local iface=''

  if has_cmd ip; then
    iface="$(ip route show default 2>/dev/null | awk '/default/ { print $5; exit }')"
  fi

  if [[ -z "$iface" && -r /proc/net/route ]]; then
    iface="$(awk '$2 == "00000000" { print $1; exit }' /proc/net/route)"
  fi

  if [[ -z "$iface" ]]; then
    iface='unknown'
  fi

  printf '%s\n' "$iface"
}

read_iface_bytes() {
  local iface="$1"

  if [[ "$iface" == 'unknown' ]] || [[ ! -r /proc/net/dev ]]; then
    printf '0 0\n'
    return
  fi

  awk -v iface="$iface" '$1 ~ (iface ":") { gsub(":", "", $1); print $2, $10; found = 1; exit } END { if (found != 1) print "0 0" }' /proc/net/dev
}

read_root_disk_used_percent() {
  df -P / | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }'
}

read_cpu_count() {
  if has_cmd nproc; then
    nproc
  else
    awk '/^processor/ { count += 1 } END { print count + 0 }' /proc/cpuinfo
  fi
}

has_thermal_zones() {
  compgen -G '/sys/class/thermal/thermal_zone*/temp' >/dev/null 2>&1
}

read_thermal_zone_summary() {
  local zone type_file temp_file type_name temp_millideg temp_display
  local crit_file crit_millideg crit_display

  for zone in /sys/class/thermal/thermal_zone*; do
    type_file="$zone/type"
    temp_file="$zone/temp"

    [[ -r "$temp_file" ]] || continue
    type_name="unknown"
    [[ -r "$type_file" ]] && type_name="$(<"$type_file")"

    temp_millideg="$(<"$temp_file")"
    temp_display="$(awk -v t="$temp_millideg" 'BEGIN { printf "%.1f", t / 1000.0 }')"

    crit_display=''
    for crit_file in "$zone"/trip_point_*_temp; do
      [[ -r "$crit_file" ]] || continue
      if [[ "$crit_file" == *_temp ]] && grep -q 'critical' "${crit_file/_temp/_type}" 2>/dev/null; then
        crit_millideg="$(<"$crit_file")"
        crit_display=" crit=$(awk -v t="$crit_millideg" 'BEGIN { printf "%.0f", t / 1000.0 }')C"
        break
      fi
    done

    printf '  %-24s %s°C%s\n' "$type_name" "$temp_display" "$crit_display"
  done
}

read_thermal_max_millideg() {
  local max=0 temp_millideg

  for temp_file in /sys/class/thermal/thermal_zone*/temp; do
    [[ -r "$temp_file" ]] || continue
    temp_millideg="$(<"$temp_file")"
    if (( temp_millideg > max )); then
      max="$temp_millideg"
    fi
  done

  printf '%s\n' "$max"
}

read_thermal_hottest_zone() {
  local max=0 hottest='unknown' temp_millideg type_name

  for zone in /sys/class/thermal/thermal_zone*; do
    [[ -r "$zone/temp" ]] || continue
    temp_millideg="$(<"$zone/temp")"
    if (( temp_millideg > max )); then
      max="$temp_millideg"
      type_name='unknown'
      [[ -r "$zone/type" ]] && type_name="$(<"$zone/type")"
      hottest="$type_name"
    fi
  done

  printf '%s\n' "$hottest"
}

PREV_CPU_TOTAL=''
PREV_CPU_IDLE=''

read_cpu_busy_tenths() {
  local user nice system idle iowait irq softirq steal total idle_all
  local delta_total delta_idle busy

  read -r user nice system idle iowait irq softirq steal _ < <(
    awk '/^cpu / { print $2, $3, $4, $5, $6, $7, $8, $9, $10; exit }' /proc/stat
  )

  total=$((user + nice + system + idle + iowait + irq + softirq + steal))
  idle_all=$((idle + iowait))

  if [[ -z "$PREV_CPU_TOTAL" ]]; then
    PREV_CPU_TOTAL="$total"
    PREV_CPU_IDLE="$idle_all"
    printf '%s\n' '-1'
    return
  fi

  delta_total=$((total - PREV_CPU_TOTAL))
  delta_idle=$((idle_all - PREV_CPU_IDLE))
  PREV_CPU_TOTAL="$total"
  PREV_CPU_IDLE="$idle_all"

  if (( delta_total <= 0 )); then
    printf '%s\n' '-1'
    return
  fi

  busy=$((((delta_total - delta_idle) * 1000) / delta_total))
  printf '%s\n' "$busy"
}

print_limited_stream() {
  local limit="$1"

  awk -v limit="$limit" '
    NR <= limit { print }
    END {
      if (NR == 0) {
        print "No matching lines."
      } else if (NR > limit) {
        printf "... truncated %d line(s)\n", NR - limit
      }
    }
  '
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --only)
      IFS=',' read -ra _sections <<< "$2"
      ONLY_SECTIONS+=("${_sections[@]}")
      shift 2
      ;;
    --samples)
      SAMPLES="$2"
      shift 2
      ;;
    --interval)
      INTERVAL="$2"
      shift 2
      ;;
    --known-logs-minutes)
      KNOWN_LOGS_MINUTES="$2"
      shift 2
      ;;
    --open-opencode)
      OPEN_OPENCODE=1
      shift
      ;;
    --output)
      OUTPUT_FILE="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'system-health-check: unknown argument: %s\n' "$1" >&2
      exit 1
      ;;
  esac
done

if [[ -r /dev/tty && -w /dev/tty ]]; then
  HAS_INTERACTIVE_TTY=1
fi

# Validate --only section names
VALID_SECTIONS='cpu memory psi network disk thermal logs'
for _s in "${ONLY_SECTIONS[@]}"; do
  if [[ " $VALID_SECTIONS " != *" $_s "* ]]; then
    printf 'system-health-check: unknown section: %s\nValid sections: %s\n' "$_s" "$VALID_SECTIONS" >&2
    exit 1
  fi
done

section_enabled() {
  if (( ${#ONLY_SECTIONS[@]} == 0 )); then
    return 0
  fi
  local s
  for s in "${ONLY_SECTIONS[@]}"; do
    [[ "$s" == "$1" ]] && return 0
  done
  return 1
}

RUN_CPU=0;     section_enabled cpu     && RUN_CPU=1
RUN_MEMORY=0;  section_enabled memory  && RUN_MEMORY=1
RUN_PSI=0;     section_enabled psi     && RUN_PSI=1
RUN_NETWORK=0; section_enabled network && RUN_NETWORK=1
RUN_DISK=0;    section_enabled disk    && RUN_DISK=1
RUN_THERMAL=0; section_enabled thermal && RUN_THERMAL=1
RUN_LOGS=0;    section_enabled logs    && RUN_LOGS=1

RUN_SAMPLING=0
if (( RUN_CPU || RUN_MEMORY || RUN_PSI || RUN_NETWORK || RUN_THERMAL )); then
  RUN_SAMPLING=1
fi

validate_positive_int '--samples' "$SAMPLES"
validate_positive_int '--interval' "$INTERVAL"
validate_positive_int '--known-logs-minutes' "$KNOWN_LOGS_MINUTES"

if [[ -z "$OUTPUT_FILE" ]]; then
  mkdir -p "$OUTPUT_DIR"
  OUTPUT_FILE="$OUTPUT_DIR/system-health-check-$(date +%Y%m%d-%H%M%S).txt"
else
  mkdir -p "$(dirname "$OUTPUT_FILE")"
fi

exec > >(tee "$OUTPUT_FILE") 2>&1

log_header 'System Health Check'
log_info "Timestamp: $(date -Is)"
log_info "Host: $(hostname)"
log_info "Kernel: $(uname -r)"
log_info "Uptime/load: $(uptime)"

cpu_count="$(read_cpu_count)"
primary_iface="$(detect_primary_iface)"

if has_cmd fastfetch; then
  log_section 'Hardware'
  ff_json="$(fastfetch -s host:board:chassis:cpu:gpu:memory --format json 2>/dev/null)" || ff_json=''
  if [[ -n "$ff_json" ]] && has_cmd jq; then
    ff_val() { jq -r --arg t "$1" '.[] | select(.type == $t) | .result // empty' <<< "$ff_json"; }

    host_vendor="$(ff_val Host | jq -r '.vendor // empty')"
    host_name="$(ff_val Host | jq -r '.name // empty')"
    if [[ -n "$host_name" ]]; then
      log_info "Device: ${host_vendor:+$host_vendor }${host_name}"
    fi

    chassis_type="$(ff_val Chassis | jq -r '.type // empty')"
    [[ -n "$chassis_type" ]] && log_info "Chassis: $chassis_type"

    board_vendor="$(ff_val Board | jq -r '.vendor // empty')"
    board_name="$(ff_val Board | jq -r '.name // empty')"
    board_version="$(ff_val Board | jq -r '.version // empty')"
    if [[ -n "$board_name" ]]; then
      log_info "Motherboard: ${board_vendor:+$board_vendor }${board_name}${board_version:+ ($board_version)}"
    fi

    cpu_name="$(ff_val CPU | jq -r '.cpu // empty')"
    cpu_phys="$(ff_val CPU | jq -r '.cores.physical // empty')"
    cpu_logical="$(ff_val CPU | jq -r '.cores.logical // empty')"
    cpu_freq_max="$(ff_val CPU | jq -r '.frequency.max // empty')"
    if [[ -n "$cpu_name" ]]; then
      cpu_detail="$cpu_name"
      [[ -n "$cpu_phys" && -n "$cpu_logical" ]] && cpu_detail+=" (${cpu_phys}P/${cpu_logical}T)"
      [[ -n "$cpu_freq_max" ]] && cpu_detail+=" @ $(awk -v f="$cpu_freq_max" 'BEGIN { printf "%.1f GHz", f / 1000.0 }')"
      log_info "CPU: $cpu_detail"
    fi

    gpu_count="$(jq -r '.[] | select(.type == "GPU") | .result | length' <<< "$ff_json" 2>/dev/null)" || gpu_count=0
    if (( gpu_count > 0 )); then
      while IFS='|' read -r g_name g_driver g_type; do
        [[ -n "$g_name" ]] && log_info "GPU: ${g_name}${g_type:+ ($g_type)}${g_driver:+ [$g_driver]}"
      done < <(jq -r '.[] | select(.type == "GPU") | .result[] | [.name // "", .driver // "", .type // ""] | join("|")' <<< "$ff_json" 2>/dev/null)
    fi

    mem_total="$(ff_val Memory | jq -r '.total // empty')"
    if [[ -n "$mem_total" && "$mem_total" != "0" ]]; then
      mem_gb="$(awk -v b="$mem_total" 'BEGIN { printf "%.0f", b / 1073741824.0 }')"
      log_info "Memory: ${mem_gb} GB"
    fi
  fi

  if [[ -n "${OMARCHY_HOST:-}" ]]; then
    log_info "Omarchy host: $OMARCHY_HOST"
  fi
fi

log_section 'Config'

if (( ${#ONLY_SECTIONS[@]} > 0 )); then
  log_info "Sections: ${ONLY_SECTIONS[*]}"
else
  log_info "Sections: all"
fi

if (( RUN_SAMPLING )); then
  log_info "Snapshots: $SAMPLES"
  log_info "Interval: ${INTERVAL}s"
fi
if (( RUN_LOGS )); then
  log_info "Known logs window: ${KNOWN_LOGS_MINUTES} minute(s)"
fi
if (( RUN_CPU )); then
  log_info "CPU count: $cpu_count"
fi
if (( RUN_NETWORK )); then
  log_info "Primary interface: $primary_iface"
fi

root_disk_used=0
if (( RUN_DISK )); then
  root_disk_used="$(read_root_disk_used_percent)"
  log_info "Root disk used: ${root_disk_used}%"
fi

HAS_THERMAL=0
if (( RUN_THERMAL )) && has_thermal_zones; then
  HAS_THERMAL=1
  log_info 'Thermal zones:'
  read_thermal_zone_summary
elif (( RUN_THERMAL )); then
  log_info 'Thermal zones: not available'
fi

declare -a sample_epoch=()
declare -a load1_tenths=()
declare -a cpu_busy_tenths=()
declare -a mem_available_kb=()
declare -a swap_used_kb=()
declare -a cpu_psi_tenths=()
declare -a mem_psi_tenths=()
declare -a io_psi_tenths=()
declare -a tcp_sockets=()
declare -a rx_bytes=()
declare -a tx_bytes=()
declare -a cpu_busy_valid=()
declare -a thermal_max_millideg=()

duration_seconds=0
mem_drop_kb=0
swap_growth_kb=0
tcp_growth=0
rx_growth_bytes=0
tx_growth_bytes=0
load_min=0; load_max=0; load_avg=0
cpu_busy_min='-1'; cpu_busy_max='-1'; cpu_busy_avg='-1'
thermal_min=0; thermal_max_stat=0; thermal_avg=0; thermal_rise_millideg=0

if (( RUN_SAMPLING )); then
  log_section 'Snapshot Sampling'
  for ((i = 1; i <= SAMPLES; i += 1)); do
    if (( i > 1 )); then
      sleep "$INTERVAL"
    fi

    sample_epoch+=("$(date +%s)")

    load1=0; busy=-1
    if (( RUN_CPU )); then
      load1="$(read_load1_tenths)"
      busy="$(read_cpu_busy_tenths)"
    fi

    mem_avail=0; swap_used=0
    if (( RUN_MEMORY )); then
      mem_avail="$(read_mem_available_kb)"
      swap_used="$(read_swap_used_kb)"
    fi

    cpu_psi=0; mem_psi=0; io_psi=0
    if (( RUN_PSI )); then
      cpu_psi="$(read_pressure_tenths /proc/pressure/cpu)"
      mem_psi="$(read_pressure_tenths /proc/pressure/memory)"
      io_psi="$(read_pressure_tenths /proc/pressure/io)"
    fi

    tcp=0; rx=0; tx=0
    if (( RUN_NETWORK )); then
      tcp="$(read_tcp_sockets)"
      read -r rx tx <<< "$(read_iface_bytes "$primary_iface")"
    fi

    thermal_max=0
    if (( HAS_THERMAL )); then
      thermal_max="$(read_thermal_max_millideg)"
    fi

    load1_tenths+=("$load1")
    cpu_busy_tenths+=("$busy")
    mem_available_kb+=("$mem_avail")
    swap_used_kb+=("$swap_used")
    cpu_psi_tenths+=("$cpu_psi")
    mem_psi_tenths+=("$mem_psi")
    io_psi_tenths+=("$io_psi")
    tcp_sockets+=("$tcp")
    rx_bytes+=("$rx")
    tx_bytes+=("$tx")
    thermal_max_millideg+=("$thermal_max")

    if (( RUN_CPU && busy >= 0 )); then
      cpu_busy_valid+=("$busy")
    fi

    # Build sample display line from enabled sections
    sample_parts="sample $(printf '%02d/%02d' "$i" "$SAMPLES")"
    if (( RUN_CPU )); then
      busy_display='n/a'
      (( busy >= 0 )) && busy_display="$(format_tenths "$busy")%"
      sample_parts+=" load=$(format_tenths "$load1") cpu_busy=$busy_display"
    fi
    if (( RUN_MEMORY )); then
      sample_parts+=" mem_avail=$(format_mb_from_kb "$mem_avail")MB swap=$(format_mb_from_kb "$swap_used")MB"
    fi
    if (( RUN_PSI )); then
      sample_parts+=" cpu_psi60=$(format_tenths "$cpu_psi") mem_psi60=$(format_tenths "$mem_psi") io_psi60=$(format_tenths "$io_psi")"
    fi
    if (( RUN_NETWORK )); then
      sample_parts+=" tcp=$tcp rx_mb=$(awk -v b="$rx" 'BEGIN { printf "%.1f", b / 1048576.0 }') tx_mb=$(awk -v b="$tx" 'BEGIN { printf "%.1f", b / 1048576.0 }')"
    fi
    if (( HAS_THERMAL )); then
      sample_parts+=" thermal_max=$(format_millideg "$thermal_max")C"
    fi
    log_info "$sample_parts"
  done

  last_index=$((SAMPLES - 1))
  duration_seconds=$((sample_epoch[last_index] - sample_epoch[0]))

  if (( RUN_CPU )); then
    read -r load_min load_max load_avg <<< "$(summarize_array "${load1_tenths[@]}")"
    if (( ${#cpu_busy_valid[@]} > 0 )); then
      read -r cpu_busy_min cpu_busy_max cpu_busy_avg <<< "$(summarize_array "${cpu_busy_valid[@]}")"
    fi
  fi

  if (( RUN_MEMORY )); then
    mem_drop_kb=$((mem_available_kb[0] - mem_available_kb[last_index]))
    swap_growth_kb=$((swap_used_kb[last_index] - swap_used_kb[0]))
  fi

  if (( RUN_NETWORK )); then
    tcp_growth=$((tcp_sockets[last_index] - tcp_sockets[0]))
    rx_growth_bytes=$((rx_bytes[last_index] - rx_bytes[0]))
    tx_growth_bytes=$((tx_bytes[last_index] - tx_bytes[0]))
  fi

  if (( RUN_PSI )); then
    # shellcheck disable=SC2034  # min/max/avg parsed alongside thermal summary
    read -r cpu_psi_min cpu_psi_max cpu_psi_avg <<< "$(summarize_array "${cpu_psi_tenths[@]}")"
    # shellcheck disable=SC2034
    read -r mem_psi_min mem_psi_max mem_psi_avg <<< "$(summarize_array "${mem_psi_tenths[@]}")"
    # shellcheck disable=SC2034
    read -r io_psi_min io_psi_max io_psi_avg <<< "$(summarize_array "${io_psi_tenths[@]}")"
  fi

  if (( HAS_THERMAL )); then
    read -r thermal_min thermal_max_stat thermal_avg <<< "$(summarize_array "${thermal_max_millideg[@]}")"
    thermal_rise_millideg=$((thermal_max_millideg[last_index] - thermal_max_millideg[0]))
  fi
fi

user_log_count=0
kernel_log_count=0

if (( RUN_LOGS )); then
  log_section 'Known Logs (User Journal)'
  if has_cmd journalctl; then
    journalctl_user_cmd=(journalctl --user --since "${KNOWN_LOGS_MINUTES} minutes ago" --no-pager)
    if [[ -n "$SELF_UNIT" ]]; then
      journalctl_user_cmd+=(--unit "$SELF_UNIT")
    fi

    user_log_count="$("${journalctl_user_cmd[@]}" -o cat | awk -v pattern="$KNOWN_LOG_PATTERN" 'BEGIN { IGNORECASE = 1 } $0 ~ pattern { count += 1 } END { print count + 0 }')"
    "${journalctl_user_cmd[@]}" -o short-iso \
      | awk -v pattern="$KNOWN_LOG_PATTERN" 'BEGIN { IGNORECASE = 1 } $0 ~ pattern { print }' \
      | print_limited_stream "$KNOWN_LOG_MAX_LINES"

    printf '\n'
    log_info 'Top repeated user signals:'
    "${journalctl_user_cmd[@]}" -o cat \
      | awk -v pattern="$KNOWN_LOG_PATTERN" 'BEGIN { IGNORECASE = 1 } $0 ~ pattern { print }' \
      | sort \
      | uniq -c \
      | sort -nr \
      | awk 'NR <= 15 { printf "%7d %s\n", $1, substr($0, index($0, $2)) } END { if (NR == 0) print "No repeated user signals." }'
  else
    log_warn 'journalctl unavailable; skipping known logs collection.'
  fi

  log_section 'Known Logs (Kernel Journal)'
  if has_cmd journalctl; then
    kernel_log_count="$(journalctl -k --since "${KNOWN_LOGS_MINUTES} minutes ago" --no-pager -o cat | awk -v pattern="$KNOWN_LOG_PATTERN" 'BEGIN { IGNORECASE = 1 } $0 ~ pattern { count += 1 } END { print count + 0 }')"
    journalctl -k --since "${KNOWN_LOGS_MINUTES} minutes ago" --no-pager -o short-iso \
      | awk -v pattern="$KNOWN_LOG_PATTERN" 'BEGIN { IGNORECASE = 1 } $0 ~ pattern { print }' \
      | print_limited_stream "$KNOWN_LOG_MAX_LINES"

    printf '\n'
    log_info 'Top repeated kernel signals:'
    journalctl -k --since "${KNOWN_LOGS_MINUTES} minutes ago" --no-pager -o cat \
      | awk -v pattern="$KNOWN_LOG_PATTERN" 'BEGIN { IGNORECASE = 1 } $0 ~ pattern { print }' \
      | sort \
      | uniq -c \
      | sort -nr \
      | awk 'NR <= 15 { printf "%7d %s\n", $1, substr($0, index($0, $2)) } END { if (NR == 0) print "No repeated kernel signals." }'
  else
    log_warn 'journalctl unavailable; skipping kernel signal collection.'
  fi
fi

severity=0
declare -a watch_notes=()
declare -a stressed_notes=()

add_watch() {
  watch_notes+=("$1")
  if (( severity < 1 )); then
    severity=1
  fi
}

add_stressed() {
  stressed_notes+=("$1")
  severity=2
}

load_watch_threshold=$((cpu_count * 8))
load_stress_threshold=$((cpu_count * 12))

if (( RUN_CPU && ${#load1_tenths[@]} > 0 )); then
  if (( load1_tenths[last_index] > load_stress_threshold )); then
    add_stressed "Load avg1 is high for CPU count ($(format_tenths "${load1_tenths[last_index]}") on $cpu_count cores)."
  elif (( load1_tenths[last_index] > load_watch_threshold )); then
    add_watch "Load avg1 is elevated for CPU count ($(format_tenths "${load1_tenths[last_index]}") on $cpu_count cores)."
  fi

  if (( cpu_busy_avg >= 0 )); then
    if (( cpu_busy_avg > 850 )); then
      add_stressed "Average CPU busy is very high ($(format_tenths "$cpu_busy_avg")%)."
    elif (( cpu_busy_avg > 700 )); then
      add_watch "Average CPU busy is elevated ($(format_tenths "$cpu_busy_avg")%)."
    fi
  fi
fi

if (( RUN_MEMORY )); then
  if (( mem_drop_kb > 1024 * 1024 )); then
    add_stressed "MemAvailable dropped by more than 1.0 GiB ($(format_mb_from_kb "$mem_drop_kb") MB)."
  elif (( mem_drop_kb > 512 * 1024 )); then
    add_watch "MemAvailable dropped by more than 512 MB ($(format_mb_from_kb "$mem_drop_kb") MB)."
  fi

  if (( swap_growth_kb > 512 * 1024 )); then
    add_stressed "Swap used grew by more than 512 MB ($(format_mb_from_kb "$swap_growth_kb") MB)."
  elif (( swap_growth_kb > 128 * 1024 )); then
    add_watch "Swap used grew by more than 128 MB ($(format_mb_from_kb "$swap_growth_kb") MB)."
  fi
fi

if (( RUN_PSI && ${#cpu_psi_tenths[@]} > 0 )); then
  if (( cpu_psi_tenths[last_index] > 30 )); then
    add_stressed "CPU PSI avg60 is high ($(format_tenths "${cpu_psi_tenths[last_index]}"))."
  elif (( cpu_psi_tenths[last_index] > 10 )); then
    add_watch "CPU PSI avg60 is elevated ($(format_tenths "${cpu_psi_tenths[last_index]}"))."
  fi

  if (( mem_psi_tenths[last_index] > 20 )); then
    add_stressed "Memory PSI avg60 is high ($(format_tenths "${mem_psi_tenths[last_index]}"))."
  elif (( mem_psi_tenths[last_index] > 5 )); then
    add_watch "Memory PSI avg60 is elevated ($(format_tenths "${mem_psi_tenths[last_index]}"))."
  fi

  if (( io_psi_tenths[last_index] > 20 )); then
    add_stressed "IO PSI avg60 is high ($(format_tenths "${io_psi_tenths[last_index]}"))."
  elif (( io_psi_tenths[last_index] > 5 )); then
    add_watch "IO PSI avg60 is elevated ($(format_tenths "${io_psi_tenths[last_index]}"))."
  fi
fi

if (( RUN_NETWORK )); then
  if (( tcp_growth > 400 )); then
    add_stressed "TCP socket count grew sharply ($tcp_growth)."
  elif (( tcp_growth > 150 )); then
    add_watch "TCP socket count grew noticeably ($tcp_growth)."
  fi
fi

if (( RUN_LOGS )); then
  total_known_log_matches=$((user_log_count + kernel_log_count))
  if (( total_known_log_matches > 80 )); then
    add_stressed "Known log matches are very high ($total_known_log_matches lines in ${KNOWN_LOGS_MINUTES}m)."
  elif (( total_known_log_matches > 10 )); then
    add_watch "Known log matches are elevated ($total_known_log_matches lines in ${KNOWN_LOGS_MINUTES}m)."
  fi
fi

if (( RUN_DISK )); then
  if (( root_disk_used > 95 )); then
    add_stressed "Root disk usage is critical (${root_disk_used}%)."
  elif (( root_disk_used > 85 )); then
    add_watch "Root disk usage is high (${root_disk_used}%)."
  fi
fi

if (( HAS_THERMAL )); then
  # thermal_max_stat is in millidegrees: 90000 = 90°C, 80000 = 80°C
  if (( thermal_max_stat > 95000 )); then
    add_stressed "Peak thermal reading is critical ($(format_millideg "$thermal_max_stat")°C) — likely throttling."
  elif (( thermal_max_stat > 85000 )); then
    add_stressed "Peak thermal reading is very high ($(format_millideg "$thermal_max_stat")°C)."
  elif (( thermal_max_stat > 75000 )); then
    add_watch "Peak thermal reading is elevated ($(format_millideg "$thermal_max_stat")°C)."
  fi

  if (( thermal_rise_millideg > 15000 )); then
    add_stressed "Temperature rose sharply during sampling ($(format_millideg "$thermal_rise_millideg")°C increase)."
  elif (( thermal_rise_millideg > 8000 )); then
    add_watch "Temperature rose noticeably during sampling ($(format_millideg "$thermal_rise_millideg")°C increase)."
  fi
fi

log_section 'Friendly Summary'

if (( RUN_SAMPLING )); then
  log_info "Sampling duration: ${duration_seconds}s"
fi

if (( RUN_CPU && ${#load1_tenths[@]} > 0 )); then
  log_info "CPU load avg1: start=$(format_tenths "${load1_tenths[0]}") end=$(format_tenths "${load1_tenths[last_index]}") min=$(format_tenths "$load_min") max=$(format_tenths "$load_max") avg=$(format_tenths "$load_avg")"
  if (( cpu_busy_avg >= 0 )); then
    log_info "CPU busy: min=$(format_tenths "$cpu_busy_min")% max=$(format_tenths "$cpu_busy_max")% avg=$(format_tenths "$cpu_busy_avg")%"
  else
    log_info 'CPU busy: n/a'
  fi
fi

if (( RUN_MEMORY && ${#mem_available_kb[@]} > 0 )); then
  log_info "MemAvailable: start=$(format_mb_from_kb "${mem_available_kb[0]}")MB end=$(format_mb_from_kb "${mem_available_kb[last_index]}")MB delta=$(format_mb_from_kb "$mem_drop_kb")MB"
  log_info "Swap used: start=$(format_mb_from_kb "${swap_used_kb[0]}")MB end=$(format_mb_from_kb "${swap_used_kb[last_index]}")MB delta=$(format_mb_from_kb "$swap_growth_kb")MB"
fi

if (( RUN_PSI && ${#cpu_psi_tenths[@]} > 0 )); then
  log_info "PSI avg60 (end): cpu=$(format_tenths "${cpu_psi_tenths[last_index]}") mem=$(format_tenths "${mem_psi_tenths[last_index]}") io=$(format_tenths "${io_psi_tenths[last_index]}")"
fi

if (( RUN_NETWORK && ${#tcp_sockets[@]} > 0 )); then
  log_info "TCP sockets: start=${tcp_sockets[0]} end=${tcp_sockets[last_index]} delta=$tcp_growth"
  log_info "Network traffic ($primary_iface): rx_delta=$(awk -v b="$rx_growth_bytes" 'BEGIN { printf "%.1f", b / 1048576.0 }')MB tx_delta=$(awk -v b="$tx_growth_bytes" 'BEGIN { printf "%.1f", b / 1048576.0 }')MB"
fi

if (( RUN_DISK )); then
  log_info "Root disk: ${root_disk_used}%"
fi

if (( RUN_LOGS )); then
  log_info "Known logs: user=$user_log_count kernel=$kernel_log_count total=${total_known_log_matches:-0}"
fi

if (( HAS_THERMAL )); then
  log_info "Thermal max: start=$(format_millideg "${thermal_max_millideg[0]}")C end=$(format_millideg "${thermal_max_millideg[last_index]}")C min=$(format_millideg "$thermal_min")C max=$(format_millideg "$thermal_max_stat")C avg=$(format_millideg "$thermal_avg")C delta=$(format_millideg "$thermal_rise_millideg")C"
  log_info "Hottest zone: $(read_thermal_hottest_zone)"
fi

if (( severity == 0 )); then
  log_info 'Verdict: Healthy'
  log_info 'Your system looked stable across this sampling window.'
elif (( severity == 1 )); then
  log_warn 'Verdict: Watch'
  log_warn 'A few signals are elevated. Keep an eye on these:'
  for note in "${watch_notes[@]}"; do
    log_warn "- $note"
  done
else
  log_error 'Verdict: Stressed'
  log_error 'Multiple stress indicators were detected:'
  for note in "${stressed_notes[@]}"; do
    log_error "- $note"
  done

  if (( ${#watch_notes[@]} > 0 )); then
    log_warn 'Additional watch items:'
    for note in "${watch_notes[@]}"; do
      log_warn "- $note"
    done
  fi
fi

printf '\n'
log_info "Saved system health report: $OUTPUT_FILE"

if (( OPEN_OPENCODE )); then
  log_section 'OpenCode Handoff'

  if ! has_cmd opencode; then
    log_error 'opencode command not found. Skipping OpenCode handoff.'
    exit 0
  fi

  opencode_prompt="Review the system health report at ${OUTPUT_FILE}. Read it with the Read tool first. Give a concise diagnosis, probable causes, and a prioritized action plan. Use the logs and metrics to justify each recommendation."

  if (( HAS_INTERACTIVE_TTY )); then
    log_info 'Launching interactive OpenCode session...'
    opencode --prompt "$opencode_prompt" < /dev/tty > /dev/tty 2>&1 \
      || log_error 'OpenCode session exited with an error.'
  else
    log_warn 'No interactive TTY detected. Run manually: opencode --prompt "..."'
  fi
fi
