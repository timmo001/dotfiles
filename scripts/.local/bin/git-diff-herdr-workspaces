#!/usr/bin/env bash
set -euo pipefail

DOT_BIN="${DOT_BIN:-$HOME/.config/dotfiles/scripts/.local/bin/dot}"
MODE="${1:-changed}"

case "$MODE" in
  changed) diff_arg="--list-changed" ;;
  all) diff_arg="--list-all" ;;
  *)
    printf 'Usage: %s [changed|all]\n' "${0##*/}" >&2
    exit 1
    ;;
esac

if ! command -v herdr >/dev/null 2>&1; then
  notify-send 'Git diff' 'Herdr is not installed yet.' >/dev/null 2>&1 || true
  exit 1
fi

workspace_id_for() {
  local label="$1"
  local cwd="$2"

  herdr workspace list 2>/dev/null |
    jq -r --arg label "$label" --arg cwd "$cwd" '
      (.result.workspaces // .workspaces // [])[]
      | select(.label == $label or .cwd == $cwd)
      | .workspace_id
    ' | awk 'NF { print; exit }'
}

created=0
while IFS='|' read -r name path; do
  [[ -n "$name" && -n "$path" ]] || continue
  label="${name#*:}"
  existing="$(workspace_id_for "$label" "$path")"
  if [[ -n "$existing" ]]; then
    herdr workspace focus "$existing" >/dev/null 2>&1 || true
  else
    herdr workspace create --cwd "$path" --label "$label" --no-focus >/dev/null
  fi
  created=$((created + 1))
done < <("$DOT_BIN" git-diff "$diff_arg")

if [[ "$created" -eq 0 ]]; then
  notify-send 'Git diff' 'No repositories to open in Herdr.' >/dev/null 2>&1 || true
  exit 0
fi

uwsm app -- xdg-terminal-exec --app-id=org.omarchy.terminal herdr
