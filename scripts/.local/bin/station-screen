#!/usr/bin/env bash

# Give this machine an extra screen shown on Station: a headless Hyprland
# output that Sunshine streams (output_name = STATION in sunshine.conf) and
# Moonlight on Station plays. Its mode comes from hypr/monitors.lua.
#
# Usage: station-screen on|off|status

set -euo pipefail

output=STATION
station=aidan@arch-station.local
moonlight_unit="station-screen-moonlight"
host="$(hostnamectl hostname).local"

output_json() {
  hyprctl monitors -j | jq -e --arg name "$output" '.[] | select(.name == $name)'
}

on_station() {
  ssh -o ConnectTimeout=5 "$station" "$@"
}

case "${1:-}" in
  on)
    systemctl --user start app-dev.lizardbyte.app.Sunshine.service
    if ! output_json >/dev/null; then
      hyprctl output create headless "$output" >/dev/null
    fi
    read -r width height fps < <(output_json | jq -r '"\(.width) \(.height) \(.refreshRate | round)"')
    if on_station systemctl --user --quiet is-active "$moonlight_unit"; then
      echo "Moonlight is already showing it on Station."
      exit 0
    fi
    on_station systemd-run --user --collect --quiet --unit="$moonlight_unit" \
      moonlight stream "$host" Desktop --resolution "${width}x${height}" --fps "$fps" --display-mode fullscreen --audio-on-host
    echo "Station is showing $output (${width}x${height}@${fps})."
    ;;
  off)
    on_station systemctl --user stop "$moonlight_unit" 2>/dev/null || true
    if output_json >/dev/null; then
      hyprctl output remove "$output" >/dev/null
    fi
    echo "$output is off."
    ;;
  status)
    if output_json >/dev/null; then
      output_json | jq -r '"\(.name): \(.width)x\(.height)@\(.refreshRate | round), workspace \(.activeWorkspace.name)"'
    else
      echo "$output: off"
    fi
    printf 'Moonlight on Station: '
    on_station systemctl --user is-active "$moonlight_unit" || true
    ;;
  *)
    echo "Usage: station-screen on|off|status" >&2
    exit 1
    ;;
esac
