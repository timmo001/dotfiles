#!/bin/bash

# Default web browser for xdg-open and omarchy-launch-browser, which runs the
# first word of the desktop entry's Exec line with browser arguments.

# omarchy-launch-browser runs `--help` on every launch to spot Firefox. Answer
# it here, or dot opens a browser with it and waits for that to take focus.
[[ ${1-} == --help ]] && exit 0

exec dot link open -- "$@"
