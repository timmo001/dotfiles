#!/usr/bin/env bash

set -euo pipefail

MOTION_ENTITY="input_boolean.doorbell"
CAMERA_ENTITY="camera.front_door_snapshot"
HOME_ASSISTANT_BASE_URL="http://homeassistant.local:8123"

POPUP_WIDTH="380"
POPUP_HEIGHT="500"
POPUP_MARGIN="16"
POPUP_BOTTOM_MARGIN="6"
POPUP_DURATION_SECONDS="20"
POPUP_MONITOR=""
OPEN_ONLY=0
AUTO_CLOSE=1

POPUP_URL="${HOME_ASSISTANT_BASE_URL}/lovelace/home?more-info-entity-id=${CAMERA_ENTITY}"
POPUP_ADDR_FILE="${XDG_RUNTIME_DIR:-/tmp}/doorbell-popup.address"

popup_addr=""
close_timer_pid=""

usage() {
  cat <<'EOF'
Usage: doorbell-popup [options]

Options:
  --camera-entity <entity_id>   Camera entity for more-info popup
  --monitor <name>              Target monitor name (e.g. DP-1)
  --width <px>                  Popup width in pixels
  --height <px>                 Popup height in pixels
  --open-only                   Open popup once and exit
  --no-auto-close               Keep popup open (disable auto-close timer)
  --help                        Show this help
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --camera-entity)
        CAMERA_ENTITY="$2"
        shift 2
        ;;
      --monitor)
        POPUP_MONITOR="$2"
        shift 2
        ;;
      --width)
        POPUP_WIDTH="$2"
        shift 2
        ;;
      --height)
        POPUP_HEIGHT="$2"
        shift 2
        ;;
      --open-only)
        OPEN_ONLY=1
        shift
        ;;
      --no-auto-close)
        AUTO_CLOSE=0
        shift
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*)
        printf 'doorbell-popup: unknown option: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
      *)
        printf 'doorbell-popup: unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

validate_numeric_settings() {
  local key value

  for key in POPUP_WIDTH POPUP_HEIGHT; do
    value="${!key}"
    if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value <= 0 )); then
      printf 'doorbell-popup: %s must be a positive integer\n' "$key" >&2
      exit 1
    fi
  done
}

require_commands() {
  local cmd
  for cmd in go-automate hyprctl jq launch-floating-webapp; do
    command -v "$cmd" >/dev/null 2>&1 || {
      printf 'doorbell-popup: missing command: %s\n' "$cmd" >&2
      exit 1
    }
  done
}

window_exists() {
  local addr="$1"
  [[ -n "$addr" ]] || return 1
  hyprctl -j clients | jq -e --arg addr "$addr" '.[] | select(.address == $addr)' >/dev/null
}

load_known_popup_addr() {
  local known_addr

  if [[ -f "$POPUP_ADDR_FILE" ]]; then
    known_addr="$(< "$POPUP_ADDR_FILE")"
    if window_exists "$known_addr"; then
      popup_addr="$known_addr"
      return 0
    fi
    rm -f "$POPUP_ADDR_FILE"
  fi

  return 1
}

position_popup() {
  local addr="$1"
  local -a args=(--address "$addr" --width "$POPUP_WIDTH" --height "$POPUP_HEIGHT" --right-margin "$POPUP_MARGIN" --bottom-margin "$POPUP_BOTTOM_MARGIN")
  [[ -z $POPUP_MONITOR ]] || args+=(--monitor "$POPUP_MONITOR")
  launch-floating-webapp "${args[@]}" >/dev/null
}

open_popup() {
  local -a args=(--width "$POPUP_WIDTH" --height "$POPUP_HEIGHT" --right-margin "$POPUP_MARGIN" --bottom-margin "$POPUP_BOTTOM_MARGIN")
  [[ -z $POPUP_MONITOR ]] || args+=(--monitor "$POPUP_MONITOR")
  popup_addr="$(launch-floating-webapp "${args[@]}" "$POPUP_URL")" || return 1
  printf '%s\n' "$popup_addr" >"$POPUP_ADDR_FILE"
}

stop_close_timer() {
  if [[ -n "$close_timer_pid" ]] && kill -0 "$close_timer_pid" 2>/dev/null; then
    kill "$close_timer_pid" 2>/dev/null || true
    wait "$close_timer_pid" 2>/dev/null || true
  fi
  close_timer_pid=""
}

schedule_close() {
  local addr="$1"

  stop_close_timer
  (
    sleep "$POPUP_DURATION_SECONDS"
    if hyprctl -j clients | jq -e --arg close_addr "$addr" '.[] | select(.address == $close_addr)' >/dev/null; then
      hyprctl dispatch "hl.dsp.window.close({ window = 'address:${addr}' })" >/dev/null 2>&1 || true
    fi
  ) &
  close_timer_pid="$!"
}

restore_focus() {
  local addr="$1"

  [[ -n "$addr" ]] || return 0
  window_exists "$addr" || return 0
  hyprctl dispatch "hl.dsp.focus({ window = 'address:${addr}' })" >/dev/null 2>&1 || true
}

handle_motion_event() {
  local active_addr

  active_addr="$(hyprctl -j activewindow | jq -r '.address // empty' 2>/dev/null || true)"

  if [[ -z "$popup_addr" ]]; then
    load_known_popup_addr || true
  fi

  if window_exists "$popup_addr"; then
    position_popup "$popup_addr" || true
    restore_focus "$active_addr"
    if (( AUTO_CLOSE )); then
      schedule_close "$popup_addr"
    fi
    return
  fi

  popup_addr=""
  if open_popup; then
    restore_focus "$active_addr"
    if (( AUTO_CLOSE )); then
      schedule_close "$popup_addr"
    fi
  fi
}

watch_motion() {
  local line state
  local watch_pid=""

  while true; do
    coproc MOTION_WATCH {
      exec go-automate ha bridge watch entity --bar-json --icon '' "$MOTION_ENTITY" 2>/dev/null
    }

    watch_pid="${MOTION_WATCH_PID:-}"

    while IFS= read -r line <&"${MOTION_WATCH[0]}"; do
      state="$(jq -r '.class // ""' <<< "$line" 2>/dev/null)"
      state="${state%% *}"
      if [[ "$state" == "on" ]]; then
        handle_motion_event
      fi
    done

    if [[ -n "$watch_pid" ]]; then
      wait "$watch_pid" 2>/dev/null || true
    fi
    sleep 1
  done
}

cleanup() {
  stop_close_timer
}

main() {
  parse_args "$@"
  validate_numeric_settings
  POPUP_URL="${HOME_ASSISTANT_BASE_URL}/lovelace/home?more-info-entity-id=${CAMERA_ENTITY}"
  require_commands
  trap cleanup EXIT INT TERM

  if (( OPEN_ONLY )); then
    handle_motion_event
    exit 0
  fi

  watch_motion
}

main "$@"
