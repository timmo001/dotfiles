#!/usr/bin/env bash
# Pops up the doorbell's live view from Kestrel, through camera-popup, when
# the doorbell rings, or once with --open-only, and closes it after a while
# unless --no-auto-close. Focus goes back to the window that had it.

set -euo pipefail

MOTION_ENTITY="input_boolean.doorbell"
CAMERA="reolink-front-door/1"

POPUP_WIDTH="480"
POPUP_HEIGHT="420"
POPUP_DURATION_SECONDS="20"
POPUP_MONITOR=""
OPEN_ONLY=0
AUTO_CLOSE=1

popup_addr=""
close_timer_pid=""

usage() {
  cat <<'EOF'
Usage: doorbell-popup [options]

Options:
  --camera <id>                 Kestrel camera id (default: reolink-front-door/1)
  --monitor <name>              Target monitor name (e.g. DP-1)
  --width <px>                  Popup width in pixels
  --height <px>                 Popup height in pixels
  --open-only                   Open popup once and exit
  --no-auto-close               Keep popup open (disable auto-close timer)
  --help                        Show this help
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --camera)
        CAMERA="$2"
        shift 2
        ;;
      --monitor)
        POPUP_MONITOR="$2"
        shift 2
        ;;
      --width)
        POPUP_WIDTH="$2"
        shift 2
        ;;
      --height)
        POPUP_HEIGHT="$2"
        shift 2
        ;;
      --open-only)
        OPEN_ONLY=1
        shift
        ;;
      --no-auto-close)
        AUTO_CLOSE=0
        shift
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*)
        printf 'doorbell-popup: unknown option: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
      *)
        printf 'doorbell-popup: unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

require_commands() {
  local cmd
  for cmd in camera-popup ha-bridge hyprctl jq; do
    command -v "$cmd" >/dev/null 2>&1 || {
      printf 'doorbell-popup: missing command: %s\n' "$cmd" >&2
      exit 1
    }
  done
}

window_exists() {
  local addr="$1"
  [[ -n "$addr" ]] || return 1
  hyprctl -j clients | jq -e --arg addr "$addr" '.[] | select(.address == $addr)' >/dev/null
}

# Opens the popup, or moves the one already open back into place
open_popup() {
  local -a args=(--name doorbell --width "$POPUP_WIDTH" --height "$POPUP_HEIGHT")
  [[ -z $POPUP_MONITOR ]] || args+=(--monitor "$POPUP_MONITOR")
  popup_addr="$(camera-popup "${args[@]}" "$CAMERA")"
}

stop_close_timer() {
  if [[ -n "$close_timer_pid" ]] && kill -0 "$close_timer_pid" 2>/dev/null; then
    kill "$close_timer_pid" 2>/dev/null || true
    wait "$close_timer_pid" 2>/dev/null || true
  fi
  close_timer_pid=""
}

schedule_close() {
  local addr="$1"

  stop_close_timer
  (
    sleep "$POPUP_DURATION_SECONDS"
    if window_exists "$addr"; then
      hyprctl dispatch "hl.dsp.window.close({ window = 'address:${addr}' })" >/dev/null 2>&1 || true
    fi
  ) &
  close_timer_pid="$!"
}

restore_focus() {
  local addr="$1"

  [[ -n "$addr" ]] || return 0
  window_exists "$addr" || return 0
  hyprctl dispatch "hl.dsp.focus({ window = 'address:${addr}' })" >/dev/null 2>&1 || true
}

handle_motion_event() {
  local active_addr

  active_addr="$(hyprctl -j activewindow | jq -r '.address // empty' 2>/dev/null || true)"

  open_popup || return 0
  restore_focus "$active_addr"
  if (( AUTO_CLOSE )); then
    schedule_close "$popup_addr"
  fi
}

watch_motion() {
  local line state
  local watch_pid=""

  while true; do
    coproc MOTION_WATCH {
      exec ha-bridge watch --bar-json --icon '' "$MOTION_ENTITY" 2>/dev/null
    }

    watch_pid="${MOTION_WATCH_PID:-}"

    while IFS= read -r line <&"${MOTION_WATCH[0]}"; do
      state="$(jq -r '.class // ""' <<< "$line" 2>/dev/null)"
      state="${state%% *}"
      if [[ "$state" == "on" ]]; then
        handle_motion_event
      fi
    done

    if [[ -n "$watch_pid" ]]; then
      wait "$watch_pid" 2>/dev/null || true
    fi
    sleep 1
  done
}

cleanup() {
  stop_close_timer
}

main() {
  parse_args "$@"
  require_commands
  trap cleanup EXIT INT TERM

  if (( OPEN_ONLY )); then
    handle_motion_event
    exit 0
  fi

  watch_motion
}

main "$@"
