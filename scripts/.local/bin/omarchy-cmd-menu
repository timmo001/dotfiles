    local choice
    choice="$(walker_menu 'Toggle...' \
      '󰙿  Nightlight' \
      '󰒲  Idle lock' \
      '󰃎  Waybar' \
      '󰟸  Touchpad' \
      '󰍶  Touchscreen' \
      '󰂛  Notification silencing' \
      '󰤄  Suspend' \
      '󰖤  Screensaver' \
    )"
    case "$(pick "$choice")" in
      'Nightlight')              omarchy toggle nightlight; exit 0 ;;
      'Idle lock')               omarchy toggle idle; exit 0 ;;
      'Waybar')                  omarchy toggle waybar; exit 0 ;;
      'Touchpad')                omarchy toggle touchpad; exit 0 ;;
      'Touchscreen')             omarchy toggle touchscreen; exit 0 ;;
      'Notification silencing')  omarchy toggle notification silencing; exit 0 ;;
      'Suspend')                 omarchy toggle suspend; exit 0 ;;
      'Screensaver')             omarchy toggle screensaver; exit 0 ;;
      *) return ;;
    esac
  done
}

