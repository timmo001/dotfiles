  while true; do
    local choice
    choice="$(walker_menu 'Remove...' \
      '󱣔  Browser' \
      '󰄡  Dev environment' \
      '󰺵  Gaming' \
      '󰏓  Preinstalls' \
      '󰒃  Security (FIDO2)' \
      '󰃅  Security (fingerprint)' \
    )"
    case "$(pick "$choice")" in
      'Browser')                 run_terminal 'omarchy remove browser' ;;
      'Dev environment')         run_terminal 'omarchy remove dev env' ;;
      'Gaming')                  run_terminal 'omarchy remove gaming steam' ;;
      'Preinstalls')             run_terminal 'omarchy remove preinstalls' ;;
      'Security (FIDO2)')        run_terminal 'omarchy remove security fido2' ;;
      'Security (fingerprint)')  run_terminal 'omarchy remove security fingerprint' ;;
      *) return ;;
    esac
  done
}

pkg_menu() {
  while true; do
    local choice
    choice="$(walker_menu 'Packages...' \
      '󰏓  Install packages' \
      '󰏓  Install AUR packages' \
      '󰆴  Remove packages' \
    )"
    case "$(pick "$choice")" in
      'Install packages')     run_terminal 'omarchy pkg install' ;;
      'Install AUR packages') run_terminal 'omarchy pkg aur install' ;;
      'Remove packages')      run_terminal 'omarchy pkg remove' ;;
      *) return ;;
    esac
  done
}

share_menu() {
  while true; do
    local choice
    choice="$(walker_menu 'Share...' \
      '󰅇  Clipboard' \
      '󰈔  File' \
      '󰉋  Folder' \
    )"
    case "$(pick "$choice")" in
      'Clipboard') omarchy share clipboard; exit 0 ;;
      'File')      omarchy share file; exit 0 ;;
      'Folder')    omarchy share folder; exit 0 ;;
      *) return ;;
    esac
  done
}

reminder_menu() {
  while true; do
    local choice
    choice="$(walker_menu 'Reminder...' \
      '󰂞  Set reminder' \
      '󰽛  Show reminders' \
      '󰆴  Clear reminders' \
    )"
    case "$(pick "$choice")" in
      'Set reminder')
        local input
        input="$(echo '' | omarchy-launch-walker --dmenu --width 360 --minheight 1 -p 'Minutes message...' 2>/dev/null || true)"
        if [[ -n $input ]]; then
          # shellcheck disable=SC2086
          omarchy reminder $input
        fi
        exit 0
        ;;
      'Show reminders')  run_terminal 'omarchy reminder show' ;;
      'Clear reminders') run_notify 'Reminder' omarchy reminder clear; exit 0 ;;
      *) return ;;
    esac
  done
}

setup_menu() {
  while true; do
    local choice
    choice="$(walker_menu 'Setup...' \
      '󱣔  DNS' \
      '󰃅  Fingerprint' \
      '󰒃  FIDO2' \
    )"
    case "$(pick "$choice")" in
      'DNS')         run_terminal 'omarchy setup dns' ;;
      'Fingerprint') run_terminal 'omarchy setup security fingerprint' ;;
      'FIDO2')       run_terminal 'omarchy setup security fido2' ;;
      *) return ;;
    esac
  done
}

brightness_menu() {
  while true; do
    local choice
    choice="$(walker_menu 'Brightness...' \
      '󰃟  Display +10%' \
      '󰃞  Display -10%' \
      '󰃜  Display off' \
      '󰃟  Display on' \
      '󰖘  Keyboard up' \
      '󰁅  Keyboard down' \
      '󰓡  Keyboard cycle' \
      '󰻳  Keyboard off' \
    )"
    case "$(pick "$choice")" in
      'Display +10%')    omarchy brightness display +10%; exit 0 ;;
      'Display -10%')    omarchy brightness display 10%-; exit 0 ;;
      'Display off')     omarchy brightness display off; exit 0 ;;
      'Display on')      omarchy brightness display on; exit 0 ;;
      'Keyboard up')     omarchy brightness keyboard up; exit 0 ;;
      'Keyboard down')   omarchy brightness keyboard down; exit 0 ;;
      'Keyboard cycle')  omarchy brightness keyboard cycle; exit 0 ;;
      'Keyboard off')    omarchy brightness keyboard off; exit 0 ;;
      *) return ;;
    esac
  done
}

power_menu() {
  while true; do
    local choice
    choice="$(walker_menu 'Power profile...' \
      '󰁨  Autodetect' \
      '󰐥  AC (performance)' \
      '󰁺  Battery (power saver)' \
    )"
    case "$(pick "$choice")" in
      'Autodetect')           run_notify 'Power' omarchy powerprofiles set autodetect; exit 0 ;;
      'AC (performance)')     run_notify 'Power' omarchy powerprofiles set ac; exit 0 ;;
      'Battery (power saver)') run_notify 'Power' omarchy powerprofiles set battery; exit 0 ;;
      *) return ;;
    esac
  done
}

# --- Main menu ---

while true; do
  choice="$(walker_menu 'Omarchy...' \
    '󰚰  Update' \
    '󰏘  Theme...' \
    '󰛖  Font...' \
    '󰔡  Toggle...' \
    '󰄀  Capture...' \
    '󰐥  System...' \
    '󱓞  Launch...' \
    '󰑐  Refresh...' \
    '󰜉  Restart...' \
    '󰇚  Install...' \
    '󰆴  Remove...' \
    '󰏓  Packages...' \
    '󰒗  Share...' \
    '󰂞  Reminder...' \
    '󰒓  Setup...' \
    '󰁯  Snapshot...' \
    '󰃠  Brightness...' \
    '󰂄  Power profile...' \
    '󰋼  Version' \
    '󰃤  Debug' \
  )"

  case "$(pick "$choice")" in
    'Update')          run_terminal 'omarchy update' ;;
    'Theme...')        theme_menu ;;
    'Font...')         font_menu ;;
    'Toggle...')       toggle_menu ;;
    'Capture...')      capture_menu ;;
    'System...')       system_menu ;;
    'Launch...')       launch_menu ;;
    'Refresh...')      refresh_menu ;;
    'Restart...')      restart_menu ;;
    'Install...')      install_menu ;;
    'Remove...')       remove_menu ;;
    'Packages...')     pkg_menu ;;
    'Share...')        share_menu ;;
    'Reminder...')     reminder_menu ;;
    'Setup...')        setup_menu ;;
    'Snapshot...')
      local snap_choice
      snap_choice="$(walker_menu 'Snapshot...' \
        '󰄀  Create snapshot' \
        '󰁯  Restore snapshot' \
      )"
      case "$(pick "$snap_choice")" in
        'Create snapshot')   run_terminal 'omarchy snapshot create' ;;
        'Restore snapshot')  run_terminal 'omarchy snapshot restore' ;;
      esac
      ;;
    'Brightness...')   brightness_menu ;;
    'Power profile...')  power_menu ;;
    'Version')         run_notify 'Version' omarchy version; exit 0 ;;
    'Debug')           run_terminal 'omarchy debug --no-sudo --print' ;;
    *)                 exit 0 ;;
  esac
done
