#!/usr/bin/env bash

set -euo pipefail

walker_menu() {
  local prompt="${1:?}"
  shift
  printf '%s\n' "$@" | omarchy-launch-walker --dmenu --width 400 --minheight 1 --maxheight 520 -p "$prompt" 2>/dev/null || true
}

pick() {
  local choice="${1:?}"
  echo "${choice#*  }"
}

run_notify() {
  local label="${1:?}"
  shift
  local output
  if output="$("$@" 2>&1)"; then
    notify-send -a 'Omarchy' "$label" "${output:-Done}"
  else
    notify-send -u critical -a 'Omarchy' "$label failed" "${output:-Unknown error}"
  fi
}

run_terminal() {
  local command="${1:?}"
  exec setsid uwsm-app -- xdg-terminal-exec \
    --app-id=org.omarchy.terminal \
    --title='Omarchy' \
    -e bash -c "$command; printf '\n'; read -r -p 'Press Enter to close...'"
}

# --- Sub-menus ---

theme_menu() {
  while true; do
    local choice
    choice="$(walker_menu 'Theme...' \
      '󰏘  Set theme' \
      '󰋩  Next background' \
      '󰋽  Current theme' \
      '󰽛  List themes' \
      '󰑐  Refresh theme' \
      '󰋩  Install backgrounds' \
      '󰇚  Install theme' \
      '󰚰  Update themes' \
      '󰆴  Remove theme' \
    )"
    case "$(pick "$choice")" in
      'Set theme')
        local themes
        themes="$(omarchy theme list 2>/dev/null)" || continue
        local selected
        selected="$(echo "$themes" | omarchy-launch-walker --dmenu --width 360 --minheight 1 --maxheight 420 -p 'Theme...' 2>/dev/null || true)"
        [[ -n $selected ]] && omarchy theme set "$selected"
        exit 0
        ;;
      'Next background')       omarchy theme bg next; exit 0 ;;
      'Current theme')         run_notify 'Theme' omarchy theme current; exit 0 ;;
      'List themes')           run_terminal 'omarchy theme list' ;;
      'Refresh theme')         omarchy theme refresh; exit 0 ;;
      'Install backgrounds')   omarchy theme bg install; exit 0 ;;
      'Install theme')         run_terminal 'omarchy theme install' ;;
      'Update themes')         run_notify 'Theme update' omarchy theme update; exit 0 ;;
      'Remove theme')          run_terminal 'omarchy theme remove' ;;
      *) return ;;
    esac
  done
}

font_menu() {
  while true; do
    local choice
    choice="$(walker_menu 'Font...' \
      '󰛖  Set font' \
      '󰋽  Current font' \
      '󰽛  List fonts' \
    )"
    case "$(pick "$choice")" in
      'Set font')
        local fonts
        fonts="$(omarchy font list 2>/dev/null)" || continue
        local selected
        selected="$(echo "$fonts" | omarchy-launch-walker --dmenu --width 360 --minheight 1 --maxheight 420 -p 'Font...' 2>/dev/null || true)"
        [[ -n $selected ]] && omarchy font set "$selected"
        exit 0
        ;;
      'Current font')  run_notify 'Font' omarchy font current; exit 0 ;;
      'List fonts')    run_terminal 'omarchy font list' ;;
      *) return ;;
    esac
  done
}

