refresh_menu() {
  while true; do
    local choice
    choice="$(walker_menu 'Refresh...' \
      '󰢓  Hyprland' \
      '󰃎  Waybar' \
      '󰍉  Walker' \
      '󰤄  Hypridle' \
      '󰌾  Hyprlock' \
      '󰙿  Hyprsunset' \
      '󰖀  SwayOSD' \
      '󰈹  Tmux' \
      '󰈹  Terminal' \
      '󰋽  Fastfetch' \
      '󱣔  Chromium' \
      '󰘔  Applications' \
      '󰏓  Pacman' \
      '󰓎  Plymouth' \
      '󰩈  SDDM' \
    )"
    case "$(pick "$choice")" in
      'Hyprland')     run_notify 'Refresh' omarchy refresh hyprland; exit 0 ;;
      'Waybar')       run_notify 'Refresh' omarchy refresh waybar; exit 0 ;;
      'Walker')       run_notify 'Refresh' omarchy refresh walker; exit 0 ;;
      'Hypridle')     run_notify 'Refresh' omarchy refresh hypridle; exit 0 ;;
      'Hyprlock')     run_notify 'Refresh' omarchy refresh hyprlock; exit 0 ;;
      'Hyprsunset')   run_notify 'Refresh' omarchy refresh hyprsunset; exit 0 ;;
      'SwayOSD')      run_notify 'Refresh' omarchy refresh swayosd; exit 0 ;;
      'Tmux')         run_notify 'Refresh' omarchy refresh tmux; exit 0 ;;
      'Terminal')     run_notify 'Refresh' omarchy refresh terminal; exit 0 ;;
      'Fastfetch')    run_notify 'Refresh' omarchy refresh fastfetch; exit 0 ;;
      'Chromium')     run_notify 'Refresh' omarchy refresh chromium; exit 0 ;;
      'Applications') run_terminal 'omarchy refresh applications' ;;
      'Pacman')       run_terminal 'omarchy refresh pacman' ;;
      'Plymouth')     run_terminal 'omarchy refresh plymouth' ;;
      'SDDM')        run_terminal 'omarchy refresh sddm' ;;
      *) return ;;
    esac
  done
}

