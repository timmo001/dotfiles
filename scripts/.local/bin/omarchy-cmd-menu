      'Bluetooth')  run_notify 'Restart' omarchy restart bluetooth; exit 0 ;;
      'Wi-Fi')      run_notify 'Restart' omarchy restart wifi; exit 0 ;;
      'Terminal')   run_notify 'Restart' omarchy restart terminal; exit 0 ;;
