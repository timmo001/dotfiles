    choice="$(walker_menu 'Capture...' \
      '󰄀  Screenshot' \
      '󰕨  Screen recording' \
      '󱄼  Text extraction (OCR)' \
    )"
    case "$(pick "$choice")" in
      'Screenshot')            omarchy capture screenshot; exit 0 ;;
      'Screen recording')      omarchy capture screenrecording; exit 0 ;;
      'Text extraction (OCR)') omarchy capture text extraction; exit 0 ;;
      *) return ;;
    esac
  done
}

