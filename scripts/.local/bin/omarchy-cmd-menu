  while true; do
    local choice
    choice="$(walker_menu 'Install...' \
      '󱣔  Browser' \
      '󰄡  Dev environment' \
      '󰈹  Terminal' \
      '󰡨  Docker databases' \
      '󰺵  Gaming' \
      '󰨞  VS Code' \
      '󰄡  Zed' \
      '󰄡  Helix' \
      '󰨦  Tailscale' \
      '󰨦  NordVPN' \
      '󰇡  Dropbox' \
    )"
    case "$(pick "$choice")" in
      'Browser')          run_terminal 'omarchy install browser' ;;
      'Dev environment')  run_terminal 'omarchy install dev-env' ;;
      'Terminal')         run_terminal 'omarchy install terminal' ;;
      'Docker databases') run_terminal 'omarchy install docker dbs' ;;
      'Gaming')           run_terminal 'omarchy install gaming steam' ;;
      'VS Code')          run_terminal 'omarchy install vscode' ;;
      'Zed')              run_terminal 'omarchy install zed' ;;
      'Helix')            run_terminal 'omarchy install helix' ;;
      'Tailscale')        run_terminal 'omarchy install tailscale' ;;
      'NordVPN')          run_terminal 'omarchy install nordvpn' ;;
      'Dropbox')          run_terminal 'omarchy install dropbox' ;;
