  while true; do
    local choice
    choice="$(walker_menu 'Launch...' \
      '󱣔  Browser' \
      '󰕾  Audio controls' \
      '󰂯  Bluetooth' \
      '󰖩  Wi-Fi' \
      '󰋽  About' \
      '󰖤  Screensaver' \
      '󰍉  Walker' \
    )"
    case "$(pick "$choice")" in
      'Browser')        omarchy launch browser; exit 0 ;;
      'Audio controls') omarchy launch audio; exit 0 ;;
      'Bluetooth')      omarchy launch bluetooth; exit 0 ;;
      'Wi-Fi')          omarchy launch wifi; exit 0 ;;
