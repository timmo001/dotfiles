      'Hypridle')   run_notify 'Restart' omarchy restart hypridle; exit 0 ;;
      'Hyprsunset') run_notify 'Restart' omarchy restart hyprsunset; exit 0 ;;
      'Mako')       run_notify 'Restart' omarchy restart mako; exit 0 ;;
      'SwayOSD')    run_notify 'Restart' omarchy restart swayosd; exit 0 ;;
      'Trackpad')   run_notify 'Restart' omarchy restart trackpad; exit 0 ;;
      *) return ;;
    esac
