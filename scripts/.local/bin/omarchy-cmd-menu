    choice="$(walker_menu 'Restart...' \
      '󰃎  Waybar' \
      '󰍉  Walker' \
      '󰝟  Pipewire' \
      '󰂯  Bluetooth' \
      '󰖩  Wi-Fi' \
      '󰈹  Terminal' \
      '󰈹  Tmux' \
      '󰢓  Hyprland' \
      '󰤄  Hypridle' \
      '󰙿  Hyprsunset' \
      '󰂞  Mako' \
      '󰖀  SwayOSD' \
