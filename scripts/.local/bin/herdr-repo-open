#!/bin/sh
set -eu

if [ "$#" -lt 2 ] || [ "$#" -gt 4 ]; then
  echo "Usage: herdr-repo-open <label> <directory> [tab-label command]" >&2
  exit 2
fi

label="$1"
directory="$2"
tab_label="${3:-Shell}"
command="${4:-}"

picker_cache="${XDG_CACHE_HOME:-$HOME/.cache}/dot/repo-picker.json"
if [ -r "$picker_cache" ]; then
  canonical_label="$(jq -r --arg directory "$directory" '
    map(select(.path == $directory)) | first | .name // empty
  ' "$picker_cache")"
  if [ -n "$canonical_label" ]; then
    label="$canonical_label"
  fi
fi

if ! herdr status server >/dev/null 2>&1; then
  echo "Shared Herdr server is not running" >&2
  exit 1
fi

workspace_id="$(herdr workspace list | jq -r --arg label "$label" '
  (.result.workspaces // .workspaces // [])
  | map(select(.label == $label))
  | first
  | .workspace_id // empty
')"

if [ -z "$workspace_id" ]; then
  if [ -n "$label" ]; then
    created="$(herdr workspace create --cwd "$directory" --label "$label" --no-focus)"
  else
    created="$(herdr workspace create --cwd "$directory" --no-focus)"
  fi
  workspace_id="$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id // .workspace.workspace_id // empty')"
  tab_id="$(printf '%s' "$created" | jq -r '.result.tab.tab_id // .tab.tab_id // empty')"
  root_pane_id="$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // .root_pane.pane_id // empty')"
elif [ -n "$command" ]; then
  created="$(herdr tab create --workspace "$workspace_id" --cwd "$directory" --label "$tab_label" --no-focus)"
  tab_id="$(printf '%s' "$created" | jq -r '.result.tab.tab_id // .tab.tab_id // empty')"
  root_pane_id="$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // .root_pane.pane_id // empty')"
fi

if [ -z "$workspace_id" ]; then
  echo "Herdr did not return a workspace ID for ${label:-$directory}" >&2
  exit 1
fi

if [ -n "$command" ]; then
  if [ -z "${tab_id:-}" ] || [ -z "${root_pane_id:-}" ]; then
    echo "Herdr did not return tab and pane IDs for ${label:-$directory}" >&2
    exit 1
  fi
  herdr tab rename "$tab_id" "$tab_label" >/dev/null
  herdr pane run "$root_pane_id" "$command" >/dev/null
fi

herdr workspace focus "$workspace_id" >/dev/null
if [ -n "${tab_id:-}" ]; then
  herdr tab focus "$tab_id" >/dev/null
fi
