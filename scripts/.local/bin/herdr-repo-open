#!/bin/sh
set -eu

mode="tab"
if [ "${1:-}" = "--pane" ]; then
  mode="pane"
  shift
fi

if [ "$#" -lt 2 ] || [ "$#" -gt 4 ]; then
  echo "Usage: herdr-repo-open [--pane] <label> <directory> [tab-label command]" >&2
  exit 2
fi

label="$1"
directory="$2"
tab_label="${3:-Shell}"
command="${4:-}"

picker_cache="${XDG_CACHE_HOME:-$HOME/.cache}/dot/repo-picker.json"
if [ -r "$picker_cache" ]; then
  canonical_label="$(jq -r --arg directory "$directory" '
    map(select(.path == $directory)) | first | .name // empty
  ' "$picker_cache")"
  if [ -n "$canonical_label" ]; then
    label="$canonical_label"
  fi
fi

if ! herdr status server >/dev/null 2>&1; then
  echo "Shared Herdr server is not running" >&2
  exit 1
fi

workspaces="$(herdr workspace list)"
workspace_id="$(printf '%s' "$workspaces" | jq -r --arg label "$label" '
  (.result.workspaces // .workspaces // [])
  | map(select(.label == $label))
  | first
  | .workspace_id // empty
')"

if [ -z "$workspace_id" ]; then
  if [ -n "$label" ]; then
    created="$(herdr workspace create --cwd "$directory" --label "$label" --no-focus)"
  else
    created="$(herdr workspace create --cwd "$directory" --no-focus)"
  fi
  workspace_id="$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id // .workspace.workspace_id // empty')"
  tab_id="$(printf '%s' "$created" | jq -r '.result.tab.tab_id // .tab.tab_id // empty')"
  root_pane_id="$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // .root_pane.pane_id // empty')"
elif [ -n "$command" ] && [ "$mode" = "pane" ]; then
  active_tab_id="$(printf '%s' "$workspaces" | jq -r --arg workspace_id "$workspace_id" '
    (.result.workspaces // .workspaces // [])
    | map(select(.workspace_id == $workspace_id))
    | first
    | .active_tab_id // empty
  ')"
  target_pane_id="$(herdr pane list --workspace "$workspace_id" | jq -r --arg active_tab_id "$active_tab_id" '
    (.result.panes // .panes // []) as $panes
    | ($panes | map(select(.tab_id == $active_tab_id and .focused == true)) | first
      // ($panes | map(select(.tab_id == $active_tab_id)) | first)
      // $panes[0])
    | .pane_id // empty
  ')"
  if [ -z "$target_pane_id" ]; then
    echo "Herdr did not return a pane ID for ${label:-$directory}" >&2
    exit 1
  fi
  created="$(herdr pane split --pane "$target_pane_id" --direction right --cwd "$directory" --focus)"
  root_pane_id="$(printf '%s' "$created" | jq -r '.result.pane.pane_id // .pane.pane_id // empty')"
elif [ -n "$command" ]; then
  created="$(herdr tab create --workspace "$workspace_id" --cwd "$directory" --label "$tab_label" --no-focus)"
  tab_id="$(printf '%s' "$created" | jq -r '.result.tab.tab_id // .tab.tab_id // empty')"
  root_pane_id="$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // .root_pane.pane_id // empty')"
fi

if [ -z "$workspace_id" ]; then
  echo "Herdr did not return a workspace ID for ${label:-$directory}" >&2
  exit 1
fi

if [ -n "$command" ]; then
  if [ -z "${root_pane_id:-}" ] || { [ "$mode" = "tab" ] && [ -z "${tab_id:-}" ]; }; then
    echo "Herdr did not return the required pane or tab ID for ${label:-$directory}" >&2
    exit 1
  fi
  if [ -n "${tab_id:-}" ]; then
    herdr tab rename "$tab_id" "$tab_label" >/dev/null
  fi
  herdr pane run "$root_pane_id" "$command" >/dev/null
fi

herdr workspace focus "$workspace_id" >/dev/null
if [ -n "${tab_id:-}" ]; then
  herdr tab focus "$tab_id" >/dev/null
elif [ -n "${root_pane_id:-}" ]; then
  herdr pane focus "$root_pane_id" >/dev/null
fi
