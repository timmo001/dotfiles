#!/bin/bash

WORK_DIR="$HOME/repos/home-assistant/frontend"

BROWSER_PERSONAL_CMD='uwsm app -- chromium --new-window --ozone-platform=wayland --profile-directory=Default --force-device-scale-factor=0.8'
WORK_CHROME_BASE='uwsm app -- google-chrome-stable --new-window --ozone-platform=wayland --force-device-scale-factor=0.8 --profile-directory=Profile\ 1 --user-data-dir=$HOME/.config/google-chrome-work'
WORK_SLACK_CMD="$WORK_CHROME_BASE --app=https://app.slack.com/client"
WORK_DISCORD_CMD="$WORK_CHROME_BASE --app=https://discord.com/app"
WORK_BROWSER_CMD="$WORK_CHROME_BASE --class=work-browser"
TERM_WORK_CMD="uwsm app -- ghostty --working-directory=$WORK_DIR"
TERM_DEFAULT_CMD='uwsm app -- ghostty'

WS1_SLACK_SIZE="645 590"
WS1_DISCORD_SIZE="645 590"
WS1_BROWSER_TOP_SIZE="1294 590"
WS1_BROWSER_SIZE="1294 1110"
WS1_TERMINAL_SIZE="1294 564"

TAG_PREFIX="wssetup-"
TAG_WS1_SLACK="${TAG_PREFIX}ws1-slack"
TAG_WS1_DISCORD="${TAG_PREFIX}ws1-discord"
TAG_WS1_BROWSER_MAIN="${TAG_PREFIX}ws1-browser-main"
TAG_WS1_BROWSER_TOP="${TAG_PREFIX}ws1-browser-top"
TAG_WS1_TERM="${TAG_PREFIX}ws1-term"
TAG_WS2_TERM="${TAG_PREFIX}ws2-term"
TAG_WS3_BROWSER="${TAG_PREFIX}ws3-browser"

MANAGED_TAGS=(
  "$TAG_WS1_SLACK"
  "$TAG_WS1_DISCORD"
  "$TAG_WS1_BROWSER_MAIN"
  "$TAG_WS1_BROWSER_TOP"
  "$TAG_WS1_TERM"
  "$TAG_WS2_TERM"
  "$TAG_WS3_BROWSER"
)

START_FOCUS_ADDR="$(hyprctl activewindow -j | jq -r '.address // empty')"
USED_ADDRS=""
ENSURED_ADDR=""

line_in_list() {
  local list="$1"
  local line="$2"
  [ -n "$line" ] || return 1
  grep -Fqx "$line" <<< "$list"
}

is_used() {
  line_in_list "$USED_ADDRS" "$1"
}

mark_used() {
  local addr="$1"
  [ -n "$addr" ] || return
  if ! is_used "$addr"; then
    if [ -n "$USED_ADDRS" ]; then
      USED_ADDRS+=$'\n'
    fi
    USED_ADDRS+="$addr"
  fi
}

first_unused_from_list() {
  local list="$1"
  local addr

  while IFS= read -r addr; do
    [ -n "$addr" ] || continue
    if ! is_used "$addr"; then
      printf '%s\n' "$addr"
      return 0
    fi
  done <<< "$list"

  return 1
}

first_new_unused_from_lists() {
  local before="$1"
  local after="$2"
  local addr

  while IFS= read -r addr; do
    [ -n "$addr" ] || continue
    if ! line_in_list "$before" "$addr" && ! is_used "$addr"; then
      printf '%s\n' "$addr"
      return 0
    fi
  done <<< "$after"

  return 1
}

matching_addresses() {
  local re="$1"
  local skip_oc="$2"

  hyprctl clients -j | jq -r \
    --arg re "$re" \
    --arg keep "$START_FOCUS_ADDR" \
    --argjson skip_oc "$skip_oc" \
    '.[]
     | select((((.class // "") | test($re)) or ((.initialClass // "") | test($re))))
     | select(.address != $keep)
     | select(if $skip_oc then ((.title // "") | startswith("OC |") | not) else true end)
     | .address'
}

find_candidate_addresses() {
  local re="$1"
  local workspace="$2"
  local skip_oc="$3"

  hyprctl clients -j | jq -r \
    --arg re "$re" \
    --argjson ws "$workspace" \
    --arg keep "$START_FOCUS_ADDR" \
    --argjson skip_oc "$skip_oc" \
    --arg prefix "$TAG_PREFIX" \
    '[.[]
      | select((((.class // "") | test($re)) or ((.initialClass // "") | test($re))))
      | select(.address != $keep)
      | select(if $skip_oc then ((.title // "") | startswith("OC |") | not) else true end)
    ]
    | sort_by({
        ws: ((.workspace.id == $ws) | not),
        tagged: ((.tags // []) | map(startswith($prefix)) | any),
        history: (.focusHistoryID // 999999)
      })
    | .[].address'
}

address_by_tag() {
  local tag="$1"
  hyprctl clients -j | jq -r --arg tag "$tag" 'first(.[] | select((.tags // []) | index($tag))) | .address // empty'
}

clear_tag_from_all() {
  local tag="$1"
  local addrs
  local addr

  addrs="$(hyprctl clients -j | jq -r --arg tag "$tag" '.[] | select((.tags // []) | index($tag)) | .address')"

  while IFS= read -r addr; do
    [ -n "$addr" ] || continue
    hyprctl dispatch tagwindow "-$tag" "address:$addr" >/dev/null 2>&1 || true
  done <<< "$addrs"
}

tag_address_for_slot() {
  local addr="$1"
  local tag="$2"
  local managed

  for managed in "${MANAGED_TAGS[@]}"; do
    hyprctl dispatch tagwindow "-$managed" "address:$addr" >/dev/null 2>&1 || true
  done

  clear_tag_from_all "$tag"
  hyprctl dispatch tagwindow "+$tag" "address:$addr" >/dev/null 2>&1 || true
}

move_to_workspace_silent() {
  local workspace="$1"
  local addr="$2"
  hyprctl dispatch movetoworkspacesilent "$workspace,address:$addr" >/dev/null 2>&1 || true
}

ensure_slot() {
  local tag="$1"
  local re="$2"
  local command="$3"
  local workspace="$4"
  local skip_oc="$5"

  local addr=""
  local before=""
  local after=""
  local candidates=""

  ENSURED_ADDR=""

  addr="$(address_by_tag "$tag")"
  if [ -n "$addr" ] && is_used "$addr"; then
    addr=""
  fi

  if [ -z "$addr" ]; then
    candidates="$(find_candidate_addresses "$re" "$workspace" "$skip_oc")"
    addr="$(first_unused_from_list "$candidates" || true)"
  fi

  if [ -z "$addr" ]; then
    before="$(matching_addresses "$re" "$skip_oc")"
    hyprctl dispatch exec "$command" >/dev/null 2>&1 || true

    for _ in {1..80}; do
      after="$(matching_addresses "$re" "$skip_oc")"
      addr="$(first_new_unused_from_lists "$before" "$after" || true)"
      if [ -n "$addr" ]; then
        break
      fi
      sleep 0.1
    done
  fi

  if [ -z "$addr" ]; then
    candidates="$(find_candidate_addresses "$re" "$workspace" "$skip_oc")"
    addr="$(first_unused_from_list "$candidates" || true)"
  fi

  [ -n "$addr" ] || return 1

  move_to_workspace_silent "$workspace" "$addr"
  tag_address_for_slot "$addr" "$tag"
  mark_used "$addr"
  ENSURED_ADDR="$addr"
  return 0
}

focus_addr() {
  local addr="$1"
  [ -n "$addr" ] || return 1
  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
}

resize_tagged_window_exact() {
  local tag="$1"
  local width="$2"
  local height="$3"
  local addr

  addr="$(address_by_tag "$tag")"
  [ -n "$addr" ] || return 1

  focus_addr "$addr" || return 1
  hyprctl dispatch resizeactive exact "$width" "$height" >/dev/null 2>&1 || return 1
  return 0
}

apply_workspace1_sizes() {
  local restore_addr="$1"

  resize_tagged_window_exact "$TAG_WS1_SLACK" ${WS1_SLACK_SIZE} || true
  resize_tagged_window_exact "$TAG_WS1_DISCORD" ${WS1_DISCORD_SIZE} || true
  resize_tagged_window_exact "$TAG_WS1_BROWSER_MAIN" ${WS1_BROWSER_SIZE} || true
  resize_tagged_window_exact "$TAG_WS1_TERM" ${WS1_TERMINAL_SIZE} || true

  if [ -n "$restore_addr" ]; then
    focus_addr "$restore_addr" || true
  fi
}

apply_workspace1_nonwork_sizes() {
  local restore_addr="$1"

  resize_tagged_window_exact "$TAG_WS1_BROWSER_TOP" ${WS1_BROWSER_TOP_SIZE} || true
  resize_tagged_window_exact "$TAG_WS1_BROWSER_MAIN" ${WS1_BROWSER_SIZE} || true
  resize_tagged_window_exact "$TAG_WS1_TERM" ${WS1_TERMINAL_SIZE} || true

  if [ -n "$restore_addr" ]; then
    focus_addr "$restore_addr" || true
  fi
}

rebuild_workspace1_tree() {
  local temp_ws="name:wssetup-temp"
  local slack_addr
  local discord_addr
  local browser_addr
  local term_addr

  slack_addr="$(address_by_tag "$TAG_WS1_SLACK")"
  discord_addr="$(address_by_tag "$TAG_WS1_DISCORD")"
  browser_addr="$(address_by_tag "$TAG_WS1_BROWSER_MAIN")"
  term_addr="$(address_by_tag "$TAG_WS1_TERM")"

  if [ -z "$slack_addr" ] || [ -z "$discord_addr" ] || [ -z "$browser_addr" ] || [ -z "$term_addr" ]; then
    return 0
  fi

  move_to_workspace_silent "$temp_ws" "$slack_addr"
  move_to_workspace_silent "$temp_ws" "$discord_addr"
  move_to_workspace_silent "$temp_ws" "$browser_addr"
  move_to_workspace_silent "$temp_ws" "$term_addr"
  sleep 0.2

  move_to_workspace_silent 1 "$slack_addr"
  focus_addr "$slack_addr" || true
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.1

  move_to_workspace_silent 1 "$browser_addr"
  focus_addr "$browser_addr" || true
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.1

  move_to_workspace_silent 1 "$term_addr"
  focus_addr "$slack_addr" || true
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.1

  move_to_workspace_silent 1 "$discord_addr"
  sleep 0.2
}

rebuild_workspace1_nonwork_tree() {
  local temp_ws="name:wssetup-temp"
  local top_addr
  local main_addr
  local term_addr

  top_addr="$(address_by_tag "$TAG_WS1_BROWSER_TOP")"
  main_addr="$(address_by_tag "$TAG_WS1_BROWSER_MAIN")"
  term_addr="$(address_by_tag "$TAG_WS1_TERM")"

  if [ -z "$top_addr" ] || [ -z "$main_addr" ] || [ -z "$term_addr" ]; then
    return 0
  fi

  move_to_workspace_silent "$temp_ws" "$top_addr"
  move_to_workspace_silent "$temp_ws" "$main_addr"
  move_to_workspace_silent "$temp_ws" "$term_addr"
  sleep 0.2

  move_to_workspace_silent 1 "$top_addr"
  focus_addr "$top_addr" || true
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.1

  move_to_workspace_silent 1 "$main_addr"
  focus_addr "$main_addr" || true
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.1

  move_to_workspace_silent 1 "$term_addr"
  sleep 0.2
}

if is-work-time; then
  WORK_TIME=true
else
  WORK_TIME=false
fi

if $WORK_TIME; then
  clear_tag_from_all "$TAG_WS1_BROWSER_TOP"

  ensure_slot "$TAG_WS1_SLACK" '^chrome-app\.slack\.com__client' "$WORK_SLACK_CMD" 1 false || true
  WS1_SLACK_ADDR="$ENSURED_ADDR"

  ensure_slot "$TAG_WS1_BROWSER_MAIN" '^chromium$' "$BROWSER_PERSONAL_CMD" 1 false || true
  WS1_BROWSER_ADDR="$ENSURED_ADDR"

  if [ -n "$WS1_BROWSER_ADDR" ]; then
    focus_addr "$WS1_BROWSER_ADDR" || true
    hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
    sleep 0.2
  fi

  ensure_slot "$TAG_WS1_TERM" '^com\.mitchellh\.ghostty$' "$TERM_WORK_CMD" 1 true || true

  if [ -n "$WS1_SLACK_ADDR" ]; then
    focus_addr "$WS1_SLACK_ADDR" || true
    hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
    sleep 0.2
  fi

  ensure_slot "$TAG_WS1_DISCORD" '^chrome-discord\.com__app' "$WORK_DISCORD_CMD" 1 false || true

  rebuild_workspace1_tree
  apply_workspace1_sizes "$START_FOCUS_ADDR"

  ensure_slot "$TAG_WS2_TERM" '^com\.mitchellh\.ghostty$' "$TERM_WORK_CMD" 2 true || true
  ensure_slot "$TAG_WS3_BROWSER" '^(work-browser|google-chrome)$' "$WORK_BROWSER_CMD" 3 false || true
else
  clear_tag_from_all "$TAG_WS1_SLACK"
  clear_tag_from_all "$TAG_WS1_DISCORD"

  ensure_slot "$TAG_WS1_BROWSER_TOP" '^chromium$' "$BROWSER_PERSONAL_CMD" 1 false || true
  ensure_slot "$TAG_WS1_BROWSER_MAIN" '^chromium$' "$BROWSER_PERSONAL_CMD" 1 false || true
  ensure_slot "$TAG_WS1_TERM" '^com\.mitchellh\.ghostty$' "$TERM_DEFAULT_CMD" 1 true || true

  rebuild_workspace1_nonwork_tree
  apply_workspace1_nonwork_sizes "$START_FOCUS_ADDR"

  ensure_slot "$TAG_WS2_TERM" '^com\.mitchellh\.ghostty$' "$TERM_DEFAULT_CMD" 2 true || true
fi

if $WORK_TIME; then
  hyprctl dispatch workspace 3 >/dev/null 2>&1 || true
else
  hyprctl dispatch workspace 2 >/dev/null 2>&1 || true
fi
