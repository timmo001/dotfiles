#!/bin/bash

WORK_DIR="$HOME/repos/home-assistant/frontend"

STEP_MODE=false
SLOW_MULTIPLIER="1.8"
STARTUP_DELAY="0"
LOG_DIR_DEFAULT="$HOME/.local/state/workspace-setup/runs"
LOG_FILE=""

usage() {
  cat <<'EOF'
Usage: workspace-setup [--step-through] [--speed-multiplier=N] [--sleep=N] [--fast]

Options:
  --step-through          Pause after each logged step and wait for Enter.
  --speed-multiplier=N    Multiply all built-in sleep durations (default: 1.8).
  --sleep=N               Wait N seconds before running setup logic (default: 0).
  --fast                  Alias for --speed-multiplier=1.
  -h, --help              Show this help.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --step-through|--step)
      STEP_MODE=true
      ;;
    --speed-multiplier=*)
      SLOW_MULTIPLIER="${1#*=}"
      ;;
    --sleep=*)
      STARTUP_DELAY="${1#*=}"
      ;;
    --fast)
      SLOW_MULTIPLIER="1"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'workspace-setup: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if ! awk -v n="$SLOW_MULTIPLIER" 'BEGIN { exit !(n ~ /^[0-9]+([.][0-9]+)?$/ && n > 0) }'; then
  printf 'workspace-setup: --speed-multiplier must be a positive number\n' >&2
  exit 1
fi

if ! awk -v n="$STARTUP_DELAY" 'BEGIN { exit !(n ~ /^[0-9]+([.][0-9]+)?$/) }'; then
  printf 'workspace-setup: --sleep must be a non-negative number\n' >&2
  exit 1
fi

if [ -n "${WORKSPACE_SETUP_LOG_FILE:-}" ]; then
  LOG_FILE="$WORKSPACE_SETUP_LOG_FILE"
else
  LOG_FILE="$LOG_DIR_DEFAULT/workspace-setup-$(date +%Y%m%d-%H%M%S).log"
fi

mkdir -p "$(dirname "$LOG_FILE")"

log_step() {
  local message="$1"
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  printf '[workspace-setup %s] %s\n' "$timestamp" "$message" | tee -a "$LOG_FILE"

  if $STEP_MODE; then
    read -r -p "[workspace-setup] Press Enter to continue... "
  fi
}

if awk -v n="$STARTUP_DELAY" 'BEGIN { exit !(n > 0) }'; then
  printf '[workspace-setup] Sleeping %ss before startup\n' "$STARTUP_DELAY" | tee -a "$LOG_FILE"
  command sleep "$STARTUP_DELAY"
fi

sleep() {
  local duration="${1:-0}"
  local scaled
  scaled="$(awk -v d="$duration" -v m="$SLOW_MULTIPLIER" 'BEGIN { printf "%.3f", d * m }')"
  command sleep "$scaled"
}

BROWSER_PERSONAL_CMD='uwsm app -- chromium --new-window --ozone-platform=wayland --profile-directory="Default" --force-device-scale-factor=0.8'
WORK_CHROME_BASE='uwsm app -- google-chrome-stable --new-window --ozone-platform=wayland --force-device-scale-factor=0.8 --profile-directory=Profile\ 1 --user-data-dir=$HOME/.config/google-chrome-work'
WORK_SLACK_CMD="$WORK_CHROME_BASE --app=https://app.slack.com/client"
WORK_DISCORD_CMD="$WORK_CHROME_BASE --app=https://discord.com/app"
WORK_BROWSER_CMD="$WORK_CHROME_BASE --class=work-browser"
TERM_WORK_CMD="uwsm app -- ghostty --working-directory=$WORK_DIR"
TERM_DEFAULT_CMD='uwsm app -- ghostty'

WS1_SLACK_SIZE="645 660"
WS1_DISCORD_SIZE="645 660"
WS1_BROWSER_TOP_SIZE="1294 600"
WS1_BROWSER_SIZE="1294 930"
WS1_TERMINAL_SIZE="1294 700"

TAG_PREFIX="wssetup-"
TAG_WS1_SLACK="${TAG_PREFIX}ws1-slack"
TAG_WS1_DISCORD="${TAG_PREFIX}ws1-discord"
TAG_WS1_BROWSER_MAIN="${TAG_PREFIX}ws1-browser-main"
TAG_WS1_BROWSER_TOP="${TAG_PREFIX}ws1-browser-top"
TAG_WS1_TERM="${TAG_PREFIX}ws1-term"
TAG_WS2_TERM="${TAG_PREFIX}ws2-term"
TAG_WS3_BROWSER="${TAG_PREFIX}ws3-browser"

MANAGED_TAGS=(
  "$TAG_WS1_SLACK"
  "$TAG_WS1_DISCORD"
  "$TAG_WS1_BROWSER_MAIN"
  "$TAG_WS1_BROWSER_TOP"
  "$TAG_WS1_TERM"
  "$TAG_WS2_TERM"
  "$TAG_WS3_BROWSER"
)

START_FOCUS_ADDR="$(hyprctl activewindow -j | jq -r '.address // empty')"
STARTUP_BROWSER_ADDR=""
USED_ADDRS=""
ENSURED_ADDR=""

if [ -n "$START_FOCUS_ADDR" ] && hyprctl clients -j | jq -e --arg a "$START_FOCUS_ADDR" '
  .[]
  | select(.address == $a)
  | (((.class // "") | test("^chromium$")) or ((.initialClass // "") | test("^chromium$")))
' >/dev/null; then
  STARTUP_BROWSER_ADDR="$START_FOCUS_ADDR"
fi

log_step "Starting workspace setup (step-through=$STEP_MODE, speed-multiplier=$SLOW_MULTIPLIER, log-file=$LOG_FILE)"

if [ -n "$STARTUP_BROWSER_ADDR" ]; then
  log_step "Startup browser detected at $STARTUP_BROWSER_ADDR; preferring it for center browser slot"
elif [ -n "$START_FOCUS_ADDR" ]; then
  log_step "Focused startup window $START_FOCUS_ADDR is not chromium; center browser slot will use normal candidate selection"
else
  log_step "No focused startup window detected; center browser slot will use normal candidate selection"
fi

line_in_list() {
  local list="$1"
  local line="$2"
  [ -n "$line" ] || return 1
  grep -Fqx "$line" <<< "$list"
}

is_used() {
  line_in_list "$USED_ADDRS" "$1"
}

mark_used() {
  local addr="$1"
  [ -n "$addr" ] || return
  if ! is_used "$addr"; then
    if [ -n "$USED_ADDRS" ]; then
      USED_ADDRS+=$'\n'
    fi
    USED_ADDRS+="$addr"
  fi
}

first_unused_from_list() {
  local list="$1"
  local addr

  while IFS= read -r addr; do
    [ -n "$addr" ] || continue
    if ! is_used "$addr"; then
      printf '%s\n' "$addr"
      return 0
    fi
  done <<< "$list"

  return 1
}

first_new_unused_from_lists() {
  local before="$1"
  local after="$2"
  local addr

  while IFS= read -r addr; do
    [ -n "$addr" ] || continue
    if ! line_in_list "$before" "$addr" && ! is_used "$addr"; then
      printf '%s\n' "$addr"
      return 0
    fi
  done <<< "$after"

  return 1
}

matching_addresses() {
  local re="$1"
  local skip_oc="$2"

  hyprctl clients -j | jq -r \
    --arg re "$re" \
    --arg keep "$START_FOCUS_ADDR" \
    --argjson skip_oc "$skip_oc" \
    '.[]
     | select((((.class // "") | test($re)) or ((.initialClass // "") | test($re))))
     | select(.address != $keep)
     | select(if $skip_oc then ((.title // "") | startswith("OC |") | not) else true end)
     | .address'
}

find_candidate_addresses() {
  local re="$1"
  local workspace="$2"
  local skip_oc="$3"

  hyprctl clients -j | jq -r \
    --arg re "$re" \
    --argjson ws "$workspace" \
    --arg keep "$START_FOCUS_ADDR" \
    --argjson skip_oc "$skip_oc" \
    --arg prefix "$TAG_PREFIX" \
    '[.[]
      | select((((.class // "") | test($re)) or ((.initialClass // "") | test($re))))
      | select(.address != $keep)
      | select(if $skip_oc then ((.title // "") | startswith("OC |") | not) else true end)
    ]
    | sort_by({
        ws: ((.workspace.id == $ws) | not),
        tagged: ((.tags // []) | map(startswith($prefix)) | any),
        history: (.focusHistoryID // 999999)
      })
    | .[].address'
}

address_by_tag() {
  local tag="$1"
  hyprctl clients -j | jq -r --arg tag "$tag" 'first(.[] | select((.tags // []) | index($tag))) | .address // empty'
}

clear_tag_from_all() {
  local tag="$1"
  local addrs
  local addr

  log_step "Clearing tag '$tag' from all windows"
  addrs="$(hyprctl clients -j | jq -r --arg tag "$tag" '.[] | select((.tags // []) | index($tag)) | .address')"

  while IFS= read -r addr; do
    [ -n "$addr" ] || continue
    hyprctl dispatch tagwindow -- "-$tag" "address:$addr" >/dev/null 2>&1 || true
  done <<< "$addrs"
}

tag_address_for_slot() {
  local addr="$1"
  local tag="$2"
  local managed

  log_step "Tagging window $addr as '$tag'"
  for managed in "${MANAGED_TAGS[@]}"; do
    hyprctl dispatch tagwindow -- "-$managed" "address:$addr" >/dev/null 2>&1 || true
  done

  clear_tag_from_all "$tag"
  hyprctl dispatch tagwindow "+$tag" "address:$addr" >/dev/null 2>&1 || true
}

move_to_workspace_silent() {
  local workspace="$1"
  local addr="$2"
  log_step "Moving window $addr to workspace $workspace"
  hyprctl dispatch movetoworkspacesilent "$workspace,address:$addr" >/dev/null 2>&1 || true
}

ensure_slot() {
  local tag="$1"
  local re="$2"
  local command="$3"
  local workspace="$4"
  local skip_oc="$5"
  local preferred_addr="${6:-}"

  local addr=""
  local before=""
  local after=""
  local candidates=""

  ENSURED_ADDR=""
  log_step "Ensuring slot '$tag' on workspace $workspace"

  addr="$(address_by_tag "$tag")"
  if [ -n "$addr" ] && is_used "$addr"; then
    addr=""
  fi

  if [ -z "$addr" ]; then
    if [ -n "$preferred_addr" ] && ! is_used "$preferred_addr" && hyprctl clients -j | jq -e \
      --arg a "$preferred_addr" \
      --arg re "$re" \
      --argjson skip_oc "$skip_oc" '
        .[]
        | select(.address == $a)
        | select((((.class // "") | test($re)) or ((.initialClass // "") | test($re))))
        | select(if $skip_oc then ((.title // "") | startswith("OC |") | not) else true end)
      ' >/dev/null; then
      log_step "Using preferred window $preferred_addr for slot '$tag'"
      addr="$preferred_addr"
    fi
  fi

  if [ -z "$addr" ]; then
    log_step "No existing slot for '$tag', looking for candidate windows"
    candidates="$(find_candidate_addresses "$re" "$workspace" "$skip_oc")"
    addr="$(first_unused_from_list "$candidates" || true)"
  fi

  if [ -z "$addr" ]; then
    log_step "No reusable candidate for '$tag', launching command"
    before="$(matching_addresses "$re" "$skip_oc")"
    hyprctl dispatch exec "$command" >/dev/null 2>&1 || true

    for _ in {1..80}; do
      after="$(matching_addresses "$re" "$skip_oc")"
      addr="$(first_new_unused_from_lists "$before" "$after" || true)"
      if [ -n "$addr" ]; then
        break
      fi
      sleep 0.1
    done
  fi

  if [ -z "$addr" ]; then
    log_step "Fallback candidate lookup for '$tag'"
    candidates="$(find_candidate_addresses "$re" "$workspace" "$skip_oc")"
    addr="$(first_unused_from_list "$candidates" || true)"
  fi

  if [ -z "$addr" ]; then
    log_step "Failed to resolve address for slot '$tag'"
    return 1
  fi

  move_to_workspace_silent "$workspace" "$addr"
  tag_address_for_slot "$addr" "$tag"
  mark_used "$addr"
  ENSURED_ADDR="$addr"
  log_step "Slot '$tag' now bound to $addr"
  return 0
}

focus_addr() {
  local addr="$1"
  [ -n "$addr" ] || return 1
  log_step "Focusing window $addr"
  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
}

resize_tagged_window_exact() {
  local tag="$1"
  local width="$2"
  local height="$3"
  local addr

  addr="$(address_by_tag "$tag")"
  [ -n "$addr" ] || return 1

  log_step "Resizing tag '$tag' ($addr) to ${width}x${height}"
  focus_addr "$addr" || return 1
  hyprctl dispatch resizeactive exact "$width" "$height" >/dev/null 2>&1 || return 1
  return 0
}

apply_workspace1_sizes() {
  local restore_addr="$1"

  log_step "Applying workspace 1 work layout sizes"

  resize_tagged_window_exact "$TAG_WS1_SLACK" ${WS1_SLACK_SIZE} || true
  resize_tagged_window_exact "$TAG_WS1_DISCORD" ${WS1_DISCORD_SIZE} || true
  resize_tagged_window_exact "$TAG_WS1_BROWSER_MAIN" ${WS1_BROWSER_SIZE} || true
  resize_tagged_window_exact "$TAG_WS1_TERM" ${WS1_TERMINAL_SIZE} || true

  if [ -n "$restore_addr" ]; then
    focus_addr "$restore_addr" || true
  fi
}

apply_workspace1_nonwork_sizes() {
  local restore_addr="$1"

  log_step "Applying workspace 1 non-work layout sizes"

  resize_tagged_window_exact "$TAG_WS1_BROWSER_TOP" ${WS1_BROWSER_TOP_SIZE} || true
  resize_tagged_window_exact "$TAG_WS1_BROWSER_MAIN" ${WS1_BROWSER_SIZE} || true
  resize_tagged_window_exact "$TAG_WS1_TERM" ${WS1_TERMINAL_SIZE} || true

  if [ -n "$restore_addr" ]; then
    focus_addr "$restore_addr" || true
  fi
}

is_blank_chromium_addr() {
  local addr="$1"
  [ -n "$addr" ] || return 1

  hyprctl clients -j | jq -e --arg a "$addr" '
    .[]
    | select(.address == $a and .class == "chromium")
    | (((.title // "") | test("^(New tab|about:blank)"; "i"))
       or ((.initialTitle // "") | test("^(New tab|about:blank)"; "i")))
  ' >/dev/null
}

swap_slot_tags() {
  local tag_a="$1"
  local tag_b="$2"
  local addr_a
  local addr_b

  addr_a="$(address_by_tag "$tag_a")"
  addr_b="$(address_by_tag "$tag_b")"

  [ -n "$addr_a" ] || return 1
  [ -n "$addr_b" ] || return 1

  clear_tag_from_all "$tag_a"
  clear_tag_from_all "$tag_b"
  hyprctl dispatch tagwindow "+$tag_a" "address:$addr_b" >/dev/null 2>&1 || true
  hyprctl dispatch tagwindow "+$tag_b" "address:$addr_a" >/dev/null 2>&1 || true
}

normalize_nonwork_browser_slot_order() {
  local top_addr
  local main_addr

  top_addr="$(address_by_tag "$TAG_WS1_BROWSER_TOP")"
  main_addr="$(address_by_tag "$TAG_WS1_BROWSER_MAIN")"

  [ -n "$top_addr" ] || return 0
  [ -n "$main_addr" ] || return 0

  if is_blank_chromium_addr "$top_addr"; then
    log_step "Non-work browser slot order already normalized"
    return 0
  fi

  if is_blank_chromium_addr "$main_addr"; then
    log_step "Swapping non-work browser slots to keep blank tab on top"
    swap_slot_tags "$TAG_WS1_BROWSER_TOP" "$TAG_WS1_BROWSER_MAIN" || true
  fi
}

rebuild_workspace1_tree() {
  local temp_ws="name:wssetup-temp"
  local slack_addr
  local discord_addr
  local browser_addr
  local term_addr

  slack_addr="$(address_by_tag "$TAG_WS1_SLACK")"
  discord_addr="$(address_by_tag "$TAG_WS1_DISCORD")"
  browser_addr="$(address_by_tag "$TAG_WS1_BROWSER_MAIN")"
  term_addr="$(address_by_tag "$TAG_WS1_TERM")"

  if [ -z "$slack_addr" ] || [ -z "$discord_addr" ] || [ -z "$browser_addr" ] || [ -z "$term_addr" ]; then
    log_step "Skipping workspace 1 work tree rebuild (missing one or more windows)"
    return 0
  fi

  log_step "Rebuilding workspace 1 work tree"

  move_to_workspace_silent "$temp_ws" "$slack_addr"
  move_to_workspace_silent "$temp_ws" "$discord_addr"
  move_to_workspace_silent "$temp_ws" "$browser_addr"
  move_to_workspace_silent "$temp_ws" "$term_addr"
  sleep 0.2

  move_to_workspace_silent 1 "$slack_addr"
  focus_addr "$slack_addr" || true
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.1

  move_to_workspace_silent 1 "$browser_addr"
  focus_addr "$browser_addr" || true
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.1

  move_to_workspace_silent 1 "$term_addr"
  focus_addr "$slack_addr" || true
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.1

  move_to_workspace_silent 1 "$discord_addr"
  sleep 0.2
}

rebuild_workspace1_nonwork_tree() {
  local temp_ws="name:wssetup-temp"
  local top_addr
  local main_addr
  local term_addr

  top_addr="$(address_by_tag "$TAG_WS1_BROWSER_TOP")"
  main_addr="$(address_by_tag "$TAG_WS1_BROWSER_MAIN")"
  term_addr="$(address_by_tag "$TAG_WS1_TERM")"

  if [ -z "$top_addr" ] || [ -z "$main_addr" ] || [ -z "$term_addr" ]; then
    log_step "Skipping workspace 1 non-work tree rebuild (missing one or more windows)"
    return 0
  fi

  log_step "Rebuilding workspace 1 non-work tree"

  move_to_workspace_silent "$temp_ws" "$top_addr"
  move_to_workspace_silent "$temp_ws" "$main_addr"
  move_to_workspace_silent "$temp_ws" "$term_addr"
  sleep 0.2

  move_to_workspace_silent 1 "$top_addr"
  focus_addr "$top_addr" || true
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.1

  move_to_workspace_silent 1 "$main_addr"
  focus_addr "$main_addr" || true
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.1

  move_to_workspace_silent 1 "$term_addr"
  sleep 0.2
}

if is-work-time; then
  WORK_TIME=true
else
  WORK_TIME=false
fi

if $WORK_TIME; then
  log_step "Detected work-time mode"
else
  log_step "Detected non-work-time mode"
fi

if $WORK_TIME; then
  log_step "Preparing workspace 1 work apps"
  clear_tag_from_all "$TAG_WS1_BROWSER_TOP"

  ensure_slot "$TAG_WS1_SLACK" '^chrome-app\.slack\.com__client' "$WORK_SLACK_CMD" 1 false || true
  WS1_SLACK_ADDR="$ENSURED_ADDR"

  ensure_slot "$TAG_WS1_BROWSER_MAIN" '^chromium$' "$BROWSER_PERSONAL_CMD" 1 false "$STARTUP_BROWSER_ADDR" || true
  WS1_BROWSER_ADDR="$ENSURED_ADDR"

  if [ -n "$WS1_BROWSER_ADDR" ]; then
    focus_addr "$WS1_BROWSER_ADDR" || true
    hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
    sleep 0.2
  fi

  ensure_slot "$TAG_WS1_TERM" '^com\.mitchellh\.ghostty$' "$TERM_WORK_CMD" 1 true || true

  if [ -n "$WS1_SLACK_ADDR" ]; then
    focus_addr "$WS1_SLACK_ADDR" || true
    hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
    sleep 0.2
  fi

  ensure_slot "$TAG_WS1_DISCORD" '^chrome-discord\.com__app' "$WORK_DISCORD_CMD" 1 false || true

  rebuild_workspace1_tree
  apply_workspace1_sizes "$START_FOCUS_ADDR"

  log_step "Preparing workspace 2 and 3 work apps"
  ensure_slot "$TAG_WS2_TERM" '^com\.mitchellh\.ghostty$' "$TERM_WORK_CMD" 2 true || true
  ensure_slot "$TAG_WS3_BROWSER" '^(work-browser|google-chrome)$' "$WORK_BROWSER_CMD" 3 false || true
else
  log_step "Preparing workspace 1 non-work apps"
  clear_tag_from_all "$TAG_WS1_SLACK"
  clear_tag_from_all "$TAG_WS1_DISCORD"

  ensure_slot "$TAG_WS1_BROWSER_MAIN" '^chromium$' "$BROWSER_PERSONAL_CMD" 1 false "$STARTUP_BROWSER_ADDR" || true
  ensure_slot "$TAG_WS1_BROWSER_TOP" '^chromium$' "$BROWSER_PERSONAL_CMD" 1 false || true
  normalize_nonwork_browser_slot_order
  ensure_slot "$TAG_WS1_TERM" '^com\.mitchellh\.ghostty$' "$TERM_DEFAULT_CMD" 1 true || true

  rebuild_workspace1_nonwork_tree
  apply_workspace1_nonwork_sizes "$START_FOCUS_ADDR"

  log_step "Preparing workspace 2 non-work app"
  ensure_slot "$TAG_WS2_TERM" '^com\.mitchellh\.ghostty$' "$TERM_DEFAULT_CMD" 2 true || true
fi

if $WORK_TIME; then
  log_step "Switching to workspace 3"
  hyprctl dispatch workspace 3 >/dev/null 2>&1 || true
else
  log_step "Switching to workspace 2"
  hyprctl dispatch workspace 2 >/dev/null 2>&1 || true
fi

log_step "Workspace setup complete"

log_step "Cleaning up logs older than 7 days"
if [ -d "$LOG_DIR_DEFAULT" ]; then
  find "$LOG_DIR_DEFAULT" -type f -name 'workspace-setup-*.log' -mtime +7 -delete 2>/dev/null || true
fi
