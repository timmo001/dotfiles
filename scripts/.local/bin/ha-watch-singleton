#!/usr/bin/env bash

set -euo pipefail

MODULE_ID=""
ENTITY_ID=""
ICON=""
TEXT_ON=""
TEXT_OFF=""
TOOLTIP_ON=""
TOOLTIP_OFF=""
CLASS_ON=""
CLASS_OFF=""
HIDE_OFF=0

usage() {
  cat <<'EOF'
Usage: ha-watch-singleton --module <id> --entity <entity_id> [options]

Options:
  --module <id>           Module identifier used in singleton key
  --entity <entity_id>    Home Assistant entity id to watch
  --icon <icon>           Status bar icon for on/off states
  --text-on <text>        Status bar text when state is on
  --text-off <text>       Status bar text when state is not on
  --tooltip-on <text>     Status bar tooltip when state is on
  --tooltip-off <text>    Status bar tooltip when state is not on
  --class-on <class>      Status bar class when state is on
  --class-off <class>     Status bar class when state is not on
  --hide-off              Hide module when state is not on
  --help                  Show this help
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --module)
        MODULE_ID="$2"
        shift 2
        ;;
      --entity)
        ENTITY_ID="$2"
        shift 2
        ;;
      --icon)
        ICON="$2"
        shift 2
        ;;
      --text-on)
        TEXT_ON="$2"
        shift 2
        ;;
      --text-off)
        TEXT_OFF="$2"
        shift 2
        ;;
      --tooltip-on)
        TOOLTIP_ON="$2"
        shift 2
        ;;
      --tooltip-off)
        TOOLTIP_OFF="$2"
        shift 2
        ;;
      --class-on)
        CLASS_ON="$2"
        shift 2
        ;;
      --class-off)
        CLASS_OFF="$2"
        shift 2
        ;;
      --hide-off)
        HIDE_OFF=1
        shift
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*)
        printf 'ha-watch-singleton: unknown option: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
      *)
        printf 'ha-watch-singleton: unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  if [[ -z "$MODULE_ID" || -z "$ENTITY_ID" ]]; then
    printf 'ha-watch-singleton: --module and --entity are required\n' >&2
    usage >&2
    exit 1
  fi
}

# Walk up the process tree to find the bar host (Quickshell) so the singleton
# stream can be tied to the shell's lifetime. Falls back to the direct parent.
find_bar_ancestor_pid() {
  local pid="$PPID"
  local depth=0
  local comm=""
  local next_pid=""

  while [[ "$pid" =~ ^[0-9]+$ ]] && (( pid > 1 )) && (( depth < 8 )); do
    comm="$(awk '{print $2}' "/proc/$pid/stat" 2>/dev/null || true)"
    if [[ "$comm" == "(quickshell)" ]]; then
      printf '%s' "$pid"
      return 0
    fi

    next_pid="$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null || true)"
    if [[ ! "$next_pid" =~ ^[0-9]+$ ]] || (( next_pid <= 1 )); then
      break
    fi

    pid="$next_pid"
    depth=$((depth + 1))
  done

  return 1
}

build_watch_command() {
  WATCH_CMD=(go-automate ha bridge watch entity --bar-json)

  if [[ -n "$ICON" ]]; then
    WATCH_CMD+=(--icon "$ICON")
  fi
  if [[ -n "$TEXT_ON" ]]; then
    WATCH_CMD+=(--text-on "$TEXT_ON")
  fi
  if [[ -n "$TEXT_OFF" ]]; then
    WATCH_CMD+=(--text-off "$TEXT_OFF")
  fi
  if [[ -n "$TOOLTIP_ON" ]]; then
    WATCH_CMD+=(--tooltip-on "$TOOLTIP_ON")
  fi
  if [[ -n "$TOOLTIP_OFF" ]]; then
    WATCH_CMD+=(--tooltip-off "$TOOLTIP_OFF")
  fi
  if [[ -n "$CLASS_ON" ]]; then
    WATCH_CMD+=(--class-on "$CLASS_ON")
  fi
  if [[ -n "$CLASS_OFF" ]]; then
    WATCH_CMD+=(--class-off "$CLASS_OFF")
  fi
  if (( HIDE_OFF )); then
    WATCH_CMD+=(--hide-off)
  fi

  WATCH_CMD+=("$ENTITY_ID")
}

main() {
  local bar_pid=""
  local bar_starttime=""
  local stream_key=""

  parse_args "$@"

  if ! command -v go-automate >/dev/null 2>&1 || ! command -v singleton-stream >/dev/null 2>&1; then
    printf 'ha-watch-singleton: missing required command (go-automate or singleton-stream)\n' >&2
    exit 1
  fi

  bar_pid="$(find_bar_ancestor_pid || printf '%s' "$PPID")"
  bar_starttime="$(awk '{print $22}' "/proc/$bar_pid/stat" 2>/dev/null || true)"
  if [[ -z "$bar_starttime" ]]; then
    printf 'ha-watch-singleton: unable to read bar host parent starttime\n' >&2
    exit 1
  fi

  build_watch_command
  stream_key="ha-watch.${MODULE_ID}.${ENTITY_ID}"

  exec singleton-stream \
    --key "$stream_key" \
    --parent-pid "$bar_pid" \
    --parent-starttime "$bar_starttime" \
    -- "${WATCH_CMD[@]}"
}

main "$@"
