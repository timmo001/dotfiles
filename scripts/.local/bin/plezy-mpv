#!/usr/bin/env bash

set -euo pipefail

# External player for Plezy. plezy.sh points these at Plezy's bundled
# libraries, and mpv inherits them: its older libstdc++ stops the system mpv
# from starting (GLIBCXX not found). Add this as a custom player command in
# Plezy so mpv runs against the system libraries.
#
# Each run's verbose mpv log replaces the last one in the state directory, so
# the output colourspace (HDR passthrough or not) can be checked afterwards. It
# includes the stream URL, Plex token and all.
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/plezy-mpv"
mkdir -p "$log_dir"

exec env \
  -u LD_LIBRARY_PATH \
  -u GDK_PIXBUF_MODULE_FILE \
  -u GIO_MODULE_DIR \
  -u GIO_LAUNCH_DESKTOP \
  -u GTK_IM_MODULE_FILE \
  -u GTK_PATH \
  -u GSETTINGS_SCHEMA_DIR \
  mpv --log-file="$log_dir/mpv.log" "$@"
