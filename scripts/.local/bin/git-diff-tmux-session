#!/usr/bin/env bash
# Open dot-tracked repos in a shared tmux session, one window per repo.
set -euo pipefail

DOT_BIN="${DOT_BIN:-$HOME/.config/dotfiles/scripts/.local/bin/dot}"
TMUX_BIN="${TMUX_BIN:-/usr/bin/tmux}"
POPUP_LOADING_BIN="${POPUP_LOADING_BIN:-$HOME/.local/bin/popup-loading}"
GIT_DIFF_CACHE_FILE="${GIT_DIFF_CACHE_FILE:-${XDG_CACHE_HOME:-$HOME/.cache}/waybar/git-diff-waybar.json}"
MODE="${1:-changed}"
SESSION="dot"
window_names=()
window_paths=()
popup_visible=0

open_session_in_terminal() {
  local session_name="$1"

  uwsm app -- xdg-terminal-exec --app-id=org.omarchy.terminal /usr/bin/env bash -lc '
    tmux_bin="$1"
    session="$2"

    printf "\033]0;%s\007" "$session"
    exec "$tmux_bin" attach-session -t "$session"
  ' _ "$TMUX_BIN" "$session_name"
}

notify_no_changed_repos() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send \
      'Git diff' \
      'No changed repositories to open. In dot git-diff, press Tab to focus Other, then t to open all tracked repositories.' \
      >/dev/null 2>&1 || true
  fi
}

show_popup() {
  local message="${1:-Opening dot tmux session...}"

  if [[ -x "$POPUP_LOADING_BIN" ]]; then
    "$POPUP_LOADING_BIN" show "$message" >/dev/null 2>&1 || true
    popup_visible=1
  fi
}

update_popup() {
  local message="$1"

  if [[ "$popup_visible" -eq 1 && -x "$POPUP_LOADING_BIN" ]]; then
    "$POPUP_LOADING_BIN" show "$message" >/dev/null 2>&1 || true
  else
    show_popup "$message"
  fi
}

hide_popup() {
  if [[ "$popup_visible" -eq 1 && -x "$POPUP_LOADING_BIN" ]]; then
    "$POPUP_LOADING_BIN" hide >/dev/null 2>&1 || true
    popup_visible=0
  fi
}

trim_whitespace() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

load_changed_repos_from_waybar_cache() {
  local cache_json tooltip name path raw_segment segment
  local -a cached_segments=()

  [[ -s "$GIT_DIFF_CACHE_FILE" ]] || return 1

  cache_json="$(< "$GIT_DIFF_CACHE_FILE")"
  [[ "$cache_json" == *'"class":"dots-unknown"'* ]] && return 1

  if [[ "$cache_json" == *'"class":"dots-ok"'* ]]; then
    return 0
  fi

  tooltip="${cache_json#*\"tooltip\":\"}"
  [[ "$tooltip" != "$cache_json" ]] || return 1
  tooltip="${tooltip%%\",\"class\":\"*}"

  if [[ "$tooltip" == 'Repositories with changes pending: '* ]]; then
    tooltip="${tooltip#Repositories with changes pending: }"
  else
    return 1
  fi

  IFS=';'
  read -r -a cached_segments <<< "$tooltip"
  unset IFS

  while IFS='|' read -r name path; do
    [[ -z "$name" || -z "$path" ]] && continue

    for raw_segment in "${cached_segments[@]}"; do
      segment="$(trim_whitespace "$raw_segment")"
      if [[ "$segment" == "$name" ]]; then
        window_names+=("${name#*:}")
        window_paths+=("$path")
        break
      fi
    done
  done < <("$DOT_BIN" git-diff --list-all)

  return 0
}

trap hide_popup EXIT

case "$MODE" in
  changed)
    diff_arg="--list-changed"
    ;;
  all)
    diff_arg="--list-all"
    ;;
  *)
    printf 'Usage: %s [changed|all]\n' "${0##*/}" >&2
    exit 1
    ;;
esac

if [[ "$MODE" == "changed" ]]; then
  show_popup "Finding changed repos for tmux..."
  if ! load_changed_repos_from_waybar_cache; then
    while IFS='|' read -r name path; do
      if [[ -z "$name" || -z "$path" ]]; then
        continue
      fi

      window_names+=("${name#*:}")
      window_paths+=("$path")
    done < <("$DOT_BIN" git-diff "$diff_arg")
  fi
else
  show_popup "Finding all dot repos for tmux..."
  while IFS='|' read -r name path; do
    if [[ -z "$name" || -z "$path" ]]; then
      continue
    fi

    window_names+=("${name#*:}")
    window_paths+=("$path")
  done < <("$DOT_BIN" git-diff "$diff_arg")
fi

if [[ ${#window_names[@]} -eq 0 ]]; then
  if [[ "$MODE" == "changed" ]]; then
    hide_popup
    notify_no_changed_repos
  else
    update_popup "No dot repos to open."
  fi
  exit 0
fi

repo_count=${#window_names[@]}

if "$TMUX_BIN" has-session -t "$SESSION" 2>/dev/null; then
  clients=()
  update_popup "Found existing tmux dot session. Checking for attached clients..."
  if mapfile -t clients < <("$TMUX_BIN" list-clients -t "$SESSION" -F '#{client_tty}' 2>/dev/null) && [[ ${#clients[@]} -gt 0 ]]; then
    update_popup "Opening existing tmux dot session..."
    hide_popup
    open_session_in_terminal "$SESSION"
    exit 0
  fi

  update_popup "Resetting stale tmux dot session..."
  "$TMUX_BIN" kill-session -t "$SESSION"
fi

update_popup "Creating tmux dot session for ${repo_count} repo(s)..."
first=1
for i in "${!window_names[@]}"; do
  win="${window_names[$i]}"
  path="${window_paths[$i]}"
  current_index=$((i + 1))

  update_popup "Preparing ${win} (${current_index}/${repo_count})..."
  if [[ $first -eq 1 ]]; then
    "$TMUX_BIN" new-session -d -s "$SESSION" -n "$win" -c "$path"
    first=0
  else
    "$TMUX_BIN" new-window -t "$SESSION:" -n "$win" -c "$path"
  fi
done

if [[ $first -eq 1 ]]; then
  exit 0
fi

update_popup "Opening tmux dot session..."
hide_popup
open_session_in_terminal "$SESSION"
