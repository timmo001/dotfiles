#!/bin/bash

# Reloads desktop services and shell state that can go stale after suspend.

LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/reload-ui.log"

log() {
  mkdir -p "$(dirname "$LOG_FILE")"
  echo "[$(date '+%H:%M:%S')] $1" >> "$LOG_FILE"
}

refresh_shell_indicators() {
  omarchy-shell -q omarchy.indicators refresh || true
  omarchy-shell -q omarchy.clock refresh || true
}

refresh_git_modules() {
  omarchy-shell -q timmo.git refresh || true
}

if [[ "${RELOAD_UI_DETACHED:-0}" != "1" ]]; then
  export RELOAD_UI_DETACHED=1
  setsid "$0" "$@" >/dev/null 2>&1 &
  exit 0
fi

mkdir -p "$(dirname "$LOG_FILE")"
: > "$LOG_FILE"
log "UI reload started"

# Re-arm the laptop keyboard backlight, which the EC can leave at 0 after
# suspend. This is a no-op on machines without a keyboard backlight.
if command -v kbd-backlight-rearm >/dev/null 2>&1; then
  kbd-backlight-rearm || true
  log "Re-armed keyboard backlight"
fi

# Recheck upnext, opening configured live channels after a real resume. The
# daemon restarts its sources after sleep by itself; this only rechecks now.
upnext_args=(recheck)
if [[ "${1:-}" != "--no-auto-open" ]]; then
  upnext_args+=(--open)
fi

if ! upnext "${upnext_args[@]}" >/dev/null 2>&1; then
  systemctl --user restart upnext.service >/dev/null 2>&1 || true
fi
log "upnext recheck requested"

# Restore the generated host layout before restarting the shell. This also
# reverses ad-hoc `omarchy bar move` changes made since the last stow.
if dot omarchy-shell-config; then
  log "Regenerated Omarchy shell layout"
else
  log "Omarchy shell layout regeneration failed"
fi

# Restart the shell before asking its modules to repaint current state.
if omarchy restart shell; then
  log "Restarted Omarchy shell"
else
  log "Omarchy shell restart failed"
fi

if omarchy shell shell rescanPlugins; then
  log "Reloaded Omarchy shell plugins"
else
  log "Omarchy shell plugin reload failed"
fi

refresh_shell_indicators
log "Requested Omarchy shell indicator refresh"

# Reload the polling git status modules so they show fresh state after wake.
refresh_git_modules
log "Requested git status module refresh"

if dot updates refresh >> "$LOG_FILE" 2>&1; then
  log "Refreshed available updates"
else
  log "Available updates refresh failed"
fi

if systemctl --user start --no-block dot-doctor.service; then
  log "Started dot doctor check"
else
  log "dot doctor check failed to start"
fi

log "UI reload complete"
