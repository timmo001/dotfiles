#!/usr/bin/env bash
# Run dot doctor and send a desktop notification if there are errors.
# Intended for use with the dot-doctor systemd service (login timer and reload-ui).
set -euo pipefail

strip_ansi() {
  sed 's/\x1b\[[0-9;]*m//g'
}

status=0
raw_output=$(dot doctor 2>&1) || status=$?
plain=$(echo "$raw_output" | strip_ansi)
summary=$(echo "$plain" | grep -E '[0-9]+ passed' | tail -1 | sed 's/^ *//')
echo "[RESULT] $summary"

if [[ $status -ne 0 ]]; then
  errors=$(echo "$plain" | grep -E '^\[ERROR\]' | head -10 || true)
  omarchy notification send -g "󰒓" -u critical --app-name "dot doctor" 'dot doctor' "$(printf '%s\n\n%s' "$summary" "$errors")"
fi
