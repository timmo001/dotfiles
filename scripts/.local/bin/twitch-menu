#!/usr/bin/env bash
set -euo pipefail

open_url() {
  local url="${1:?}"
  local host="${OMARCHY_HOST:-}"

  if [[ "$host" == 'desktop' ]] && command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$url"
  fi

  exec omarchy-launch-webapp "$url"
}

channels_menu() {
  local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/twitch-notifications/channels.yml"
  local status_json tooltip line choice choice_label selected target_url live_entry live_channel
  local -a all_channels options
  declare -A live_display=()
  declare -A live_lookup=()

  [[ -f "$config_file" ]] || return 0

  while IFS= read -r line; do
    if [[ $line =~ ^[[:space:]]*-[[:space:]]name:[[:space:]]*([^[:space:]]+)[[:space:]]*$ ]]; then
      all_channels+=("${BASH_REMATCH[1]}")
    fi
  done < "$config_file"

  status_json="$(twitch-notifications --status-bar-json 2>/dev/null || true)"
  tooltip="$(jq -r '.tooltip // empty' <<<"$status_json" 2>/dev/null || true)"

  while IFS= read -r line; do
    [[ $line == '- '* ]] || continue
    live_entry="${line#- }"
    if [[ $live_entry =~ ^([^:[:space:]]+)[[:space:]]*:[[:space:]]+(.+)$ ]]; then
      live_channel="${BASH_REMATCH[1]}"
    else
      live_channel="$live_entry"
    fi
    live_lookup["${live_channel,,}"]=1
    live_display["${live_channel,,}"]="$live_entry"
  done <<< "$tooltip"

  options+=('󰕃  Open all live autolaunch')

  for line in "${all_channels[@]}"; do
    if [[ -n ${live_lookup["${line,,}"]:-} ]]; then
      options+=("  ${live_display["${line,,}"]:-$line}")
    fi
  done

  for line in "${all_channels[@]}"; do
    if [[ -z ${live_lookup["${line,,}"]:-} ]]; then
      options+=("󰖪  $line [offline]")
    fi
  done

  choice="$(printf '%s\n' "${options[@]}" | omarchy-launch-walker --dmenu --width 360 --minheight 1 --maxheight 630 -p 'Twitch channels…' 2>/dev/null || true)"
  choice_label="${choice#*  }"
  [[ $choice_label == 'Open all live autolaunch' ]] && exec twitch-notifications --recheck --open
  selected="${choice_label% \[offline\]}"
  selected="${selected%%:*}"

  if [[ -n $selected ]]; then
    target_url="https://twitch.tv/$selected"
    [[ $choice_label == *' [offline]' ]] && target_url+='/videos?filter=archives&sort=time'
    open_url "$target_url"
  fi
}

while true; do
  choice="$(printf '%s\n' '  Recheck notifications' '󰜉  Restart notifications' '  Open following' '  Open following live' '  Open channel(s)..' | omarchy-launch-walker --dmenu --width 295 --minheight 1 --maxheight 630 -p 'Twitch…' 2>/dev/null || true)"
  choice="${choice#*  }"

  case "$choice" in
    'Recheck notifications')
      exec ~/.config/dotfiles/scripts/.local/bin/twitch-notifications-recheck
      ;;
    'Restart notifications')
      exec ~/.config/dotfiles/scripts/.local/bin/twitch-notifications-restart
      ;;
    'Open following')
      open_url 'https://twitch.tv/directory/following'
      ;;
    'Open channel(s)..')
      channels_menu
      ;;
    'Open following live')
      open_url 'https://twitch.tv/directory/following/live'
      ;;
    *)
      exit 0
      ;;
  esac
done
