#!/usr/bin/env zsh

# Find the Bazzite entry
boot_entry=$(sudo efibootmgr | grep "Bazzite" | awk '{print $1}' | sed 's/Boot//;s/\*//')

if [ -z "$boot_entry" ]; then
  echo "Bazzite not found!"
  exit 1
fi

# Set the Bazzite as the next boot option
sudo efibootmgr --bootnext $boot_entry

if [ $? -ne 0 ]; then
  echo "Failed to set the Bazzite as the next boot option"
  exit 1
fi

echo "Rebooting into Bazzite..."
sudo reboot
