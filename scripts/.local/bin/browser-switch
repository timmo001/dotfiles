#!/usr/bin/env bash
# Switches between the personal browser (Chromium) and the work browser (Chrome,
# class work-browser): from one, focus the other; from anything else, focus
# whichever was used last. Opens the personal browser when neither is open.
# Focusing a window moves the pointer onto it.

set -euo pipefail

if (($# != 1)); then
  echo "Usage: browser-switch <personal-launch-command>" >&2
  exit 1
fi

PERSONAL="chromium"
WORK="work-browser"

clients="$(hyprctl -j clients)"
active="$(hyprctl -j activewindow | jq -r '.class // ""')"

# The most recently focused window of a class
latest() {
  jq -r --arg class "$1" '[.[] | select(.class == $class)] | sort_by(.focusHistoryID) | first | .address // empty' <<<"$clients"
}

personal="$(latest "$PERSONAL")"
work="$(latest "$WORK")"

case "$active" in
  "$PERSONAL") target="${work:-$personal}" ;;
  "$WORK") target="${personal:-$work}" ;;
  *)
    target="$(jq -r --arg a "$PERSONAL" --arg b "$WORK" '[.[] | select(.class == $a or .class == $b)] | sort_by(.focusHistoryID) | first | .address // empty' <<<"$clients")"
    ;;
esac

if [[ -z "$target" ]]; then
  eval exec setsid "$1"
fi

hyprctl dispatch "hl.dsp.focus({ window = 'address:${target}' })" >/dev/null
