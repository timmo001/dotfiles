#!/bin/bash

STATE_FILE="$HOME/.local/state/steam-scale-1x-state"

if [[ ! -f "$STATE_FILE" ]]; then
  notify-send -u low "Steam scale restore" "No saved Steam scale state was found."
  exit 0
fi

source "$STATE_FILE"

if [[ -n $ACTIVE_MONITOR && -n $WIDTH && -n $HEIGHT && -n $REFRESH_RATE && -n $X && -n $Y && -n $SCALE ]]; then
  if [[ $TRANSFORM == "0" || -z $TRANSFORM ]]; then
    hyprctl keyword monitor "$ACTIVE_MONITOR,${WIDTH}x${HEIGHT}@${REFRESH_RATE},${X}x${Y},${SCALE}" >/dev/null 2>&1
  else
    hyprctl keyword monitor "$ACTIVE_MONITOR,${WIDTH}x${HEIGHT}@${REFRESH_RATE},${X}x${Y},${SCALE},transform,${TRANSFORM}" >/dev/null 2>&1
  fi
fi

if [[ -n $SENSITIVITY ]]; then
  hyprctl keyword input:sensitivity "$SENSITIVITY" >/dev/null 2>&1
fi

notify-send -u low "Steam scale restored" "Restored your previous monitor scale and pointer speed."

rm -f "$STATE_FILE"
