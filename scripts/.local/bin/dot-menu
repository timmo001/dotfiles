#!/usr/bin/env bash

set -euo pipefail

run_with_notify() {
  local label="${1:?}"
  shift
  local output
  if output="$("$@" 2>&1)"; then
    notify-send -a 'Dot' "$label" "$output"
  else
    notify-send -u critical -a 'Dot' "$label failed" "${output:-Unknown error}"
  fi
  exit 0
}

while true; do
  options=(
    '󰚰  Update'
    '󰏗  Stow'
    '󰊢  Diff'
    '󰛯  Doctor'
    '󰗶  System health check'
    '󰏬  Skill updates'
    '󰟶  Memory refresh'
    '󰁝  Topgrade'
    '󰣇  Omarchy..'
  )

  choice="$(printf '%s\n' "${options[@]}" | omarchy-launch-walker --dmenu --width 360 --minheight 1 --maxheight 420 -p 'Dot...' 2>/dev/null || true)"
  choice="${choice#*  }"

  case "$choice" in
    'Update')
      exec run-in-terminal --wait 'dot update'
      ;;
    'Topgrade')
      exec run-in-terminal --wait 'topgrade'
      ;;
    'Stow')
      run_with_notify 'Stow' dot stow
      ;;
    'Diff')
      exec run-in-terminal 'dot diff'
      ;;
    'Doctor')
      exec run-in-terminal --wait 'dot doctor'
      ;;
    'System health check')
      exec run-in-terminal --wait 'system-health-check'
      ;;
    'Skill updates')
      exec run-in-terminal --wait 'dot skill-updates'
      ;;
    'Memory refresh')
      run_with_notify 'Memory' dot memory
      ;;
    'Omarchy..')
      exec omarchy-cmd-menu
      ;;
    *)
      exit 0
      ;;
  esac
done
