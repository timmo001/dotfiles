#!/usr/bin/env bash

set -euo pipefail

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"

count_waybar() {
  pgrep -fc "^/usr/bin/waybar" || true
}

count_motion_script() {
  pgrep -fc "front-door-motion.sh --entity binary_sensor.front_door_motion_2" || true
}

count_singleton() {
  pgrep -fc "singleton-stream --key front-door-motion.binary_sensor.front_door_motion_2" || true
}

count_motion_watcher() {
  pgrep -af "^go-automate ha bridge watch entity --waybar --icon .*binary_sensor.front_door_motion_2$" | wc -l || true
}

list_motion_processes() {
  pgrep -af "front-door-motion|binary_sensor.front_door_motion_2|singleton-stream|^/usr/bin/waybar" || true
}

print_counts() {
  local label="$1"

  printf '\n== %s ==\n' "$label"
  printf 'waybar: %s\n' "$(count_waybar)"
  printf 'motion script: %s\n' "$(count_motion_script)"
  printf 'singleton stream: %s\n' "$(count_singleton)"
  printf 'motion watcher: %s\n' "$(count_motion_watcher)"
  list_motion_processes
}

cleanup_motion() {
  pkill -f "front-door-motion.sh" >/dev/null 2>&1 || true
  pkill -f "singleton-stream.*front-door-motion" >/dev/null 2>&1 || true
  pkill -f "go-automate ha bridge watch entity --waybar --icon '' binary_sensor.front_door_motion_2" >/dev/null 2>&1 || true
  pkill -x waybar >/dev/null 2>&1 || true

  rm -f "$RUNTIME_DIR/singleton-stream-front-door-motion.binary_sensor.front_door_motion_2.lock" >/dev/null 2>&1 || true
  rm -f "$RUNTIME_DIR/singleton-stream-front-door-motion.binary_sensor.front_door_motion_2.state" >/dev/null 2>&1 || true
  rm -f "$RUNTIME_DIR/singleton-stream-front-door-motion.binary_sensor.front_door_motion_2.lock.owner" >/dev/null 2>&1 || true
  rm -f "$RUNTIME_DIR/front-door-popup.binary_sensor.front_door_motion_2.lock" >/dev/null 2>&1 || true
  rm -f "$RUNTIME_DIR/front-door-motion-popup.address" >/dev/null 2>&1 || true
}

main() {
  printf 'Front door motion test\n'
  printf 'Runtime dir: %s\n' "$RUNTIME_DIR"

  cleanup_motion
  sleep 1
  print_counts "After cleanup"

  printf '\nStarting Waybar...\n'
  omarchy-restart-waybar
  sleep 1
  print_counts "After first start"

  printf '\nRestarting Waybar three times...\n'
  omarchy-restart-waybar
  sleep 1
  omarchy-restart-waybar
  sleep 1
  omarchy-restart-waybar
  sleep 1
  print_counts "After three restarts"

  printf '\nToggling Waybar off...\n'
  omarchy-toggle-waybar
  sleep 1
  print_counts "After toggle off"

  printf '\nToggling Waybar on...\n'
  omarchy-toggle-waybar
  sleep 1
  print_counts "After toggle on"

  printf '\nDone.\n'
}

main "$@"
