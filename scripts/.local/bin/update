#!/bin/bash

set -o pipefail

section() {
  printf '\n\033[1;36m%s\033[0m\n' "$1"
}

agent_sudo_dir=''
cleanup() {
  [[ -z $agent_sudo_dir ]] || rm -rf "$agent_sudo_dir"
}
trap cleanup EXIT

yes=0
case "${1:-}" in
  -y|--yes)
    yes=1
    shift
    ;;
esac

if (( $# > 0 )); then
  echo "Usage: update [-y|--yes]" >&2
  exit 1
fi

topgrade_labels=(
  'Topgrade: Mise'
  'Topgrade: GitHub CLI extensions'
  'Topgrade: Yazi'
  'Topgrade: ProtonPlus'
  'Topgrade: Firmware'
  'Topgrade: Rustup'
  'Topgrade: TLDR'
  'Topgrade: Neovim'
  'Topgrade: Containers'
  'Topgrade: Claude Code'
  'Topgrade: Claude Code plugins'
  'Topgrade: uv'
)
topgrade_steps=(
  mise
  github_cli_extensions
  yazi
  protonplus
  firmware
  rustup
  tldr
  vim
  containers
  claude_code
  claude_code_plugins
  uv
)
default_selected='Dotfiles,Topgrade: Mise,Topgrade: GitHub CLI extensions,Topgrade: Yazi,Omarchy'

if (( ! yes )) && [[ -t 0 && -t 1 ]]; then
  mapfile -t selected < <(gum choose --no-limit --selected="$default_selected" --header='Choose updates:' \
    'Dotfiles' 'Omarchy' "${topgrade_labels[@]}")
else
  yes=1
  selected=('Dotfiles' 'Omarchy' "${topgrade_labels[@]}")
fi

if dot is-agent --quiet >/dev/null 2>&1 && [[ ! -t 0 || ! -t 1 ]]; then
  if ! command -v pkexec >/dev/null 2>&1; then
    echo 'update: pkexec is required when running under an agent' >&2
    exit 1
  fi

  agent_sudo_dir=$(mktemp -d)
  ln -s "$HOME/.local/libexec/update-sudo" "$agent_sudo_dir/sudo"
  export PATH="$agent_sudo_dir:$PATH"
fi

topgrade_selected=()
dotfiles_selected=0
omarchy_selected=0
for i in "${!topgrade_labels[@]}"; do
  for selected_step in "${selected[@]}"; do
    if [[ $selected_step == "${topgrade_labels[$i]}" ]]; then
      topgrade_selected+=("${topgrade_steps[$i]}")
      break
    fi
  done
done
for selected_step in "${selected[@]}"; do
  case "$selected_step" in
    Dotfiles) dotfiles_selected=1 ;;
    Omarchy) omarchy_selected=1 ;;
  esac
done

run_topgrade() {
  (( ${#topgrade_selected[@]} > 0 )) || return 0

  section 'Topgrade'
  if (( ${#topgrade_selected[@]} == ${#topgrade_steps[@]} )); then
    if (( yes )); then
      topgrade -y || exit
    else
      topgrade || exit
    fi
  else
    topgrade --only "${topgrade_selected[@]}" || exit
  fi
  topgrade_selected=()
}

if (( dotfiles_selected )); then
  section 'Dotfiles'
  dot update || exit
fi

if (( omarchy_selected )); then
  section 'Omarchy'
  omarchy update -y || exit
fi

run_topgrade
