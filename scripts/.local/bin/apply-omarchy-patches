#!/bin/bash

set -euo pipefail

omarchy_path=${OMARCHY_PATCH_ROOT:-${OMARCHY_PATH:-/usr/share/omarchy}}
script_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
patch_dir=${OMARCHY_PATCH_DIR:-$script_dir/../share/omarchy-patches}
target=$(readlink -f "$omarchy_path/bin/omarchy-agent-crash")
patch_file="$patch_dir/agent-crash-hook.patch"
printf -v marker 'dispatch_hook="$%s/.config/omarchy/hooks/agent-crash"' HOME
target_dir=$(dirname "$target")

[[ -f $target ]] || {
  printf 'Omarchy crash command not found: %s\n' "$target" >&2
  exit 1
}
[[ -f $patch_file ]] || {
  printf 'Omarchy patch not found: %s\n' "$patch_file" >&2
  exit 1
}

if grep -Fq "$marker" "$target"; then
  printf 'Omarchy crash dispatch patch already applied\n'
  exit 0
fi

if ! patch --batch --forward --fuzz=0 --dry-run -d "$target_dir" -p2 <"$patch_file" >/dev/null; then
  printf 'Omarchy crash dispatch patch no longer matches upstream\n' >&2
  exit 1
fi

patch_args=(--batch --forward --fuzz=0 -d "$target_dir" -p2 -i "$patch_file")
if [[ -w $target ]]; then
  patch "${patch_args[@]}" >/dev/null
elif command -v pkexec >/dev/null 2>&1 && pkexec patch "${patch_args[@]}" >/dev/null; then
  :
elif command -v sudo >/dev/null 2>&1; then
  sudo patch "${patch_args[@]}" >/dev/null
else
  printf 'pkexec or sudo is required to patch %s\n' "$target" >&2
  exit 1
fi
printf 'Applied Omarchy crash dispatch patch\n'
