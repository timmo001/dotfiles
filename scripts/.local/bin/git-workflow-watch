#!/usr/bin/env bash

set -euo pipefail

PRIVATE_DOTFILES="${DOTFILES_PRIVATE_DIR:-$HOME/.config/dotfiles-private}"
WATCH_REPOS_FILE="${DOT_WORKFLOW_WATCH_REPOS_FILE:-$PRIVATE_DOTFILES/.git-workflow-watch-repos}"
HOOKS_PATH="${DOT_WORKFLOW_WATCH_HOOKS_PATH:-$HOME/.config/git/workflow-watch-hooks}"
STATE_DIR="${DOT_WORKFLOW_WATCH_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/git-workflow-watch}"
QUEUE_DIR="$STATE_DIR/queue"
NOTIFIED_DIR="$STATE_DIR/notified"
EXPIRED_DIR="$STATE_DIR/expired"
RUN_FAILED_DIR="$STATE_DIR/run-failed"
RUN_NOTIFIED_DIR="$STATE_DIR/run-notified"
LOCK_DIR="$STATE_DIR/process.lock"
RUN_DISCOVERY_TIMEOUT_SECONDS="${DOT_WORKFLOW_WATCH_TIMEOUT_SECONDS:-1800}"
FAILED_RUN_TTL_SECONDS="${DOT_WORKFLOW_WATCH_FAILED_RUN_TTL_SECONDS:-3600}"
NOTIFY_NO_RUNS="${DOT_WORKFLOW_WATCH_NOTIFY_NO_RUNS:-0}"
WAYBAR_WORKFLOW_FAILURES_SIGNAL="${WAYBAR_WORKFLOW_FAILURES_SIGNAL:-12}"

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

trim_whitespace() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s\n' "$value"
}

create_state_dirs() {
  mkdir -p "$QUEUE_DIR" "$NOTIFIED_DIR" "$EXPIRED_DIR" "$RUN_FAILED_DIR" "$RUN_NOTIFIED_DIR"
}

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '%s\n' "$value"
}

signal_waybar_workflow_failures_refresh() {
  pkill -RTMIN+${WAYBAR_WORKFLOW_FAILURES_SIGNAL} waybar >/dev/null 2>&1 || true
}

safe_key() {
  local value="$1"
  value="${value//\//__}"
  value="${value//[^A-Za-z0-9._-]/_}"
  printf '%s\n' "$value"
}

github_repo_slug_from_url() {
  local url="$1"
  local slug=''

  case "$url" in
    git@github.com:*)
      slug="${url#git@github.com:}"
      ;;
    ssh://git@github.com/*)
      slug="${url#ssh://git@github.com/}"
      ;;
    https://github.com/*)
      slug="${url#https://github.com/}"
      ;;
    http://github.com/*)
      slug="${url#http://github.com/}"
      ;;
    git://github.com/*)
      slug="${url#git://github.com/}"
      ;;
    *)
      return 1
      ;;
  esac

  slug="${slug%.git}"
  slug="${slug%/}"
  [[ "$slug" == */* ]] || return 1
  printf '%s\n' "$slug"
}

repo_is_watched() {
  local repo_slug="$1"
  local raw_line
  local line
  local candidate

  [[ -r "$WATCH_REPOS_FILE" ]] || return 1

  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    line="${raw_line%%#*}"
    line="$(trim_whitespace "$line")"
    [[ -n "$line" ]] || continue

    candidate="$line"
    if candidate_slug="$(github_repo_slug_from_url "$line" 2>/dev/null)"; then
      candidate="$candidate_slug"
    fi

    if [[ "$candidate" == "$repo_slug" ]]; then
      return 0
    fi
  done < "$WATCH_REPOS_FILE"

  return 1
}

identity_matches_commit() {
  local author_name="$1"
  local author_email="$2"
  local committer_name="$3"
  local committer_email="$4"
  local expected_name
  local expected_email

  expected_name="$(git config --get user.name 2>/dev/null || git config --global --get user.name 2>/dev/null || true)"
  expected_email="$(git config --get user.email 2>/dev/null || git config --global --get user.email 2>/dev/null || true)"

  if [[ -z "$expected_name" && -z "$expected_email" ]]; then
    return 0
  fi

  if [[ -n "$expected_email" ]]; then
    if [[ "$author_email" == "$expected_email" || "$committer_email" == "$expected_email" ]]; then
      return 0
    fi
  fi

  if [[ -n "$expected_name" ]]; then
    if [[ "$author_name" == "$expected_name" || "$committer_name" == "$expected_name" ]]; then
      return 0
    fi
  fi

  return 1
}

queue_file_path() {
  local repo_slug="$1"
  local sha="$2"
  printf '%s/%s.env\n' "$QUEUE_DIR" "$(safe_key "${repo_slug}__${sha}")"
}

notified_file_path() {
  local repo_slug="$1"
  local sha="$2"
  printf '%s/%s.env\n' "$NOTIFIED_DIR" "$(safe_key "${repo_slug}__${sha}")"
}

expired_file_path() {
  local repo_slug="$1"
  local sha="$2"
  printf '%s/%s.env\n' "$EXPIRED_DIR" "$(safe_key "${repo_slug}__${sha}")"
}

run_notified_file_path() {
  local repo_slug="$1"
  local sha="$2"
  local run_id="$3"
  printf '%s/%s\n' "$RUN_NOTIFIED_DIR" "$(safe_key "${repo_slug}__${sha}__${run_id}")"
}

run_failed_file_path() {
  local repo_slug="$1"
  local sha="$2"
  local run_id="$3"
  printf '%s/%s.state\n' "$RUN_FAILED_DIR" "$(safe_key "${repo_slug}__${sha}__${run_id}")"
}

record_failed_run() {
  local repo_slug="$1"
  local branch="$2"
  local sha="$3"
  local subject="$4"
  local workflow_name="$5"
  local conclusion="$6"
  local run_id="$7"
  local run_url="$8"
  local failed_file
  local tmp_file

  create_state_dirs
  failed_file="$(run_failed_file_path "$repo_slug" "$sha" "$run_id")"
  tmp_file="$(mktemp "$RUN_FAILED_DIR/.tmp.XXXXXX")"
  {
    printf 'repo_slug=%q\n' "$repo_slug"
    printf 'branch=%q\n' "$branch"
    printf 'sha=%q\n' "$sha"
    printf 'subject=%q\n' "$subject"
    printf 'workflow_name=%q\n' "$workflow_name"
    printf 'conclusion=%q\n' "$conclusion"
    printf 'run_id=%q\n' "$run_id"
    printf 'run_url=%q\n' "$run_url"
    printf 'recorded_at_epoch=%q\n' "$(date +%s)"
  } > "$tmp_file"
  mv -f "$tmp_file" "$failed_file"
  signal_waybar_workflow_failures_refresh
  printf '%s\n' "$failed_file"
}

clear_failed_run() {
  local failed_file="$1"

  [[ -n "$failed_file" ]] || return 0
  if [[ -f "$failed_file" ]]; then
    rm -f "$failed_file"
    signal_waybar_workflow_failures_refresh
  fi
}

cleanup_expired_failed_runs() {
  local failed_file
  local now
  local removed_any=0

  create_state_dirs
  now="$(date +%s)"

  shopt -s nullglob
  for failed_file in "$RUN_FAILED_DIR"/*.state; do
    unset repo_slug branch sha subject workflow_name conclusion run_id run_url recorded_at_epoch
    # Files are generated by this script and contain shell-escaped values.
    # shellcheck disable=SC1090
    source "$failed_file"
    [[ -n "${recorded_at_epoch:-}" ]] || continue
    if (( now - recorded_at_epoch >= FAILED_RUN_TTL_SECONDS )); then
      rm -f "$failed_file"
      removed_any=1
    fi
  done
  shopt -u nullglob

  if [[ "$removed_any" -eq 1 ]]; then
    signal_waybar_workflow_failures_refresh
  fi
}

open_url() {
  local url="$1"

  if ! has_cmd xdg-open; then
    return 1
  fi

  xdg-open "$url" >/dev/null 2>&1 &
}

queue_push_event() {
  local repo_slug="$1"
  local branch="$2"
  local remote_name="$3"
  local remote_url="$4"
  local sha="$5"
  local subject="$6"
  local author_name="$7"
  local author_email="$8"
  local committer_name="$9"
  local committer_email="${10}"
  local host_name="${11}"
  local queue_file
  local notified_file
  local tmp_file

  create_state_dirs
  queue_file="$(queue_file_path "$repo_slug" "$sha")"
  notified_file="$(notified_file_path "$repo_slug" "$sha")"

  [[ -f "$notified_file" ]] && return 1

  tmp_file="$(mktemp "$QUEUE_DIR/.tmp.XXXXXX")"
  {
    printf 'repo_slug=%q\n' "$repo_slug"
    printf 'branch=%q\n' "$branch"
    printf 'remote_name=%q\n' "$remote_name"
    printf 'remote_url=%q\n' "$remote_url"
    printf 'sha=%q\n' "$sha"
    printf 'subject=%q\n' "$subject"
    printf 'author_name=%q\n' "$author_name"
    printf 'author_email=%q\n' "$author_email"
    printf 'committer_name=%q\n' "$committer_name"
    printf 'committer_email=%q\n' "$committer_email"
    printf 'host_name=%q\n' "$host_name"
    printf 'created_at_epoch=%q\n' "$(date +%s)"
  } > "$tmp_file"
  mv -f "$tmp_file" "$queue_file"
  return 0
}

start_processor() {
  if has_cmd systemctl; then
    systemctl --user start git-workflow-watch.service >/dev/null 2>&1 || true
  fi
}

command_enqueue_pre_push() {
  local stdin_file=''
  local remote_name=''
  local remote_url=''
  local repo_slug=''
  local host_name='unknown'
  local local_ref
  local local_sha
  local remote_ref
  local remote_sha
  local branch
  local author_name
  local author_email
  local committer_name
  local committer_email
  local subject
  local queued_any=0

  if [[ "${1:-}" == '--stdin-file' ]]; then
    stdin_file="${2:-}"
    shift 2 || true
  fi

  remote_name="${1:-}"
  remote_url="${2:-}"
  [[ -n "$remote_name" ]] || return 0

  if [[ -z "$remote_url" ]]; then
    remote_url="$(git remote get-url "$remote_name" 2>/dev/null || true)"
  fi

  repo_slug="$(github_repo_slug_from_url "$remote_url" 2>/dev/null || true)"
  [[ -n "$repo_slug" ]] || return 0
  repo_is_watched "$repo_slug" || return 0

  host_name="$(hostname 2>/dev/null || uname -n 2>/dev/null || printf 'unknown')"

  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n "$local_ref" && -n "$local_sha" ]] || continue
    [[ "$local_ref" == refs/heads/* ]] || continue
    [[ "$local_sha" != '0000000000000000000000000000000000000000' ]] || continue

    if ! git cat-file -e "$local_sha^{commit}" >/dev/null 2>&1; then
      continue
    fi

    branch="${local_ref#refs/heads/}"
    subject="$(git log -1 --format=%s "$local_sha" 2>/dev/null || true)"
    author_name="$(git log -1 --format=%an "$local_sha" 2>/dev/null || true)"
    author_email="$(git log -1 --format=%ae "$local_sha" 2>/dev/null || true)"
    committer_name="$(git log -1 --format=%cn "$local_sha" 2>/dev/null || true)"
    committer_email="$(git log -1 --format=%ce "$local_sha" 2>/dev/null || true)"

    if ! identity_matches_commit "$author_name" "$author_email" "$committer_name" "$committer_email"; then
      continue
    fi

    if queue_push_event \
      "$repo_slug" \
      "$branch" \
      "$remote_name" \
      "$remote_url" \
      "$local_sha" \
      "$subject" \
      "$author_name" \
      "$author_email" \
      "$committer_name" \
      "$committer_email" \
      "$host_name"; then
      queued_any=1
    fi
  done < "${stdin_file:-/dev/stdin}"

  if [[ "$queued_any" -eq 1 ]]; then
    start_processor
  fi
}

notify_workflow_run() {
  local repo_slug="$1"
  local branch="$2"
  local sha="$3"
  local subject="$4"
  local workflow_name="$5"
  local conclusion="$6"
  local run_url="$7"
  local short_sha="${sha:0:7}"
  local title='GitHub Actions passed'
  local body=''
  local action=''

  if [[ "$conclusion" != 'success' ]]; then
    title='GitHub Actions need attention'
    body="$repo_slug ($branch)\n$short_sha ${subject:-Workflow run completed}\n$workflow_name: ${conclusion:-completed}"
  else
    body="$repo_slug ($branch)\n$short_sha ${subject:-Workflow run completed}\n$workflow_name: success"
  fi

  if has_cmd notify-send; then
    if action="$(notify-send -A open=Open "$title" "$body" 2>/dev/null || true)"; then
      if [[ "$action" == 'open' && -n "$run_url" ]]; then
        open_url "$run_url" || true
      fi
    fi
  fi
}

command_notify_workflow_run() {
  notify_workflow_run "$@"
}

notify_no_runs() {
  local repo_slug="$1"
  local branch="$2"
  local sha="$3"
  local subject="$4"
  local short_sha="${sha:0:7}"

  [[ "$NOTIFY_NO_RUNS" == '1' ]] || return 0

  if has_cmd notify-send; then
    notify-send \
      'GitHub Actions not triggered' \
      "$repo_slug ($branch)\n$short_sha ${subject:-No workflow runs were created}\nNo workflow runs were detected before the timeout" \
      >/dev/null 2>&1 || true
  fi
}

process_queue_file() {
  local queue_file="$1"
  local now
  local age_seconds
  local run_lines=''
  local run_id=''
  local status=''
  local conclusion=''
  local workflow_name=''
  local run_url=''
  local pending_runs=0
  local done_file
  local expired_file
  local run_notified_file
  local failed_file

  # Queue files are generated by this script and contain shell-escaped values.
  # shellcheck disable=SC1090
  source "$queue_file"

  now="$(date +%s)"
  age_seconds=$((now - created_at_epoch))

  if ! has_cmd gh; then
    return 0
  fi

  run_lines="$(gh run list \
    --repo "$repo_slug" \
    --commit "$sha" \
    --limit 100 \
    --json databaseId,status,conclusion,workflowName,url \
    --jq '.[] | [.databaseId, .status, (.conclusion // ""), (.workflowName // "Unnamed workflow"), (.url // "")] | @tsv' \
    2>/dev/null || true)"

  if [[ -z "$run_lines" ]]; then
    if [[ "$age_seconds" -ge "$RUN_DISCOVERY_TIMEOUT_SECONDS" ]]; then
      notify_no_runs "$repo_slug" "$branch" "$sha" "$subject"
      expired_file="$(expired_file_path "$repo_slug" "$sha")"
      mv -f "$queue_file" "$expired_file"
    fi
    return 0
  fi

  while IFS=$'\t' read -r run_id status conclusion workflow_name run_url; do
    [[ -n "$run_id" ]] || continue
    failed_file="$(run_failed_file_path "$repo_slug" "$sha" "$run_id")"

    if [[ "$status" != 'completed' ]]; then
      pending_runs=$((pending_runs + 1))
      continue
    fi

    run_notified_file="$(run_notified_file_path "$repo_slug" "$sha" "$run_id")"
    if [[ "$conclusion" == 'success' ]]; then
      clear_failed_run "$failed_file"
    else
      record_failed_run "$repo_slug" "$branch" "$sha" "$subject" "$workflow_name" "$conclusion" "$run_id" "$run_url" >/dev/null
    fi

    if [[ ! -f "$run_notified_file" ]]; then
      if has_cmd setsid; then
        setsid "$0" notify-workflow-run "$repo_slug" "$branch" "$sha" "$subject" "$workflow_name" "$conclusion" "$run_url" >/dev/null 2>&1 &
      else
        "$0" notify-workflow-run "$repo_slug" "$branch" "$sha" "$subject" "$workflow_name" "$conclusion" "$run_url" >/dev/null 2>&1 &
      fi
      : > "$run_notified_file"
    fi
  done <<< "$run_lines"

  if [[ "$pending_runs" -gt 0 ]]; then
    return 0
  fi

  done_file="$(notified_file_path "$repo_slug" "$sha")"
  mv -f "$queue_file" "$done_file"
}

command_process_queue() {
  local queue_file

  create_state_dirs
  cleanup_expired_failed_runs

  if ! mkdir "$LOCK_DIR" >/dev/null 2>&1; then
    return 0
  fi
  trap 'rm -rf "$LOCK_DIR"' EXIT

  shopt -s nullglob
  for queue_file in "$QUEUE_DIR"/*.env; do
    process_queue_file "$queue_file"
  done
  shopt -u nullglob
}

command_waybar_status() {
  local failed_file
  local count=0
  local tooltip='GitHub workflows: no failed runs tracked.'
  local class='hidden'
  local text=''
  local rendered_tooltip=''
  local line=''

  create_state_dirs
  cleanup_expired_failed_runs

  shopt -s nullglob
  for failed_file in "$RUN_FAILED_DIR"/*.state; do
    count=$((count + 1))
  done

  if [[ "$count" -gt 0 ]]; then
    text=" ${count}"
    tooltip='Failed GitHub workflow runs: '
    for failed_file in "$RUN_FAILED_DIR"/*.state; do
      # Files are generated by this script and contain shell-escaped values.
      # shellcheck disable=SC1090
      source "$failed_file"
      [[ -n "$line" ]] && tooltip+='; '
      line="$repo_slug: $workflow_name ($conclusion)"
      tooltip+="$line"
    done
    class='workflow-failures-attention'
  fi
  shopt -u nullglob

  rendered_tooltip="$(json_escape "$tooltip")"
  printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$text" "$rendered_tooltip" "$class"
}

command_open_failed_runs() {
  local failed_file
  local opened_any=0

  create_state_dirs
  cleanup_expired_failed_runs

  shopt -s nullglob
  for failed_file in "$RUN_FAILED_DIR"/*.state; do
    # Files are generated by this script and contain shell-escaped values.
    # shellcheck disable=SC1090
    source "$failed_file"
    if [[ -n "${run_url:-}" ]]; then
      open_url "$run_url" || true
      opened_any=1
    fi
  done
  shopt -u nullglob

  if [[ "$opened_any" -eq 0 ]] && has_cmd notify-send; then
    notify-send 'GitHub workflow watch' 'No failed workflow runs to open.' >/dev/null 2>&1 || true
  fi
}

command_clear_failed_runs() {
  local failed_file
  local cleared_any=0

  create_state_dirs

  shopt -s nullglob
  for failed_file in "$RUN_FAILED_DIR"/*.state; do
    rm -f "$failed_file"
    cleared_any=1
  done
  shopt -u nullglob

  if [[ "$cleared_any" -eq 1 ]]; then
    signal_waybar_workflow_failures_refresh
  fi
}

usage() {
  printf 'Usage: %s <enqueue-pre-push|process-queue|notify-workflow-run|waybar-status|open-failed-runs|clear-failed-runs> [args]\n' "${0##*/}"
}

main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    enqueue-pre-push)
      command_enqueue_pre_push "$@"
      ;;
    process-queue)
      command_process_queue
      ;;
    notify-workflow-run)
      command_notify_workflow_run "$@"
      ;;
    waybar-status)
      command_waybar_status
      ;;
    open-failed-runs)
      command_open_failed_runs
      ;;
    clear-failed-runs)
      command_clear_failed_runs
      ;;
    ''|help|-h|--help)
      usage
      ;;
    *)
      usage >&2
      return 1
      ;;
  esac
}

main "$@"
