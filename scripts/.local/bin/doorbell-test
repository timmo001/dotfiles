#!/usr/bin/env bash

set -euo pipefail

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
MOTION_ENTITY="input_boolean.doorbell"

usage() {
  cat <<'EOF'
Usage: doorbell-test [options]

Options:
  --entity <entity_id>   Motion entity used by front-door module
  --help                 Show this help
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --entity)
        MOTION_ENTITY="$2"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*)
        printf 'doorbell-test: unknown option: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
      *)
        printf 'doorbell-test: unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

count_waybar() {
  pgrep -fc "^/usr/bin/waybar" || true
}

count_motion_script() {
  pgrep -fc "ha-waybar-module.sh doorbell" || true
}

count_singleton() {
  pgrep -fc "singleton-stream --key doorbell.${MOTION_ENTITY}" || true
}

count_motion_watcher() {
  pgrep -af "^go-automate ha bridge watch entity --waybar --icon .*${MOTION_ENTITY}$" | wc -l || true
}

list_motion_processes() {
  pgrep -af "ha-waybar-module.sh doorbell|${MOTION_ENTITY}|singleton-stream|doorbell-popup|^/usr/bin/waybar" || true
}

print_counts() {
  local label="$1"

  printf '\n== %s ==\n' "$label"
  printf 'waybar: %s\n' "$(count_waybar)"
  printf 'motion script: %s\n' "$(count_motion_script)"
  printf 'singleton stream: %s\n' "$(count_singleton)"
  printf 'motion watcher: %s\n' "$(count_motion_watcher)"
  list_motion_processes
}

cleanup_motion() {
  pkill -f "ha-waybar-module.sh doorbell" >/dev/null 2>&1 || true
  pkill -f "singleton-stream.*doorbell" >/dev/null 2>&1 || true
  pkill -f "go-automate ha bridge watch entity --waybar --icon '' ${MOTION_ENTITY}" >/dev/null 2>&1 || true
  pkill -f "doorbell-popup --open-only" >/dev/null 2>&1 || true
  pkill -x waybar >/dev/null 2>&1 || true

  rm -f "$RUNTIME_DIR/singleton-stream-doorbell.${MOTION_ENTITY}.lock" >/dev/null 2>&1 || true
  rm -f "$RUNTIME_DIR/singleton-stream-doorbell.${MOTION_ENTITY}.state" >/dev/null 2>&1 || true
  rm -f "$RUNTIME_DIR/singleton-stream-doorbell.${MOTION_ENTITY}.lock.owner" >/dev/null 2>&1 || true
  rm -f "$RUNTIME_DIR/doorbell-popup.${MOTION_ENTITY}.lock" >/dev/null 2>&1 || true
  rm -f "$RUNTIME_DIR/doorbell-popup.address" >/dev/null 2>&1 || true
}

main() {
  parse_args "$@"

  printf 'Doorbell test\n'
  printf 'Runtime dir: %s\n' "$RUNTIME_DIR"
  printf 'Motion entity: %s\n' "$MOTION_ENTITY"

  cleanup_motion
  sleep 1
  print_counts "After cleanup"

  printf '\nStarting Waybar...\n'
  omarchy-restart-waybar
  sleep 1
  print_counts "After first start"

  printf '\nRestarting Waybar three times...\n'
  omarchy-restart-waybar
  sleep 1
  omarchy-restart-waybar
  sleep 1
  omarchy-restart-waybar
  sleep 1
  print_counts "After three restarts"

  printf '\nToggling Waybar off...\n'
  omarchy-toggle-waybar
  sleep 1
  print_counts "After toggle off"

  printf '\nToggling Waybar on...\n'
  omarchy-toggle-waybar
  sleep 1
  print_counts "After toggle on"

  printf '\nDone.\n'
}

main "$@"
