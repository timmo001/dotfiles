#!/usr/bin/env bash

set -euo pipefail

SCRIPT_NAME="${0##*/}"
# Absolute path to this script (for re-invoking commands, e.g. dot update → dot memory).
DOT_SELF="${BASH_SOURCE[0]:-$0}"

PUBLIC_DOTFILES="${DOTFILES_PUBLIC_DIR:-$HOME/.config/dotfiles}"
PRIVATE_DOTFILES="${DOTFILES_PRIVATE_DIR:-$HOME/.config/dotfiles-private}"
NOTES_REPO_DIR="${DOT_NOTES_DIR:-$HOME/Documents/notes}"
PRIVATE_EXTRA_REPOS_FILE="${DOT_PRIVATE_EXTRA_REPOS_FILE:-$PRIVATE_DOTFILES/.dot-extra-repos}"

EXPECTED_GH_USER="${DOT_PRIVATE_GH_USER:-timmo001}"
PRIVATE_MODE="${DOT_ALLOW_PRIVATE:-auto}" # auto|always|never
INCLUDE_OMARCHY_DIFF_REPOS="${DOT_INCLUDE_OMARCHY_DIFF_REPOS:-1}"
INCLUDE_OMARCHY_UPDATE_REPOS="${DOT_INCLUDE_OMARCHY_UPDATE_REPOS:-1}"
INIT_NONINTERACTIVE="${DOT_INIT_NONINTERACTIVE:-0}"
DOT_AGENTS_SYNC_ON_UPDATE="${DOT_AGENTS_SYNC_ON_UPDATE:-1}"
DOT_MEMORY_ON_AGENTS_SYNC="${DOT_MEMORY_ON_AGENTS_SYNC:-1}"
DOT_FETCH_TTL_SECONDS="${DOT_FETCH_TTL_SECONDS:-300}"
DOT_FETCH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dot/fetch-upstream"
DOT_WORKFLOW_WATCH_HOOKS_PATH="${DOT_WORKFLOW_WATCH_HOOKS_PATH:-$HOME/.config/git/workflow-watch-hooks}"
DOT_WORKFLOW_WATCH_REPOS_FILE="${DOT_WORKFLOW_WATCH_REPOS_FILE:-$PRIVATE_DOTFILES/.git-workflow-watch-repos}"
DOT_WORKFLOW_WATCH_TIMER_UNIT="${DOT_WORKFLOW_WATCH_TIMER_UNIT:-git-workflow-watch.timer}"
DOT_DOCTOR_STARTUP_TIMER_UNIT="${DOT_DOCTOR_STARTUP_TIMER_UNIT:-dot-doctor-startup.timer}"
DOT_DAILY_VOLUME_ZERO_TIMER_UNIT="${DOT_DAILY_VOLUME_ZERO_TIMER_UNIT:-daily-volume-zero.timer}"

OMARCHY_REPO_BASE="${OMARCHY_REPO_BASE_DIR:-$HOME/.config}"
OMARCHY_DIFF_REPOS=(hypr waybar bootstrap ghostty uwsm)
OMARCHY_WORKTREE_REPOS=(hypr)
OMARCHY_WORKTREE_BRANCHES=(desktop laptop)
OMARCHY_SINGLE_BRANCH_REPOS=(bootstrap waybar ghostty uwsm)
OMARCHY_BRANCH="${DOT_OMARCHY_BRANCH:-}"
BOOTSTRAP_BRANCH="${DOT_BOOTSTRAP_BRANCH:-distro/omarchy}"

OMARCHY_TARGET_NAMES=()
OMARCHY_TARGET_PATHS=()
UPDATED_REPO_NAMES=()

DIFF_ATTENTION_ISSUES=0
DIFF_ATTENTION_SEGMENTS=()
DIFF_ATTENTION_PATHS=()
DIFF_ATTENTION_HAS_DIRTY=0
DIFF_ATTENTION_HAS_AHEAD=0
DIFF_ATTENTION_HAS_BEHIND=0
DIFF_ATTENTION_VERBOSE=0

PRIVATE_REASON=""

DOT_PUBLIC_PACKAGES_FILE="${DOT_PUBLIC_PACKAGES_FILE:-$PUBLIC_DOTFILES/.dot-public-packages}"
PUBLIC_ARCH_PACKAGES=()
MISSING_PUBLIC_ARCH_PACKAGES=()

PRIVATE_ARCH_PACKAGES=()
MISSING_PRIVATE_ARCH_PACKAGES=()

DOT_PRIVATE_PACKAGE_REPO_FILE_DEFAULT="$PRIVATE_DOTFILES/.dot-private-package-repo"
DOT_PRIVATE_PACKAGE_REPO_FILE="${DOT_PRIVATE_PACKAGE_REPO_FILE:-$DOT_PRIVATE_PACKAGE_REPO_FILE_DEFAULT}"
DOT_PRIVATE_PACKAGES_FILE_DEFAULT="$PRIVATE_DOTFILES/.dot-private-packages"
DOT_PRIVATE_PACKAGES_FILE="${DOT_PRIVATE_PACKAGES_FILE:-$DOT_PRIVATE_PACKAGES_FILE_DEFAULT}"
DOT_PRIVATE_PACKAGE_MAP_FILE_DEFAULT="$PRIVATE_DOTFILES/.dot-private-package-map"
DOT_PRIVATE_PACKAGE_MAP_FILE="${DOT_PRIVATE_PACKAGE_MAP_FILE:-$DOT_PRIVATE_PACKAGE_MAP_FILE_DEFAULT}"
DOT_PRIVATE_PACMAN_REPO_CONFIG_DEFAULT='/etc/pacman.d/timmo-private.conf'
DOT_PRIVATE_PACMAN_REPO_CONFIG="${DOT_PRIVATE_PACMAN_REPO_CONFIG:-$DOT_PRIVATE_PACMAN_REPO_CONFIG_DEFAULT}"
DOT_PRIVATE_PACMAN_MAIN_CONFIG_DEFAULT='/etc/pacman.conf'
DOT_PRIVATE_PACMAN_MAIN_CONFIG="${DOT_PRIVATE_PACMAN_MAIN_CONFIG:-$DOT_PRIVATE_PACMAN_MAIN_CONFIG_DEFAULT}"

PRIVATE_PACKAGE_REPO_NAME=''
PRIVATE_PACKAGE_REPO_PATH=''
PRIVATE_PACKAGE_REPO_MIRROR_PATH=''
PRIVATE_PACKAGE_REPO_SIGLEVEL='Optional TrustAll'

DOT_PRIVATE_BROWSER_CHECKS_FILE_DEFAULT="$PRIVATE_DOTFILES/.dot-browser-checks"
DOT_PRIVATE_BROWSER_CHECKS_FILE="${DOT_PRIVATE_BROWSER_CHECKS_FILE:-$DOT_PRIVATE_BROWSER_CHECKS_FILE_DEFAULT}"

INIT_SELECTED_OMARCHY_BRANCH=''
INIT_RUN_BOOTSTRAP=0
INIT_INSTALL_PUBLIC_ARCH_PACKAGES=1
INIT_INSTALL_PRIVATE_ARCH_PACKAGES=1

if [[ -n "${FORCE_COLOR:-}" ]] || [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  DOT_RED=$'\033[31m'
  DOT_GREEN=$'\033[32m'
  DOT_YELLOW=$'\033[33m'
  DOT_BLUE=$'\033[34m'
  DOT_MAGENTA=$'\033[35m'
  DOT_CYAN=$'\033[36m'
  DOT_BOLD=$'\033[1m'
  DOT_DIM=$'\033[2m'
  DOT_RESET=$'\033[0m'
else
  DOT_RED=''
  DOT_GREEN=''
  DOT_YELLOW=''
  DOT_BLUE=''
  DOT_MAGENTA=''
  DOT_CYAN=''
  DOT_BOLD=''
  DOT_DIM=''
  DOT_RESET=''
fi

term_width() {
  local width="${COLUMNS:-88}"

  if ! [[ "$width" =~ ^[0-9]+$ ]]; then
    width=88
  fi

  if [[ "$width" -lt 48 ]]; then
    width=48
  elif [[ "$width" -gt 120 ]]; then
    width=120
  fi

  printf '%s\n' "$width"
}

log_divider() {
  local char="${1:--}"
  local color="${2:-$DOT_DIM}"
  local width="${3:-$(term_width)}"
  local line

  line=$(printf '%*s' "$width" '')
  line=${line// /$char}
  printf '%b%s%b\n' "$color" "$line" "$DOT_RESET"
}

log_label() {
  local color="$1"
  local level="$2"
  local message="$3"
  local stream="${4:-stdout}"

  if [[ "$stream" == 'stderr' ]]; then
    printf '%b%-8s%b %s\n' "${DOT_BOLD}${color}" "[$level]" "$DOT_RESET" "$message" >&2
  else
    printf '%b%-8s%b %s\n' "${DOT_BOLD}${color}" "[$level]" "$DOT_RESET" "$message"
  fi
}

log_header() {
  local title="$1"

  printf '\n'
  log_divider '=' "$DOT_BLUE"
  printf '%b%s%b\n' "${DOT_BOLD}${DOT_BLUE}" "  $title" "$DOT_RESET"
  log_divider '=' "$DOT_BLUE"
}

log_info() {
  log_label "$DOT_CYAN" 'INFO' "$*"
}

log_warn() {
  log_label "$DOT_YELLOW" 'WARN' "$*" 'stderr'
}

log_error() {
  log_label "$DOT_RED" 'ERROR' "$*" 'stderr'
}

log_section() {
  printf '\n'
  log_divider '-' "$DOT_DIM" 72
  printf '%b%s%b\n' "${DOT_BOLD}${DOT_MAGENTA}" "  $*" "$DOT_RESET"
}

display_path() {
  local path="$1"
  local home_prefix="${HOME%/}"

  if [[ "$path" == "$home_prefix"* ]]; then
    printf '~%s\n' "${path#$home_prefix}"
  else
    printf '%s\n' "$path"
  fi
}

log_context() {
  log_info "Public repo: $(display_path "$PUBLIC_DOTFILES")"
  log_info "Private repo: $(display_path "$PRIVATE_DOTFILES")"
  log_info "Notes repo: $(display_path "$NOTES_REPO_DIR")"
  log_info "Private mode: $PRIVATE_MODE"
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

is_truthy() {
  case "${1,,}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

array_contains() {
  local needle="$1"
  shift
  local item

  for item in "$@"; do
    if [[ "$item" == "$needle" ]]; then
      return 0
    fi
  done

  return 1
}

trim_whitespace() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s\n' "$value"
}

expand_home_path() {
  local path="$1"

  if [[ "$path" == '~' ]]; then
    printf '%s\n' "$HOME"
    return
  fi

  if [[ "$path" == '~/'* ]]; then
    printf '%s/%s\n' "$HOME" "${path:2}"
    return
  fi

  printf '%s\n' "$path"
}

is_interactive_terminal() {
  [[ -t 0 && -t 1 ]]
}

confirm_action() {
  local prompt="$1"
  local response=''

  if ! is_interactive_terminal; then
    return 1
  fi

  if has_cmd gum; then
    gum confirm "$prompt"
    return $?
  fi

  printf '%s [y/N] ' "$prompt" > /dev/tty
  if ! read -r response < /dev/tty; then
    return 1
  fi

  case "${response,,}" in
    y|yes)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Shared helpers — loaded from dot-lib
# ---------------------------------------------------------------------------
# shellcheck source=dot-lib
source "$(dirname "${BASH_SOURCE[0]}")/dot-lib"

# ---------------------------------------------------------------------------
# Private package management — lazy-loaded from dot-private-pkg-lib
# ---------------------------------------------------------------------------

_ensure_private_pkg_lib() {
  if [[ -z "${_DOT_PRIVATE_PKG_LIB_LOADED:-}" ]]; then
    # shellcheck source=dot-private-pkg-lib
    source "$(dirname "${BASH_SOURCE[0]}")/dot-private-pkg-lib"
    _DOT_PRIVATE_PKG_LIB_LOADED=1
  fi
}

install_aur_packages() {
  local confirm="${1:-false}"
  shift || true

  if [[ $# -eq 0 ]]; then
    return 0
  fi

  if ! has_cmd omarchy-pkg-aur-add; then
    log_warn 'Cannot install AUR packages automatically (omarchy-pkg-aur-add not found)'
    return 0
  fi

  if [[ "$confirm" == 'true' ]]; then
    log_warn '--confirm is ignored for omarchy-pkg-aur-add (it is non-interactive)'
  fi

  omarchy-pkg-aur-add "$@"
}

install_missing_public_arch_packages() {
  local confirm="${1:-false}"

  collect_missing_public_arch_packages

  if [[ "${#MISSING_PUBLIC_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    log_info 'Public Arch packages already installed'
    return 0
  fi

  if ! has_cmd omarchy-pkg-aur-add; then
    log_warn 'Cannot install missing public Arch packages automatically (omarchy-pkg-aur-add not found)'
    return 0
  fi

  log_info "Installing missing public Arch packages: ${MISSING_PUBLIC_ARCH_PACKAGES[*]}"
  install_aur_packages "$confirm" "${MISSING_PUBLIC_ARCH_PACKAGES[@]}"
}

PRIVATE_EXTRA_REPO_NAMES=()
PRIVATE_EXTRA_REPO_PATHS=()
PRIVATE_EXTRA_REPO_SCHEDULES=()

# ---------------------------------------------------------------------------
# Cron schedule matching — loaded from dot-cron-lib
# ---------------------------------------------------------------------------
# shellcheck source=dot-cron-lib
source "$(dirname "${BASH_SOURCE[0]}")/dot-cron-lib"

private_extra_repo_visible_now() {
  local index="$1"
  private_extra_repo_schedule_active "${PRIVATE_EXTRA_REPO_SCHEDULES[$index]:-}"
}

load_private_extra_repos() {
  local config_file="$PRIVATE_EXTRA_REPOS_FILE"
  local raw_line
  local line
  local repo_name
  local repo_path
  local repo_schedule

  PRIVATE_EXTRA_REPO_NAMES=()
  PRIVATE_EXTRA_REPO_PATHS=()
  PRIVATE_EXTRA_REPO_SCHEDULES=()

  if [[ ! -f "$config_file" ]] || [[ ! -r "$config_file" ]]; then
    return 0
  fi

  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    line="$(trim_whitespace "$raw_line")"
    [[ -z "$line" || "${line:0:1}" == '#' ]] && continue

    if [[ "$line" == *'|'* ]]; then
      IFS='|' read -r repo_name repo_path repo_schedule _ <<< "$line"
      repo_name="$(trim_whitespace "$repo_name")"
      repo_path="$(trim_whitespace "$repo_path")"
      repo_schedule="$(trim_whitespace "${repo_schedule:-}")"
    else
      repo_name=''
      repo_path="$line"
      repo_schedule=''
    fi

    [[ -z "$repo_path" ]] && continue
    repo_path="$(expand_home_path "$repo_path")"

    if [[ -z "$repo_name" ]]; then
      repo_name="$(basename -- "$repo_path")"
    fi

    [[ -z "$repo_name" ]] && continue

    PRIVATE_EXTRA_REPO_NAMES+=("$repo_name")
    PRIVATE_EXTRA_REPO_PATHS+=("$repo_path")
    PRIVATE_EXTRA_REPO_SCHEDULES+=("$repo_schedule")
  done <"$config_file"
}

# Refresh local tracking refs for the configured upstream branch.
fetch_repo_upstream() {
  local repo_dir="$1"
  local upstream_ref
  local remote_name
  local remote_branch
  local cache_key=''
  local cache_file=''
  local now
  local last_attempt=''
  local ttl_seconds="$DOT_FETCH_TTL_SECONDS"

  if ! git -C "$repo_dir" rev-parse '@{u}' >/dev/null 2>&1; then
    return 1
  fi

  upstream_ref="$(git -C "$repo_dir" rev-parse --abbrev-ref '@{u}' 2>/dev/null || true)"
  if [[ -z "$upstream_ref" || "$upstream_ref" != */* ]]; then
    return 1
  fi

  remote_name="${upstream_ref%%/*}"
  remote_branch="${upstream_ref#*/}"
  now="$(date +%s)"

  if [[ "$ttl_seconds" =~ ^[0-9]+$ ]] && (( ttl_seconds > 0 )); then
    mkdir -p "$DOT_FETCH_CACHE_DIR" >/dev/null 2>&1 || true
    cache_key="$(printf '%s\n%s\n' "$repo_dir" "$upstream_ref" | sha1sum | awk '{print $1}')"
    cache_file="$DOT_FETCH_CACHE_DIR/$cache_key"

    if [[ -r "$cache_file" ]]; then
      last_attempt="$(< "$cache_file")"
      if [[ "$last_attempt" =~ ^[0-9]+$ ]] && (( now - last_attempt < ttl_seconds )); then
        return 0
      fi
    fi
  fi

  if git -C "$repo_dir" fetch --quiet "$remote_name" "$remote_branch" >/dev/null 2>&1 \
    || git -C "$repo_dir" fetch --quiet "$remote_name" >/dev/null 2>&1; then
    if [[ -n "$cache_file" ]]; then
      printf '%s\n' "$now" > "$cache_file" 2>/dev/null || true
    fi
    return 0
  fi

  if [[ -n "$cache_file" ]]; then
    printf '%s\n' "$now" > "$cache_file" 2>/dev/null || true
  fi

  return 1
}

# Populates DIFF_ATTENTION_ISSUES and DIFF_ATTENTION_SEGMENTS (same rules as `dot diff --waybar`).
# When DIFF_ATTENTION_VERBOSE=1, logs the per-repo status as it is checked.
_diff_attention_scan_repo() {
  local name="$1"
  local path="$2"
  local dirty=0
  local ahead=0
  local behind=0
  local fetch_upstream="${3:-1}"
  local verbose="${DIFF_ATTENTION_VERBOSE:-0}"

  if ! git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if [[ "$verbose" == "1" ]]; then
      log_info "Checking ${name}: not a git repo (skipped) — $(display_path "$path")"
    fi
    return 0
  fi

  [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]] && dirty=1
  ahead=0
  behind=0
  local has_upstream=0
  if git -C "$path" rev-parse '@{u}' >/dev/null 2>&1; then
    has_upstream=1
    if [[ "$fetch_upstream" == "1" ]]; then
      fetch_repo_upstream "$path" || true
    fi
    ahead="$(git -C "$path" rev-list --count '@{u}..HEAD' 2>/dev/null || printf '0')"
    behind="$(git -C "$path" rev-list --count 'HEAD..@{u}' 2>/dev/null || printf '0')"
  fi

  if [[ "$verbose" == "1" ]]; then
    local -a parts=()
    [[ "${behind:-0}" -gt 0 ]] && parts+=("behind ${behind}")
    [[ "${ahead:-0}" -gt 0 ]] && parts+=("ahead ${ahead}")
    [[ "$dirty" -eq 1 ]] && parts+=("dirty")
    if [[ "${#parts[@]}" -eq 0 ]]; then
      if [[ "$has_upstream" -eq 1 ]]; then
        parts+=("up to date")
      else
        parts+=("clean (no upstream)")
      fi
    fi
    local status_str="${parts[0]}"
    local p_i
    for ((p_i = 1; p_i < ${#parts[@]}; p_i++)); do
      status_str+=", ${parts[$p_i]}"
    done
    log_info "Checking ${name}: ${status_str}"
  fi

  if [[ "$dirty" -eq 1 ]] || [[ "${ahead:-0}" -gt 0 ]] || [[ "${behind:-0}" -gt 0 ]]; then
    DIFF_ATTENTION_ISSUES=$((DIFF_ATTENTION_ISSUES + 1))
    DIFF_ATTENTION_SEGMENTS+=("$name")
    DIFF_ATTENTION_PATHS+=("$path")
    [[ "$dirty" -eq 1 ]] && DIFF_ATTENTION_HAS_DIRTY=1
    [[ "${ahead:-0}" -gt 0 ]] && DIFF_ATTENTION_HAS_AHEAD=1
    [[ "${behind:-0}" -gt 0 ]] && DIFF_ATTENTION_HAS_BEHIND=1
  fi

  return 0
}

# Sort PRIVATE_EXTRA_REPO_NAMES / PRIVATE_EXTRA_REPO_PATHS together by name.
sort_private_extra_repos() {
  [[ ${#PRIVATE_EXTRA_REPO_NAMES[@]} -le 1 ]] && return 0
  local -a sorted_names=()
  local -a sorted_paths=()
  local -a sorted_schedules=()
  local name path schedule
  while IFS=$'\t' read -r name path schedule; do
    sorted_names+=("$name")
    sorted_paths+=("$path")
    sorted_schedules+=("$schedule")
  done < <(
    local j
    for j in "${!PRIVATE_EXTRA_REPO_NAMES[@]}"; do
      printf '%s\t%s\t%s\n' "${PRIVATE_EXTRA_REPO_NAMES[$j]}" "${PRIVATE_EXTRA_REPO_PATHS[$j]}" "${PRIVATE_EXTRA_REPO_SCHEDULES[$j]}"
    done | sort
  )
  PRIVATE_EXTRA_REPO_NAMES=("${sorted_names[@]}")
  PRIVATE_EXTRA_REPO_PATHS=("${sorted_paths[@]}")
  PRIVATE_EXTRA_REPO_SCHEDULES=("${sorted_schedules[@]}")
}

diff_collect_attention() {
  diff_collect_attention_with_fetch 1
}

diff_collect_attention_with_fetch() {
  local fetch_upstream="${1:-1}"
  local public_name
  local private_name
  local notes_name
  local i

  DIFF_ATTENTION_ISSUES=0
  DIFF_ATTENTION_SEGMENTS=()
  DIFF_ATTENTION_PATHS=()
  DIFF_ATTENTION_HAS_DIRTY=0
  DIFF_ATTENTION_HAS_AHEAD=0
  DIFF_ATTENTION_HAS_BEHIND=0

  public_name="$(basename -- "${PUBLIC_DOTFILES%/}")"
  _diff_attention_scan_repo "$public_name" "$PUBLIC_DOTFILES" "$fetch_upstream"

  if can_use_private; then
    private_name="$(basename -- "${PRIVATE_DOTFILES%/}")"
    notes_name="$(basename -- "${NOTES_REPO_DIR%/}")"
    _diff_attention_scan_repo "$private_name" "$PRIVATE_DOTFILES" "$fetch_upstream"
    _diff_attention_scan_repo "$notes_name" "$NOTES_REPO_DIR" "$fetch_upstream"
  fi

  if is_truthy "$INCLUDE_OMARCHY_DIFF_REPOS"; then
    local om_i
    _ensure_omarchy_lib
    omarchy_collect_repo_targets
    for om_i in "${!OMARCHY_TARGET_PATHS[@]}"; do
      _diff_attention_scan_repo "${OMARCHY_TARGET_NAMES[$om_i]}" "${OMARCHY_TARGET_PATHS[$om_i]}" "$fetch_upstream"
    done
  fi

  if can_use_private; then
    load_private_extra_repos
    sort_private_extra_repos
    for i in "${!PRIVATE_EXTRA_REPO_PATHS[@]}"; do
      private_extra_repo_visible_now "$i" || continue
      _diff_attention_scan_repo "extra:${PRIVATE_EXTRA_REPO_NAMES[$i]}" "${PRIVATE_EXTRA_REPO_PATHS[$i]}" "$fetch_upstream"
    done
  fi
}

require_repo_dir() {
  local repo_dir="$1"
  local name="$2"

  if [[ ! -d "$repo_dir" ]]; then
    log_error "$name directory not found: $repo_dir"
    return 1
  fi
}

list_stow_folders() {
  local repo_dir="$1"
  local include_backup="${2:-false}"
  local dir
  local folder
  local host_suffix

  shopt -s nullglob
  for dir in "$repo_dir"/*/; do
    folder="${dir%/}"
    folder="${folder##*/}"

    if [[ "$include_backup" != "true" && "$folder" == "backup" ]]; then
      continue
    fi

    # Host-specific packages use double-dash: <name>--<host>
    # Skip packages that target a different OMARCHY_HOST
    if [[ "$folder" == *--* ]]; then
      host_suffix="${folder##*--}"
      if [[ "$host_suffix" != "${OMARCHY_HOST:-}" ]]; then
        continue
      fi
    fi

    printf '%s\n' "$folder"
  done
  shopt -u nullglob
}

stow_in_repo() {
  local repo_dir="$1"
  shift

  (
    cd "$repo_dir"
    stow "$@"
  )
}

workflow_watch_configured_hook_path() {
  git config --global --get core.hooksPath 2>/dev/null || true
}

workflow_watch_hooks_path_matches() {
  local configured_path
  local resolved_configured
  local resolved_expected

  configured_path="$(workflow_watch_configured_hook_path)"
  [[ -n "$configured_path" ]] || return 1

  resolved_configured="$(readlink -f "$configured_path" 2>/dev/null || printf '%s\n' "$configured_path")"
  resolved_expected="$(readlink -f "$DOT_WORKFLOW_WATCH_HOOKS_PATH" 2>/dev/null || printf '%s\n' "$DOT_WORKFLOW_WATCH_HOOKS_PATH")"
  [[ "$resolved_configured" == "$resolved_expected" ]]
}

workflow_watch_timer_is_enabled() {
  has_cmd systemctl || return 1
  systemctl --user is-enabled "$DOT_WORKFLOW_WATCH_TIMER_UNIT" >/dev/null 2>&1
}

workflow_watch_timer_is_active() {
  has_cmd systemctl || return 1
  systemctl --user is-active "$DOT_WORKFLOW_WATCH_TIMER_UNIT" >/dev/null 2>&1
}

workflow_watch_waybar_config_path() {
  local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/waybar"
  local host="${OMARCHY_HOST:-}"
  local host_config=''

  if [[ -n "$host" ]]; then
    host_config="$config_dir/config.${host}.jsonc"
    if [[ -f "$host_config" ]]; then
      printf '%s\n' "$host_config"
      return 0
    fi
  fi

  printf '%s\n' "$config_dir/config.jsonc"
}

# Walk a Waybar config file and its includes, calling $match_fn on each file.
# $match_fn receives the config_path as $1 and any extra args passed after it.
# Returns 0 as soon as $match_fn succeeds on any file.
_waybar_config_walk() {
  local match_fn="$1"
  local config_path="$2"
  shift 2
  local include_line=''
  local include_body=''
  local include_entry=''
  local include_path=''
  local config_dir=''

  [[ -f "$config_path" ]] || return 1
  if "$match_fn" "$config_path" "$@"; then
    return 0
  fi

  include_line="$(grep -E '"include"[[:space:]]*:' "$config_path" 2>/dev/null || true)"
  [[ -n "$include_line" ]] || return 1

  include_body="${include_line#*[}"
  include_body="${include_body%]*}"
  config_dir="$(dirname -- "$config_path")"

  IFS=',' read -r -a _waybar_walk_entries <<< "$include_body"
  unset IFS

  for include_entry in "${_waybar_walk_entries[@]}"; do
    include_entry="$(trim_whitespace "$include_entry")"
    include_entry="${include_entry#\"}"
    include_entry="${include_entry%\"}"
    include_path="${include_entry/#~/$HOME}"
    if [[ "$include_path" != /* ]]; then
      include_path="$config_dir/$include_path"
    fi
    if _waybar_config_walk "$match_fn" "$include_path" "$@"; then
      return 0
    fi
  done

  return 1
}

_waybar_match_contains() {
  local config_path="$1"
  local needle="$2"
  grep -Fq "$needle" "$config_path"
}

_waybar_match_orders_before() {
  local config_path="$1"
  local first="$2"
  local second="$3"
  local config_text
  config_text="$(tr -d '\n\r' < "$config_path")"
  [[ "$config_text" =~ ${first}[[:space:]]*,[[:space:]]*${second} ]]
}

workflow_watch_waybar_config_contains() {
  _waybar_config_walk _waybar_match_contains "$@"
}

workflow_watch_waybar_config_orders_before() {
  _waybar_config_walk _waybar_match_orders_before "$@"
}

configure_workflow_watch() {
  local hook_path="$DOT_WORKFLOW_WATCH_HOOKS_PATH"

  log_section 'Configure workflow watch'

  if ! has_cmd git; then
    log_warn 'Skipping workflow watch configuration (git not found)'
    return 0
  fi

  if [[ ! -d "$hook_path" ]]; then
    log_warn "Skipping workflow watch configuration (missing hooks path: $(display_path "$hook_path"))"
    return 0
  fi

  if workflow_watch_hooks_path_matches; then
    log_info "Workflow watch hooksPath already configured: $(display_path "$hook_path")"
  else
    git config --global core.hooksPath "$hook_path"
    log_info "Configured global git hooksPath: $(display_path "$hook_path")"
  fi

  if [[ ! -f "$DOT_WORKFLOW_WATCH_REPOS_FILE" ]]; then
    log_warn "Workflow watch repo list not found: $(display_path "$DOT_WORKFLOW_WATCH_REPOS_FILE")"
  else
    log_info "Workflow watch repo list: $(display_path "$DOT_WORKFLOW_WATCH_REPOS_FILE")"
  fi

  if has_cmd systemctl; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    if systemctl --user enable --now "$DOT_WORKFLOW_WATCH_TIMER_UNIT" >/dev/null 2>&1; then
      log_info "Enabled workflow watch timer: $DOT_WORKFLOW_WATCH_TIMER_UNIT"
    else
      log_warn "Could not enable workflow watch timer: $DOT_WORKFLOW_WATCH_TIMER_UNIT"
    fi
  else
    log_warn 'Skipping workflow watch timer enable (systemctl not found)'
  fi
}

configure_git_config_include() {
  local git_config_file="$HOME/.config/git/config"
  local git_include_path='~/.config/git/config.dotfiles'
  local git_config_dotfiles="$HOME/.config/git/config.dotfiles"

  if [[ ! -L "$git_config_dotfiles" && ! -f "$git_config_dotfiles" ]]; then
    log_warn "Stowed git config.dotfiles not found — run: dot stow"
    return 0
  fi

  if [[ -f "$git_config_file" ]] && grep -q "path = $git_include_path" "$git_config_file" 2>/dev/null; then
    log_info "Git config already includes managed dotfiles settings"
  else
    git config --global --add include.path "$git_include_path"
    log_info "Added git config include: $git_include_path"
  fi
}

# Mirror AGENTS.md into a Cursor user rule (.mdc with alwaysApply) so it is always-on context.
# Default output: private agents package at agents/.cursor/rules/global-agents.mdc (stows into ~/.cursor/rules/).
run_agents_sync() {
  local source="${DOT_AGENTS_SYNC_SOURCE:-$HOME/.config/opencode/AGENTS.md}"
  local dest
  local rule_dir
  local tmp
  local resolved

  if [[ -n "${DOT_AGENTS_SYNC_RULE_FILE:-}" ]]; then
    dest="$DOT_AGENTS_SYNC_RULE_FILE"
  elif [[ -d "$PRIVATE_DOTFILES/agents" ]]; then
    dest="$PRIVATE_DOTFILES/agents/.cursor/rules/global-agents.mdc"
  else
    dest="$HOME/.cursor/rules/global-agents.mdc"
  fi

  rule_dir="$(dirname -- "$dest")"

  if [[ ! -e "$source" ]]; then
    log_warn "agents-sync skipped (missing source): $(display_path "$source")"
    return 1
  fi

  if [[ ! -r "$source" ]]; then
    log_warn "agents-sync skipped (not readable): $(display_path "$source")"
    return 1
  fi

  resolved="$(readlink -f "$source" 2>/dev/null || printf '%s\n' "$source")"

  tmp="$(mktemp)" || {
    log_error 'agents-sync failed (mktemp)'
    return 1
  }

  {
    printf '%s\n' '---'
    printf '%s\n' 'description: Global agent instructions mirrored from AGENTS.md; refresh with dot agents-sync.'
    printf '%s\n' 'alwaysApply: true'
    printf '%s\n' '---'
    printf '\n'
    printf '%s\n' "<!-- dot agents-sync: source=$(display_path "$resolved") synced=$(date -Iseconds) -->"
    printf '\n'
    cat "$source"
  } >"$tmp" || {
    rm -f "$tmp"
    log_error 'agents-sync failed while writing temp file'
    return 1
  }

  if ! mkdir -p "$rule_dir"; then
    rm -f "$tmp"
    log_error "agents-sync failed (mkdir $(display_path "$rule_dir"))"
    return 1
  fi

  if mv -f "$tmp" "$dest"; then
    log_info "Wrote Cursor rule: $(display_path "$dest")"
    return 0
  fi

  rm -f "$tmp"
  log_error "agents-sync failed (mv to $(display_path "$dest"))"
  return 1
}

maybe_build_tui() {
  local tui_dir="$PUBLIC_DOTFILES/tui"
  if [[ ! -f "$tui_dir/package.json" ]]; then
    return 0
  fi
  if ! has_cmd bun; then
    log_warn 'Skipping TUI build (bun not found in PATH)'
    return 0
  fi
  log_section 'Build dot-tui'
  log_info "Building dot-tui: $(display_path "$tui_dir")"
  if (cd "$tui_dir" && bun install --frozen-lockfile 2>/dev/null && bun run build); then
    log_info 'dot-tui built successfully'
  else
    log_warn 'dot-tui build failed (non-fatal)'
  fi
}

maybe_agents_sync_after_update() {
  is_truthy "${DOT_AGENTS_SYNC_ON_UPDATE:-1}" || return 0
  log_section 'Agents rules sync'
  run_agents_sync || true
}

# Sync ~/.config/opencode/AGENTS.md durable block via dotfiles-private memory.js --update.
# soft=1: missing deps or node failure returns 0 (for dot update hook). soft=0: returns 1 on failure.
_dot_run_memory_js() {
  local soft="${1:-0}"
  local script="$PRIVATE_DOTFILES/agents/.config/opencode/plugins/memory.js"

  if [[ ! -f "$script" ]]; then
    log_warn "Skipping memory sync (missing $(display_path "$script"))"
    if [[ "$soft" -eq 1 ]]; then
      return 0
    fi
    return 1
  fi

  if ! has_cmd node; then
    log_warn 'Skipping memory sync (node not found in PATH)'
    if [[ "$soft" -eq 1 ]]; then
      return 0
    fi
    return 1
  fi

  log_info "OpenCode memory: node $(display_path "$script") --update"
  if (cd "$HOME" && node "$script" --update); then
    return 0
  fi

  log_warn 'Memory sync failed'
  if [[ "$soft" -eq 1 ]]; then
    return 0
  fi
  return 1
}

# @cmd memory — Refresh OpenCode durable memory
# @opt --soft — Quick refresh (used by dot update)
cmd_memory() {
  local soft=0
  if [[ "${1:-}" == '--soft' ]]; then
    soft=1
    shift
  fi

  log_section 'OpenCode memory sync'

  if ! can_use_private; then
    log_warn "Memory sync requires private dotfiles ($PRIVATE_REASON)"
    if [[ "$soft" -eq 1 ]]; then
      return 0
    fi
    return 1
  fi

  _dot_run_memory_js "$soft"
}

# @cmd opencode-debug — Run OpenCode debug paths/config/skill/info
# @opt --agent <name> — Inspect a specific agent
cmd_opencode_debug() {
  local agent_name=''
  local output=''
  local status=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)
        if [[ $# -lt 2 || -z "${2:-}" ]]; then
          log_error 'opencode-debug requires a value for --agent'
          return 1
        fi
        agent_name="$2"
        shift 2
        ;;
      -h|--help)
        printf 'Usage: %s opencode-debug [--agent <name>]\n' "$SCRIPT_NAME"
        printf '\n'
        printf 'Run useful OpenCode debug commands in one place.\n'
        return 0
        ;;
      *)
        log_error "Unknown opencode-debug option: $1"
        return 1
        ;;
    esac
  done

  log_section 'OpenCode debug'

  if ! has_cmd opencode; then
    log_error 'OpenCode command not found in PATH'
    return 1
  fi

  log_info 'Running: opencode debug paths'
  if ! opencode debug paths; then
    status=1
  fi

  log_info 'Running: opencode debug config'
  if ! opencode debug config; then
    status=1
  fi

  log_info 'Running: opencode debug skill'
  if ! opencode debug skill; then
    status=1
  fi

  log_info 'Running: opencode debug info'
  if ! opencode debug info; then
    status=1
  fi

  if [[ -n "$agent_name" ]]; then
    log_info "Running: opencode debug agent $agent_name"
    if ! opencode debug agent "$agent_name"; then
      status=1
    fi
  else
    if output="$(opencode agent list 2>/dev/null)" && [[ -n "$output" ]]; then
      log_info 'Tip: add --agent <name> to inspect one configured agent'
    fi
  fi

  return "$status"
}

maybe_memory_update_after_update() {
  is_truthy "${DOT_MEMORY_UPDATE_ON_UPDATE:-1}" || return 0
  "$DOT_SELF" memory --soft || true
}

track_updated_repo() {
  local repo_name="$1"

  array_contains "$repo_name" "${UPDATED_REPO_NAMES[@]}" && return 0
  UPDATED_REPO_NAMES+=("$repo_name")
}

maybe_notify_updated_repos() {
  local count="${#UPDATED_REPO_NAMES[@]}"
  local title=''
  local message=''
  local repo_name

  [[ "$count" -gt 0 ]] || return 0
  has_cmd notify-send || return 0

  if [[ "$count" -eq 1 ]]; then
    title='Git repo updated'
    message="${UPDATED_REPO_NAMES[0]} pulled new changes"
  else
    title='Git repos updated'
    message="${count} repos pulled new changes"
    for repo_name in "${UPDATED_REPO_NAMES[@]}"; do
      message+="\n- ${repo_name}"
    done
  fi

  notify-send "$title" "$message" >/dev/null 2>&1 || true
}

# Shared pull logic: clear stale lock (prompt if held), skip dirty trees, pull --rebase.
# Callers must validate repo_dir/.git exists and git is available before calling.
_git_clear_lock_and_pull() {
  local name="$1"
  local repo_dir="$2"

  # Remove stale index lock if present; prompt if held by a running process
  local lock_file="$repo_dir/.git/index.lock"
  if [[ -f "$lock_file" ]]; then
    if has_cmd fuser && fuser "$lock_file" >/dev/null 2>&1; then
      log_warn "Lock held by active git process for $name: $(display_path "$repo_dir")"
      printf '  Remove lock and continue anyway? [y/N] '
      local reply
      read -r reply
      if [[ "$reply" != [yY]* ]]; then
        log_info "Skipping $name pull (lock kept)"
        return 0
      fi
    fi
    log_warn "Removing stale lock for $name: $(display_path "$lock_file")"
    rm -f "$lock_file"
  fi

  if [[ -n "$(git -C "$repo_dir" status --porcelain 2>/dev/null || true)" ]]; then
    log_warn "Skipping $name pull (working tree not clean): $(display_path "$repo_dir")"
    return 0
  fi

  log_info "Pulling latest for $name: $(display_path "$repo_dir")"
  local before_head after_head
  before_head="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"
  if ! git -C "$repo_dir" pull --rebase; then
    log_warn "Pull failed for $name — aborting rebase and continuing: $(display_path "$repo_dir")"
    git -C "$repo_dir" rebase --abort 2>/dev/null || true
    return 0
  fi
  after_head="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"

  if [[ -n "$before_head" && -n "$after_head" && "$before_head" != "$after_head" ]]; then
    track_updated_repo "$name"
  fi
}

safe_pull_repo() {
  local name="$1"
  local repo_dir="$2"

  if [[ ! -e "$repo_dir/.git" ]]; then
    log_warn "Skipping $name pull (not a git repo): $(display_path "$repo_dir")"
    return 0
  fi

  if ! has_cmd git; then
    log_error "Git not found; cannot pull $name"
    return 1
  fi

  _git_clear_lock_and_pull "$name" "$repo_dir"
}

repo_current_branch() {
  local repo_dir="$1"
  git -C "$repo_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || true
}

repo_upstream_ref() {
  local repo_dir="$1"

  if git -C "$repo_dir" rev-parse '@{u}' >/dev/null 2>&1; then
    git -C "$repo_dir" rev-parse --abbrev-ref '@{u}' 2>/dev/null || true
  else
    printf '\n'
  fi
}

# ---------------------------------------------------------------------------
# Omarchy repo management — lazy-loaded from dot-omarchy-lib
# ---------------------------------------------------------------------------

_ensure_omarchy_lib() {
  if [[ -z "${_DOT_OMARCHY_LIB_LOADED:-}" ]]; then
    # shellcheck source=dot-omarchy-lib
    source "$(dirname "${BASH_SOURCE[0]}")/dot-omarchy-lib"
    _DOT_OMARCHY_LIB_LOADED=1
  fi
}

run_init_questionnaire() {
  INIT_SELECTED_OMARCHY_BRANCH="$OMARCHY_BRANCH"
  INIT_RUN_BOOTSTRAP=0
  INIT_INSTALL_PUBLIC_ARCH_PACKAGES=1
  INIT_INSTALL_PRIVATE_ARCH_PACKAGES=1

  _ensure_omarchy_lib

  if is_truthy "$INIT_NONINTERACTIVE" || ! is_interactive_terminal; then
    return 0
  fi

  if [[ -n "$INIT_SELECTED_OMARCHY_BRANCH" ]]; then
    log_info "Using preselected omarchy branch: $INIT_SELECTED_OMARCHY_BRANCH"
  elif has_cmd gum && has_cmd gh; then
    local branches
    branches="$(discover_omarchy_branches || true)"

    if [[ -n "$branches" ]]; then
      log_section 'Select omarchy branch'
      INIT_SELECTED_OMARCHY_BRANCH="$(printf '%s\n' "$branches" | gum choose --header 'Available branches')"
      log_info "Selected omarchy branch: $INIT_SELECTED_OMARCHY_BRANCH"
    else
      log_warn 'Could not discover omarchy branches; using current/default branches'
    fi
  else
    log_warn 'Skipping branch questionnaire (requires gum + gh)'
  fi

  if has_cmd gum; then
    if gum confirm 'Would you like to run bootstrap init now?'; then
      INIT_RUN_BOOTSTRAP=1
    fi
  fi

  collect_missing_public_arch_packages
  if [[ "${#MISSING_PUBLIC_ARCH_PACKAGES[@]}" -gt 0 ]]; then
    if confirm_action "Install missing public Arch packages (${MISSING_PUBLIC_ARCH_PACKAGES[*]}) now?"; then
      INIT_INSTALL_PUBLIC_ARCH_PACKAGES=1
    else
      INIT_INSTALL_PUBLIC_ARCH_PACKAGES=0
    fi
  fi

  _ensure_private_pkg_lib
  collect_missing_private_arch_packages
  if [[ "${#MISSING_PRIVATE_ARCH_PACKAGES[@]}" -gt 0 ]]; then
    if confirm_action "Install missing private Arch packages (${MISSING_PRIVATE_ARCH_PACKAGES[*]}) now?"; then
      INIT_INSTALL_PRIVATE_ARCH_PACKAGES=1
    else
      INIT_INSTALL_PRIVATE_ARCH_PACKAGES=0
    fi
  fi
}

run_bootstrap_init_if_requested() {
  local bootstrap_init="$OMARCHY_REPO_BASE/bootstrap/init.sh"

  if [[ "$INIT_RUN_BOOTSTRAP" != '1' ]]; then
    return 0
  fi

  if [[ ! -x "$bootstrap_init" ]]; then
    log_warn "Bootstrap init script not found/executable: $(display_path "$bootstrap_init")"
    return 0
  fi

  log_section 'Running bootstrap init'
  "$bootstrap_init"
}

show_repo_diffs() {
  local name="$1"
  local repo_dir="$2"
  local status_out
  local unstaged_out
  local staged_out
  local unpushed_out
  local unpulled_out

  if [[ ! -e "$repo_dir/.git" ]]; then
    log_warn "Skipping $name diff (not a git repo): $(display_path "$repo_dir")"
    return 0
  fi

  log_section "$name repo: $(display_path "$repo_dir")"

  status_out="$(cd "$repo_dir" && git status --short)"
  if [[ -n "$status_out" ]]; then
    log_info 'Git status:'
    printf '%s\n' "$status_out"
  else
    log_info 'Git status: clean'
  fi

  unstaged_out="$(cd "$repo_dir" && git diff --stat)"
  if [[ -n "$unstaged_out" ]]; then
    log_info 'Unstaged diff:'
    printf '%s\n' "$unstaged_out"
  else
    log_info 'Unstaged diff: none'
  fi

  staged_out="$(cd "$repo_dir" && git diff --cached --stat)"
  if [[ -n "$staged_out" ]]; then
    log_info 'Staged diff:'
    printf '%s\n' "$staged_out"
  else
    log_info 'Staged diff: none'
  fi

  if git -C "$repo_dir" rev-parse '@{u}' >/dev/null 2>&1; then
    fetch_repo_upstream "$repo_dir" || true

    unpushed_out="$(cd "$repo_dir" && git log '@{u}..HEAD' --oneline -20)"
    if [[ -n "$unpushed_out" ]]; then
      log_info 'Unpushed commits:'
      printf '%s\n' "$unpushed_out"
    else
      log_info 'Unpushed commits: none'
    fi

    unpulled_out="$(cd "$repo_dir" && git log 'HEAD..@{u}' --oneline -20)"
    if [[ -n "$unpulled_out" ]]; then
      log_info 'Unpulled commits:'
      printf '%s\n' "$unpulled_out"
    else
      log_info 'Unpulled commits: none'
    fi
  else
    log_info 'Unpushed / unpulled commits: no upstream configured'
  fi
}

# One-line JSON for Waybar (no log noise). Same repos as cmd_diff.
cmd_diff_status() {
  local fetch_upstream=1

  if [[ "${1:-}" == '--no-fetch' ]]; then
    fetch_upstream=0
  fi

  _diff_status_json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    printf '%s' "$s"
  }

  diff_collect_attention_with_fetch "$fetch_upstream"

  local text tooltip class json_tip only_extra_repos only_pulls_wanted only_extra_worktree_changes
  local issues="${DIFF_ATTENTION_ISSUES:-0}"
  local -a segments=("${DIFF_ATTENTION_SEGMENTS[@]}")

  if [[ "$issues" -eq 0 ]]; then
    text=''
    tooltip='All tracked repositories look up to date.'
    class='dots-ok'
  else
    text=" ${issues}"
    tooltip='Repositories with changes pending: '
    only_extra_repos=1
    only_pulls_wanted=1
    only_extra_worktree_changes=1
    local i=0
    local seg
    for seg in "${segments[@]}"; do
      [[ $i -gt 0 ]] && tooltip+='; '
      tooltip+="$seg"
      if [[ "$seg" != extra:* ]]; then
        only_extra_repos=0
      fi
      i=$((i + 1))
    done
    if [[ "$DIFF_ATTENTION_HAS_DIRTY" -eq 1 ]] || [[ "$DIFF_ATTENTION_HAS_AHEAD" -eq 1 ]] || [[ "$DIFF_ATTENTION_HAS_BEHIND" -ne 1 ]]; then
      only_pulls_wanted=0
    fi
    if [[ "$DIFF_ATTENTION_HAS_DIRTY" -ne 1 ]] || [[ "$DIFF_ATTENTION_HAS_AHEAD" -eq 1 ]] || [[ "$DIFF_ATTENTION_HAS_BEHIND" -eq 1 ]]; then
      only_extra_worktree_changes=0
    fi
    if [[ "$only_pulls_wanted" -eq 1 ]]; then
      class='dots-pull-only'
    elif [[ "$only_extra_repos" -eq 1 ]] && [[ "$only_extra_worktree_changes" -eq 1 ]]; then
      class='dots-extra-only'
    else
      class='dots-attention'
    fi
  fi

  json_tip="$(_diff_status_json_escape "$tooltip")"
  printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$text" "$json_tip" "$class"
}

# Output one "name|path" line per repo that currently has changes (dirty / ahead / behind).
cmd_diff_list_changed() {
  diff_collect_attention
  local i
  for i in "${!DIFF_ATTENTION_SEGMENTS[@]}"; do
    printf '%s|%s\n' "${DIFF_ATTENTION_SEGMENTS[$i]}" "${DIFF_ATTENTION_PATHS[$i]}"
  done
}

# Output one "name|path" line for every repo tracked by dot diff, in diff order.
# Only includes repos whose directories exist on this machine.
cmd_diff_list_all() {
  local p

  p="$PUBLIC_DOTFILES"
  [[ -d "$p" ]] && printf '%s|%s\n' "$(basename -- "${p%/}")" "$p"

  if can_use_private; then
    p="$PRIVATE_DOTFILES"
    [[ -d "$p" ]] && printf '%s|%s\n' "$(basename -- "${p%/}")" "$p"

    p="$NOTES_REPO_DIR"
    [[ -d "$p" ]] && printf '%s|%s\n' "$(basename -- "${p%/}")" "$p"
  fi

  if is_truthy "$INCLUDE_OMARCHY_DIFF_REPOS"; then
    _ensure_omarchy_lib
    omarchy_collect_repo_targets
    local om_i
    for om_i in "${!OMARCHY_TARGET_PATHS[@]}"; do
      p="${OMARCHY_TARGET_PATHS[$om_i]}"
      [[ -d "$p" ]] && printf '%s|%s\n' "${OMARCHY_TARGET_NAMES[$om_i]}" "$p"
    done
  fi

  if can_use_private; then
    load_private_extra_repos
    sort_private_extra_repos
    local i
    for i in "${!PRIVATE_EXTRA_REPO_PATHS[@]}"; do
      private_extra_repo_visible_now "$i" || continue
      p="${PRIVATE_EXTRA_REPO_PATHS[$i]}"
      [[ -d "$p" ]] && printf '%s|%s\n' "extra:${PRIVATE_EXTRA_REPO_NAMES[$i]}" "$p"
    done
  fi
}

can_use_private() {
  case "$PRIVATE_MODE" in
    always)
      PRIVATE_REASON='DOT_ALLOW_PRIVATE=always'
      return 0
      ;;
    never)
      PRIVATE_REASON='DOT_ALLOW_PRIVATE=never'
      return 1
      ;;
    auto)
      ;;
    *)
      log_warn "Unknown DOT_ALLOW_PRIVATE value '$PRIVATE_MODE', using auto"
      ;;
  esac

  if [[ ! -d "$PRIVATE_DOTFILES" || ! -r "$PRIVATE_DOTFILES" ]]; then
    PRIVATE_REASON="private repo not present/readable ($(display_path "$PRIVATE_DOTFILES"))"
    return 1
  fi

  if ! [[ -O "$PRIVATE_DOTFILES" ]]; then
    PRIVATE_REASON="private repo is not owned by current user ($(display_path "$PRIVATE_DOTFILES"))"
    return 1
  fi

  PRIVATE_REASON='private repo access granted'
  return 0
}

backup_public_files_for_install() {
  local backup_root="$PUBLIC_DOTFILES/backup"

  backup_item_for_install() {
    local source_path="$1"
    local backup_parent="$2"
    local source_name
    local backup_target

    if [[ ! -e "$source_path" ]]; then
      return 0
    fi

    if [[ -L "$source_path" ]]; then
      log_info "Skip backup for symlink target: $(display_path "$source_path")"
      return 0
    fi

    mkdir -p "$backup_parent"
    source_name="${source_path##*/}"
    backup_target="$backup_parent/$source_name"

    if [[ -e "$backup_target" ]]; then
      backup_target="$backup_parent/$source_name.$(date +%Y%m%d-%H%M%S)"
    fi

    log_info "Backup: $(display_path "$source_path") -> $(display_path "$backup_target")"
    mv "$source_path" "$backup_target"
  }

  if [[ -f "$HOME/.zshrc" ]]; then
    backup_item_for_install "$HOME/.zshrc" "$backup_root"
  fi

  if [[ -f "$HOME/.editorconfig" ]]; then
    backup_item_for_install "$HOME/.editorconfig" "$backup_root"
  fi

  if [[ -f "$HOME/.config/ghostty/config.toml" ]]; then
    backup_item_for_install "$HOME/.config/ghostty/config.toml" "$backup_root/.config/ghostty"
  fi

  if [[ -d "$HOME/.config/nvim" ]]; then
    backup_item_for_install "$HOME/.config/nvim" "$backup_root/.config"
  fi
}

# ---------------------------------------------------------------------------
# Unified stow operation: run_stow <mode> <scope>
#   mode:  install | stow | clean
#   scope: public  | private
# ---------------------------------------------------------------------------

install_private_agents() {
  local opencode_target="$HOME/.config/opencode/opencode.json"
  local backup_dir="$PRIVATE_DOTFILES/backup/opencode"

  if [[ -e "$opencode_target" && ! -L "$opencode_target" ]]; then
    mkdir -p "$backup_dir"
    log_info "Backup: $(display_path "$opencode_target") -> $(display_path "$backup_dir")"
    mv "$opencode_target" "$backup_dir/opencode.json.$(date +%Y%m%d-%H%M%S)"
  fi

  stow_in_repo "$PRIVATE_DOTFILES" \
    --no-folding \
    --ignore=node_modules \
    --ignore=package\.json \
    --ignore=bun\.lock \
    --ignore=\.gitignore \
    agents
}

_stow_agents_folder() {
  local mode="$1"
  local scope="$2"
  local repo_dir="$3"

  # Private install has a special backup-and-adopt flow
  if [[ "$scope" == 'private' && "$mode" == 'install' ]]; then
    install_private_agents
    return
  fi

  local -a extra_flags=(--no-folding)

  if [[ "$mode" == 'install' ]]; then
    extra_flags+=(--adopt)
  fi

  if [[ "$scope" == 'private' ]]; then
    extra_flags+=(
      --ignore=node_modules
      --ignore='package\.json'
      --ignore='bun\.lock'
      --ignore='\.gitignore'
    )
  fi

  stow_in_repo "$repo_dir" "${extra_flags[@]}" agents
}

run_stow() {
  local mode="$1"
  local scope="$2"
  local repo_dir label include_backup log_verb
  local -a folders
  local folder

  case "$scope" in
    public)  repo_dir="$PUBLIC_DOTFILES"; label='public dotfiles' ;;
    private) repo_dir="$PRIVATE_DOTFILES"; label='private dotfiles' ;;
  esac

  require_repo_dir "$repo_dir" "$label"

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  # Pre-install backup (public only)
  if [[ "$mode" == 'install' && "$scope" == 'public' ]]; then
    backup_public_files_for_install
  fi

  case "$mode" in
    install|stow) log_verb='stow'; include_backup=false ;;
    clean)        log_verb='remove'; include_backup=true ;;
  esac

  mapfile -t folders < <(list_stow_folders "$repo_dir" "$include_backup")
  for folder in "${folders[@]}"; do
    log_info "[$scope] $log_verb $folder (repo: $(display_path "$repo_dir"))"
    stow_in_repo "$repo_dir" -D "$folder"

    # Clean mode only unstows
    [[ "$mode" == 'clean' ]] && continue

    if [[ "$folder" == 'agents' ]]; then
      _stow_agents_folder "$mode" "$scope" "$repo_dir"
    elif [[ "$mode" == 'install' && "$scope" == 'public' ]]; then
      stow_in_repo "$repo_dir" --adopt "$folder"
    else
      stow_in_repo "$repo_dir" "$folder"
    fi
  done
}

install_public_dotfiles()  { run_stow install public; }
stow_public_dotfiles()     { run_stow stow    public; }
clean_public_dotfiles()    { run_stow clean   public; }
install_private_dotfiles() { run_stow install private; }
stow_private_dotfiles()    { run_stow stow    private; }
clean_private_dotfiles()   { run_stow clean   private; }

run_setup_packages() {
  local confirm=false
  local arg

  for arg in "$@"; do
    case "$arg" in
      --confirm)
        confirm=true
        ;;
      *)
        log_error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  if has_cmd stow; then
    log_info 'Skipping setup: stow already installed'
    return 0
  fi

  if ! has_cmd omarchy-pkg-add; then
    log_error 'Required command missing: omarchy-pkg-add (setup installs stow when absent)'
    return 1
  fi

  install_group() {
    local title="$1"
    shift

    log_section "$title"
    if [[ "$confirm" == 'true' ]]; then
      log_warn '--confirm is ignored for omarchy-pkg-add (it is non-interactive)'
    fi
    omarchy-pkg-add "$@"
  }

  install_group 'Init prerequisites (required)' stow

  printf '\n'
  log_info 'Installed init prerequisites only.'
}

run_init_public_package_installs() {
  local confirm=false

  if [[ "${INIT_INSTALL_PUBLIC_ARCH_PACKAGES:-1}" != '1' ]]; then
    collect_missing_public_arch_packages
    if [[ "${#MISSING_PUBLIC_ARCH_PACKAGES[@]}" -gt 0 ]]; then
      log_warn "Skipping public Arch package install (${MISSING_PUBLIC_ARCH_PACKAGES[*]})"
    else
      log_info 'Public Arch packages already installed'
    fi
    return 0
  fi

  if [[ "${#MISSING_PUBLIC_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    collect_missing_public_arch_packages
  fi

  if [[ "${#MISSING_PUBLIC_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    log_info 'Public Arch packages already installed'
    return 0
  fi

  if ! has_cmd omarchy-pkg-aur-add; then
    log_warn 'Skipping public Arch package install (omarchy-pkg-aur-add not found)'
    return 0
  fi

  if [[ "${1:-}" == '--confirm' ]]; then
    confirm=true
  fi

  log_section 'Install public Arch packages'
  install_missing_public_arch_packages "$confirm"
}

run_init_private_package_installs() {
  local confirm=false

  if ! can_use_private; then
    log_warn "Skipping private Arch package setup ($PRIVATE_REASON)"
    return 0
  fi

  _ensure_private_pkg_lib

  if ! load_private_package_repo_config; then
    log_warn "Skipping private Arch package install (missing config: $(display_path "$DOT_PRIVATE_PACKAGE_REPO_FILE"))"
    return 0
  fi

  log_section 'Sync private package repo mirror'
  sync_private_package_repo_mirror

  if ! private_package_repo_registered || ! private_package_repo_config_matches; then
    log_section 'Configure private pacman repo'
    ensure_private_package_repo_config
  fi

  if ! private_package_repo_include_registered; then
    log_section 'Register private pacman repo include'
    ensure_private_package_repo_include
  fi

  if ! private_package_repo_registered || ! private_package_repo_include_registered || ! private_package_repo_config_matches; then
    log_warn 'Skipping private Arch package install (private pacman repo is not configured for current user permissions)'
    return 0
  fi

  if [[ "${INIT_INSTALL_PRIVATE_ARCH_PACKAGES:-1}" != '1' ]]; then
    collect_missing_private_arch_packages
    if [[ "${#MISSING_PRIVATE_ARCH_PACKAGES[@]}" -gt 0 ]]; then
      log_warn "Skipping private Arch package install (${MISSING_PRIVATE_ARCH_PACKAGES[*]})"
    fi
    return 0
  fi

  if [[ "${#MISSING_PRIVATE_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    collect_missing_private_arch_packages
  fi

  if [[ "${#MISSING_PRIVATE_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    return 0
  fi

  if ! has_cmd omarchy-pkg-aur-add; then
    log_warn 'Skipping private Arch package install (omarchy-pkg-aur-add not found)'
    return 0
  fi

  if [[ "${1:-}" == '--confirm' ]]; then
    confirm=true
  fi

  log_section 'Install private Arch packages'
  install_missing_private_arch_packages "$confirm"
}

# @cmd init — Run questionnaire, sync omarchy repos, setup, install
# @opt --confirm — Pass through to setup (non-interactive package helpers)
# @opt --noninteractive — Skip questionnaire for this run
# @opt --interactive — Force questionnaire for this run
# @opt --branch <name> — Omarchy branch override for split repos (e.g. hypr)
# @opt --bootstrap-branch — Bootstrap repo branch override
cmd_init() {
  local -a sync_args=()
  local -a setup_args=()
  local branch_override=''
  local has_branch_override=0
  local setup_confirm=false
  local prev_noninteractive="$INIT_NONINTERACTIVE"
  local prev_omarchy_branch="$OMARCHY_BRANCH"

  log_section 'Initialization workflow'

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --confirm)
        setup_args+=("$1")
        setup_confirm=true
        ;;
      --noninteractive)
        INIT_NONINTERACTIVE=1
        ;;
      --interactive)
        INIT_NONINTERACTIVE=0
        ;;
      --branch)
        if [[ -z "${2:-}" ]]; then
          log_error '--branch requires a value'
          return 1
        fi
        branch_override="$2"
        has_branch_override=1
        sync_args+=("$1" "$2")
        shift
        ;;
      --branch=*)
        branch_override="${1#*=}"
        has_branch_override=1
        sync_args+=("$1")
        ;;
      --bootstrap-branch)
        if [[ -z "${2:-}" ]]; then
          log_error '--bootstrap-branch requires a value'
          return 1
        fi
        sync_args+=("$1" "$2")
        shift
        ;;
      --bootstrap-branch=*)
        sync_args+=("$1")
        ;;
      *)
        log_error "Unknown init option: $1"
        return 1
        ;;
    esac
    shift
  done

  if [[ -n "$branch_override" ]]; then
    OMARCHY_BRANCH="$branch_override"
  fi

  run_init_questionnaire

  if [[ -n "${INIT_SELECTED_OMARCHY_BRANCH:-}" && $has_branch_override -eq 0 ]]; then
    sync_args+=(--branch "$INIT_SELECTED_OMARCHY_BRANCH")
  fi

  _ensure_omarchy_lib
  omarchy_sync_repos "${sync_args[@]}"
  run_bootstrap_init_if_requested
  run_setup_packages "${setup_args[@]}"
  if [[ "$setup_confirm" == 'true' ]]; then
    run_init_public_package_installs --confirm
    run_init_private_package_installs --confirm
  else
    run_init_public_package_installs
    run_init_private_package_installs
  fi
  install_public_dotfiles
  configure_workflow_watch
  configure_git_config_include

  if can_use_private; then
    install_private_dotfiles
  else
    log_warn "Skipping private install ($PRIVATE_REASON)"
  fi

  INIT_NONINTERACTIVE="$prev_noninteractive"
  OMARCHY_BRANCH="$prev_omarchy_branch"
}

# @cmd update — Pull repos, stow dotfiles, rebuild TUI, run post-hooks
# @opt --pull — Pull all repos (dotfiles, private, notes, extra, omarchy)
# @opt --stow — Re-stow public/private dotfiles
# @opt --tui — Rebuild dot-tui binary
cmd_update() {
  local i
  local updated=0
  local has_flags=0
  local do_pull=0
  local do_stow=0
  local do_tui_build=0

  # Parse flags — inclusive: specifying any flag selects only those steps.
  # No flags = full update (all steps).
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pull)  do_pull=1; has_flags=1 ;;
      --stow)  do_stow=1; has_flags=1 ;;
      --tui)   do_tui_build=1; has_flags=1 ;;
      --help|-h)
        printf 'Usage: dot update [steps]\n\n'
        printf 'Without flags, runs a full update (pull, stow, tui build, hooks).\n'
        printf 'Specify one or more steps to run only those:\n\n'
        printf '  --pull      Pull all repos (dotfiles, private, notes, extra, omarchy)\n'
        printf '  --stow      Re-stow public/private dotfiles\n'
        printf '  --tui       Rebuild dot-tui binary\n\n'
        printf 'Post-hooks (agents-sync, memory, skills, notifications) run automatically\n'
        printf 'whenever repos are updated.\n'
        return 0
        ;;
      *)
        log_error "Unknown flag: $1"
        return 1
        ;;
    esac
    shift
  done

  # No flags = full update (all steps enabled)
  if [[ "$has_flags" -eq 0 ]]; then
    do_pull=1
    do_stow=1
    do_tui_build=1
  fi

  UPDATED_REPO_NAMES=()

  log_section 'Update workflow'

  # --- Pull repos (including omarchy) ---
  if [[ "$do_pull" -eq 1 ]]; then
    log_section 'Fetching and checking for updates'
    DIFF_ATTENTION_VERBOSE=1
    diff_collect_attention
    DIFF_ATTENTION_VERBOSE=0

    if [[ "$DIFF_ATTENTION_HAS_BEHIND" -eq 0 ]]; then
      if [[ "$DIFF_ATTENTION_HAS_DIRTY" -eq 1 ]] || [[ "$DIFF_ATTENTION_HAS_AHEAD" -eq 1 ]]; then
        local -a notes=()
        [[ "$DIFF_ATTENTION_HAS_DIRTY" -eq 1 ]] && notes+=('dirty working tree')
        [[ "$DIFF_ATTENTION_HAS_AHEAD" -eq 1 ]] && notes+=('ahead of upstream')
        local note_str="${notes[0]}"
        local n_i
        for ((n_i = 1; n_i < ${#notes[@]}; n_i++)); do
          note_str+=", ${notes[$n_i]}"
        done
        log_info "Nothing to pull (no repos behind upstream)"
        log_warn "${DIFF_ATTENTION_ISSUES} repo(s) need attention: ${note_str}"
        local s_i
        for s_i in "${!DIFF_ATTENTION_SEGMENTS[@]}"; do
          log_warn "  - ${DIFF_ATTENTION_SEGMENTS[$s_i]}: $(display_path "${DIFF_ATTENTION_PATHS[$s_i]}")"
        done
      else
        log_info 'All repositories are up to date'
      fi
    else
      log_info "${DIFF_ATTENTION_ISSUES} repo(s) need attention"

      if is_truthy "$INCLUDE_OMARCHY_UPDATE_REPOS"; then
        if _update_path_needs_pull_any_omarchy; then
          log_section 'Omarchy repo sync'
          omarchy_sync_repos
          updated=1
        fi
      fi

      if _update_path_needs_pull "$PUBLIC_DOTFILES"; then
        log_section 'Public repo pull'
        _update_pull_behind 'dotfiles' "$PUBLIC_DOTFILES"
        updated=1
      fi

      if can_use_private; then
        if _update_path_needs_pull "$PRIVATE_DOTFILES"; then
          log_section 'Private repo pull'
          _update_pull_behind 'dotfiles-private' "$PRIVATE_DOTFILES"
          updated=1
        fi

        _ensure_private_pkg_lib
        if load_private_package_repo_config; then
          log_section 'Sync private package repo mirror'
          sync_private_package_repo_mirror
        fi

        if _update_path_needs_pull "$NOTES_REPO_DIR"; then
          log_section 'Notes repo pull'
          _update_pull_behind 'notes' "$NOTES_REPO_DIR"
          updated=1
        fi

        load_private_extra_repos
        if [[ "${#PRIVATE_EXTRA_REPO_PATHS[@]}" -gt 0 ]]; then
          local pulled_extra=0
          for i in "${!PRIVATE_EXTRA_REPO_PATHS[@]}"; do
            if _update_path_needs_pull "${PRIVATE_EXTRA_REPO_PATHS[$i]}"; then
              [[ "$pulled_extra" -eq 0 ]] && log_section 'Additional private repo pulls'
              _update_pull_behind "extra:${PRIVATE_EXTRA_REPO_NAMES[$i]}" "${PRIVATE_EXTRA_REPO_PATHS[$i]}"
              pulled_extra=1
              updated=1
            fi
          done
        fi
      else
        log_warn "Skipping private and notes pull ($PRIVATE_REASON)"
      fi
    fi
  fi

  # --- Stow ---
  if [[ "$do_stow" -eq 1 ]]; then
    log_section 'Stow public dotfiles'
    stow_public_dotfiles
    configure_workflow_watch

    if can_use_private; then
      log_section 'Stow private dotfiles'
      stow_private_dotfiles
    fi
  fi

  # --- TUI build ---
  if [[ "$do_tui_build" -eq 1 ]]; then
    maybe_build_tui
  fi

  # --- Post-hooks (automatic when repos were updated) ---
  if [[ "$updated" -eq 1 ]]; then
    maybe_agents_sync_after_update
    maybe_memory_update_after_update
    maybe_notify_updated_repos
    _ensure_skill_updates_lib
    cmd_skill_updates --update
  fi

  if [[ "$updated" -eq 0 ]] && [[ "$do_stow" -eq 0 ]] && [[ "$do_tui_build" -eq 0 ]]; then
    log_info 'Nothing to do'
  fi
}

# Check if a repo path appears in the attention list (is behind or dirty).
_update_path_needs_pull() {
  local target="$1"
  local i
  for i in "${!DIFF_ATTENTION_PATHS[@]}"; do
    [[ "${DIFF_ATTENTION_PATHS[$i]}" == "$target" ]] && return 0
  done
  return 1
}

# Check if any omarchy target path needs pulling.
_update_path_needs_pull_any_omarchy() {
  _ensure_omarchy_lib
  omarchy_collect_repo_targets
  local om_i
  for om_i in "${!OMARCHY_TARGET_PATHS[@]}"; do
    if _update_path_needs_pull "${OMARCHY_TARGET_PATHS[$om_i]}"; then
      return 0
    fi
  done
  return 1
}

# Pull a repo that is known to be behind (fetch already done by diff_collect_attention).
_update_pull_behind() {
  _git_clear_lock_and_pull "$1" "$2"
}

# @cmd agents-sync — Run dot memory then write global-agents.mdc
cmd_agents_sync() {
  if is_truthy "${DOT_MEMORY_ON_AGENTS_SYNC:-1}"; then
    if ! cmd_memory; then
      log_warn 'dot memory failed; mirroring existing AGENTS.md to the Cursor rule'
    fi
  fi

  log_section 'Agents rules sync'
  if run_agents_sync; then
    log_info 'agents-sync finished'
  else
    log_warn 'agents-sync did not update the rule (see messages above)'
  fi
}

# ---------------------------------------------------------------------------
# dot skill-updates — lazy-loaded from dot-skill-updates-lib
# ---------------------------------------------------------------------------

_ensure_skill_updates_lib() {
  if [[ -z "${_DOT_SKILL_UPDATES_LIB_LOADED:-}" ]]; then
    # shellcheck source=dot-skill-updates-lib
    source "$(dirname "${BASH_SOURCE[0]}")/dot-skill-updates-lib"
    _DOT_SKILL_UPDATES_LIB_LOADED=1
  fi
}

# @cmd stow — Re-stow public/private dotfiles (no git pull)
# @opt --public — Stow public dotfiles only
# @opt --private — Stow private dotfiles only
cmd_stow() {
  local has_flags=0
  local do_public=0
  local do_private=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --public)  do_public=1; has_flags=1 ;;
      --private) do_private=1; has_flags=1 ;;
      --help|-h)
        printf 'Usage: dot stow [scope]\n\n'
        printf 'Without flags, stows both public and private dotfiles.\n'
        printf 'Specify one or more scopes to stow only those:\n\n'
        printf '  --public    Stow public dotfiles only\n'
        printf '  --private   Stow private dotfiles only\n'
        return 0
        ;;
      *)
        log_error "Unknown flag: $1"
        return 1
        ;;
    esac
    shift
  done

  if [[ "$has_flags" -eq 0 ]]; then
    do_public=1
    do_private=1
  fi

  log_section 'Stow workflow'

  if [[ "$do_public" -eq 1 ]]; then
    stow_public_dotfiles
  fi

  if [[ "$do_private" -eq 1 ]]; then
    if can_use_private; then
      stow_private_dotfiles
    else
      log_warn "Skipping private stow ($PRIVATE_REASON)"
    fi
  fi
}

# @cmd setup — Install packages
# @opt --confirm — Non-interactive mode (currently default)
cmd_setup() {
  run_setup_packages "$@"
}

# @cmd install — Backup/adopt and install public/private dotfiles
cmd_install() {
  log_section 'Install workflow'
  install_public_dotfiles
  configure_workflow_watch

  if can_use_private; then
    install_private_dotfiles
  else
    log_warn "Skipping private install ($PRIVATE_REASON)"
  fi
}

# @cmd clean — Unstow private then public dotfiles
cmd_clean() {
  log_section 'Clean workflow'
  if can_use_private; then
    clean_private_dotfiles
  else
    log_warn "Skipping private clean ($PRIVATE_REASON)"
  fi

  clean_public_dotfiles
}

# ---------------------------------------------------------------------------
# dot doctor — lazy-loaded from dot-doctor-lib
# ---------------------------------------------------------------------------

_ensure_doctor_lib() {
  if [[ -z "${_DOT_DOCTOR_LIB_LOADED:-}" ]]; then
    # shellcheck source=dot-doctor-lib
    source "$(dirname "${BASH_SOURCE[0]}")/dot-doctor-lib"
    _DOT_DOCTOR_LIB_LOADED=1
  fi
}

# @cmd diff — Open the diff/repo watcher TUI view
# @opt --raw — Original CLI per-repo status + diffs output
# @opt --waybar — One-line JSON for Waybar (same checks; no banners)
# @opt --list-changed — name|path lines for repos with changes
# @opt --list-all — name|path lines for all tracked repos
cmd_diff() {
  # Machine-readable and TUI modes bypass the header
  case "${1:-}" in
    --waybar)       shift; cmd_diff_status "$@"; return ;;
    --list-changed) cmd_diff_list_changed; return ;;
    --list-all)     cmd_diff_list_all; return ;;
    --raw)          shift ;;  # fall through to CLI diff
    *)
      # Default: launch TUI at the diff view
      if has_cmd dot-tui; then
        exec dot-tui diff "$@"
      fi
      # Fallback to CLI diff if TUI not available
      ;;
  esac

  # CLI diff (--raw or TUI fallback)
  if [[ -d "$PUBLIC_DOTFILES" ]]; then
    cd "$PUBLIC_DOTFILES"
  fi
  log_header 'dot diff'
  log_context

  local i
  local om_i

  log_section 'Diff workflow'
  show_repo_diffs 'public' "$PUBLIC_DOTFILES"

  if can_use_private; then
    show_repo_diffs 'private' "$PRIVATE_DOTFILES"
    show_repo_diffs 'notes' "$NOTES_REPO_DIR"
  else
    log_warn "Skipping private and notes diff ($PRIVATE_REASON)"
  fi

  if is_truthy "$INCLUDE_OMARCHY_DIFF_REPOS"; then
    log_section 'Omarchy repo diffs'
    _ensure_omarchy_lib
    omarchy_collect_repo_targets
    for om_i in "${!OMARCHY_TARGET_PATHS[@]}"; do
      show_repo_diffs "${OMARCHY_TARGET_NAMES[$om_i]}" "${OMARCHY_TARGET_PATHS[$om_i]}"
    done
  else
    log_warn "Skipping Omarchy repo diffs (DOT_INCLUDE_OMARCHY_DIFF_REPOS=$INCLUDE_OMARCHY_DIFF_REPOS)"
  fi

  if can_use_private; then
    load_private_extra_repos
    sort_private_extra_repos
    if [[ "${#PRIVATE_EXTRA_REPO_PATHS[@]}" -gt 0 ]]; then
      log_section 'Additional private repo diffs'
      for i in "${!PRIVATE_EXTRA_REPO_PATHS[@]}"; do
        if ! private_extra_repo_visible_now "$i"; then
          log_section "extra:${PRIVATE_EXTRA_REPO_NAMES[$i]} repo: $(display_path "${PRIVATE_EXTRA_REPO_PATHS[$i]}")"
          log_info "Skipping extra:${PRIVATE_EXTRA_REPO_NAMES[$i]} diff (outside schedule window: ${PRIVATE_EXTRA_REPO_SCHEDULES[$i]})"
          continue
        fi
        show_repo_diffs "extra:${PRIVATE_EXTRA_REPO_NAMES[$i]}" "${PRIVATE_EXTRA_REPO_PATHS[$i]}"
      done
    fi
  fi
}

# ---------------------------------------------------------------------------
# Help: auto-generated command list from @cmd / @opt tags
# ---------------------------------------------------------------------------

# Display order for commands in help output. Commands not listed here
# appear at the end in discovery order.
_HELP_CMD_ORDER=(
  init update stow tui diff doctor setup install clean
  memory agents-sync skill-updates opencode-debug
  setup-private-repo private-pkg-publish help
)

# Parse @cmd / @opt comment tags from all dot* scripts and print a
# formatted command listing.  Tags must appear on consecutive comment
# lines; the first non-comment / non-@opt line ends the option block.
#
# Tag format:
#   # @cmd <name> — <description>
#   # @opt <flag> — <description>
_help_print_commands() {
  local fmt_cmd='  %-24s%s\n'
  local fmt_opt='      %-20s%s\n'
  local script_dir
  script_dir="$(dirname "${BASH_SOURCE[0]}")"

  # --- collect tags --------------------------------------------------
  local -A cmd_descs=()
  local -A cmd_opts=()   # newline-separated "flag|desc" pairs
  local current_cmd=''

  local line
  while IFS= read -r line; do
    if [[ "$line" =~ ^[[:space:]]*#\ @cmd\ ([^—]+)—\ (.+)$ ]]; then
      current_cmd="${BASH_REMATCH[1]}"
      current_cmd="${current_cmd%"${current_cmd##*[![:space:]]}"}"   # rtrim
      cmd_descs["$current_cmd"]="${BASH_REMATCH[2]}"
      cmd_opts["$current_cmd"]=''
    elif [[ "$line" =~ ^[[:space:]]*#\ @opt\ ([^—]+)—\ (.+)$ && -n "$current_cmd" ]]; then
      local opt="${BASH_REMATCH[1]}"
      opt="${opt%"${opt##*[![:space:]]}"}"   # rtrim
      local desc="${BASH_REMATCH[2]}"
      [[ -n "${cmd_opts[$current_cmd]}" ]] && cmd_opts["$current_cmd"]+=$'\n'
      cmd_opts["$current_cmd"]+="${opt}|${desc}"
    elif [[ ! "$line" =~ ^[[:space:]]*# ]]; then
      current_cmd=''
    fi
  done < <(cat "$script_dir"/dot "$script_dir"/dot-*-lib 2>/dev/null)

  # --- print in order ------------------------------------------------
  local -A printed=()
  local name
  for name in "${_HELP_CMD_ORDER[@]}"; do
    [[ -z "${cmd_descs[$name]:-}" ]] && continue
    printf "$fmt_cmd" "$name" "${cmd_descs[$name]}"
    if [[ -n "${cmd_opts[$name]:-}" ]]; then
      while IFS='|' read -r opt desc; do
        printf "$fmt_opt" "$opt" "$desc"
      done <<< "${cmd_opts[$name]}"
    fi
    printf '\n'
    printed["$name"]=1
  done

  # Any discovered commands not in the order array
  for name in "${!cmd_descs[@]}"; do
    [[ -n "${printed[$name]:-}" ]] && continue
    printf "$fmt_cmd" "$name" "${cmd_descs[$name]}"
    if [[ -n "${cmd_opts[$name]:-}" ]]; then
      while IFS='|' read -r opt desc; do
        printf "$fmt_opt" "$opt" "$desc"
      done <<< "${cmd_opts[$name]}"
    fi
    printf '\n'
  done
}

# @cmd help — Show this help
cmd_help() {
  local fmt_env='  %-36s%s\n'

  printf 'Usage: %s [command] [args]\n\n' "$SCRIPT_NAME"
  printf 'Without a command, launches the TUI dashboard (dot-tui).\n\n'
  printf 'Commands:\n'
  _help_print_commands

  printf 'Environment:\n'
  printf "$fmt_env" 'DOTFILES_PUBLIC_DIR' 'Override public dotfiles path'
  printf "$fmt_env" 'DOTFILES_PRIVATE_DIR' 'Override private dotfiles path'
  printf "$fmt_env" 'DOT_NOTES_DIR' 'Notes vault git repo (default ~/Documents/notes)'
  printf "$fmt_env" 'DOT_PRIVATE_EXTRA_REPOS_FILE' 'Extra repos file for diff/update/doctor'
  printf "$fmt_env" 'DOT_ALLOW_PRIVATE' 'auto|always|never (default: auto)'
  printf "$fmt_env" 'DOT_PRIVATE_GH_USER' 'Expected gh username for private actions'
  printf "$fmt_env" 'OMARCHY_REPO_BASE_DIR' 'Base directory for omarchy repos (default: ~/.config)'
  printf "$fmt_env" 'DOT_OMARCHY_BRANCH' 'Branch override for split omarchy repos'
  printf "$fmt_env" 'DOT_BOOTSTRAP_BRANCH' 'Branch for bootstrap repo (default: distro/omarchy)'
  printf "$fmt_env" 'DOT_INCLUDE_OMARCHY_DIFF_REPOS' '1|0 include omarchy repos in diff (default: 1)'
  printf "$fmt_env" 'DOT_INCLUDE_OMARCHY_UPDATE_REPOS' '1|0 include omarchy repos in update (default: 1)'
  printf "$fmt_env" 'DOT_FETCH_TTL_SECONDS' 'Seconds to reuse last upstream fetch (default: 300)'
  printf "$fmt_env" 'DOT_INIT_NONINTERACTIVE' '1|0 skip init questionnaire (default: 0)'
  printf "$fmt_env" 'DOT_WORKFLOW_WATCH_HOOKS_PATH' 'Git hooksPath for workflow watch hooks'
  printf "$fmt_env" 'DOT_WORKFLOW_WATCH_REPOS_FILE' 'Watched GitHub repo list file'
  printf "$fmt_env" 'DOT_WORKFLOW_WATCH_TIMER_UNIT' 'Systemd timer for workflow polling'
  printf "$fmt_env" 'DOT_DOCTOR_STARTUP_TIMER_UNIT' 'Systemd timer for doctor startup notifications'
  printf "$fmt_env" 'DOT_DAILY_VOLUME_ZERO_TIMER_UNIT' 'Systemd timer for 5am volume reset'
  printf "$fmt_env" 'DOT_AGENTS_SYNC_SOURCE' 'Path to AGENTS.md to mirror'
  printf "$fmt_env" 'DOT_AGENTS_SYNC_RULE_FILE' 'Cursor rule file path for global-agents.mdc'
  printf "$fmt_env" 'DOT_AGENTS_SYNC_ON_UPDATE' '1|0 run agents-sync after update (default: 1)'
  printf "$fmt_env" 'DOT_MEMORY_UPDATE_ON_UPDATE' '1|0 run dot memory --soft after update (default: 1)'
  printf "$fmt_env" 'DOT_MEMORY_ON_AGENTS_SYNC' '1|0 run dot memory before agents-sync (default: 1)'
}

main() {
  local cmd="${1:-}"

  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    log_error 'Run dot as your regular user account (not as root)'
    return 1
  fi

  # No arguments — launch the TUI (fallback to help if not built)
  if [[ -z "$cmd" ]]; then
    if has_cmd dot-tui; then
      exec dot-tui
    else
      log_warn 'dot-tui not built — run dot update or: cd tui && bun run build'
      cmd_help
      return
    fi
  fi

  shift || true

  # @cmd tui — Launch the TUI dashboard (passes subcommands/flags through)
  # "tui" subcommand — pass through to dot-tui with remaining args
  if [[ "$cmd" == 'tui' ]]; then
    if has_cmd dot-tui; then
      exec dot-tui "$@"
    else
      log_warn 'dot-tui not built — run dot update or: cd tui && bun run build'
      cmd_help
      return 1
    fi
  fi

  # diff handles its own header/context (most modes bypass it)
  if [[ "$cmd" == 'diff' ]]; then
    cmd_diff "$@"
    return
  fi

  if [[ "$cmd" != 'help' && "$cmd" != '-h' && "$cmd" != '--help' ]]; then
    if [[ -d "$PUBLIC_DOTFILES" ]]; then
      cd "$PUBLIC_DOTFILES"
    fi

    log_header "dot $cmd"
    log_context
  fi

  case "$cmd" in
    init) cmd_init "$@" ;;
    update) cmd_update "$@" ;;
    stow) cmd_stow "$@" ;;
    setup) cmd_setup "$@" ;;
    install) cmd_install "$@" ;;
    clean) cmd_clean "$@" ;;
    doctor)
      _ensure_doctor_lib
      cmd_doctor "$@"
      ;;
    opencode-debug) cmd_opencode_debug "$@" ;;
    setup-private-repo)
      _ensure_private_pkg_lib
      cmd_setup_private_repo "$@"
      ;;
    private-pkg-publish)
      _ensure_private_pkg_lib
      cmd_private_pkg_publish "$@"
      ;;
    agents-sync) cmd_agents_sync "$@" ;;
    skill-updates)
      _ensure_skill_updates_lib
      cmd_skill_updates "$@"
      ;;
    memory) cmd_memory "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
      log_error "Unknown command: $cmd"
      cmd_help
      return 1
      ;;
  esac
}

main "$@"
