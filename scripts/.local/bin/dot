run_setup_packages() {
  local confirm=false
  local arg

  for arg in "$@"; do
    case "$arg" in
      --confirm)
        confirm=true
        ;;
      *)
        log_error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  if has_cmd stow; then
    log_info 'Skipping setup: stow already installed'
    return 0
  fi

  if ! has_cmd omarchy-pkg-add; then
    log_error 'Required command missing: omarchy-pkg-add (setup installs stow when absent)'
    return 1
  fi

  install_group() {
    local title="$1"
    shift

    log_section "$title"
    if [[ "$confirm" == 'true' ]]; then
      log_warn '--confirm is ignored for omarchy-pkg-add (it is non-interactive)'
    fi
    omarchy-pkg-add "$@"
  }

  install_group 'Init prerequisites (required)' stow

  printf '\n'
  log_info 'Installed init prerequisites only.'
}

run_init_public_package_installs() {
  local confirm=false

  if [[ "${INIT_INSTALL_PUBLIC_ARCH_PACKAGES:-1}" != '1' ]]; then
    collect_missing_public_arch_packages
    if [[ "${#MISSING_PUBLIC_ARCH_PACKAGES[@]}" -gt 0 ]]; then
      log_warn "Skipping public Arch package install (${MISSING_PUBLIC_ARCH_PACKAGES[*]})"
    else
      log_info 'Public Arch packages already installed'
    fi
    return 0
  fi

  if [[ "${#MISSING_PUBLIC_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    collect_missing_public_arch_packages
  fi

  if [[ "${#MISSING_PUBLIC_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    log_info 'Public Arch packages already installed'
    return 0
  fi

  if ! has_cmd omarchy-pkg-aur-add; then
    log_warn 'Skipping public Arch package install (omarchy-pkg-aur-add not found)'
    return 0
  fi

  if [[ "${1:-}" == '--confirm' ]]; then
    confirm=true
  fi

  log_section 'Install public Arch packages'
  install_missing_public_arch_packages "$confirm"
}

run_init_private_package_installs() {
  local confirm=false

  if ! can_use_private; then
    log_warn "Skipping private Arch package setup ($PRIVATE_REASON)"
    return 0
  fi

  if ! load_private_package_repo_config; then
    log_warn "Skipping private Arch package install (missing config: $(display_path "$DOT_PRIVATE_PACKAGE_REPO_FILE"))"
    return 0
  fi

  log_section 'Sync private package repo mirror'
  sync_private_package_repo_mirror

  if ! private_package_repo_registered || ! private_package_repo_config_matches; then
    log_section 'Configure private pacman repo'
    ensure_private_package_repo_config
  fi

  if ! private_package_repo_include_registered; then
    log_section 'Register private pacman repo include'
    ensure_private_package_repo_include
  fi

  if ! private_package_repo_registered || ! private_package_repo_include_registered || ! private_package_repo_config_matches; then
    log_warn 'Skipping private Arch package install (private pacman repo is not configured for current user permissions)'
    return 0
  fi

  if [[ "${INIT_INSTALL_PRIVATE_ARCH_PACKAGES:-1}" != '1' ]]; then
    collect_missing_private_arch_packages
    if [[ "${#MISSING_PRIVATE_ARCH_PACKAGES[@]}" -gt 0 ]]; then
      log_warn "Skipping private Arch package install (${MISSING_PRIVATE_ARCH_PACKAGES[*]})"
    fi
    return 0
  fi

  if [[ "${#MISSING_PRIVATE_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    collect_missing_private_arch_packages
  fi

  if [[ "${#MISSING_PRIVATE_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    return 0
  fi

  if ! has_cmd omarchy-pkg-aur-add; then
    log_warn 'Skipping private Arch package install (omarchy-pkg-aur-add not found)'
    return 0
  fi

  if [[ "${1:-}" == '--confirm' ]]; then
    confirm=true
  fi

  log_section 'Install private Arch packages'
  install_missing_private_arch_packages "$confirm"
}

cmd_init() {
  local -a sync_args=()
  local -a setup_args=()
  local branch_override=''
  local has_branch_override=0
  local setup_confirm=false
  local prev_noninteractive="$INIT_NONINTERACTIVE"
  local prev_omarchy_branch="$OMARCHY_BRANCH"

  log_section 'Initialization workflow'

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --confirm)
        setup_args+=("$1")
        setup_confirm=true
        ;;
      --noninteractive)
        INIT_NONINTERACTIVE=1
        ;;
      --interactive)
        INIT_NONINTERACTIVE=0
        ;;
      --branch)
        if [[ -z "${2:-}" ]]; then
          log_error '--branch requires a value'
          return 1
        fi
        branch_override="$2"
        has_branch_override=1
        sync_args+=("$1" "$2")
        shift
        ;;
      --branch=*)
        branch_override="${1#*=}"
        has_branch_override=1
        sync_args+=("$1")
        ;;
      --bootstrap-branch)
        if [[ -z "${2:-}" ]]; then
          log_error '--bootstrap-branch requires a value'
          return 1
        fi
        sync_args+=("$1" "$2")
        shift
        ;;
      --bootstrap-branch=*)
        sync_args+=("$1")
        ;;
      *)
        log_error "Unknown init option: $1"
        return 1
        ;;
    esac
    shift
  done

  if [[ -n "$branch_override" ]]; then
    OMARCHY_BRANCH="$branch_override"
  fi

  run_init_questionnaire

  if [[ -n "${INIT_SELECTED_OMARCHY_BRANCH:-}" && $has_branch_override -eq 0 ]]; then
    sync_args+=(--branch "$INIT_SELECTED_OMARCHY_BRANCH")
  fi

  omarchy_sync_repos "${sync_args[@]}"
  run_bootstrap_init_if_requested
  run_setup_packages "${setup_args[@]}"
  if [[ "$setup_confirm" == 'true' ]]; then
    run_init_public_package_installs --confirm
    run_init_private_package_installs --confirm
  else
    run_init_public_package_installs
    run_init_private_package_installs
  fi
  install_public_dotfiles
  configure_workflow_watch
  configure_git_config_include

  if can_use_private; then
    install_private_dotfiles
  else
    log_warn "Skipping private install ($PRIVATE_REASON)"
  fi

  INIT_NONINTERACTIVE="$prev_noninteractive"
  OMARCHY_BRANCH="$prev_omarchy_branch"
}

cmd_update() {
  local i
  local updated=0

  UPDATED_REPO_NAMES=()

  log_section 'Update workflow'

  # Fetch all repos and determine which are behind upstream.
  log_section 'Fetching and checking for updates'
  DIFF_ATTENTION_VERBOSE=1
  diff_collect_attention
  DIFF_ATTENTION_VERBOSE=0

  if [[ "$DIFF_ATTENTION_HAS_BEHIND" -eq 0 ]]; then
    if [[ "$DIFF_ATTENTION_HAS_DIRTY" -eq 1 ]] || [[ "$DIFF_ATTENTION_HAS_AHEAD" -eq 1 ]]; then
      local -a notes=()
      [[ "$DIFF_ATTENTION_HAS_DIRTY" -eq 1 ]] && notes+=('dirty working tree')
      [[ "$DIFF_ATTENTION_HAS_AHEAD" -eq 1 ]] && notes+=('ahead of upstream')
      local note_str="${notes[0]}"
      local n_i
      for ((n_i = 1; n_i < ${#notes[@]}; n_i++)); do
        note_str+=", ${notes[$n_i]}"
      done
      log_info "Nothing to pull (no repos behind upstream)"
      log_warn "${DIFF_ATTENTION_ISSUES} repo(s) need attention: ${note_str}"
      local s_i
      for s_i in "${!DIFF_ATTENTION_SEGMENTS[@]}"; do
        log_warn "  - ${DIFF_ATTENTION_SEGMENTS[$s_i]}: $(display_path "${DIFF_ATTENTION_PATHS[$s_i]}")"
      done
    else
      log_info 'All repositories are up to date'
    fi
    return 0
  fi

  log_info "${DIFF_ATTENTION_ISSUES} repo(s) need attention"

  if is_truthy "$INCLUDE_OMARCHY_UPDATE_REPOS"; then
    if _update_path_needs_pull_any_omarchy; then
      log_section 'Omarchy repo sync'
      omarchy_sync_repos
      updated=1
    fi
  fi

  if _update_path_needs_pull "$PUBLIC_DOTFILES"; then
    log_section 'Public repo pull'
    _update_pull_behind 'dotfiles' "$PUBLIC_DOTFILES"
    updated=1
  fi

  if can_use_private; then
    if _update_path_needs_pull "$PRIVATE_DOTFILES"; then
      log_section 'Private repo pull'
      _update_pull_behind 'dotfiles-private' "$PRIVATE_DOTFILES"
      updated=1
    fi

    if load_private_package_repo_config; then
      log_section 'Sync private package repo mirror'
      sync_private_package_repo_mirror
    fi

    if _update_path_needs_pull "$NOTES_REPO_DIR"; then
      log_section 'Notes repo pull'
      _update_pull_behind 'notes' "$NOTES_REPO_DIR"
      updated=1
    fi

    load_private_extra_repos
    if [[ "${#PRIVATE_EXTRA_REPO_PATHS[@]}" -gt 0 ]]; then
      local pulled_extra=0
      for i in "${!PRIVATE_EXTRA_REPO_PATHS[@]}"; do
        if _update_path_needs_pull "${PRIVATE_EXTRA_REPO_PATHS[$i]}"; then
          [[ "$pulled_extra" -eq 0 ]] && log_section 'Additional private repo pulls'
          _update_pull_behind "extra:${PRIVATE_EXTRA_REPO_NAMES[$i]}" "${PRIVATE_EXTRA_REPO_PATHS[$i]}"
          pulled_extra=1
          updated=1
        fi
      done
    fi
  else
    log_warn "Skipping private and notes pull ($PRIVATE_REASON)"
  fi

  if [[ "$updated" -eq 1 ]]; then
    log_section 'Stow public dotfiles'
    stow_public_dotfiles
    configure_workflow_watch

    if can_use_private; then
      log_section 'Stow private dotfiles'
      stow_private_dotfiles
    fi

    maybe_agents_sync_after_update
    maybe_memory_update_after_update
    maybe_notify_updated_repos
    cmd_skill_updates --update
  else
    log_info 'Nothing pulled; skipping stow'
  fi
}

# Check if a repo path appears in the attention list (is behind or dirty).
_update_path_needs_pull() {
  local target="$1"
  local i
  for i in "${!DIFF_ATTENTION_PATHS[@]}"; do
    [[ "${DIFF_ATTENTION_PATHS[$i]}" == "$target" ]] && return 0
  done
  return 1
}

# Check if any omarchy target path needs pulling.
_update_path_needs_pull_any_omarchy() {
  omarchy_collect_repo_targets
  local om_i
  for om_i in "${!OMARCHY_TARGET_PATHS[@]}"; do
    if _update_path_needs_pull "${OMARCHY_TARGET_PATHS[$om_i]}"; then
      return 0
    fi
  done
  return 1
}

# Pull a repo that is known to be behind (fetch already done by diff_collect_attention).
_update_pull_behind() {
  local name="$1"
  local repo_dir="$2"
  local before_head=''
  local after_head=''

  if [[ -n "$(git -C "$repo_dir" status --porcelain 2>/dev/null || true)" ]]; then
    log_warn "Skipping $name pull (working tree not clean): $(display_path "$repo_dir")"
    return 0
  fi

  log_info "Pulling latest for $name: $(display_path "$repo_dir")"
  before_head="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"
  git -C "$repo_dir" pull --rebase
  after_head="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"

  if [[ -n "$before_head" && -n "$after_head" && "$before_head" != "$after_head" ]]; then
    track_updated_repo "$name"
  fi
}

cmd_agents_sync() {
  if is_truthy "${DOT_MEMORY_ON_AGENTS_SYNC:-1}"; then
    if ! cmd_memory; then
      log_warn 'dot memory failed; mirroring existing AGENTS.md to the Cursor rule'
    fi
  fi

  log_section 'Agents rules sync'
  if run_agents_sync; then
    log_info 'agents-sync finished'
  else
    log_warn 'agents-sync did not update the rule (see messages above)'
  fi
}

# ---------------------------------------------------------------------------
# dot skill-updates — check imported skills for upstream changes
# ---------------------------------------------------------------------------

SKILLS_DIR="${PUBLIC_DOTFILES}/agents/.config/opencode/skills"

# Read the stored upstream-sha from a skill's SKILL.md frontmatter.
_skill_updates_stored_sha() {
  local skill_md="$1"
  awk 'NR==1 && /^---$/ { in_fm=1; next } in_fm && /^---$/ { exit } in_fm && /^# upstream-sha:/ { sub(/^# upstream-sha: */, ""); print; exit }' "$skill_md"
}

# Write or update the upstream-sha in a skill's SKILL.md frontmatter.
_skill_updates_write_sha() {
  local skill_md="$1" sha="$2"
  if grep -q '^# upstream-sha:' "$skill_md"; then
    sed -i "s|^# upstream-sha:.*|# upstream-sha: ${sha}|" "$skill_md"
  else
    # Insert after the # origin: line in frontmatter.
    sed -i "/^# origin:/a # upstream-sha: ${sha}" "$skill_md"
  fi
}

# Query the latest commit SHA that touched a path in a GitHub repo.
_skill_updates_upstream_sha() {
  local owner="$1" repo="$2" branch="$3" path="$4"
  local sha
  sha="$(gh api "repos/${owner}/${repo}/commits?path=${path}&per_page=1&sha=${branch}" \
    --jq '.[0].sha' 2>/dev/null)" || return 0
  # Validate: a commit SHA is exactly 40 hex chars.
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] && printf '%s' "$sha"
}

# Parse a GitHub tree URL into owner, repo, branch, and path components.
# Sets: _SU_OWNER, _SU_REPO, _SU_BRANCH, _SU_PATH
_skill_updates_parse_origin() {
  local url="$1"
  # https://github.com/{owner}/{repo}/tree/{branch}/{path...}
  if [[ "$url" =~ ^https://github\.com/([^/]+)/([^/]+)/tree/([^/]+)/(.+)$ ]]; then
    _SU_OWNER="${BASH_REMATCH[1]}"
    _SU_REPO="${BASH_REMATCH[2]}"
    _SU_BRANCH="${BASH_REMATCH[3]}"
    _SU_PATH="${BASH_REMATCH[4]}"
    return 0
  fi
  return 1
}

# Strip local-only frontmatter additions (# origin:, # upstream-sha:, # local-edits: block) from content.
_skill_updates_normalise_local() {
  sed '/^# origin:/d; /^# upstream-sha:/d; /^# local-edits:/d; /^#   - /d'
}

# Strip upstream-only frontmatter fields (metadata block, category, tags) from content.
_skill_updates_normalise_upstream() {
  awk '
    BEGIN { in_fm=0; skip_meta=0 }
    /^---$/ && !in_fm { in_fm=1; print; next }
    /^---$/ && in_fm  { in_fm=0; skip_meta=0; print; next }
    in_fm && /^metadata:/ { skip_meta=1; next }
    in_fm && skip_meta && /^  / { next }
    in_fm && skip_meta && !/^  / { skip_meta=0 }
    in_fm && /^category:/ { next }
    in_fm && /^tags:/ { skip_meta=1; next }
    { print }
  '
}

# Fetch a single file from GitHub via the API. Prints decoded content to stdout.
# Returns 1 on failure.
_skill_updates_fetch_file() {
  local owner="$1" repo="$2" branch="$3" filepath="$4"
  local content
  content="$(gh api "repos/${owner}/${repo}/contents/${filepath}?ref=${branch}" \
    --jq '.content' 2>/dev/null)" || return 1
  [[ -z "$content" ]] && return 1
  printf '%s' "$content" | base64 -d 2>/dev/null || return 1
}

# List files in an upstream skill directory (non-recursive, one level).
# Returns lines of "type name" (file SKILL.md, dir references, etc.)
_skill_updates_list_upstream_dir() {
  local owner="$1" repo="$2" branch="$3" dirpath="$4"
  gh api "repos/${owner}/${repo}/contents/${dirpath}?ref=${branch}" \
    --jq '.[] | "\(.type) \(.name)"' 2>/dev/null || return 1
}

# List all files in the upstream skill recursively.
# Prints relative paths (e.g. "SKILL.md", "references/CHOREOGRAPHY_PATTERNS.md").
_skill_updates_list_upstream_files() {
  local owner="$1" repo="$2" branch="$3" dirpath="$4"
  local line ftype fname
  while IFS= read -r line; do
    ftype="${line%% *}"
    fname="${line#* }"
    if [[ "$ftype" == 'file' ]]; then
      printf '%s\n' "$fname"
    elif [[ "$ftype" == 'dir' ]]; then
      local subline subtype subname
      while IFS= read -r subline; do
        subtype="${subline%% *}"
        subname="${subline#* }"
        if [[ "$subtype" == 'file' ]]; then
          printf '%s/%s\n' "$fname" "$subname"
        fi
      done < <(_skill_updates_list_upstream_dir "$owner" "$repo" "$branch" "${dirpath}/${fname}")
    fi
  done < <(_skill_updates_list_upstream_dir "$owner" "$repo" "$branch" "$dirpath")
}

# Apply the local frontmatter format to an upstream SKILL.md.
# Reads upstream content from stdin; writes normalised local content to stdout.
# Requires: skill_name, origin_url, local_description, upstream_sha (to preserve across updates).
_skill_updates_apply_frontmatter() {
  local skill_name="$1" origin_url="$2" local_description="$3" sha="$4"
  local line in_fm=0 past_fm=0 wrote_fm=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$past_fm" -eq 1 ]]; then
      printf '%s\n' "$line"
      continue
    fi
    if [[ "$line" == '---' && "$in_fm" -eq 0 ]]; then
      in_fm=1
      printf '%s\n' '---'
      continue
    fi
    if [[ "$line" == '---' && "$in_fm" -eq 1 ]]; then
      # End of upstream frontmatter; emit our local format
      if [[ "$wrote_fm" -eq 0 ]]; then
        printf 'name: %s\n' "$skill_name"
        printf 'description: %s\n' "$local_description"
        printf '# origin: %s\n' "$origin_url"
        [[ -n "$sha" ]] && printf '# upstream-sha: %s\n' "$sha"
        wrote_fm=1
      fi
      printf '%s\n' '---'
      past_fm=1
      in_fm=0
      continue
    fi
    # Skip upstream frontmatter lines (we rebuild it)
  done
}

# Check and optionally update a single imported skill.
# Returns 0 if up-to-date or updated, 1 on error.
# Check a single imported skill against upstream.
# $1 = skill directory, $2 = mode (check|interactive|update)
# Returns: 0 = up-to-date or applied, 1 = error,
#          2 = changes available (check/interactive), 3 = has local edits (needs manual review)
_skill_updates_check_skill() {
  local skill_dir="$1" mode="$2"
  local skill_name origin_url
  local skill_md="${skill_dir}/SKILL.md"

  skill_name="$(basename "$skill_dir")"

  # Extract origin URL from frontmatter.
  origin_url="$(awk 'NR==1 && /^---$/ { in_fm=1; next } in_fm && /^---$/ { exit } in_fm && /^# origin:/ { sub(/^# origin: */, ""); print; exit }' "$skill_md")"
  if [[ -z "$origin_url" ]]; then
    return 0 # No origin; skip silently.
  fi

  if ! _skill_updates_parse_origin "$origin_url"; then
    log_warn "  ${skill_name}: could not parse origin URL: ${origin_url}"
    return 1
  fi

  local owner="$_SU_OWNER" repo="$_SU_REPO" branch="$_SU_BRANCH" spath="$_SU_PATH"

  # Detect local edits.
  local local_edits
  local_edits="$(awk 'NR==1 && /^---$/ { in_fm=1; next } in_fm && /^---$/ { exit } in_fm && /^# local-edits:/ { show=1; next } in_fm && show && /^#   - / { sub(/^#   - /, ""); print; next } in_fm && show { show=0 }' "$skill_md")"
  local has_local_edits=0
  [[ -n "$local_edits" ]] && has_local_edits=1

  # Query upstream commit SHA (used for comparison and written after successful checks).
  local upstream_sha=''
  upstream_sha="$(_skill_updates_upstream_sha "$owner" "$repo" "$branch" "$spath")"

  # Compare upstream SHA against stored SHA in frontmatter to skip unchanged origins.
  if [[ -n "$upstream_sha" ]]; then
    local stored_sha
    stored_sha="$(_skill_updates_stored_sha "$skill_md")"
    if [[ "$upstream_sha" == "$stored_sha" ]]; then
      log_info "  ${skill_name}: up to date (cached)"
      return 0
    fi
  fi

  # List upstream files.
  local upstream_files
  upstream_files="$(_skill_updates_list_upstream_files "$owner" "$repo" "$branch" "$spath" 2>/dev/null)"
  if [[ -z "$upstream_files" ]]; then
    log_warn "  ${skill_name}: could not list upstream directory"
    return 1
  fi

  # Compare each file.
  local file has_changes=0 changes_summary='' local_file upstream_content
  local local_norm upstream_norm tmpdir
  tmpdir="$(mktemp -d)"

  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    local_file="${skill_dir}/${file}"

    upstream_content="$(_skill_updates_fetch_file "$owner" "$repo" "$branch" "${spath}/${file}" 2>/dev/null)"
    if [[ -z "$upstream_content" ]]; then
      log_warn "  ${skill_name}: could not fetch upstream ${file}"
      continue
    fi

    if [[ ! -f "$local_file" ]]; then
      # New upstream file.
      has_changes=1
      changes_summary+="    + ${file} (new upstream file)"$'\n'
      printf '%s' "$upstream_content" > "${tmpdir}/${file##*/}.upstream"
      continue
    fi

    # Normalise and compare.
    if [[ "$file" == 'SKILL.md' ]]; then
      local_norm="$(< "$local_file" _skill_updates_normalise_local)"
      upstream_norm="$(printf '%s' "$upstream_content" | _skill_updates_normalise_upstream)"
    else
      local_norm="$(< "$local_file")"
      upstream_norm="$upstream_content"
    fi

    if [[ "$local_norm" != "$upstream_norm" ]]; then
      has_changes=1
      local diff_lines
      diff_lines="$(diff --unified=2 \
        <(printf '%s\n' "$local_norm") \
        <(printf '%s\n' "$upstream_norm") \
        | tail -n +3 | head -20)" || true
      changes_summary+="    ~ ${file}"$'\n'
      if [[ -n "$diff_lines" ]]; then
        changes_summary+="${diff_lines}"$'\n'
      fi
    fi
  done <<< "$upstream_files"

  rm -rf "$tmpdir"

  if [[ "$has_changes" -eq 0 ]]; then
    [[ "$mode" != 'check' && -n "$upstream_sha" ]] && _skill_updates_write_sha "$skill_md" "$upstream_sha"
    log_info "  ${skill_name}: up to date"
    return 0
  fi

  # Report changes.
  printf '  %s: upstream changes detected\n' "$skill_name"

  # Show local-edits notes if present (explains expected diffs).
  if [[ "$has_local_edits" -eq 1 ]]; then
    printf '    [local edits — diffs expected, skipping auto-apply]\n'
    while IFS= read -r line; do
      printf '      - %s\n' "$line"
    done <<< "$local_edits"
  fi

  printf '%s' "$changes_summary"

  # Check-only mode: report and signal changes via exit code.
  if [[ "$mode" == 'check' ]]; then
    [[ "$has_local_edits" -eq 1 ]] && return 3
    return 2
  fi

  # Skills with local edits cannot be auto-applied; they need manual review.
  if [[ "$has_local_edits" -eq 1 ]]; then
    [[ -n "$upstream_sha" ]] && _skill_updates_write_sha "$skill_md" "$upstream_sha"
    log_info "  ${skill_name}: skipped (has local edits — review manually or via /check-skill-updates)"
    return 3
  fi

  # Determine whether to apply.
  local do_apply=0
  if [[ "$mode" == 'update' ]]; then
    do_apply=1
  else
    printf '  Apply update for %s? [y/N] ' "$skill_name"
    local reply
    read -r reply
    [[ "$reply" =~ ^[Yy] ]] && do_apply=1
  fi

  if [[ "$do_apply" -eq 0 ]]; then
    log_info "  ${skill_name}: skipped"
    return 2
  fi

  # Extract current local description (preserve it across updates).
  local local_description
  local_description="$(awk 'NR==1 && /^---$/ { in_fm=1; next } in_fm && /^---$/ { exit } in_fm && /^description:/ { sub(/^description: */, ""); print; exit }' "$skill_md")"

  # Apply updates.
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    local_file="${skill_dir}/${file}"

    upstream_content="$(_skill_updates_fetch_file "$owner" "$repo" "$branch" "${spath}/${file}")" || continue

    # Ensure parent directory exists for new files.
    mkdir -p "$(dirname "$local_file")"

    if [[ "$file" == 'SKILL.md' ]]; then
      printf '%s' "$upstream_content" \
        | _skill_updates_apply_frontmatter "$skill_name" "$origin_url" "$local_description" "$upstream_sha" \
        > "$local_file"
    else
      printf '%s' "$upstream_content" > "$local_file"
    fi
  done <<< "$upstream_files"

  [[ -n "$upstream_sha" ]] && _skill_updates_write_sha "$skill_md" "$upstream_sha"
  log_info "  ${skill_name}: updated"
  return 0
}

cmd_skill_updates() {
  local mode='interactive'
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --update) mode='update'; shift ;;
      --check)  mode='check'; shift ;;
      *) log_error "Unknown flag: $1"; return 1 ;;
    esac
  done

  log_section 'Skill origin updates'

  if ! command -v gh &>/dev/null; then
    log_warn 'gh CLI not available; skipping skill origin checks'
    return 0
  fi

  if [[ ! -d "$SKILLS_DIR" ]]; then
    log_info 'No skills directory found'
    return 0
  fi

  # Collect skills with origin annotations.
  local skill_dirs=() d
  for d in "${SKILLS_DIR}"/*/; do
    [[ -f "${d}SKILL.md" ]] || continue
    if awk 'NR==1 && /^---$/ { in_fm=1; next } in_fm && /^---$/ { exit } in_fm && /^# origin:/ { found=1; exit } END { exit !found }' "${d}SKILL.md" 2>/dev/null; then
      skill_dirs+=("${d%/}")
    fi
  done

  if [[ "${#skill_dirs[@]}" -eq 0 ]]; then
    log_info 'No imported skills with origin tracking'
    return 0
  fi

  log_info "Checking ${#skill_dirs[@]} imported skill(s) for upstream changes"

  local skill_dir errors=0 available=0 needs_review=0 rc
  local available_names=() review_names=() review_origins=()
  for skill_dir in "${skill_dirs[@]}"; do
    rc=0
    _skill_updates_check_skill "$skill_dir" "$mode" || rc=$?
    case "$rc" in
      1) errors=$((errors + 1)) ;;
      2) available=$((available + 1))
         available_names+=("$(basename "$skill_dir")") ;;
      3) needs_review=$((needs_review + 1))
         review_names+=("$(basename "$skill_dir")")
         review_origins+=("$(awk 'NR==1 && /^---$/ { in_fm=1; next } in_fm && /^---$/ { exit } in_fm && /^# origin:/ { sub(/^# origin: */, ""); print; exit }' "${skill_dir}/SKILL.md")") ;;
    esac
  done

  if [[ "$errors" -gt 0 ]]; then
    log_warn "${errors} skill(s) had errors during update check"
  fi

  if [[ "$mode" == 'check' ]]; then
    local total=$((available + needs_review))
    if [[ "$total" -gt 0 ]]; then
      log_info "${total} skill(s) have upstream updates available"
      return 1
    fi
    return 0
  fi

  # Interactive mode: generate a paste-ready agent report at the end.
  if [[ "$mode" == 'interactive' ]]; then
    local has_report=0

    if [[ "$available" -gt 0 ]]; then
      has_report=1
      printf '\n'
      log_section 'Agent report — clean updates'
      printf 'Paste into an agent session to apply:\n\n'
      printf '```\n'
      printf '/check-skill-updates\n'
      printf '\n'
      printf 'The following skills have clean upstream updates (no local edits).\n'
      printf 'Run dot skill-updates --update to apply all, then dot stow.\n'
      printf '\n'
      local s
      for s in "${available_names[@]}"; do
        printf 'Update available: %s\n' "$s"
      done
      printf '```\n'
    fi

    if [[ "$needs_review" -gt 0 ]]; then
      has_report=1
      printf '\n'
      log_section 'Agent report — skills with local edits'
      printf 'These skills have local edits and cannot be auto-updated.\n'
      printf 'Paste into an agent session to review and selectively merge:\n\n'
      printf '```\n'
      printf 'The following imported skills have upstream changes but also have\n'
      printf 'local edits that prevent automatic updates. For each skill, fetch\n'
      printf 'the upstream version, compare against local, and present what\n'
      printf 'changed upstream so I can decide what to merge.\n'
      printf '\n'
      local i
      for i in "${!review_names[@]}"; do
        printf 'Skill: %s\n' "${review_names[$i]}"
        printf 'Origin: %s\n' "${review_origins[$i]}"
        printf '\n'
      done
      printf '```\n'
    fi

    if [[ "$has_report" -eq 0 && "$errors" -eq 0 ]]; then
      log_info 'All imported skills are up to date'
    fi
  fi
}

cmd_stow() {
  log_section 'Stow workflow'
  stow_public_dotfiles

  if can_use_private; then
    stow_private_dotfiles
  else
    log_warn "Skipping private stow ($PRIVATE_REASON)"
  fi
}

cmd_setup() {
  run_setup_packages "$@"
}

cmd_install() {
  log_section 'Install workflow'
  install_public_dotfiles
  configure_workflow_watch

  if can_use_private; then
    install_private_dotfiles
  else
    log_warn "Skipping private install ($PRIVATE_REASON)"
  fi
}

cmd_clean() {
  log_section 'Clean workflow'
  if can_use_private; then
    clean_private_dotfiles
  else
    log_warn "Skipping private clean ($PRIVATE_REASON)"
  fi

  clean_public_dotfiles
}

cmd_doctor() {
  local issues=0
  local warnings=0
  local status=0
  local summary_message
  local summary_section
  local doctor_current_section='General'
  local -a doctor_warning_messages=()
  local -a doctor_warning_sections=()
  local -a doctor_error_messages=()
  local -a doctor_error_sections=()
  local -a doctor_missing_aur_packages=()
  local -a doctor_switch_aur_packages=()
  local -a doctor_update_aur_packages=()
  local -a doctor_missing_private_packages=()

  doctor_log_section() {
    doctor_current_section="$1"
    log_section "$doctor_current_section"
  }

  doctor_warn() {
    local message="$*"
    doctor_warning_sections+=("$doctor_current_section")
    doctor_warning_messages+=("$message")
    warnings=$((warnings + 1))
  }

  doctor_error() {
    local message="$*"
    doctor_error_sections+=("$doctor_current_section")
    doctor_error_messages+=("$message")
    issues=$((issues + 1))
  }

  doctor_summary_warn() {
    log_label "$DOT_YELLOW" 'WARN' "$*"
  }

  doctor_summary_error() {
    log_label "$DOT_RED" 'ERROR' "$*"
  }

  doctor_summary_section() {
    printf '%b%s%b\n' "${DOT_BOLD}${DOT_BLUE}" "  $*" "$DOT_RESET"
  }

  print_grouped_doctor_messages() {
    local kind="$1"
    local current_section=''
    local i

    case "$kind" in
      error)
        [[ "${#doctor_error_messages[@]}" -gt 0 ]] || return 0
        doctor_log_section 'Collected Errors'
        for i in "${!doctor_error_messages[@]}"; do
          summary_section="${doctor_error_sections[$i]}"
          summary_message="${doctor_error_messages[$i]}"
          if [[ "$summary_section" != "$current_section" ]]; then
            current_section="$summary_section"
            doctor_summary_section "$current_section"
          fi
          doctor_summary_error "$summary_message"
        done
        ;;
      warning)
        [[ "${#doctor_warning_messages[@]}" -gt 0 ]] || return 0
        doctor_log_section 'Collected Warnings'
        for i in "${!doctor_warning_messages[@]}"; do
          summary_section="${doctor_warning_sections[$i]}"
          summary_message="${doctor_warning_messages[$i]}"
          if [[ "$summary_section" != "$current_section" ]]; then
            current_section="$summary_section"
            doctor_summary_section "$current_section"
          fi
          doctor_summary_warn "$summary_message"
        done
        ;;
    esac
  }

  report_package_status() {
    local package_name="$1"
    local display_name
    local installed_name=''
    local installed_version=''
    local latest_aur_version=''

    display_name="$(public_arch_package_label "$package_name")"
    installed_name="$(public_arch_installed_package_name "$package_name")"

    if public_arch_package_present "$package_name"; then
      log_info "$display_name is installed"

      installed_version="$(public_arch_installed_version "$package_name" "$installed_name" 2>/dev/null || true)"
      latest_aur_version="$(public_arch_latest_aur_version "$package_name" 2>/dev/null || true)"

      if [[ -n "$installed_name" && "$installed_name" != "$package_name" ]]; then
        doctor_warn "$installed_name is installed instead of canonical AUR package $package_name"
        if [[ -n "$latest_aur_version" ]]; then
          doctor_warn "Latest AUR version for $package_name: $latest_aur_version"
        fi
        doctor_switch_aur_packages+=("$package_name")
        doctor_warn 'Keep the local package only if you intentionally want to override the AUR package on this machine'
      elif [[ -n "$installed_version" && -n "$latest_aur_version" && "$installed_version" != "$latest_aur_version" ]]; then
        doctor_warn "$package_name version differs from latest AUR ($installed_version installed, $latest_aur_version latest)"
        doctor_update_aur_packages+=("$package_name")
      fi
    else
      doctor_warn "$display_name is missing"
      doctor_missing_aur_packages+=("$package_name")
    fi
  }

  report_private_package_repo_status() {
    if ! can_use_private; then
      doctor_warn "Skipping private package repo checks ($PRIVATE_REASON)"
      return 0
    fi

    if ! load_private_package_repo_config; then
      doctor_warn "Missing private package repo config: $(display_path "$DOT_PRIVATE_PACKAGE_REPO_FILE")"
      return 0
    fi

    if [[ ! -d "$PRIVATE_PACKAGE_REPO_PATH" ]]; then
      doctor_warn "Missing private package repo clone: $(display_path "$PRIVATE_PACKAGE_REPO_PATH")"
    fi

    if [[ ! -d "$PRIVATE_PACKAGE_REPO_MIRROR_PATH" ]]; then
      doctor_warn "Missing private package repo mirror: $(display_path "$PRIVATE_PACKAGE_REPO_MIRROR_PATH")"
      doctor_warn 'Run dot init to sync the private package repo mirror'
      return 0
    fi

    if ! private_package_repo_registered; then
      doctor_warn "Private pacman repo is not configured in $(display_path "$DOT_PRIVATE_PACMAN_REPO_CONFIG")"
      doctor_warn 'Run dot init to configure the private pacman repo'
      return 0
    fi

    if ! private_package_repo_include_registered; then
      doctor_warn "Private pacman repo include is missing from $(display_path "$DOT_PRIVATE_PACMAN_MAIN_CONFIG")"
      doctor_warn 'Run dot init to add the private pacman repo include'
      return 0
    fi

    if ! private_package_repo_config_matches; then
      doctor_warn "Private pacman repo config differs from expected contents: $(display_path "$DOT_PRIVATE_PACMAN_REPO_CONFIG")"
      doctor_warn 'Run dot init to rewrite the private pacman repo config'
      return 0
    fi

    log_info "Private pacman repo is configured ($(display_path "$DOT_PRIVATE_PACMAN_REPO_CONFIG"))"
  }

  report_private_package_status() {
    local package_name="$1"
    local installed_version=''
    local repo_version=''

    if package_installed "$package_name"; then
      log_info "$package_name is installed"
      installed_version="$(pacman -Q "$package_name" 2>/dev/null | awk '{ print $2 }')"
      if private_package_repo_registered && private_package_repo_config_matches; then
        repo_version="$(private_arch_repo_latest_version "$package_name" 2>/dev/null || true)"
      fi

      if [[ -n "$installed_version" && -n "$repo_version" && "$installed_version" != "$repo_version" ]]; then
        doctor_warn "$package_name version differs from private repo ($installed_version installed, $repo_version latest)"
      fi
    else
      doctor_warn "$package_name is missing"
      doctor_missing_private_packages+=("$package_name")
    fi
  }

  report_chromium_extension_status() {
    local extension_label="$1"
    local install_hint="$2"
    local checker="$3"
    local profile_dir="$4"
    shift 4

    if [[ ! -d "$profile_dir" ]]; then
      doctor_warn "Chromium profile not found: $(display_path "$profile_dir")"
      return 0
    fi

    if "$checker" "$profile_dir" "$@"; then
      log_info "$extension_label is installed in $(display_path "$profile_dir")"
    else
      doctor_warn "$extension_label is missing from $(display_path "$profile_dir")"
      doctor_warn "$install_hint"
    fi
  }

  report_opencode_location_status() {
    local legacy_path
    local canonical_path
    local legacy_source
    local legacy_target
    local singular_name
    local found_legacy=false

    log_info 'OpenCode documented global resources live under ~/.config/opencode'

    local -a opencode_resource_names=(AGENTS.md agents commands skills plugins rules)
    for legacy_path in "${opencode_resource_names[@]}"; do
      canonical_path="$HOME/.config/opencode/$legacy_path"
      legacy_path="$HOME/.opencode/$legacy_path"

      if [[ -e "$canonical_path" || -L "$canonical_path" ]]; then
        log_info "OpenCode canonical path exists: $(display_path "$canonical_path")"
      else
        doctor_warn "OpenCode canonical path missing: $(display_path "$canonical_path")"
      fi

      if [[ -e "$legacy_path" || -L "$legacy_path" ]]; then
        found_legacy=true
        if [[ -L "$legacy_path" ]]; then
          legacy_target="$(readlink "$legacy_path" 2>/dev/null || true)"
          doctor_warn "Legacy OpenCode path still exists: $(display_path "$legacy_path") -> $legacy_target"
        else
          doctor_warn "Legacy OpenCode path still exists: $(display_path "$legacy_path")"
        fi
        doctor_warn "Move/remove legacy OpenCode resources after confirming $(display_path "$canonical_path") is correct"
      fi
    done

    local -a opencode_legacy_singular_names=(agent command skill plugin rule)
    for singular_name in "${opencode_legacy_singular_names[@]}"; do
      for legacy_path in "$HOME/.config/opencode/$singular_name" "$HOME/.opencode/$singular_name"; do
        if [[ -e "$legacy_path" || -L "$legacy_path" ]]; then
          found_legacy=true
          if [[ -L "$legacy_path" ]]; then
            legacy_target="$(readlink "$legacy_path" 2>/dev/null || true)"
            doctor_warn "Legacy OpenCode singular path still exists: $(display_path "$legacy_path") -> $legacy_target"
          else
            doctor_warn "Legacy OpenCode singular path still exists: $(display_path "$legacy_path")"
          fi
          doctor_warn 'Remove legacy singular OpenCode paths after confirming the plural ~/.config/opencode/* resources are correct'
        fi
      done
    done

    for legacy_source in \
      "$PUBLIC_DOTFILES/agents/.opencode" \
      "$PRIVATE_DOTFILES/agents/.opencode"
    do
      if [[ -e "$legacy_source" || -L "$legacy_source" ]]; then
        found_legacy=true
        doctor_warn "Legacy OpenCode stow source still exists: $(display_path "$legacy_source")"
        doctor_warn 'Use agents/.config/opencode in the public/private dotfiles repos instead'
      fi
    done

    if [[ "$found_legacy" == false ]]; then
      log_info 'No legacy OpenCode resource paths found under ~/.opencode or stow sources'
    fi
  }

  doctor_log_section 'Dependency checks'

  require_cmd() {
    local cmd="$1"
    local purpose="$2"
    if has_cmd "$cmd"; then
      log_info "$cmd is available ($purpose)"
    else
      doctor_error "$cmd is missing ($purpose)"
    fi
  }

  optional_cmd() {
    local cmd="$1"
    local purpose="$2"
    if has_cmd "$cmd"; then
      log_info "$cmd is available ($purpose)"
    else
      doctor_warn "$cmd is missing ($purpose)"
    fi
  }

  require_cmd git 'repo sync/diff'
  require_cmd stow 'dotfile linking'
  require_cmd bash 'dot runtime'
  optional_cmd omarchy-pkg-add 'dot setup installs stow when missing'
  optional_cmd omarchy-pkg-aur-add 'dot init installs missing AUR packages'
  optional_cmd yay 'used by omarchy-pkg-aur-add and AUR version checks'
  optional_cmd gh 'branch discovery + authenticated clone convenience'
  optional_cmd gum 'interactive init questionnaire'
   optional_cmd notify-send 'desktop workflow notifications'
  if has_cmd wpctl; then
    log_info 'wpctl is available (optional daily 5am volume reset on PipeWire/WirePlumber)'
  else
    log_info 'wpctl is missing (optional daily 5am volume reset on PipeWire/WirePlumber)'
  fi

  if has_cmd gh; then
    if gh auth status >/dev/null 2>&1; then
      log_info 'gh authentication is active'
    else
      doctor_warn 'gh is installed but not authenticated (branch questionnaire discovery disabled)'
    fi
  fi

  if [[ -d "$PUBLIC_DOTFILES" ]]; then
    doctor_log_section 'Repository checks'
    log_info "Found $(display_path "$PUBLIC_DOTFILES")"
  else
    doctor_log_section 'Repository checks'
    doctor_error "Missing $(display_path "$PUBLIC_DOTFILES")"
  fi

  if [[ -d "$PRIVATE_DOTFILES" ]]; then
    log_info "Found $(display_path "$PRIVATE_DOTFILES")"
  else
    doctor_warn "Missing $(display_path "$PRIVATE_DOTFILES")"
  fi

  if can_use_private; then
    doctor_log_section 'Additional private repository checks'
    load_private_extra_repos
    if [[ "${#PRIVATE_EXTRA_REPO_PATHS[@]}" -eq 0 ]]; then
      log_info 'No additional private repos configured'
    else
      local extra_repo_name
      local extra_repo_path
      local extra_current_branch
      local extra_upstream_ref
      local i

      for i in "${!PRIVATE_EXTRA_REPO_PATHS[@]}"; do
        extra_repo_name="${PRIVATE_EXTRA_REPO_NAMES[$i]}"
        extra_repo_path="${PRIVATE_EXTRA_REPO_PATHS[$i]}"

        if [[ ! -d "$extra_repo_path" ]]; then
          doctor_warn "Missing extra repo $extra_repo_name: $(display_path "$extra_repo_path")"
          continue
        fi

        if ! git -C "$extra_repo_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
          doctor_warn "Extra repo $extra_repo_name is not a git repo: $(display_path "$extra_repo_path")"
          continue
        fi

        log_info "Found extra repo $extra_repo_name: $(display_path "$extra_repo_path")"

        extra_current_branch="$(repo_current_branch "$extra_repo_path")"
        if [[ -z "$extra_current_branch" || "$extra_current_branch" == 'HEAD' ]]; then
          doctor_warn "Extra repo $extra_repo_name is not on a named branch: $(display_path "$extra_repo_path")"
          continue
        fi

        extra_upstream_ref="$(repo_upstream_ref "$extra_repo_path")"
        if [[ -z "$extra_upstream_ref" ]]; then
          doctor_warn "Extra repo $extra_repo_name branch '$extra_current_branch' has no upstream: $(display_path "$extra_repo_path")"
          continue
        fi

        log_info "Extra repo $extra_repo_name branch OK ('$extra_current_branch' -> '$extra_upstream_ref')"
      done
    fi
  else
    doctor_log_section 'Additional private repository checks'
    doctor_warn "Skipping additional private repo checks ($PRIVATE_REASON)"
  fi

  doctor_log_section 'Stow integrity'
  if has_cmd stow; then
    local stow_drift_found=false
    local stow_output
    local stow_folder

    check_stow_package() {
      local repo_dir="$1"
      local folder="$2"
      shift 2
      local extra_args=("$@")

      stow_output="$(stow_in_repo "$repo_dir" -n -v "${extra_args[@]}" "$folder" 2>&1 || true)"
      # Filter out LINK lines that revert their own UNLINK (no-op in --no-folding mode)
      if echo "$stow_output" | grep -v 'reverts previous action' | grep -q '^LINK:\|^ERROR\|existing target'; then
        stow_drift_found=true
        doctor_warn "Stow package '$folder' in $(display_path "$repo_dir") needs restow"
      fi
    }

    if [[ -d "$PUBLIC_DOTFILES" ]]; then
      mapfile -t stow_folders < <(list_stow_folders "$PUBLIC_DOTFILES" false)
      for stow_folder in "${stow_folders[@]}"; do
        if [[ "$stow_folder" == 'agents' ]]; then
          check_stow_package "$PUBLIC_DOTFILES" "$stow_folder" --no-folding
        else
          check_stow_package "$PUBLIC_DOTFILES" "$stow_folder"
        fi
      done
    fi

    if can_use_private && [[ -d "$PRIVATE_DOTFILES" ]]; then
      mapfile -t stow_folders < <(list_stow_folders "$PRIVATE_DOTFILES" false)
      for stow_folder in "${stow_folders[@]}"; do
        if [[ "$stow_folder" == 'agents' ]]; then
          check_stow_package "$PRIVATE_DOTFILES" "$stow_folder" \
            --no-folding \
            --ignore=node_modules \
            --ignore='package\.json' \
            --ignore='bun\.lock' \
            --ignore='\.gitignore'
        else
          check_stow_package "$PRIVATE_DOTFILES" "$stow_folder"
        fi
      done
    fi

    if [[ "$stow_drift_found" == false ]]; then
      log_info 'All stow packages are correctly linked'
    fi
  else
    doctor_warn 'stow not installed — cannot verify link integrity'
  fi

  doctor_log_section 'OpenCode location checks'
  report_opencode_location_status

  doctor_log_section 'Git config include'
  local git_config_file="$HOME/.config/git/config"
  local git_config_dotfiles="$HOME/.config/git/config.dotfiles"
  local git_include_path='~/.config/git/config.dotfiles'
  if [[ -L "$git_config_dotfiles" || -f "$git_config_dotfiles" ]]; then
    if [[ -f "$git_config_file" ]] && grep -q "path = $git_include_path" "$git_config_file" 2>/dev/null; then
      log_info "Git config includes managed dotfiles settings"
    else
      doctor_warn "Git config is missing the dotfiles include"
      doctor_warn "Run: git config --global --add include.path '$git_include_path'"
    fi
  else
    doctor_warn "Stowed git config.dotfiles not found — run: dot stow"
  fi

  doctor_log_section 'Workflow watch checks'
  if [[ -d "$DOT_WORKFLOW_WATCH_HOOKS_PATH" ]]; then
    log_info "Workflow watch hooks path exists: $(display_path "$DOT_WORKFLOW_WATCH_HOOKS_PATH")"
  else
    doctor_warn "Workflow watch hooks path is missing: $(display_path "$DOT_WORKFLOW_WATCH_HOOKS_PATH")"
    doctor_warn 'Run dot stow or dot init to install the workflow watch hook package'
  fi

  if workflow_watch_hooks_path_matches; then
    log_info "Global git hooksPath points to workflow watch hooks: $(display_path "$DOT_WORKFLOW_WATCH_HOOKS_PATH")"
  else
    local configured_hooks_path
    configured_hooks_path="$(workflow_watch_configured_hook_path)"
    if [[ -n "$configured_hooks_path" ]]; then
      doctor_warn "Global git hooksPath differs from workflow watch hooks ($(display_path "$configured_hooks_path"))"
    else
      doctor_warn 'Global git hooksPath is not configured'
    fi
    doctor_warn 'Run dot init to configure global workflow watch hooks'
  fi

  if [[ -f "$DOT_WORKFLOW_WATCH_REPOS_FILE" ]]; then
    log_info "Workflow watch repo list found: $(display_path "$DOT_WORKFLOW_WATCH_REPOS_FILE")"
  else
    doctor_warn "Workflow watch repo list missing: $(display_path "$DOT_WORKFLOW_WATCH_REPOS_FILE")"
    doctor_warn 'Add watched repositories in private dotfiles to enable workflow monitoring'
  fi

  if has_cmd systemctl; then
    if workflow_watch_timer_is_enabled; then
      log_info "Workflow watch timer enabled: $DOT_WORKFLOW_WATCH_TIMER_UNIT"
    else
      doctor_warn "Workflow watch timer is not enabled: $DOT_WORKFLOW_WATCH_TIMER_UNIT"
      doctor_warn 'Run dot init to enable the workflow watch timer'
    fi

    if workflow_watch_timer_is_active; then
      log_info "Workflow watch timer active: $DOT_WORKFLOW_WATCH_TIMER_UNIT"
    else
      doctor_warn "Workflow watch timer is not active: $DOT_WORKFLOW_WATCH_TIMER_UNIT"
    fi
  else
    doctor_warn 'Skipping workflow watch timer checks (systemctl not found)'
  fi

  local workflow_watch_script="$HOME/.local/bin/git-workflow-watch"
  if [[ -x "$workflow_watch_script" ]]; then
    log_info "Workflow watch script is executable: $(display_path "$workflow_watch_script")"
  else
    doctor_warn "Workflow watch script is missing or not executable: $(display_path "$workflow_watch_script")"
    doctor_warn 'Run dot stow or dot init to install the workflow watch script'
  fi

  local workflow_watch_waybar_script="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/github-workflow-failures-waybar.sh"
  if [[ -x "$workflow_watch_waybar_script" ]]; then
    log_info "Workflow watch Waybar script is executable: $(display_path "$workflow_watch_waybar_script")"
  else
    doctor_warn "Workflow watch Waybar script is missing or not executable: $(display_path "$workflow_watch_waybar_script")"
    doctor_warn 'Stow or update the Waybar repo to install the workflow failures module script'
  fi

  local workflow_watch_waybar_style="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/style.css"
  if [[ -f "$workflow_watch_waybar_style" ]]; then
    if grep -Fq '#custom-github-workflow-failures.hidden' "$workflow_watch_waybar_style"; then
      log_info "Workflow watch Waybar hidden-empty CSS found: $(display_path "$workflow_watch_waybar_style")"
    else
      doctor_warn "Workflow watch Waybar hidden-empty CSS is missing: $(display_path "$workflow_watch_waybar_style")"
      doctor_warn 'Update the Waybar style so the workflow failure icon hides when there are no failures'
    fi
  else
    doctor_warn "Waybar style file is missing: $(display_path "$workflow_watch_waybar_style")"
  fi

  local workflow_watch_waybar_config
  workflow_watch_waybar_config="$(workflow_watch_waybar_config_path)"
  if [[ -f "$workflow_watch_waybar_config" ]]; then
    log_info "Workflow watch active Waybar config: $(display_path "$workflow_watch_waybar_config")"

    if workflow_watch_waybar_config_contains "$workflow_watch_waybar_config" '"custom/github-workflow-failures"'; then
      log_info 'Workflow watch Waybar module is present in the active config'
    else
      doctor_warn "Workflow watch Waybar module is missing from $(display_path "$workflow_watch_waybar_config")"
      doctor_warn 'Add custom/github-workflow-failures before custom/dot-diff in the active Waybar config'
    fi

    if workflow_watch_waybar_config_contains "$workflow_watch_waybar_config" '"on-click": "~/.local/bin/git-workflow-watch open-failed-runs"'; then
      log_info 'Workflow watch Waybar left click opens failed runs'
    else
      doctor_warn "Workflow watch Waybar left-click action is missing in $(display_path "$workflow_watch_waybar_config")"
    fi

    if workflow_watch_waybar_config_contains "$workflow_watch_waybar_config" '"on-click-right": "~/.local/bin/git-workflow-watch clear-failed-runs"'; then
      log_info 'Workflow watch Waybar right click clears failed runs'
    else
      doctor_warn "Workflow watch Waybar right-click clear action is missing in $(display_path "$workflow_watch_waybar_config")"
    fi

    if workflow_watch_waybar_config_orders_before "$workflow_watch_waybar_config" '"custom/github-workflow-failures"' '"custom/dot-diff"'; then
      log_info 'Workflow watch Waybar module is ordered before dot diff'
    else
      doctor_warn "Workflow watch Waybar module is not ordered before dot diff in $(display_path "$workflow_watch_waybar_config")"
    fi
  else
    doctor_warn "Active Waybar config is missing: $(display_path "$workflow_watch_waybar_config")"
  fi

  doctor_log_section 'Browser freeze monitor checks'
  local browser_freeze_script="$PUBLIC_DOTFILES/.tests/browser-freeze-snapshot.sh"
  local browser_freeze_unit_path="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$DOT_BROWSER_FREEZE_TIMER_UNIT"

  if [[ -f "$browser_freeze_script" ]]; then
    log_info "Browser freeze snapshot script found: $(display_path "$browser_freeze_script")"
  else
    doctor_warn "Browser freeze snapshot script missing: $(display_path "$browser_freeze_script")"
  fi

  if [[ -f "$browser_freeze_unit_path" ]]; then
    log_info "Browser freeze timer unit file found: $(display_path "$browser_freeze_unit_path")"
  else
    doctor_warn "Browser freeze timer unit file missing: $(display_path "$browser_freeze_unit_path")"
    doctor_warn 'Run dot stow (or dot install) to link systemd user units'
  fi

  if has_cmd systemctl; then
    if systemctl --user is-enabled "$DOT_BROWSER_FREEZE_TIMER_UNIT" >/dev/null 2>&1; then
      log_info "Browser freeze monitor timer enabled: $DOT_BROWSER_FREEZE_TIMER_UNIT"
    else
      doctor_warn "Browser freeze monitor timer is disabled: $DOT_BROWSER_FREEZE_TIMER_UNIT"
      doctor_warn "Enable with: systemctl --user enable --now $DOT_BROWSER_FREEZE_TIMER_UNIT"
      doctor_warn "If unwanted, keep it disabled or remove with: systemctl --user disable --now $DOT_BROWSER_FREEZE_TIMER_UNIT"
    fi

    if systemctl --user is-active "$DOT_BROWSER_FREEZE_TIMER_UNIT" >/dev/null 2>&1; then
      log_info "Browser freeze monitor timer active: $DOT_BROWSER_FREEZE_TIMER_UNIT"
    else
      doctor_warn "Browser freeze monitor timer is not active: $DOT_BROWSER_FREEZE_TIMER_UNIT"
    fi
  else
    doctor_warn 'Skipping browser freeze monitor timer checks (systemctl not found)'
  fi

  if has_cmd notify-send; then
    if notify-send --help 2>&1 | grep -Fq -- '--action'; then
      log_info 'notify-send supports clickable notification actions'
    else
      doctor_warn 'notify-send does not advertise action support; workflow notifications may not open runs on click'
    fi
  fi

  doctor_log_section 'Doctor startup notification'
  local doctor_startup_notify_script="$HOME/.local/bin/dot-doctor-notify"
  local doctor_startup_unit_path="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$DOT_DOCTOR_STARTUP_TIMER_UNIT"

  if [[ -x "$doctor_startup_notify_script" ]]; then
    log_info "Doctor startup notify script found: $(display_path "$doctor_startup_notify_script")"
  else
    doctor_warn "Doctor startup notify script missing or not executable: $(display_path "$doctor_startup_notify_script")"
  fi

  if [[ -f "$doctor_startup_unit_path" ]]; then
    log_info "Doctor startup timer unit file found: $(display_path "$doctor_startup_unit_path")"
  else
    doctor_warn "Doctor startup timer unit file missing: $(display_path "$doctor_startup_unit_path")"
    doctor_warn 'Run dot stow (or dot install) to link systemd user units'
  fi

  if has_cmd systemctl; then
    if systemctl --user is-enabled "$DOT_DOCTOR_STARTUP_TIMER_UNIT" >/dev/null 2>&1; then
      log_info "Doctor startup timer enabled: $DOT_DOCTOR_STARTUP_TIMER_UNIT"
    else
      doctor_warn "Doctor startup timer is disabled: $DOT_DOCTOR_STARTUP_TIMER_UNIT"
      doctor_warn "Enable with: systemctl --user enable --now $DOT_DOCTOR_STARTUP_TIMER_UNIT"
    fi

    if systemctl --user is-active "$DOT_DOCTOR_STARTUP_TIMER_UNIT" >/dev/null 2>&1; then
      log_info "Doctor startup timer active: $DOT_DOCTOR_STARTUP_TIMER_UNIT"
    else
      doctor_warn "Doctor startup timer is not active: $DOT_DOCTOR_STARTUP_TIMER_UNIT"
    fi
  else
    doctor_warn 'Skipping doctor startup timer checks (systemctl not found)'
  fi

  doctor_log_section 'Daily volume reset'
  local daily_volume_zero_script="$HOME/.local/bin/daily-volume-zero"
  local daily_volume_zero_systemd_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  local daily_volume_zero_service_unit_path="$daily_volume_zero_systemd_dir/daily-volume-zero.service"
  local daily_volume_zero_timer_unit_path="$daily_volume_zero_systemd_dir/$DOT_DAILY_VOLUME_ZERO_TIMER_UNIT"
  local daily_volume_zero_host="${OMARCHY_HOST:-unset}"

  if [[ -x "$daily_volume_zero_script" ]]; then
    log_info "Daily volume reset script found: $(display_path "$daily_volume_zero_script")"
  else
    log_info "Daily volume reset script missing or not executable: $(display_path "$daily_volume_zero_script")"
  fi

  if [[ -f "$daily_volume_zero_service_unit_path" ]]; then
    log_info "Daily volume reset service unit file found: $(display_path "$daily_volume_zero_service_unit_path")"
  else
    log_info "Daily volume reset service unit file missing: $(display_path "$daily_volume_zero_service_unit_path")"
    if [[ "${OMARCHY_HOST:-}" == 'laptop' ]]; then
      log_info 'Run dot stow (or dot install) to link systemd user units if you want this optional timer'
    else
      log_info "Daily volume reset is laptop-only; not linking it for OMARCHY_HOST=$daily_volume_zero_host"
    fi
  fi

  if [[ -f "$daily_volume_zero_timer_unit_path" ]]; then
    log_info "Daily volume reset timer unit file found: $(display_path "$daily_volume_zero_timer_unit_path")"
  else
    log_info "Daily volume reset timer unit file missing: $(display_path "$daily_volume_zero_timer_unit_path")"
    if [[ "${OMARCHY_HOST:-}" == 'laptop' ]]; then
      log_info 'Run dot stow (or dot install) to link systemd user units if you want this optional timer'
    else
      log_info "Daily volume reset is laptop-only; not linking it for OMARCHY_HOST=$daily_volume_zero_host"
    fi
  fi

  if has_cmd systemctl; then
    if systemctl --user is-enabled "$DOT_DAILY_VOLUME_ZERO_TIMER_UNIT" >/dev/null 2>&1; then
      log_info "Daily volume reset timer enabled: $DOT_DAILY_VOLUME_ZERO_TIMER_UNIT"
    else
      log_info "Daily volume reset timer is disabled: $DOT_DAILY_VOLUME_ZERO_TIMER_UNIT"
      if [[ "${OMARCHY_HOST:-}" == 'laptop' ]]; then
        log_info "Enable with: systemctl --user enable --now $DOT_DAILY_VOLUME_ZERO_TIMER_UNIT"
      else
        log_info "Daily volume reset is laptop-only; leave it disabled for OMARCHY_HOST=$daily_volume_zero_host"
      fi
    fi

    if systemctl --user is-active "$DOT_DAILY_VOLUME_ZERO_TIMER_UNIT" >/dev/null 2>&1; then
      log_info "Daily volume reset timer active: $DOT_DAILY_VOLUME_ZERO_TIMER_UNIT"
    else
      log_info "Daily volume reset timer is not active: $DOT_DAILY_VOLUME_ZERO_TIMER_UNIT"
    fi
  else
    log_info 'Skipping daily volume reset timer checks (systemctl not found)'
  fi

  if is_truthy "$INCLUDE_OMARCHY_DIFF_REPOS" || is_truthy "$INCLUDE_OMARCHY_UPDATE_REPOS"; then
    doctor_log_section 'Omarchy repository checks'
    local repo_name
    local repo_path
    local repo_slug
    local current_branch
    local branch_name
    local worktree_path
    local worktree_branch

    for repo_name in "${OMARCHY_DIFF_REPOS[@]}"; do
      repo_path="$OMARCHY_REPO_BASE/$repo_name"
      repo_slug="$(omarchy_repo_slug "$repo_name")"
      if [[ -e "$repo_path/.git" ]]; then
        log_info "Found $(display_path "$repo_path")"

        if omarchy_repo_matches_remote "$repo_path" "$repo_slug"; then
          log_info "Remote OK for $repo_name ($repo_slug)"
        else
          doctor_warn "Remote mismatch for $repo_name (expected $repo_slug)"
        fi
      else
        doctor_warn "Missing git repo $(display_path "$repo_path")"
      fi
    done

    doctor_log_section 'Omarchy worktree checks'
    for repo_name in "${OMARCHY_DIFF_REPOS[@]}"; do
      repo_path="$OMARCHY_REPO_BASE/$repo_name"

      if ! omarchy_repo_has_worktree_branches "$repo_name"; then
        if omarchy_repo_is_single_branch "$repo_name"; then
          log_info "Skipping branch checks for $repo_name (single-branch repo)"
        fi
        continue
      fi

        if ! git -C "$repo_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        doctor_warn "Skipping worktree checks for $repo_name (base repo missing): $(display_path "$repo_path")"
        continue
      fi

      current_branch="$(repo_current_branch "$repo_path")"
      for branch_name in "${OMARCHY_WORKTREE_BRANCHES[@]}"; do
        if [[ "$branch_name" == "$current_branch" ]]; then
          continue
        fi

        if ! omarchy_branch_ref_exists "$repo_path" "$branch_name"; then
          log_info "Skipping ${repo_name}-${branch_name} check (branch '$branch_name' not found)"
          continue
        fi

        worktree_path="$OMARCHY_REPO_BASE/${repo_name}-${branch_name}"
        if git -C "$worktree_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
          worktree_branch="$(repo_current_branch "$worktree_path")"
          if [[ "$worktree_branch" == "$branch_name" ]]; then
            log_info "Found $(display_path "$worktree_path") (branch '$branch_name')"
          else
            doctor_warn "Worktree branch mismatch for $(display_path "$worktree_path") (expected '$branch_name', found '$worktree_branch')"
          fi
        else
          doctor_warn "Missing worktree $(display_path "$worktree_path") for branch '$branch_name'"
        fi
      done
    done
  fi

  if can_use_private; then
    doctor_log_section 'Private access'
    log_info "Private repo enabled ($PRIVATE_REASON)"
  else
    doctor_log_section 'Private access'
    doctor_warn "Private repo disabled ($PRIVATE_REASON)"
  fi

  doctor_log_section 'Browser flags'
  local browser_flags_host_pkg="chromium--${OMARCHY_HOST:-}"
  local browser_flags_pkg_dir="$PRIVATE_DOTFILES/$browser_flags_host_pkg"
  local omarchy_default_chromium_flags="$HOME/.local/share/omarchy/config/chromium-flags.conf"
  if [[ -n "${OMARCHY_HOST:-}" && -d "$browser_flags_pkg_dir" ]]; then
    local browser_flags_ok=true
    for flag_file in ~/.config/chromium-flags.conf ~/.config/chrome-flags.conf; do
      if [[ ! -e "$flag_file" ]]; then
        doctor_error "Missing $(display_path "$flag_file") — run: dot stow"
        browser_flags_ok=false
      elif [[ ! -L "$flag_file" ]]; then
        doctor_error "$(display_path "$flag_file") is not a symlink — run: dot stow"
        browser_flags_ok=false
      fi
    done
    if [[ "$browser_flags_ok" == true ]]; then
      log_info "Browser flags stowed from $browser_flags_host_pkg"
    fi
  else
    if [[ -n "${OMARCHY_HOST:-}" ]] && can_use_private; then
      doctor_error "Missing $browser_flags_host_pkg package in $(display_path "$PRIVATE_DOTFILES")"
    elif [[ -z "${OMARCHY_HOST:-}" ]]; then
      doctor_warn 'OMARCHY_HOST is not set — cannot check browser flags'
    else
      log_info 'Browser flags using omarchy defaults (private repo unavailable)'
    fi
  fi

  # Always show diff between live chromium-flags.conf and omarchy defaults
  if [[ -f "$omarchy_default_chromium_flags" && -f ~/.config/chromium-flags.conf ]]; then
    local flags_diff
    flags_diff="$(diff -u "$omarchy_default_chromium_flags" ~/.config/chromium-flags.conf \
      --label 'omarchy defaults' --label 'chromium-flags.conf' 2>/dev/null \
      | grep -v '^[+-].*--oauth2-client-')" || true
    if [[ -z "$flags_diff" ]]; then
      log_info 'chromium-flags.conf is identical to omarchy defaults'
    else
      log_info 'chromium-flags.conf diff from omarchy defaults:'
      printf '%s\n' "$flags_diff"
    fi
  elif [[ ! -f "$omarchy_default_chromium_flags" ]]; then
    doctor_warn "Omarchy default chromium-flags.conf not found at $(display_path "$omarchy_default_chromium_flags")"
  fi

  doctor_log_section 'Hardware video decode'
  local vaapi_ok=true

  # Check for vainfo
  if ! has_cmd vainfo; then
    doctor_warn 'vainfo is missing — install libva-utils to diagnose VAAPI'
    vaapi_ok=false
  fi

  # Identify render nodes and their drivers
  local render_node driver_name vaapi_driver_expected=''
  for render_node in /sys/class/drm/renderD*; do
    [[ -e "$render_node/device/driver" ]] || continue
    driver_name="$(basename "$(readlink -f "$render_node/device/driver")")"
    local node_name
    node_name="$(basename "$render_node")"
    log_info "$node_name -> $driver_name"

    # Determine expected VAAPI driver for the active GPU
    case "$driver_name" in
      i915|xe) vaapi_driver_expected='iHD' ;;
      amdgpu)  vaapi_driver_expected='radeonsi' ;;
      nvidia)  : ;; # NVIDIA render nodes don't need a VAAPI driver override
    esac
  done

  # Check VAAPI driver selection
  local current_vaapi_driver="${LIBVA_DRIVER_NAME:-auto}"
  log_info "LIBVA_DRIVER_NAME=$current_vaapi_driver (session default)"

  if [[ "$vaapi_ok" == true ]]; then
    # Test VAAPI on each render node
    local vaapi_working=false
    for render_node in /dev/dri/renderD*; do
      [[ -c "$render_node" ]] || continue
      local node_name
      node_name="$(basename "$render_node")"
      local render_sys_node="/sys/class/drm/$node_name"
      local render_driver_name=''
      local render_vaapi_driver=''

      if [[ -e "$render_sys_node/device/driver" ]]; then
        render_driver_name="$(basename "$(readlink -f "$render_sys_node/device/driver")")"
      fi

      case "$render_driver_name" in
        i915|xe) render_vaapi_driver='iHD' ;;
        amdgpu)  render_vaapi_driver='radeonsi' ;;
        nvidia)  render_vaapi_driver='' ;;
      esac

      local vainfo_output vainfo_driver vaapi_driver_label
      vaapi_driver_label="${render_vaapi_driver:-${current_vaapi_driver:-auto}}"
      if [[ -n "$render_vaapi_driver" ]]; then
        if ! vainfo_output="$(LIBVA_DRIVER_NAME="$render_vaapi_driver" vainfo --display drm --device "$render_node" 2>&1)"; then
          doctor_warn "$node_name: vainfo failed with LIBVA_DRIVER_NAME=$vaapi_driver_label"
          continue
        fi
      else
        if ! vainfo_output="$(vainfo --display drm --device "$render_node" 2>&1)"; then
          doctor_warn "$node_name: vainfo failed with LIBVA_DRIVER_NAME=$vaapi_driver_label"
          continue
        fi
      fi

      vainfo_driver="$(printf '%s\n' "$vainfo_output" | sed -n 's/.*Driver version: \(.*\)/\1/p')"
      local profile_count
      profile_count="$(printf '%s\n' "$vainfo_output" | grep -c 'VAEntrypoint' || true)"
      log_info "$node_name: $vainfo_driver ($profile_count profiles, LIBVA_DRIVER_NAME=$vaapi_driver_label)"
      vaapi_working=true
    done

    if [[ "$vaapi_working" != true ]]; then
      doctor_error 'No working VAAPI driver found on any render node'
    fi
  fi

  # Check browser wrappers for VAAPI overrides (Chromium and Chrome)
  local browser_name browser_wrapper
  for browser_name in Chromium Chrome; do
    case "$browser_name" in
      Chromium) browser_wrapper="$HOME/.local/bin/chromium" ;;
      Chrome)   browser_wrapper="$HOME/.local/bin/google-chrome-stable" ;;
    esac
    if [[ -x "$browser_wrapper" ]]; then
      local wrapper_vaapi_driver
      wrapper_vaapi_driver="$(grep -oP '^\s*export\s+LIBVA_DRIVER_NAME=\K\S+' "$browser_wrapper" 2>/dev/null || true)"
      if [[ -n "$wrapper_vaapi_driver" ]]; then
        log_info "$browser_name wrapper overrides LIBVA_DRIVER_NAME=$wrapper_vaapi_driver"
      fi
      if grep -q '__EGL_VENDOR_LIBRARY_FILENAMES' "$browser_wrapper" 2>/dev/null; then
        log_info "$browser_name wrapper forces Mesa EGL (hybrid GPU fix)"
      fi
    else
      if [[ -n "$vaapi_driver_expected" && "$current_vaapi_driver" != "$vaapi_driver_expected" ]]; then
        # Only warn if the browser is actually installed
        local browser_bin="${browser_wrapper##*/}"
        if command -v "$browser_bin" &>/dev/null; then
          doctor_warn "No $browser_name wrapper at $(display_path "$browser_wrapper") — VAAPI may use wrong driver (session=$current_vaapi_driver, expected=$vaapi_driver_expected)"
        fi
      fi
    fi
  done

  # Check browser flags.conf files for VAAPI features
  local flags_name flags_path
  for flags_name in chromium chrome; do
    case "$flags_name" in
      chromium) flags_path="$HOME/.config/chromium-flags.conf" ;;
      chrome)   flags_path="$HOME/.config/chrome-flags.conf" ;;
    esac
    if [[ -f "$flags_path" ]]; then
      if grep -qE 'AcceleratedVideoDecodeLinuxGL|VaapiVideoDecodeLinuxGL' "$flags_path" 2>/dev/null; then
        log_info "$flags_name-flags.conf has hardware video decode feature flag enabled"
      else
        doctor_warn "$flags_name-flags.conf missing hardware video decode feature flag (AcceleratedVideoDecodeLinuxGL or VaapiVideoDecodeLinuxGL)"
      fi
    fi
  done

  # Check required packages
  local vaapi_packages_ok=true
  if ! pacman -Qi libva &>/dev/null; then
    doctor_error 'libva is not installed (required for VAAPI)'
    vaapi_packages_ok=false
  fi

  local has_vaapi_driver=false
  for pkg in intel-media-driver libva-intel-driver libva-nvidia-driver libva-mesa-driver; do
    if pacman -Qi "$pkg" &>/dev/null; then
      log_info "$pkg is installed"
      has_vaapi_driver=true
    fi
  done
  if [[ "$has_vaapi_driver" != true ]]; then
    doctor_error 'No VAAPI driver package installed (need intel-media-driver, libva-mesa-driver, or similar)'
  fi

  doctor_log_section 'Browser extension checks'
  if can_use_private; then
    run_private_browser_checks report_chromium_extension_status
  else
    doctor_warn "Skipping browser extension checks ($PRIVATE_REASON)"
  fi

  doctor_log_section 'Public package checks'
  report_package_status system-bridge-git
  report_package_status go-automate-git
  report_package_status python-gobject
  report_package_status gtk4-layer-shell
  report_package_status stress-ng
  report_package_status sysbench
  report_package_status iperf3
  report_package_status sysstat
  report_package_status bmon
  report_package_status smem

  if [[ "${#doctor_missing_aur_packages[@]}" -gt 0 || "${#doctor_switch_aur_packages[@]}" -gt 0 || "${#doctor_update_aur_packages[@]}" -gt 0 ]]; then
    local combined_aur_packages=()
    combined_aur_packages+=("${doctor_missing_aur_packages[@]}" "${doctor_switch_aur_packages[@]}" "${doctor_update_aur_packages[@]}")
    doctor_warn "Install/update with: omarchy-pkg-aur-add ${combined_aur_packages[*]}"
  fi

  doctor_log_section 'Private package repo checks'
  report_private_package_repo_status

  doctor_log_section 'Private package checks'
  if can_use_private && load_private_arch_packages; then
    if [[ "${#PRIVATE_ARCH_PACKAGES[@]}" -eq 0 ]]; then
      log_info 'No private packages configured'
    else
      local private_package_name
      for private_package_name in "${PRIVATE_ARCH_PACKAGES[@]}"; do
        report_private_package_status "$private_package_name"
      done
      if [[ "${#doctor_missing_private_packages[@]}" -gt 0 ]]; then
        doctor_warn "Install with: omarchy-pkg-aur-add ${doctor_missing_private_packages[*]}"
      fi
    fi
  elif can_use_private; then
    doctor_warn "Missing private package list: $(display_path "$DOT_PRIVATE_PACKAGES_FILE")"
  else
    doctor_warn "Skipping private package checks ($PRIVATE_REASON)"
  fi

  print_grouped_doctor_messages error
  print_grouped_doctor_messages warning

  if [[ $issues -eq 0 ]]; then
    if [[ $warnings -eq 0 ]]; then
      log_info 'Doctor finished: no critical issues found'
    else
      doctor_summary_warn "Doctor finished: no critical issues, $warnings warning(s)"
    fi
  else
    doctor_summary_error "Doctor finished: $issues critical issue(s), $warnings warning(s)"
    status=1
  fi

  return "$status"
}

cmd_diff() {
  local i
  local om_i

  log_section 'Diff workflow'
  show_repo_diffs 'public' "$PUBLIC_DOTFILES"

  if can_use_private; then
    show_repo_diffs 'private' "$PRIVATE_DOTFILES"
    show_repo_diffs 'notes' "$NOTES_REPO_DIR"
  else
    log_warn "Skipping private and notes diff ($PRIVATE_REASON)"
  fi

  if is_truthy "$INCLUDE_OMARCHY_DIFF_REPOS"; then
    log_section 'Omarchy repo diffs'
    omarchy_collect_repo_targets
    for om_i in "${!OMARCHY_TARGET_PATHS[@]}"; do
      show_repo_diffs "${OMARCHY_TARGET_NAMES[$om_i]}" "${OMARCHY_TARGET_PATHS[$om_i]}"
    done
  else
    log_warn "Skipping Omarchy repo diffs (DOT_INCLUDE_OMARCHY_DIFF_REPOS=$INCLUDE_OMARCHY_DIFF_REPOS)"
  fi

  if can_use_private; then
    load_private_extra_repos
    sort_private_extra_repos
    if [[ "${#PRIVATE_EXTRA_REPO_PATHS[@]}" -gt 0 ]]; then
      log_section 'Additional private repo diffs'
      for i in "${!PRIVATE_EXTRA_REPO_PATHS[@]}"; do
        if ! private_extra_repo_visible_now "$i"; then
          log_section "extra:${PRIVATE_EXTRA_REPO_NAMES[$i]} repo: $(display_path "${PRIVATE_EXTRA_REPO_PATHS[$i]}")"
          log_info "Skipping extra:${PRIVATE_EXTRA_REPO_NAMES[$i]} diff (outside schedule window: ${PRIVATE_EXTRA_REPO_SCHEDULES[$i]})"
          continue
        fi
        show_repo_diffs "extra:${PRIVATE_EXTRA_REPO_NAMES[$i]}" "${PRIVATE_EXTRA_REPO_PATHS[$i]}"
      done
    fi
  fi

}

cmd_help() {
  local fmt_cmd='  %-20s  %s\n'
  local fmt_env='  %-34s%s\n'
  local fmt_init='  %-26s  %s\n'

  printf 'Usage: %s <command> [args]\n\n' "$SCRIPT_NAME"
  printf 'Commands:\n'
  printf "$fmt_cmd" 'init' 'Run questionnaire, sync omarchy repos, setup, install'
  printf "$fmt_cmd" 'update' 'Pull repos (public, private, notes, extra, omarchy repos), stow dotfiles (optional agents-sync + dot memory --soft)'
  printf "$fmt_cmd" 'memory' 'Refresh OpenCode durable memory (~/.config/opencode/AGENTS.md via memory.js --update)'
  printf "$fmt_cmd" 'stow' 'Re-stow public/private dotfiles (no git pull)'
  printf "$fmt_cmd" 'diff' 'Per-repo status + diffs with fetched upstream unpushed/incoming commits'
  printf "$fmt_cmd" '' 'Options: --waybar → one-line JSON for Waybar (same checks; no banners)'
  printf "$fmt_cmd" '' '         --list-changed → name|path lines for repos with changes'
  printf "$fmt_cmd" '' '         --list-all → name|path lines for all tracked repos'
  printf "$fmt_cmd" 'setup' 'Install packages (supports: --confirm, currently non-interactive)'
  printf "$fmt_cmd" 'install' 'Backup/adopt and install public/private dotfiles'
  printf "$fmt_cmd" 'clean' 'Unstow private then public dotfiles'
  printf "$fmt_cmd" 'doctor' 'Check dependencies, repos, workflow watch, packages, and browser extensions'
  printf "$fmt_cmd" 'opencode-debug' 'Run OpenCode debug paths/config/skill/info (optional: --agent <name>)'
  printf "$fmt_cmd" 'private-pkg-publish' 'Build, publish, commit, and push a mapped private package'
  printf "$fmt_cmd" 'agents-sync' 'Run dot memory then write global-agents.mdc (default: dotfiles-private agents/.cursor/rules/)'
  printf "$fmt_cmd" 'skill-updates' 'Check imported skills for upstream changes (auto-applied during update; interactive standalone)'
  printf "$fmt_cmd" '' 'Options: --check → report only, exit 1 if updates available (no prompts)'
  printf "$fmt_cmd" '' '         --update → auto-apply without prompting (used by dot update)'
  printf "$fmt_cmd" 'help' 'Show this help'

  printf '\nEnvironment:\n'
  printf "$fmt_env" 'DOTFILES_PUBLIC_DIR' 'Override public dotfiles path'
  printf "$fmt_env" 'DOTFILES_PRIVATE_DIR' 'Override private dotfiles path'
  printf "$fmt_env" 'DOT_NOTES_DIR' 'Notes vault git repo (default ~/Documents/notes); shown in dot diff with private'
  printf "$fmt_env" 'DOT_PRIVATE_EXTRA_REPOS_FILE' 'Extra repos file for diff/update/doctor; optional schedule filters diff visibility'
  printf "$fmt_env" 'DOT_ALLOW_PRIVATE' 'auto|always|never (default: auto)'
  printf "$fmt_env" 'DOT_PRIVATE_GH_USER' 'Expected gh username for private actions (default: timmo001)'
  printf "$fmt_env" 'OMARCHY_REPO_BASE_DIR' 'Base directory for omarchy repos (default: ~/.config)'
  printf "$fmt_env" 'DOT_OMARCHY_BRANCH' 'Branch override for split omarchy repos in init/update sync'
  printf "$fmt_env" 'DOT_BOOTSTRAP_BRANCH' 'Branch for bootstrap repo (default: distro/omarchy)'
  printf "$fmt_env" 'DOT_INCLUDE_OMARCHY_DIFF_REPOS' '1|0 include omarchy repos in diff (default: 1)'
  printf "$fmt_env" 'DOT_INCLUDE_OMARCHY_UPDATE_REPOS' '1|0 include omarchy repos in update pull (default: 1)'
  printf "$fmt_env" 'DOT_FETCH_TTL_SECONDS' 'Seconds to reuse the last upstream fetch result in diff commands (default: 300)'
  printf "$fmt_env" 'DOT_INIT_NONINTERACTIVE' '1|0 skip init questionnaire (default: 0)'
  printf "$fmt_env" 'DOT_WORKFLOW_WATCH_HOOKS_PATH' 'Global git hooksPath for workflow watch hooks (default ~/.config/git/workflow-watch-hooks)'
  printf "$fmt_env" 'DOT_WORKFLOW_WATCH_REPOS_FILE' 'Watched GitHub repo list file (default $DOTFILES_PRIVATE_DIR/.git-workflow-watch-repos)'
  printf "$fmt_env" 'DOT_WORKFLOW_WATCH_TIMER_UNIT' 'User systemd timer for workflow polling (default git-workflow-watch.timer)'
  printf "$fmt_env" 'DOT_BROWSER_FREEZE_TIMER_UNIT' 'User systemd timer for browser freeze snapshots (default browser-freeze-snapshot.timer)'
  printf "$fmt_env" 'DOT_DOCTOR_STARTUP_TIMER_UNIT' 'User systemd timer for dot doctor startup notifications (default dot-doctor-startup.timer)'
  printf "$fmt_env" 'DOT_DAILY_VOLUME_ZERO_TIMER_UNIT' 'User systemd timer for 5am volume reset (default daily-volume-zero.timer)'
  printf "$fmt_env" 'DOT_AGENTS_SYNC_SOURCE' 'Path to AGENTS.md to mirror (default ~/.config/opencode/AGENTS.md)'
  printf "$fmt_env" 'DOT_AGENTS_SYNC_RULE_FILE' 'Cursor rule file path (default: $DOTFILES_PRIVATE_DIR/agents/.cursor/rules/global-agents.mdc)'
  printf "$fmt_env" 'DOT_AGENTS_SYNC_ON_UPDATE' '1|0 run agents-sync after dot update (default 1)'
  printf "$fmt_env" 'DOT_MEMORY_UPDATE_ON_UPDATE' '1|0 run `dot memory --soft` after dot update (default 1)'
  printf "$fmt_env" 'DOT_MEMORY_ON_AGENTS_SYNC' '1|0 run `dot memory` before mirroring in `dot agents-sync` (default 1)'

  printf '\nInit options:\n'
  printf "$fmt_init" '--confirm' 'Passes through to setup (accepted, package helpers are non-interactive)'
  printf "$fmt_init" '--noninteractive' 'Skip questionnaire for this run'
  printf "$fmt_init" '--interactive' 'Force questionnaire for this run'
  printf "$fmt_init" '--branch <name>' 'Omarchy branch override for split repos such as hypr'
  printf "$fmt_init" '--bootstrap-branch <n>' 'Bootstrap repo branch override for this run'
  printf "$fmt_init" '--no-git' 'For private-pkg-publish: skip commit and push'
  printf "$fmt_init" '--skip-build' 'For private-pkg-publish: publish existing dist package artifact'
  printf "$fmt_init" '--install' 'For private-pkg-publish: install the published package'
}

main() {
  local cmd="${1:-help}"
  shift || true

  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    log_error 'Run dot as your regular user account (not as root)'
    return 1
  fi

  if [[ "$cmd" == 'diff' && "${1:-}" == '--waybar' ]]; then
    shift
    cmd_diff_status "$@"
    return
  fi

  if [[ "$cmd" == 'diff' && "${1:-}" == '--list-changed' ]]; then
    cmd_diff_list_changed
    return
  fi

  if [[ "$cmd" == 'diff' && "${1:-}" == '--list-all' ]]; then
    cmd_diff_list_all
    return
  fi
  if [[ "$cmd" != 'help' && "$cmd" != '-h' && "$cmd" != '--help' ]]; then
    if [[ -d "$PUBLIC_DOTFILES" ]]; then
      cd "$PUBLIC_DOTFILES"
    fi

    log_header "dot $cmd"
    log_context
  fi

  case "$cmd" in
    init) cmd_init "$@" ;;
    update) cmd_update "$@" ;;
    stow) cmd_stow "$@" ;;
    diff) cmd_diff "$@" ;;
    setup) cmd_setup "$@" ;;
    install) cmd_install "$@" ;;
    clean) cmd_clean "$@" ;;
    doctor) cmd_doctor "$@" ;;
    opencode-debug) cmd_opencode_debug "$@" ;;
    private-pkg-publish) cmd_private_pkg_publish "$@" ;;
    agents-sync) cmd_agents_sync "$@" ;;
    skill-updates) cmd_skill_updates "$@" ;;
    memory) cmd_memory "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
      log_error "Unknown command: $cmd"
      cmd_help
      return 1
      ;;
  esac
}

main "$@"
