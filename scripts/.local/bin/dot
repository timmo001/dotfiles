#!/usr/bin/env bash

set -euo pipefail

SCRIPT_NAME="${0##*/}"
# Absolute path to this script (for re-invoking commands, e.g. dot update → dot memory).
DOT_SELF="${BASH_SOURCE[0]:-$0}"

PUBLIC_DOTFILES="${DOTFILES_PUBLIC_DIR:-$HOME/.config/dotfiles}"
PRIVATE_DOTFILES="${DOTFILES_PRIVATE_DIR:-$HOME/.config/dotfiles-private}"
NOTES_REPO_DIR="${DOT_NOTES_DIR:-$HOME/Documents/notes}"

EXPECTED_GH_USER="${DOT_PRIVATE_GH_USER:-timmo001}"
PRIVATE_MODE="${DOT_ALLOW_PRIVATE:-auto}" # auto|always|never
INCLUDE_OMARCHY_DIFF_REPOS="${DOT_INCLUDE_OMARCHY_DIFF_REPOS:-1}"
INCLUDE_OMARCHY_UPDATE_REPOS="${DOT_INCLUDE_OMARCHY_UPDATE_REPOS:-1}"
INIT_NONINTERACTIVE="${DOT_INIT_NONINTERACTIVE:-0}"
DOT_AGENTS_SYNC_ON_UPDATE="${DOT_AGENTS_SYNC_ON_UPDATE:-1}"
DOT_MEMORY_ON_AGENTS_SYNC="${DOT_MEMORY_ON_AGENTS_SYNC:-1}"

OMARCHY_REPO_BASE="${OMARCHY_REPO_BASE_DIR:-$HOME/.config}"
OMARCHY_DIFF_REPOS=(bootstrap hypr waybar ghostty uwsm)
OMARCHY_BRANCH="${DOT_OMARCHY_BRANCH:-}"
BOOTSTRAP_BRANCH="${DOT_BOOTSTRAP_BRANCH:-distro/omarchy}"

PRIVATE_REASON=""

if [[ -n "${FORCE_COLOR:-}" ]] || [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  DOT_RED=$'\033[31m'
  DOT_GREEN=$'\033[32m'
  DOT_YELLOW=$'\033[33m'
  DOT_BLUE=$'\033[34m'
  DOT_MAGENTA=$'\033[35m'
  DOT_CYAN=$'\033[36m'
  DOT_BOLD=$'\033[1m'
  DOT_DIM=$'\033[2m'
  DOT_RESET=$'\033[0m'
else
  DOT_RED=''
  DOT_GREEN=''
  DOT_YELLOW=''
  DOT_BLUE=''
  DOT_MAGENTA=''
  DOT_CYAN=''
  DOT_BOLD=''
  DOT_DIM=''
  DOT_RESET=''
fi

term_width() {
  local width="${COLUMNS:-88}"

  if ! [[ "$width" =~ ^[0-9]+$ ]]; then
    width=88
  fi

  if [[ "$width" -lt 48 ]]; then
    width=48
  elif [[ "$width" -gt 120 ]]; then
    width=120
  fi

  printf '%s\n' "$width"
}

log_divider() {
  local char="${1:--}"
  local color="${2:-$DOT_DIM}"
  local width="${3:-$(term_width)}"
  local line

  line=$(printf '%*s' "$width" '')
  line=${line// /$char}
  printf '%b%s%b\n' "$color" "$line" "$DOT_RESET"
}

log_label() {
  local color="$1"
  local level="$2"
  local message="$3"
  local stream="${4:-stdout}"

  if [[ "$stream" == 'stderr' ]]; then
    printf '%b%-8s%b %s\n' "${DOT_BOLD}${color}" "[$level]" "$DOT_RESET" "$message" >&2
  else
    printf '%b%-8s%b %s\n' "${DOT_BOLD}${color}" "[$level]" "$DOT_RESET" "$message"
  fi
}

log_header() {
  local title="$1"

  printf '\n'
  log_divider '=' "$DOT_BLUE"
  printf '%b%s%b\n' "${DOT_BOLD}${DOT_BLUE}" "  $title" "$DOT_RESET"
  log_divider '=' "$DOT_BLUE"
}

log_info() {
  log_label "$DOT_CYAN" 'INFO' "$*"
}

log_warn() {
  log_label "$DOT_YELLOW" 'WARN' "$*" 'stderr'
}

log_error() {
  log_label "$DOT_RED" 'ERROR' "$*" 'stderr'
}

log_section() {
  printf '\n'
  log_divider '-' "$DOT_DIM" 72
  printf '%b%s%b\n' "${DOT_BOLD}${DOT_MAGENTA}" "  $*" "$DOT_RESET"
}

display_path() {
  local path="$1"
  local home_prefix="${HOME%/}"

  if [[ "$path" == "$home_prefix"* ]]; then
    printf '~%s\n' "${path#$home_prefix}"
  else
    printf '%s\n' "$path"
  fi
}

log_context() {
  log_info "Public repo: $(display_path "$PUBLIC_DOTFILES")"
  log_info "Private repo: $(display_path "$PRIVATE_DOTFILES")"
  log_info "Notes repo: $(display_path "$NOTES_REPO_DIR")"
  log_info "Private mode: $PRIVATE_MODE"
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

is_truthy() {
  case "${1,,}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

require_repo_dir() {
  local repo_dir="$1"
  local name="$2"

  if [[ ! -d "$repo_dir" ]]; then
    log_error "$name directory not found: $repo_dir"
    return 1
  fi
}

list_stow_folders() {
  local repo_dir="$1"
  local include_backup="${2:-false}"
  local dir
  local folder

  shopt -s nullglob
  for dir in "$repo_dir"/*/; do
    folder="${dir%/}"
    folder="${folder##*/}"

    if [[ "$include_backup" != "true" && "$folder" == "backup" ]]; then
      continue
    fi

    printf '%s\n' "$folder"
  done
  shopt -u nullglob
}

stow_in_repo() {
  local repo_dir="$1"
  shift

  (
    cd "$repo_dir"
    stow "$@"
  )
}

# Stow package was renamed opencode → agents. While opencode/ still exists in the repo
# (before pull removes it), unstow it so symlinks under ~/ are not orphaned. No-op when
# only agents/ is present.
migrate_legacy_opencode_package() {
  local repo_dir="$1"
  local label="$2"

  if [[ ! -d "$repo_dir" ]]; then
    return 0
  fi

  if [[ ! -d "$repo_dir/opencode" ]]; then
    return 0
  fi

  if ! has_cmd stow; then
    log_warn "Stow missing; cannot migrate legacy opencode package ($label)"
    return 0
  fi

  log_section "Legacy stow: opencode → agents ($label)"
  log_info "Unstowing legacy package opencode/ at $(display_path "$repo_dir")"
  if stow_in_repo "$repo_dir" -D opencode; then
    log_info "Legacy opencode unstowed ($label)"
  else
    log_warn "Legacy opencode unstow failed ($label); try: dot clean && dot install"
  fi
}

# Private package claude/ was merged into agents/. Unstow legacy claude/ while it still exists.
migrate_legacy_private_claude_package() {
  if [[ ! -d "$PRIVATE_DOTFILES/claude" ]]; then
    return 0
  fi

  if ! has_cmd stow; then
    log_warn "Stow missing; cannot migrate legacy private claude package"
    return 0
  fi

  log_section 'Legacy stow: private claude → agents'
  log_info "Unstowing legacy package claude/ at $(display_path "$PRIVATE_DOTFILES")"
  if stow_in_repo "$PRIVATE_DOTFILES" -D claude; then
    log_info 'Legacy private claude unstowed'
  else
    log_warn 'Legacy private claude unstow failed; try: dot clean && dot install'
  fi
}

# Stow package cursor/ was merged into agents/. Unstow legacy cursor/ while it still exists.
migrate_legacy_cursor_package() {
  local repo_dir="$1"
  local label="$2"

  if [[ ! -d "$repo_dir" ]]; then
    return 0
  fi

  if [[ ! -d "$repo_dir/cursor" ]]; then
    return 0
  fi

  if ! has_cmd stow; then
    log_warn "Stow missing; cannot migrate legacy cursor package ($label)"
    return 0
  fi

  log_section "Legacy stow: cursor → agents ($label)"
  log_info "Unstowing legacy package cursor/ at $(display_path "$repo_dir")"
  if stow_in_repo "$repo_dir" -D cursor; then
    log_info "Legacy cursor unstowed ($label)"
  else
    log_warn "Legacy cursor unstow failed ($label); try: dot clean && dot install"
  fi
}

# Mirror AGENTS.md into a Cursor user rule (.mdc with alwaysApply) so it is always-on context.
# Default output: private agents package at agents/.cursor/rules/global-agents.mdc (stows into ~/.cursor/rules/).
run_agents_sync() {
  local source="${DOT_AGENTS_SYNC_SOURCE:-$HOME/.opencode/AGENTS.md}"
  local dest
  local rule_dir
  local tmp
  local resolved

  if [[ -n "${DOT_AGENTS_SYNC_RULE_FILE:-}" ]]; then
    dest="$DOT_AGENTS_SYNC_RULE_FILE"
  elif [[ -d "$PRIVATE_DOTFILES/agents" ]]; then
    dest="$PRIVATE_DOTFILES/agents/.cursor/rules/global-agents.mdc"
  else
    dest="$HOME/.cursor/rules/global-agents.mdc"
  fi

  rule_dir="$(dirname -- "$dest")"

  if [[ ! -e "$source" ]]; then
    log_warn "agents-sync skipped (missing source): $(display_path "$source")"
    return 1
  fi

  if [[ ! -r "$source" ]]; then
    log_warn "agents-sync skipped (not readable): $(display_path "$source")"
    return 1
  fi

  resolved="$(readlink -f "$source" 2>/dev/null || printf '%s\n' "$source")"

  tmp="$(mktemp)" || {
    log_error 'agents-sync failed (mktemp)'
    return 1
  }

  {
    printf '%s\n' '---'
    printf '%s\n' 'description: Global agent instructions mirrored from AGENTS.md; refresh with dot agents-sync.'
    printf '%s\n' 'alwaysApply: true'
    printf '%s\n' '---'
    printf '\n'
    printf '%s\n' "<!-- dot agents-sync: source=$(display_path "$resolved") synced=$(date -Iseconds) -->"
    printf '\n'
    cat "$source"
  } >"$tmp" || {
    rm -f "$tmp"
    log_error 'agents-sync failed while writing temp file'
    return 1
  }

  if ! mkdir -p "$rule_dir"; then
    rm -f "$tmp"
    log_error "agents-sync failed (mkdir $(display_path "$rule_dir"))"
    return 1
  fi

  if mv -f "$tmp" "$dest"; then
    log_info "Wrote Cursor rule: $(display_path "$dest")"
    return 0
  fi

  rm -f "$tmp"
  log_error "agents-sync failed (mv to $(display_path "$dest"))"
  return 1
}

maybe_agents_sync_after_update() {
  is_truthy "${DOT_AGENTS_SYNC_ON_UPDATE:-1}" || return 0
  log_section 'Agents rules sync'
  run_agents_sync || true
}

# Sync ~/.opencode/AGENTS.md durable block via dotfiles-private memory.js --update.
# soft=1: missing deps or node failure returns 0 (for dot update hook). soft=0: returns 1 on failure.
_dot_run_memory_js() {
  local soft="${1:-0}"
  local script="$PRIVATE_DOTFILES/agents/.opencode/plugins/memory.js"

  if [[ ! -f "$script" ]]; then
    log_warn "Skipping memory sync (missing $(display_path "$script"))"
    if [[ "$soft" -eq 1 ]]; then
      return 0
    fi
    return 1
  fi

  if ! has_cmd node; then
    log_warn 'Skipping memory sync (node not found in PATH)'
    if [[ "$soft" -eq 1 ]]; then
      return 0
    fi
    return 1
  fi

  log_info "OpenCode memory: node $(display_path "$script") --update"
  if (cd "$HOME" && node "$script" --update); then
    return 0
  fi

  log_warn 'Memory sync failed'
  if [[ "$soft" -eq 1 ]]; then
    return 0
  fi
  return 1
}

# Optional: --soft (used by dot update) — do not fail the parent workflow on skip/error.
cmd_memory() {
  local soft=0
  if [[ "${1:-}" == '--soft' ]]; then
    soft=1
    shift
  fi

  log_section 'OpenCode memory sync'

  if ! can_use_private; then
    log_warn "Memory sync requires private dotfiles ($PRIVATE_REASON)"
    if [[ "$soft" -eq 1 ]]; then
      return 0
    fi
    return 1
  fi

  _dot_run_memory_js "$soft"
}

maybe_memory_update_after_update() {
  is_truthy "${DOT_MEMORY_UPDATE_ON_UPDATE:-1}" || return 0
  "$DOT_SELF" memory --soft || true
}

safe_pull_repo() {
  local name="$1"
  local repo_dir="$2"

  if [[ ! -e "$repo_dir/.git" ]]; then
    log_warn "Skipping $name pull (not a git repo): $(display_path "$repo_dir")"
    return 0
  fi

  if ! has_cmd git; then
    log_error "Git not found; cannot pull $name"
    return 1
  fi

  if [[ -n "$(git -C "$repo_dir" status --porcelain 2>/dev/null || true)" ]]; then
    log_warn "Skipping $name pull (working tree not clean): $(display_path "$repo_dir")"
    return 0
  fi

  log_info "Pulling latest for $name: $(display_path "$repo_dir")"
  git -C "$repo_dir" pull --rebase
}

omarchy_repo_slug() {
  local repo_name="$1"

  case "$repo_name" in
    bootstrap) printf 'timmo001/bootstrap\n' ;;
    hypr) printf 'timmo001/omarchy-hypr\n' ;;
    waybar) printf 'timmo001/omarchy-waybar\n' ;;
    ghostty) printf 'timmo001/omarchy-ghostty\n' ;;
    uwsm) printf 'timmo001/omarchy-uwsm\n' ;;
    *) return 1 ;;
  esac
}

omarchy_backup_existing_dir() {
  local repo_name="$1"
  local target_dir="$2"
  local backup_root="$OMARCHY_REPO_BASE/omarchy-backups"
  local backup_path="$backup_root/${repo_name}-$(date +%Y%m%d-%H%M%S)"

  mkdir -p "$backup_root"
  mv "$target_dir" "$backup_path"
  log_warn "Moved existing $repo_name to backup: $(display_path "$backup_path")"
}

omarchy_repo_matches_remote() {
  local target_dir="$1"
  local expected_slug="$2"
  local remote_url

  remote_url="$(git -C "$target_dir" remote get-url origin 2>/dev/null || true)"
  [[ "$remote_url" == *"$expected_slug"* ]]
}

omarchy_clone_repo() {
  local repo_slug="$1"
  local target_dir="$2"

  if has_cmd gh && gh auth status >/dev/null 2>&1; then
    log_info "Cloning $repo_slug -> $(display_path "$target_dir") (via gh)"
    gh repo clone "$repo_slug" "$target_dir"
  elif has_cmd git; then
    log_info "Cloning $repo_slug -> $(display_path "$target_dir") (via git)"
    git clone "https://github.com/${repo_slug}.git" "$target_dir"
  else
    log_error "Cannot clone $repo_slug (gh and git unavailable)"
    return 1
  fi
}

omarchy_checkout_branch_if_available() {
  local repo_name="$1"
  local target_dir="$2"
  local branch="$3"

  if [[ -z "$branch" ]]; then
    return 0
  fi

  if git -C "$target_dir" ls-remote --heads origin "$branch" | grep -q "$branch"; then
    log_info "Checking out branch '$branch' for $repo_name"
    git -C "$target_dir" fetch origin "$branch" >/dev/null 2>&1 || true
    git -C "$target_dir" checkout "$branch" >/dev/null 2>&1 || true
  else
    log_warn "Branch '$branch' not found for $repo_name; keeping current branch"
  fi
}

omarchy_sync_repo() {
  local repo_name="$1"
  local repo_slug="$2"
  local branch="$3"
  local target_dir="$OMARCHY_REPO_BASE/$repo_name"

  log_section "Omarchy sync: $repo_name"

  if [[ -d "$target_dir" ]]; then
    if [[ -e "$target_dir/.git" ]] && omarchy_repo_matches_remote "$target_dir" "$repo_slug"; then
      omarchy_checkout_branch_if_available "$repo_name" "$target_dir" "$branch"
      safe_pull_repo "omarchy:$repo_name" "$target_dir"
      return 0
    fi

    omarchy_backup_existing_dir "$repo_name" "$target_dir"
    omarchy_clone_repo "$repo_slug" "$target_dir"
    omarchy_checkout_branch_if_available "$repo_name" "$target_dir" "$branch"
    return 0
  fi

  omarchy_clone_repo "$repo_slug" "$target_dir"
  omarchy_checkout_branch_if_available "$repo_name" "$target_dir" "$branch"
}

omarchy_sync_repos() {
  local branch_override="$OMARCHY_BRANCH"
  local bootstrap_branch_override="$BOOTSTRAP_BRANCH"
  local arg
  local repo_name
  local slug

  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      --branch)
        shift
        branch_override="${1:-}"
        ;;
      --branch=*)
        branch_override="${arg#*=}"
        ;;
      --bootstrap-branch)
        shift
        bootstrap_branch_override="${1:-}"
        ;;
      --bootstrap-branch=*)
        bootstrap_branch_override="${arg#*=}"
        ;;
      *)
        log_error "Unknown omarchy-sync option: $arg"
        return 1
        ;;
    esac
    shift || true
  done

  omarchy_sync_repo 'bootstrap' "$(omarchy_repo_slug bootstrap)" "$bootstrap_branch_override"

  for repo_name in hypr waybar ghostty uwsm; do
    slug="$(omarchy_repo_slug "$repo_name")"
    omarchy_sync_repo "$repo_name" "$slug" "$branch_override"
  done
}

discover_omarchy_branches() {
  if ! has_cmd gh; then
    return 1
  fi

  gh api "repos/timmo001/omarchy-hypr/branches" --jq '.[].name' 2>/dev/null
}

run_init_questionnaire() {
  INIT_SELECTED_OMARCHY_BRANCH="$OMARCHY_BRANCH"
  INIT_RUN_BOOTSTRAP=0

  if is_truthy "$INIT_NONINTERACTIVE" || [[ ! -t 0 || ! -t 1 ]]; then
    return 0
  fi

  if [[ -n "$INIT_SELECTED_OMARCHY_BRANCH" ]]; then
    log_info "Using preselected omarchy branch: $INIT_SELECTED_OMARCHY_BRANCH"
  elif has_cmd gum && has_cmd gh && gh auth status >/dev/null 2>&1; then
    local branches
    branches="$(discover_omarchy_branches || true)"

    if [[ -n "$branches" ]]; then
      log_section 'Select omarchy branch'
      INIT_SELECTED_OMARCHY_BRANCH="$(printf '%s\n' "$branches" | gum choose --header 'Available branches')"
      log_info "Selected omarchy branch: $INIT_SELECTED_OMARCHY_BRANCH"
    else
      log_warn 'Could not discover omarchy branches; using current/default branches'
    fi
  else
    log_warn 'Skipping branch questionnaire (requires gum + gh auth)'
  fi

  if has_cmd gum; then
    if gum confirm 'Would you like to run bootstrap init now?'; then
      INIT_RUN_BOOTSTRAP=1
    fi
  fi
}

run_bootstrap_init_if_requested() {
  local bootstrap_init="$OMARCHY_REPO_BASE/bootstrap/init.sh"

  if [[ "$INIT_RUN_BOOTSTRAP" != '1' ]]; then
    return 0
  fi

  if [[ ! -x "$bootstrap_init" ]]; then
    log_warn "Bootstrap init script not found/executable: $(display_path "$bootstrap_init")"
    return 0
  fi

  log_section 'Running bootstrap init'
  "$bootstrap_init"
}

show_repo_diffs() {
  local name="$1"
  local repo_dir="$2"
  local status_out
  local unstaged_out
  local staged_out
  local unpushed_out
  local unpulled_out

  if [[ ! -e "$repo_dir/.git" ]]; then
    log_warn "Skipping $name diff (not a git repo): $(display_path "$repo_dir")"
    return 0
  fi

  log_section "$name repo: $(display_path "$repo_dir")"

  status_out="$(cd "$repo_dir" && git status --short)"
  if [[ -n "$status_out" ]]; then
    log_info 'Git status:'
    printf '%s\n' "$status_out"
  else
    log_info 'Git status: clean'
  fi

  unstaged_out="$(cd "$repo_dir" && git diff --stat)"
  if [[ -n "$unstaged_out" ]]; then
    log_info 'Unstaged diff:'
    printf '%s\n' "$unstaged_out"
  else
    log_info 'Unstaged diff: none'
  fi

  staged_out="$(cd "$repo_dir" && git diff --cached --stat)"
  if [[ -n "$staged_out" ]]; then
    log_info 'Staged diff:'
    printf '%s\n' "$staged_out"
  else
    log_info 'Staged diff: none'
  fi

  if git -C "$repo_dir" rev-parse '@{u}' >/dev/null 2>&1; then
    unpushed_out="$(cd "$repo_dir" && git log '@{u}..HEAD' --oneline -20)"
    if [[ -n "$unpushed_out" ]]; then
      log_info 'Unpushed commits:'
      printf '%s\n' "$unpushed_out"
    else
      log_info 'Unpushed commits: none'
    fi

    unpulled_out="$(cd "$repo_dir" && git log 'HEAD..@{u}' --oneline -20)"
    if [[ -n "$unpulled_out" ]]; then
      log_info 'Unpulled commits:'
      printf '%s\n' "$unpulled_out"
    else
      log_info 'Unpulled commits: none'
    fi
  else
    log_info 'Unpushed / unpulled commits: no upstream configured'
  fi
}

# One-line JSON for Waybar (no log noise). Same repos as cmd_diff.
cmd_diff_status() {
  local issues=0
  local -a segments=()
  local name path dirty ahead

  _diff_status_json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    printf '%s' "$s"
  }

  _diff_status_scan() {
    name="$1"
    path="$2"
    if ! git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      return 0
    fi
    dirty=0
    [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]] && dirty=1
    ahead=0
    if git -C "$path" rev-parse '@{u}' >/dev/null 2>&1; then
      ahead="$(git -C "$path" rev-list --count '@{u}..HEAD' 2>/dev/null || printf '0')"
    fi
    if [[ "$dirty" -eq 1 ]] || [[ "${ahead:-0}" -gt 0 ]]; then
      issues=$((issues + 1))
      local detail=()
      [[ "$dirty" -eq 1 ]] && detail+=("dirty")
      [[ "${ahead:-0}" -gt 0 ]] && detail+=("${ahead} unpushed")
      segments+=("${name} (${detail[*]})")
    fi
  }

  _diff_status_scan 'public' "$PUBLIC_DOTFILES"

  if can_use_private; then
    _diff_status_scan 'private' "$PRIVATE_DOTFILES"
    _diff_status_scan 'notes' "$NOTES_REPO_DIR"
  fi

  if is_truthy "$INCLUDE_OMARCHY_DIFF_REPOS"; then
    local om_name
    for om_name in "${OMARCHY_DIFF_REPOS[@]}"; do
      _diff_status_scan "omarchy:${om_name}" "$OMARCHY_REPO_BASE/$om_name"
    done
  fi

  local text tooltip class json_tip
  if [[ "$issues" -eq 0 ]]; then
    text=''
    tooltip='dot diff: all repos clean'
    class='dots-ok'
  else
    text=" ${issues}"
    tooltip='dot diff: '
    local i=0
    local seg
    for seg in "${segments[@]}"; do
      [[ $i -gt 0 ]] && tooltip+='; '
      tooltip+="$seg"
      i=$((i + 1))
    done
    class='dots-attention'
  fi

  json_tip="$(_diff_status_json_escape "$tooltip")"
  printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$text" "$json_tip" "$class"
}

can_use_private() {
  case "$PRIVATE_MODE" in
    always)
      PRIVATE_REASON='DOT_ALLOW_PRIVATE=always'
      return 0
      ;;
    never)
      PRIVATE_REASON='DOT_ALLOW_PRIVATE=never'
      return 1
      ;;
    auto)
      ;;
    *)
      log_warn "Unknown DOT_ALLOW_PRIVATE value '$PRIVATE_MODE', using auto"
      ;;
  esac

  if [[ ! -d "$PRIVATE_DOTFILES" || ! -r "$PRIVATE_DOTFILES" ]]; then
    PRIVATE_REASON="private repo not present/readable ($(display_path "$PRIVATE_DOTFILES"))"
    return 1
  fi

  if ! [[ -O "$PRIVATE_DOTFILES" ]]; then
    PRIVATE_REASON="private repo is not owned by current user ($(display_path "$PRIVATE_DOTFILES"))"
    return 1
  fi

  if has_cmd gh && gh auth status >/dev/null 2>&1; then
    local gh_login
    gh_login="$(gh api user --jq .login 2>/dev/null || true)"
    if [[ -n "$gh_login" && "$gh_login" != "$EXPECTED_GH_USER" ]]; then
      PRIVATE_REASON="gh user '$gh_login' does not match '$EXPECTED_GH_USER'"
      return 1
    fi
  fi

  PRIVATE_REASON='private repo access granted'
  return 0
}

backup_public_files_for_install() {
  local backup_root="$PUBLIC_DOTFILES/backup"

  if [[ -f "$HOME/.zshrc" ]]; then
    mkdir -p "$backup_root"
    log_info "Backup: $(display_path "$HOME/.zshrc") -> $(display_path "$backup_root")"
    mv "$HOME/.zshrc" "$backup_root"
  fi

  if [[ -f "$HOME/.editorconfig" ]]; then
    mkdir -p "$backup_root"
    log_info "Backup: $(display_path "$HOME/.editorconfig") -> $(display_path "$backup_root")"
    mv "$HOME/.editorconfig" "$backup_root"
  fi

  if [[ -f "$HOME/.config/ghostty/config.toml" ]]; then
    mkdir -p "$backup_root/.config/ghostty"
    log_info "Backup: $(display_path "$HOME/.config/ghostty/config.toml") -> $(display_path "$backup_root/.config/ghostty")"
    mv "$HOME/.config/ghostty/config.toml" "$backup_root/.config/ghostty"
  fi

  if [[ -d "$HOME/.config/nvim" ]]; then
    mkdir -p "$backup_root/.config"
    log_info "Backup: $(display_path "$HOME/.config/nvim") -> $(display_path "$backup_root/.config")"
    mv "$HOME/.config/nvim" "$backup_root/.config"
  fi
}

install_public_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PUBLIC_DOTFILES" 'public dotfiles'

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  migrate_legacy_opencode_package "$PUBLIC_DOTFILES" 'public'
  migrate_legacy_cursor_package "$PUBLIC_DOTFILES" 'public'

  backup_public_files_for_install

  mapfile -t folders < <(list_stow_folders "$PUBLIC_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[public] stow $folder (repo: $(display_path "$PUBLIC_DOTFILES"))"
    stow_in_repo "$PUBLIC_DOTFILES" -D "$folder"

    if [[ "$folder" == 'agents' ]]; then
      stow_in_repo "$PUBLIC_DOTFILES" --no-folding --adopt "$folder"
    else
      stow_in_repo "$PUBLIC_DOTFILES" --adopt "$folder"
    fi
  done
}

stow_public_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PUBLIC_DOTFILES" 'public dotfiles'

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  migrate_legacy_opencode_package "$PUBLIC_DOTFILES" 'public'
  migrate_legacy_cursor_package "$PUBLIC_DOTFILES" 'public'

  mapfile -t folders < <(list_stow_folders "$PUBLIC_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[public] stow $folder (repo: $(display_path "$PUBLIC_DOTFILES"))"
    if [[ "$folder" == 'agents' ]]; then
      stow_in_repo "$PUBLIC_DOTFILES" --no-folding "$folder"
    else
      stow_in_repo "$PUBLIC_DOTFILES" "$folder"
    fi
  done
}

clean_public_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PUBLIC_DOTFILES" 'public dotfiles'

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  mapfile -t folders < <(list_stow_folders "$PUBLIC_DOTFILES" true)
  for folder in "${folders[@]}"; do
    log_info "[public] remove $folder (repo: $(display_path "$PUBLIC_DOTFILES"))"
    stow_in_repo "$PUBLIC_DOTFILES" -D "$folder"
  done
}

install_private_agents() {
  local opencode_target="$HOME/.config/opencode/opencode.json"
  local backup_dir="$PRIVATE_DOTFILES/backup/opencode"

  if [[ -e "$opencode_target" && ! -L "$opencode_target" ]]; then
    mkdir -p "$backup_dir"
    log_info "Backup: $(display_path "$opencode_target") -> $(display_path "$backup_dir")"
    mv "$opencode_target" "$backup_dir/opencode.json.$(date +%Y%m%d-%H%M%S)"
  fi

  stow_in_repo "$PRIVATE_DOTFILES" \
    --no-folding \
    --ignore=node_modules \
    --ignore=package\.json \
    --ignore=bun\.lock \
    --ignore=\.gitignore \
    agents
}

install_private_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PRIVATE_DOTFILES" 'private dotfiles'

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  migrate_legacy_opencode_package "$PRIVATE_DOTFILES" 'private'
  migrate_legacy_private_claude_package
  migrate_legacy_cursor_package "$PRIVATE_DOTFILES" 'private'

  mapfile -t folders < <(list_stow_folders "$PRIVATE_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[private] stow $folder (repo: $(display_path "$PRIVATE_DOTFILES"))"
    stow_in_repo "$PRIVATE_DOTFILES" -D "$folder"

    if [[ "$folder" == 'agents' ]]; then
      install_private_agents
    else
      stow_in_repo "$PRIVATE_DOTFILES" "$folder"
    fi
  done
}

stow_private_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PRIVATE_DOTFILES" 'private dotfiles'

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  migrate_legacy_opencode_package "$PRIVATE_DOTFILES" 'private'
  migrate_legacy_private_claude_package
  migrate_legacy_cursor_package "$PRIVATE_DOTFILES" 'private'

  mapfile -t folders < <(list_stow_folders "$PRIVATE_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[private] stow $folder (repo: $(display_path "$PRIVATE_DOTFILES"))"
    if [[ "$folder" == 'agents' ]]; then
      stow_in_repo "$PRIVATE_DOTFILES" \
        --no-folding \
        --ignore=node_modules \
        --ignore=package\.json \
        --ignore=bun\.lock \
        --ignore=\.gitignore \
        "$folder"
    else
      stow_in_repo "$PRIVATE_DOTFILES" "$folder"
    fi
  done
}

clean_private_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PRIVATE_DOTFILES" 'private dotfiles'

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  mapfile -t folders < <(list_stow_folders "$PRIVATE_DOTFILES" true)
  for folder in "${folders[@]}"; do
    log_info "[private] remove $folder (repo: $(display_path "$PRIVATE_DOTFILES"))"
    stow_in_repo "$PRIVATE_DOTFILES" -D "$folder"
  done
}

run_setup_packages() {
  local confirm=false
  local arg
  local -a install_flags

  for arg in "$@"; do
    case "$arg" in
      --confirm)
        confirm=true
        ;;
      *)
        log_error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  if ! has_cmd yay; then
    log_error 'Required command missing: yay (setup)'
    return 1
  fi

  log_section 'System update'
  yay -Syu

  install_flags=(--needed --noconfirm)
  if [[ "$confirm" == 'true' ]]; then
    install_flags=(--needed)
  fi

  install_group() {
    local title="$1"
    shift

    log_section "$title"
    yay -S "${install_flags[@]}" "$@"
  }

  install_group 'Root (dotfiles management & tooling)' stow zsh
  install_group 'gamescope/' gamescope
  install_group 'ghostty/' ghostty
  install_group 'hyprland/' blueman flatpak network-manager-applet
  install_group 'hyprland/.config/hypr/scripts/' edid-decode vkbasalt
  install_group 'nvim/' go neovim nodejs python python-pip uv

  log_section 'nvim/ (Global npm)'
  npm install -g prettier

  install_group 'qt5ct/' qt5ct
  install_group 'swaync/' swaync
  install_group 'wofi/' wofi

  printf '\n'
  log_warn "This is not every package needed for these dotfiles, but it's a good starting point."
}

cmd_init() {
  local -a sync_args=()
  local -a setup_args=()
  local branch_override=''
  local has_branch_override=0
  local prev_noninteractive="$INIT_NONINTERACTIVE"
  local prev_omarchy_branch="$OMARCHY_BRANCH"

  log_section 'Initialization workflow'

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --confirm)
        setup_args+=("$1")
        ;;
      --noninteractive)
        INIT_NONINTERACTIVE=1
        ;;
      --interactive)
        INIT_NONINTERACTIVE=0
        ;;
      --branch)
        if [[ -z "${2:-}" ]]; then
          log_error '--branch requires a value'
          return 1
        fi
        branch_override="$2"
        has_branch_override=1
        sync_args+=("$1" "$2")
        shift
        ;;
      --branch=*)
        branch_override="${1#*=}"
        has_branch_override=1
        sync_args+=("$1")
        ;;
      --bootstrap-branch)
        if [[ -z "${2:-}" ]]; then
          log_error '--bootstrap-branch requires a value'
          return 1
        fi
        sync_args+=("$1" "$2")
        shift
        ;;
      --bootstrap-branch=*)
        sync_args+=("$1")
        ;;
      *)
        log_error "Unknown init option: $1"
        return 1
        ;;
    esac
    shift
  done

  if [[ -n "$branch_override" ]]; then
    OMARCHY_BRANCH="$branch_override"
  fi

  run_init_questionnaire

  if [[ -n "${INIT_SELECTED_OMARCHY_BRANCH:-}" && $has_branch_override -eq 0 ]]; then
    sync_args+=(--branch "$INIT_SELECTED_OMARCHY_BRANCH")
  fi

  omarchy_sync_repos "${sync_args[@]}"
  run_bootstrap_init_if_requested
  run_setup_packages "${setup_args[@]}"
  install_public_dotfiles

  if can_use_private; then
    install_private_dotfiles
  else
    log_warn "Skipping private install ($PRIVATE_REASON)"
  fi

  INIT_NONINTERACTIVE="$prev_noninteractive"
  OMARCHY_BRANCH="$prev_omarchy_branch"
}

cmd_update() {
  log_section 'Update workflow'

  migrate_legacy_opencode_package "$PUBLIC_DOTFILES" 'public'
  migrate_legacy_cursor_package "$PUBLIC_DOTFILES" 'public'
  if can_use_private; then
    migrate_legacy_opencode_package "$PRIVATE_DOTFILES" 'private'
    migrate_legacy_private_claude_package
    migrate_legacy_cursor_package "$PRIVATE_DOTFILES" 'private'
  fi

  if is_truthy "$INCLUDE_OMARCHY_UPDATE_REPOS"; then
    log_section 'Omarchy repo sync'
    omarchy_sync_repos
  else
    log_warn "Skipping Omarchy repo update pulls (DOT_INCLUDE_OMARCHY_UPDATE_REPOS=$INCLUDE_OMARCHY_UPDATE_REPOS)"
  fi

  log_section 'Public repo pull'
  safe_pull_repo 'dotfiles' "$PUBLIC_DOTFILES"

  if can_use_private; then
    log_section 'Private repo pull'
    safe_pull_repo 'dotfiles-private' "$PRIVATE_DOTFILES"
    log_section 'Notes repo pull'
    safe_pull_repo 'notes' "$NOTES_REPO_DIR"
  else
    log_warn "Skipping private and notes pull ($PRIVATE_REASON)"
  fi

  log_section 'Stow public dotfiles'
  stow_public_dotfiles

  if can_use_private; then
    log_section 'Stow private dotfiles'
    stow_private_dotfiles
  else
    log_warn "Skipping private stow ($PRIVATE_REASON)"
  fi

  maybe_agents_sync_after_update
  maybe_memory_update_after_update
}

cmd_agents_sync() {
  if is_truthy "${DOT_MEMORY_ON_AGENTS_SYNC:-1}"; then
    if ! cmd_memory; then
      log_warn 'dot memory failed; mirroring existing AGENTS.md to the Cursor rule'
    fi
  fi

  log_section 'Agents rules sync'
  if run_agents_sync; then
    log_info 'agents-sync finished'
  else
    log_warn 'agents-sync did not update the rule (see messages above)'
  fi
}

cmd_stow() {
  log_section 'Stow workflow'
  stow_public_dotfiles

  if can_use_private; then
    stow_private_dotfiles
  else
    log_warn "Skipping private stow ($PRIVATE_REASON)"
  fi
}

cmd_setup() {
  run_setup_packages "$@"
}

cmd_install() {
  log_section 'Install workflow'
  install_public_dotfiles

  if can_use_private; then
    install_private_dotfiles
  else
    log_warn "Skipping private install ($PRIVATE_REASON)"
  fi
}

cmd_clean() {
  log_section 'Clean workflow'
  if can_use_private; then
    clean_private_dotfiles
  else
    log_warn "Skipping private clean ($PRIVATE_REASON)"
  fi

  clean_public_dotfiles
}

cmd_doctor() {
  local issues=0
  local warnings=0

  log_section 'Dependency checks'

  require_cmd() {
    local cmd="$1"
    local purpose="$2"
    if has_cmd "$cmd"; then
      log_info "$cmd is available ($purpose)"
    else
      log_error "$cmd is missing ($purpose)"
      issues=$((issues + 1))
    fi
  }

  optional_cmd() {
    local cmd="$1"
    local purpose="$2"
    if has_cmd "$cmd"; then
      log_info "$cmd is available ($purpose)"
    else
      log_warn "$cmd is missing ($purpose)"
      warnings=$((warnings + 1))
    fi
  }

  require_cmd git 'repo sync/diff'
  require_cmd stow 'dotfile linking'
  require_cmd bash 'dot runtime'
  optional_cmd yay 'dot setup / dot init package install'
  optional_cmd npm 'global prettier install in setup'
  optional_cmd gh 'branch discovery + authenticated clone convenience'
  optional_cmd gum 'interactive init questionnaire'

  if has_cmd gh; then
    if gh auth status >/dev/null 2>&1; then
      log_info 'gh authentication is active'
    else
      log_warn 'gh is installed but not authenticated (branch questionnaire discovery disabled)'
      warnings=$((warnings + 1))
    fi
  fi

  if [[ -d "$PUBLIC_DOTFILES" ]]; then
    log_section 'Repository checks'
    log_info "Found $(display_path "$PUBLIC_DOTFILES")"
  else
    log_section 'Repository checks'
    log_error "Missing $(display_path "$PUBLIC_DOTFILES")"
    issues=$((issues + 1))
  fi

  if [[ -d "$PRIVATE_DOTFILES" ]]; then
    log_info "Found $(display_path "$PRIVATE_DOTFILES")"
  else
    log_warn "Missing $(display_path "$PRIVATE_DOTFILES")"
    warnings=$((warnings + 1))
  fi

  if is_truthy "$INCLUDE_OMARCHY_DIFF_REPOS" || is_truthy "$INCLUDE_OMARCHY_UPDATE_REPOS"; then
    log_section 'Omarchy repository checks'
    local repo_name
    local repo_path
    local repo_slug

    for repo_name in "${OMARCHY_DIFF_REPOS[@]}"; do
      repo_path="$OMARCHY_REPO_BASE/$repo_name"
      repo_slug="$(omarchy_repo_slug "$repo_name")"
      if [[ -e "$repo_path/.git" ]]; then
        log_info "Found $(display_path "$repo_path")"

        if omarchy_repo_matches_remote "$repo_path" "$repo_slug"; then
          log_info "Remote OK for $repo_name ($repo_slug)"
        else
          log_warn "Remote mismatch for $repo_name (expected $repo_slug)"
          warnings=$((warnings + 1))
        fi
      else
        log_warn "Missing git repo $(display_path "$repo_path")"
        warnings=$((warnings + 1))
      fi
    done
  fi

  if can_use_private; then
    log_section 'Private access'
    log_info "Private repo enabled ($PRIVATE_REASON)"
  else
    log_section 'Private access'
    log_warn "Private repo disabled ($PRIVATE_REASON)"
  fi

  if [[ $issues -eq 0 ]]; then
    if [[ $warnings -eq 0 ]]; then
      log_info 'Doctor finished: no critical issues found'
    else
      log_warn "Doctor finished: no critical issues, $warnings warning(s)"
    fi
  else
    log_error "Doctor finished: $issues critical issue(s), $warnings warning(s)"
    return 1
  fi
}

cmd_diff() {
  log_section 'Diff workflow'
  show_repo_diffs 'public' "$PUBLIC_DOTFILES"

  if can_use_private; then
    show_repo_diffs 'private' "$PRIVATE_DOTFILES"
    show_repo_diffs 'notes' "$NOTES_REPO_DIR"
  else
    log_warn "Skipping private and notes diff ($PRIVATE_REASON)"
  fi

  if is_truthy "$INCLUDE_OMARCHY_DIFF_REPOS"; then
    log_section 'Omarchy repo diffs'
    local repo_name
    local repo_path

    for repo_name in "${OMARCHY_DIFF_REPOS[@]}"; do
      repo_path="$OMARCHY_REPO_BASE/$repo_name"
      show_repo_diffs "omarchy:$repo_name" "$repo_path"
    done
  else
    log_warn "Skipping Omarchy repo diffs (DOT_INCLUDE_OMARCHY_DIFF_REPOS=$INCLUDE_OMARCHY_DIFF_REPOS)"
  fi
}

cmd_help() {
  local fmt_cmd='  %-14s  %s\n'
  local fmt_env='  %-34s%s\n'
  local fmt_init='  %-26s  %s\n'

  printf 'Usage: %s <command> [args]\n\n' "$SCRIPT_NAME"
  printf 'Commands:\n'
  printf "$fmt_cmd" 'init' 'Run questionnaire, sync omarchy repos, setup, install'
  printf "$fmt_cmd" 'update' 'Pull repos (public, private, notes), stow dotfiles (optional agents-sync + dot memory --soft)'
  printf "$fmt_cmd" 'memory' 'Refresh OpenCode durable memory (~/.opencode/AGENTS.md via memory.js --update)'
  printf "$fmt_cmd" 'stow' 'Re-stow public/private dotfiles (no git pull)'
  printf "$fmt_cmd" 'diff' 'Per-repo git status, diffs, upstream ahead/behind (unpushed commits)'
  printf "$fmt_cmd" '' 'Options: --status → one-line JSON for Waybar (same checks; no banners)'
  printf "$fmt_cmd" 'setup' 'Install packages (supports: --confirm)'
  printf "$fmt_cmd" 'install' 'Backup/adopt and install public/private dotfiles'
  printf "$fmt_cmd" 'clean' 'Unstow private then public dotfiles'
  printf "$fmt_cmd" 'doctor' 'Check dependencies and repo availability'
  printf "$fmt_cmd" 'agents-sync' 'Run dot memory then write global-agents.mdc (default: dotfiles-private agents/.cursor/rules/)'
  printf "$fmt_cmd" 'help' 'Show this help'

  printf '\nEnvironment:\n'
  printf "$fmt_env" 'DOTFILES_PUBLIC_DIR' 'Override public dotfiles path'
  printf "$fmt_env" 'DOTFILES_PRIVATE_DIR' 'Override private dotfiles path'
  printf "$fmt_env" 'DOT_NOTES_DIR' 'Notes vault git repo (default ~/Documents/notes); shown in dot diff with private'
  printf "$fmt_env" 'DOT_ALLOW_PRIVATE' 'auto|always|never (default: auto)'
  printf "$fmt_env" 'DOT_PRIVATE_GH_USER' 'Expected gh username for private actions (default: timmo001)'
  printf "$fmt_env" 'OMARCHY_REPO_BASE_DIR' 'Base directory for omarchy repos (default: ~/.config)'
  printf "$fmt_env" 'DOT_OMARCHY_BRANCH' 'Branch for hypr/waybar/ghostty/uwsm in init/update sync'
  printf "$fmt_env" 'DOT_BOOTSTRAP_BRANCH' 'Branch for bootstrap repo (default: distro/omarchy)'
  printf "$fmt_env" 'DOT_INCLUDE_OMARCHY_DIFF_REPOS' '1|0 include omarchy repos in diff (default: 1)'
  printf "$fmt_env" 'DOT_INCLUDE_OMARCHY_UPDATE_REPOS' '1|0 include omarchy repos in update pull (default: 1)'
  printf "$fmt_env" 'DOT_INIT_NONINTERACTIVE' '1|0 skip init questionnaire (default: 0)'
  printf "$fmt_env" 'DOT_AGENTS_SYNC_SOURCE' 'Path to AGENTS.md to mirror (default ~/.opencode/AGENTS.md)'
  printf "$fmt_env" 'DOT_AGENTS_SYNC_RULE_FILE' 'Cursor rule file path (default: $DOTFILES_PRIVATE_DIR/agents/.cursor/rules/global-agents.mdc)'
  printf "$fmt_env" 'DOT_AGENTS_SYNC_ON_UPDATE' '1|0 run agents-sync after dot update (default 1)'
  printf "$fmt_env" 'DOT_MEMORY_UPDATE_ON_UPDATE' '1|0 run `dot memory --soft` after dot update (default 1)'
  printf "$fmt_env" 'DOT_MEMORY_ON_AGENTS_SYNC' '1|0 run `dot memory` before mirroring in `dot agents-sync` (default 1)'

  printf '\nInit options:\n'
  printf "$fmt_init" '--confirm' 'Passes through to setup (interactive package install)'
  printf "$fmt_init" '--noninteractive' 'Skip questionnaire for this run'
  printf "$fmt_init" '--interactive' 'Force questionnaire for this run'
  printf "$fmt_init" '--branch <name>' 'Omarchy branch override for hypr/waybar/ghostty/uwsm'
  printf "$fmt_init" '--bootstrap-branch <n>' 'Bootstrap repo branch override for this run'
}

main() {
  local cmd="${1:-help}"
  shift || true

  if [[ "$cmd" == 'diff' && "${1:-}" == '--status' ]]; then
    cmd_diff_status
    return
  fi

  if [[ "$cmd" != 'help' && "$cmd" != '-h' && "$cmd" != '--help' ]]; then
    if [[ -d "$PUBLIC_DOTFILES" ]]; then
      cd "$PUBLIC_DOTFILES"
    fi

    log_header "dot $cmd"
    log_context
  fi

  case "$cmd" in
    init) cmd_init "$@" ;;
    update) cmd_update "$@" ;;
    stow) cmd_stow "$@" ;;
    diff) cmd_diff "$@" ;;
    setup) cmd_setup "$@" ;;
    install) cmd_install "$@" ;;
    clean) cmd_clean "$@" ;;
    doctor) cmd_doctor "$@" ;;
    agents-sync) cmd_agents_sync "$@" ;;
    memory) cmd_memory "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
      log_error "Unknown command: $cmd"
      cmd_help
      return 1
      ;;
  esac
}

main "$@"
