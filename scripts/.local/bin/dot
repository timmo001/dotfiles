#!/usr/bin/env bash

set -euo pipefail

SCRIPT_NAME="${0##*/}"

PUBLIC_DOTFILES="${DOTFILES_PUBLIC_DIR:-$HOME/.config/dotfiles}"
PRIVATE_DOTFILES="${DOTFILES_PRIVATE_DIR:-$HOME/.config/dotfiles-private}"

EXPECTED_GH_USER="${DOT_PRIVATE_GH_USER:-timmo001}"
PRIVATE_MODE="${DOT_ALLOW_PRIVATE:-auto}" # auto|always|never

PRIVATE_REASON=""

log_info() {
  printf '[dot] %s\n' "$*"
}

log_warn() {
  printf '[dot] WARN: %s\n' "$*" >&2
}

log_error() {
  printf '[dot] ERROR: %s\n' "$*" >&2
}

log_section() {
  printf '\n[dot] %s\n' "$*"
}

display_path() {
  local path="$1"
  local home_prefix="${HOME%/}"

  if [[ "$path" == "$home_prefix"* ]]; then
    printf '~%s\n' "${path#$home_prefix}"
  else
    printf '%s\n' "$path"
  fi
}

log_context() {
  log_info "public repo: $(display_path "$PUBLIC_DOTFILES")"
  log_info "private repo: $(display_path "$PRIVATE_DOTFILES")"
  log_info "private mode: $PRIVATE_MODE"
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

require_repo_dir() {
  local repo_dir="$1"
  local name="$2"

  if [[ ! -d "$repo_dir" ]]; then
    log_error "$name directory not found: $repo_dir"
    return 1
  fi
}

list_stow_folders() {
  local repo_dir="$1"
  local include_backup="${2:-false}"
  local dir
  local folder

  shopt -s nullglob
  for dir in "$repo_dir"/*/; do
    folder="${dir%/}"
    folder="${folder##*/}"

    if [[ "$include_backup" != "true" && "$folder" == "backup" ]]; then
      continue
    fi

    printf '%s\n' "$folder"
  done
  shopt -u nullglob
}

stow_in_repo() {
  local repo_dir="$1"
  shift

  (
    cd "$repo_dir"
    stow "$@"
  )
}

safe_pull_repo() {
  local name="$1"
  local repo_dir="$2"

  if [[ ! -d "$repo_dir/.git" ]]; then
    log_warn "Skipping $name pull (not a git repo): $(display_path "$repo_dir")"
    return 0
  fi

  if ! has_cmd git; then
    log_error "git not found; cannot pull $name"
    return 1
  fi

  if [[ -n "$(git -C "$repo_dir" status --porcelain 2>/dev/null || true)" ]]; then
    log_warn "Skipping $name pull (working tree not clean): $(display_path "$repo_dir")"
    return 0
  fi

  log_info "Pulling latest for $name: $(display_path "$repo_dir")"
  git -C "$repo_dir" pull --rebase
}

show_repo_diffs() {
  local name="$1"
  local repo_dir="$2"
  local status_out
  local unstaged_out
  local staged_out

  if [[ ! -d "$repo_dir/.git" ]]; then
    log_warn "Skipping $name diff (not a git repo): $(display_path "$repo_dir")"
    return 0
  fi

  log_section "$name repo: $(display_path "$repo_dir")"

  status_out="$(git -C "$repo_dir" status --short)"
  if [[ -n "$status_out" ]]; then
    log_info 'status:'
    printf '%s\n' "$status_out"
  else
    log_info 'status: clean'
  fi

  unstaged_out="$(git -C "$repo_dir" diff --stat)"
  if [[ -n "$unstaged_out" ]]; then
    log_info 'unstaged diff:'
    printf '%s\n' "$unstaged_out"
  else
    log_info 'unstaged diff: none'
  fi

  staged_out="$(git -C "$repo_dir" diff --cached --stat)"
  if [[ -n "$staged_out" ]]; then
    log_info 'staged diff:'
    printf '%s\n' "$staged_out"
  else
    log_info 'staged diff: none'
  fi
}

can_use_private() {
  case "$PRIVATE_MODE" in
    always)
      PRIVATE_REASON='DOT_ALLOW_PRIVATE=always'
      return 0
      ;;
    never)
      PRIVATE_REASON='DOT_ALLOW_PRIVATE=never'
      return 1
      ;;
    auto)
      ;;
    *)
      log_warn "Unknown DOT_ALLOW_PRIVATE value '$PRIVATE_MODE', using auto"
      ;;
  esac

  if [[ ! -d "$PRIVATE_DOTFILES" || ! -r "$PRIVATE_DOTFILES" ]]; then
    PRIVATE_REASON="private repo not present/readable ($(display_path "$PRIVATE_DOTFILES"))"
    return 1
  fi

  if ! [[ -O "$PRIVATE_DOTFILES" ]]; then
    PRIVATE_REASON="private repo is not owned by current user ($(display_path "$PRIVATE_DOTFILES"))"
    return 1
  fi

  if has_cmd gh && gh auth status >/dev/null 2>&1; then
    local gh_login
    gh_login="$(gh api user --jq .login 2>/dev/null || true)"
    if [[ -n "$gh_login" && "$gh_login" != "$EXPECTED_GH_USER" ]]; then
      PRIVATE_REASON="gh user '$gh_login' does not match '$EXPECTED_GH_USER'"
      return 1
    fi
  fi

  PRIVATE_REASON='private repo access granted'
  return 0
}

backup_public_files_for_install() {
  local backup_root="$PUBLIC_DOTFILES/backup"

  if [[ -f "$HOME/.zshrc" ]]; then
    mkdir -p "$backup_root"
    log_info "backup: $(display_path "$HOME/.zshrc") -> $(display_path "$backup_root")"
    mv "$HOME/.zshrc" "$backup_root"
  fi

  if [[ -f "$HOME/.editorconfig" ]]; then
    mkdir -p "$backup_root"
    log_info "backup: $(display_path "$HOME/.editorconfig") -> $(display_path "$backup_root")"
    mv "$HOME/.editorconfig" "$backup_root"
  fi

  if [[ -f "$HOME/.config/ghostty/config.toml" ]]; then
    mkdir -p "$backup_root/.config/ghostty"
    log_info "backup: $(display_path "$HOME/.config/ghostty/config.toml") -> $(display_path "$backup_root/.config/ghostty")"
    mv "$HOME/.config/ghostty/config.toml" "$backup_root/.config/ghostty"
  fi

  if [[ -d "$HOME/.config/nvim" ]]; then
    mkdir -p "$backup_root/.config"
    log_info "backup: $(display_path "$HOME/.config/nvim") -> $(display_path "$backup_root/.config")"
    mv "$HOME/.config/nvim" "$backup_root/.config"
  fi
}

install_public_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PUBLIC_DOTFILES" 'public dotfiles'

  if ! has_cmd stow; then
    log_error 'stow is required'
    return 1
  fi

  backup_public_files_for_install

  mapfile -t folders < <(list_stow_folders "$PUBLIC_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[public] stow $folder (repo: $(display_path "$PUBLIC_DOTFILES"))"
    stow_in_repo "$PUBLIC_DOTFILES" -D "$folder"

    if [[ "$folder" == 'opencode' ]]; then
      stow_in_repo "$PUBLIC_DOTFILES" --no-folding --adopt "$folder"
    else
      stow_in_repo "$PUBLIC_DOTFILES" --adopt "$folder"
    fi
  done
}

stow_public_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PUBLIC_DOTFILES" 'public dotfiles'

  if ! has_cmd stow; then
    log_error 'stow is required'
    return 1
  fi

  mapfile -t folders < <(list_stow_folders "$PUBLIC_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[public] stow $folder (repo: $(display_path "$PUBLIC_DOTFILES"))"
    stow_in_repo "$PUBLIC_DOTFILES" "$folder"
  done
}

clean_public_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PUBLIC_DOTFILES" 'public dotfiles'

  if ! has_cmd stow; then
    log_error 'stow is required'
    return 1
  fi

  mapfile -t folders < <(list_stow_folders "$PUBLIC_DOTFILES" true)
  for folder in "${folders[@]}"; do
    log_info "[public] remove $folder (repo: $(display_path "$PUBLIC_DOTFILES"))"
    stow_in_repo "$PUBLIC_DOTFILES" -D "$folder"
  done
}

install_private_opencode() {
  local opencode_target="$HOME/.config/opencode/opencode.json"
  local backup_dir="$PRIVATE_DOTFILES/backup/opencode"

  if [[ -e "$opencode_target" && ! -L "$opencode_target" ]]; then
    mkdir -p "$backup_dir"
    log_info "backup: $(display_path "$opencode_target") -> $(display_path "$backup_dir")"
    mv "$opencode_target" "$backup_dir/opencode.json.$(date +%Y%m%d-%H%M%S)"
  fi

  stow_in_repo "$PRIVATE_DOTFILES" \
    --no-folding \
    --ignore=node_modules \
    --ignore=package\.json \
    --ignore=bun\.lock \
    --ignore=\.gitignore \
    opencode
}

install_private_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PRIVATE_DOTFILES" 'private dotfiles'

  if ! has_cmd stow; then
    log_error 'stow is required'
    return 1
  fi

  mapfile -t folders < <(list_stow_folders "$PRIVATE_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[private] stow $folder (repo: $(display_path "$PRIVATE_DOTFILES"))"
    stow_in_repo "$PRIVATE_DOTFILES" -D "$folder"

    if [[ "$folder" == 'opencode' ]]; then
      install_private_opencode
    else
      stow_in_repo "$PRIVATE_DOTFILES" "$folder"
    fi
  done
}

stow_private_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PRIVATE_DOTFILES" 'private dotfiles'

  if ! has_cmd stow; then
    log_error 'stow is required'
    return 1
  fi

  mapfile -t folders < <(list_stow_folders "$PRIVATE_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[private] stow $folder (repo: $(display_path "$PRIVATE_DOTFILES"))"
    stow_in_repo "$PRIVATE_DOTFILES" "$folder"
  done
}

clean_private_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PRIVATE_DOTFILES" 'private dotfiles'

  if ! has_cmd stow; then
    log_error 'stow is required'
    return 1
  fi

  mapfile -t folders < <(list_stow_folders "$PRIVATE_DOTFILES" true)
  for folder in "${folders[@]}"; do
    log_info "[private] remove $folder (repo: $(display_path "$PRIVATE_DOTFILES"))"
    stow_in_repo "$PRIVATE_DOTFILES" -D "$folder"
  done
}

run_setup_packages() {
  local confirm=false
  local arg
  local -a install_flags

  for arg in "$@"; do
    case "$arg" in
      --confirm)
        confirm=true
        ;;
      *)
        log_error "Unknown option: $arg"
        return 1
        ;;
    esac
  done

  if ! has_cmd yay; then
    log_error 'yay is required for setup'
    return 1
  fi

  log_section 'System update'
  yay -Syu

  install_flags=(--needed --noconfirm)
  if [[ "$confirm" == 'true' ]]; then
    install_flags=(--needed)
  fi

  install_group() {
    local title="$1"
    shift

    log_section "$title"
    yay -S "${install_flags[@]}" "$@"
  }

  install_group 'Root (dotfiles management & tooling)' base-devel git stow yay-bin zsh
  install_group 'gamescope/' gamescope
  install_group 'ghostty/' ghostty
  install_group 'hyprland/' blueman flatpak hyprland network-manager-applet polkit-gnome swaybg wl-clipboard
  install_group 'hyprland/.config/hypr/scripts/' edid-decode jq vkbasalt
  install_group 'lazygit/' lazygit
  install_group 'nvim/' go neovim nodejs python python-pip ripgrep uv

  log_section 'nvim/ (global npm)'
  npm install -g prettier

  install_group 'qt5ct/' qt5ct
  install_group 'starship/' starship
  install_group 'swaync/' swaync
  install_group 'waybar/' playerctl python-gobject waybar
  install_group 'wofi/' wofi

  printf '\n'
  log_warn "This is not every package needed for these dotfiles, but it's a good starting point."
}

cmd_init() {
  run_setup_packages "$@"
  install_public_dotfiles

  if can_use_private; then
    install_private_dotfiles
  else
    log_warn "Skipping private install ($PRIVATE_REASON)"
  fi
}

cmd_update() {
  safe_pull_repo 'dotfiles' "$PUBLIC_DOTFILES"

  if can_use_private; then
    safe_pull_repo 'dotfiles-private' "$PRIVATE_DOTFILES"
  else
    log_warn "Skipping private pull ($PRIVATE_REASON)"
  fi

  stow_public_dotfiles

  if can_use_private; then
    stow_private_dotfiles
  else
    log_warn "Skipping private stow ($PRIVATE_REASON)"
  fi
}

cmd_stow() {
  stow_public_dotfiles

  if can_use_private; then
    stow_private_dotfiles
  else
    log_warn "Skipping private stow ($PRIVATE_REASON)"
  fi
}

cmd_setup() {
  run_setup_packages "$@"
}

cmd_install() {
  install_public_dotfiles

  if can_use_private; then
    install_private_dotfiles
  else
    log_warn "Skipping private install ($PRIVATE_REASON)"
  fi
}

cmd_clean() {
  if can_use_private; then
    clean_private_dotfiles
  else
    log_warn "Skipping private clean ($PRIVATE_REASON)"
  fi

  clean_public_dotfiles
}

cmd_doctor() {
  local issues=0

  for cmd in git stow bash; do
    if has_cmd "$cmd"; then
      log_info "$cmd is available"
    else
      log_warn "$cmd is missing"
      issues=$((issues + 1))
    fi
  done

  for path in "$PUBLIC_DOTFILES" "$PRIVATE_DOTFILES"; do
    if [[ -d "$path" ]]; then
      log_info "found $(display_path "$path")"
    else
      log_warn "missing $(display_path "$path")"
    fi
  done

  if can_use_private; then
    log_info "private repo enabled ($PRIVATE_REASON)"
  else
    log_warn "private repo disabled ($PRIVATE_REASON)"
  fi

  if [[ $issues -eq 0 ]]; then
    log_info 'doctor finished: no critical issues found'
  else
    log_warn "doctor finished: $issues critical issue(s) found"
    return 1
  fi
}

cmd_diff() {
  show_repo_diffs 'public' "$PUBLIC_DOTFILES"

  if can_use_private; then
    show_repo_diffs 'private' "$PRIVATE_DOTFILES"
  else
    log_warn "Skipping private diff ($PRIVATE_REASON)"
  fi
}

cmd_help() {
  cat <<EOF
Usage: $SCRIPT_NAME <command> [args]

Commands:
  init         Run setup, then install public/private dotfiles
  update       Pull repos, then stow public/private dotfiles
  stow         Re-stow public/private dotfiles (no git pull)
  diff         Show git status and diff summary for repos
  setup        Install packages (supports: --confirm)
  install      Backup/adopt and install public/private dotfiles
  clean        Unstow private then public dotfiles
  doctor       Check dependencies and repo availability
  help         Show this help

Environment:
  DOTFILES_PUBLIC_DIR   Override public dotfiles path
  DOTFILES_PRIVATE_DIR  Override private dotfiles path
  DOT_ALLOW_PRIVATE     auto|always|never (default: auto)
  DOT_PRIVATE_GH_USER   Expected gh username for private actions (default: timmo001)
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true

  if [[ "$cmd" != 'help' && "$cmd" != '-h' && "$cmd" != '--help' ]]; then
    if [[ -d "$PUBLIC_DOTFILES" ]]; then
      cd "$PUBLIC_DOTFILES"
    fi

    log_context
  fi

  case "$cmd" in
    init) cmd_init "$@" ;;
    update) cmd_update "$@" ;;
    stow) cmd_stow "$@" ;;
    diff) cmd_diff "$@" ;;
    setup) cmd_setup "$@" ;;
    install) cmd_install "$@" ;;
    clean) cmd_clean "$@" ;;
    doctor) cmd_doctor "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
      log_error "Unknown command: $cmd"
      cmd_help
      return 1
      ;;
  esac
}

main "$@"
