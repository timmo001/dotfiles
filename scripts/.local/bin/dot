#!/usr/bin/env bash

set -euo pipefail

SCRIPT_NAME="${0##*/}"
# Absolute path to this script (for re-invoking commands, e.g. dot update → dot memory).
DOT_SELF="${BASH_SOURCE[0]:-$0}"

PUBLIC_DOTFILES="${DOTFILES_PUBLIC_DIR:-$HOME/.config/dotfiles}"
PRIVATE_DOTFILES="${DOTFILES_PRIVATE_DIR:-$HOME/.config/dotfiles-private}"
NOTES_REPO_DIR="${DOT_NOTES_DIR:-$HOME/Documents/notes}"
PRIVATE_EXTRA_REPOS_FILE="${DOT_PRIVATE_EXTRA_REPOS_FILE:-$PRIVATE_DOTFILES/.dot-extra-repos}"

EXPECTED_GH_USER="${DOT_PRIVATE_GH_USER:-timmo001}"
PRIVATE_MODE="${DOT_ALLOW_PRIVATE:-auto}" # auto|always|never
INCLUDE_OMARCHY_DIFF_REPOS="${DOT_INCLUDE_OMARCHY_DIFF_REPOS:-1}"
INCLUDE_OMARCHY_UPDATE_REPOS="${DOT_INCLUDE_OMARCHY_UPDATE_REPOS:-1}"
INIT_NONINTERACTIVE="${DOT_INIT_NONINTERACTIVE:-0}"
DOT_AGENTS_SYNC_ON_UPDATE="${DOT_AGENTS_SYNC_ON_UPDATE:-1}"
DOT_MEMORY_ON_AGENTS_SYNC="${DOT_MEMORY_ON_AGENTS_SYNC:-1}"
DOT_FETCH_TTL_SECONDS="${DOT_FETCH_TTL_SECONDS:-300}"
DOT_FETCH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dot/fetch-upstream"
DOT_WORKFLOW_WATCH_HOOKS_PATH="${DOT_WORKFLOW_WATCH_HOOKS_PATH:-$HOME/.config/git/workflow-watch-hooks}"
DOT_WORKFLOW_WATCH_REPOS_FILE="${DOT_WORKFLOW_WATCH_REPOS_FILE:-$PRIVATE_DOTFILES/.git-workflow-watch-repos}"
DOT_WORKFLOW_WATCH_TIMER_UNIT="${DOT_WORKFLOW_WATCH_TIMER_UNIT:-git-workflow-watch.timer}"
DOT_BROWSER_FREEZE_TIMER_UNIT="${DOT_BROWSER_FREEZE_TIMER_UNIT:-browser-freeze-snapshot.timer}"
DOT_DOCTOR_STARTUP_TIMER_UNIT="${DOT_DOCTOR_STARTUP_TIMER_UNIT:-dot-doctor-startup.timer}"
DOT_DAILY_VOLUME_ZERO_TIMER_UNIT="${DOT_DAILY_VOLUME_ZERO_TIMER_UNIT:-daily-volume-zero.timer}"

OMARCHY_REPO_BASE="${OMARCHY_REPO_BASE_DIR:-$HOME/.config}"
OMARCHY_DIFF_REPOS=(hypr waybar bootstrap ghostty uwsm)
OMARCHY_WORKTREE_REPOS=(hypr)
OMARCHY_WORKTREE_BRANCHES=(desktop laptop)
OMARCHY_SINGLE_BRANCH_REPOS=(bootstrap waybar ghostty uwsm)
OMARCHY_BRANCH="${DOT_OMARCHY_BRANCH:-}"
BOOTSTRAP_BRANCH="${DOT_BOOTSTRAP_BRANCH:-distro/omarchy}"

OMARCHY_TARGET_NAMES=()
OMARCHY_TARGET_PATHS=()
UPDATED_REPO_NAMES=()

DIFF_ATTENTION_ISSUES=0
DIFF_ATTENTION_SEGMENTS=()
DIFF_ATTENTION_PATHS=()
DIFF_ATTENTION_HAS_DIRTY=0
DIFF_ATTENTION_HAS_AHEAD=0
DIFF_ATTENTION_HAS_BEHIND=0
DIFF_ATTENTION_VERBOSE=0

PRIVATE_REASON=""

PUBLIC_ARCH_PACKAGES=(
  system-bridge-git
  go-automate-git
  python-gobject
  gtk4-layer-shell
  topgrade-bin
  cpio
  stress-ng
  sysbench
  iperf3
  sysstat
  bmon
  smem
)
MISSING_PUBLIC_ARCH_PACKAGES=()

PRIVATE_ARCH_PACKAGES=()
MISSING_PRIVATE_ARCH_PACKAGES=()

DOT_PRIVATE_PACKAGE_REPO_FILE_DEFAULT="$PRIVATE_DOTFILES/.dot-private-package-repo"
DOT_PRIVATE_PACKAGE_REPO_FILE="${DOT_PRIVATE_PACKAGE_REPO_FILE:-$DOT_PRIVATE_PACKAGE_REPO_FILE_DEFAULT}"
DOT_PRIVATE_PACKAGES_FILE_DEFAULT="$PRIVATE_DOTFILES/.dot-private-packages"
DOT_PRIVATE_PACKAGES_FILE="${DOT_PRIVATE_PACKAGES_FILE:-$DOT_PRIVATE_PACKAGES_FILE_DEFAULT}"
DOT_PRIVATE_PACMAN_REPO_CONFIG_DEFAULT='/etc/pacman.d/timmo-private.conf'
DOT_PRIVATE_PACMAN_REPO_CONFIG="${DOT_PRIVATE_PACMAN_REPO_CONFIG:-$DOT_PRIVATE_PACMAN_REPO_CONFIG_DEFAULT}"
DOT_PRIVATE_PACMAN_MAIN_CONFIG_DEFAULT='/etc/pacman.conf'
DOT_PRIVATE_PACMAN_MAIN_CONFIG="${DOT_PRIVATE_PACMAN_MAIN_CONFIG:-$DOT_PRIVATE_PACMAN_MAIN_CONFIG_DEFAULT}"

PRIVATE_PACKAGE_REPO_NAME=''
PRIVATE_PACKAGE_REPO_PATH=''
PRIVATE_PACKAGE_REPO_MIRROR_PATH=''
PRIVATE_PACKAGE_REPO_SIGLEVEL='Optional TrustAll'

DOT_PRIVATE_BROWSER_CHECKS_FILE_DEFAULT="$PRIVATE_DOTFILES/.dot-browser-checks"
DOT_PRIVATE_BROWSER_CHECKS_FILE="${DOT_PRIVATE_BROWSER_CHECKS_FILE:-$DOT_PRIVATE_BROWSER_CHECKS_FILE_DEFAULT}"

INIT_SELECTED_OMARCHY_BRANCH=''
INIT_RUN_BOOTSTRAP=0
INIT_INSTALL_PUBLIC_ARCH_PACKAGES=1
INIT_INSTALL_PRIVATE_ARCH_PACKAGES=1

if [[ -n "${FORCE_COLOR:-}" ]] || [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  DOT_RED=$'\033[31m'
  DOT_GREEN=$'\033[32m'
  DOT_YELLOW=$'\033[33m'
  DOT_BLUE=$'\033[34m'
  DOT_MAGENTA=$'\033[35m'
  DOT_CYAN=$'\033[36m'
  DOT_BOLD=$'\033[1m'
  DOT_DIM=$'\033[2m'
  DOT_RESET=$'\033[0m'
else
  DOT_RED=''
  DOT_GREEN=''
  DOT_YELLOW=''
  DOT_BLUE=''
  DOT_MAGENTA=''
  DOT_CYAN=''
  DOT_BOLD=''
  DOT_DIM=''
  DOT_RESET=''
fi

term_width() {
  local width="${COLUMNS:-88}"

  if ! [[ "$width" =~ ^[0-9]+$ ]]; then
    width=88
  fi

  if [[ "$width" -lt 48 ]]; then
    width=48
  elif [[ "$width" -gt 120 ]]; then
    width=120
  fi

  printf '%s\n' "$width"
}

log_divider() {
  local char="${1:--}"
  local color="${2:-$DOT_DIM}"
  local width="${3:-$(term_width)}"
  local line

  line=$(printf '%*s' "$width" '')
  line=${line// /$char}
  printf '%b%s%b\n' "$color" "$line" "$DOT_RESET"
}

log_label() {
  local color="$1"
  local level="$2"
  local message="$3"
  local stream="${4:-stdout}"

  if [[ "$stream" == 'stderr' ]]; then
    printf '%b%-8s%b %s\n' "${DOT_BOLD}${color}" "[$level]" "$DOT_RESET" "$message" >&2
  else
    printf '%b%-8s%b %s\n' "${DOT_BOLD}${color}" "[$level]" "$DOT_RESET" "$message"
  fi
}

log_header() {
  local title="$1"

  printf '\n'
  log_divider '=' "$DOT_BLUE"
  printf '%b%s%b\n' "${DOT_BOLD}${DOT_BLUE}" "  $title" "$DOT_RESET"
  log_divider '=' "$DOT_BLUE"
}

log_info() {
  log_label "$DOT_CYAN" 'INFO' "$*"
}

log_warn() {
  log_label "$DOT_YELLOW" 'WARN' "$*" 'stderr'
}

log_error() {
  log_label "$DOT_RED" 'ERROR' "$*" 'stderr'
}

log_section() {
  printf '\n'
  log_divider '-' "$DOT_DIM" 72
  printf '%b%s%b\n' "${DOT_BOLD}${DOT_MAGENTA}" "  $*" "$DOT_RESET"
}

display_path() {
  local path="$1"
  local home_prefix="${HOME%/}"

  if [[ "$path" == "$home_prefix"* ]]; then
    printf '~%s\n' "${path#$home_prefix}"
  else
    printf '%s\n' "$path"
  fi
}

log_context() {
  log_info "Public repo: $(display_path "$PUBLIC_DOTFILES")"
  log_info "Private repo: $(display_path "$PRIVATE_DOTFILES")"
  log_info "Notes repo: $(display_path "$NOTES_REPO_DIR")"
  log_info "Private mode: $PRIVATE_MODE"
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

is_truthy() {
  case "${1,,}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

array_contains() {
  local needle="$1"
  shift
  local item

  for item in "$@"; do
    if [[ "$item" == "$needle" ]]; then
      return 0
    fi
  done

  return 1
}

omarchy_repo_is_single_branch() {
  local repo_name="$1"
  array_contains "$repo_name" "${OMARCHY_SINGLE_BRANCH_REPOS[@]}"
}

omarchy_repo_has_worktree_branches() {
  local repo_name="$1"

  if omarchy_repo_is_single_branch "$repo_name"; then
    return 1
  fi

  array_contains "$repo_name" "${OMARCHY_WORKTREE_REPOS[@]}"
}

omarchy_branch_ref_exists() {
  local repo_dir="$1"
  local branch="$2"

  git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$branch" \
    || git -C "$repo_dir" show-ref --verify --quiet "refs/remotes/origin/$branch"
}

trim_whitespace() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s\n' "$value"
}

expand_home_path() {
  local path="$1"

  if [[ "$path" == '~' ]]; then
    printf '%s\n' "$HOME"
    return
  fi

  if [[ "$path" == '~/'* ]]; then
    printf '%s/%s\n' "$HOME" "${path:2}"
    return
  fi

  printf '%s\n' "$path"
}

is_interactive_terminal() {
  [[ -t 0 && -t 1 ]]
}

confirm_action() {
  local prompt="$1"
  local response=''

  if ! is_interactive_terminal; then
    return 1
  fi

  if has_cmd gum; then
    gum confirm "$prompt"
    return $?
  fi

  printf '%s [y/N] ' "$prompt" > /dev/tty
  if ! read -r response < /dev/tty; then
    return 1
  fi

  case "${response,,}" in
    y|yes)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

package_installed() {
  local package_name="$1"

  has_cmd pacman && pacman -Q "$package_name" >/dev/null 2>&1
}

public_arch_package_present() {
  local package_name="$1"

  case "$package_name" in
    go-automate-git)
      package_installed 'go-automate-git' || package_installed 'go-automate'
      ;;
    *)
      package_installed "$package_name"
      ;;
  esac
}

public_arch_installed_package_name() {
  local package_name="$1"

  case "$package_name" in
    go-automate-git)
      if package_installed 'go-automate-git'; then
        printf 'go-automate-git\n'
      elif package_installed 'go-automate'; then
        printf 'go-automate\n'
      fi
      ;;
    *)
      if package_installed "$package_name"; then
        printf '%s\n' "$package_name"
      fi
      ;;
  esac
}

public_arch_package_label() {
  local package_name="$1"
  local installed_name=''

  installed_name="$(public_arch_installed_package_name "$package_name")"

  if [[ -n "$installed_name" ]]; then
    printf '%s\n' "$installed_name"
    return
  fi

  case "$package_name" in
    go-automate-git)
      printf 'go-automate\n'
      ;;
    *)
      printf '%s\n' "$package_name"
      ;;
  esac
}

public_arch_installed_version() {
  local package_name="$1"
  local installed_name="${2:-}"

  if [[ -z "$installed_name" ]]; then
    installed_name="$(public_arch_installed_package_name "$package_name")"
  fi

  [[ -n "$installed_name" ]] || return 1

  pacman -Q "$installed_name" 2>/dev/null | awk '{ print $2 }'
}

public_arch_latest_aur_version() {
  local package_name="$1"

  has_cmd yay || return 1

  yay -Si "$package_name" 2>/dev/null | sed -n 's/^Version[[:space:]]*:[[:space:]]*//p;q'
}

collect_missing_public_arch_packages() {
  local package_name

  MISSING_PUBLIC_ARCH_PACKAGES=()

  if ! has_cmd pacman; then
    return 0
  fi

  for package_name in "${PUBLIC_ARCH_PACKAGES[@]}"; do
    if ! public_arch_package_present "$package_name"; then
      MISSING_PUBLIC_ARCH_PACKAGES+=("$package_name")
    fi
  done
}

load_private_package_repo_config() {
  local config_file="$DOT_PRIVATE_PACKAGE_REPO_FILE"
  local raw_line
  local line
  local key
  local value

  PRIVATE_PACKAGE_REPO_NAME=''
  PRIVATE_PACKAGE_REPO_PATH=''
  PRIVATE_PACKAGE_REPO_MIRROR_PATH=''
  PRIVATE_PACKAGE_REPO_SIGLEVEL='Optional TrustAll'

  if [[ ! -f "$config_file" ]] || [[ ! -r "$config_file" ]]; then
    return 1
  fi

  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    line="$(trim_whitespace "$raw_line")"
    [[ -z "$line" || "${line:0:1}" == '#' ]] && continue

    key="$(trim_whitespace "${line%%=*}")"
    value="$(trim_whitespace "${line#*=}")"

    case "$key" in
      name)
        PRIVATE_PACKAGE_REPO_NAME="$value"
        ;;
      path)
        PRIVATE_PACKAGE_REPO_PATH="$(expand_home_path "$value")"
        ;;
      mirror_path)
        PRIVATE_PACKAGE_REPO_MIRROR_PATH="$(expand_home_path "$value")"
        ;;
      siglevel)
        PRIVATE_PACKAGE_REPO_SIGLEVEL="$value"
        ;;
    esac
  done < "$config_file"

  [[ -n "$PRIVATE_PACKAGE_REPO_NAME" && -n "$PRIVATE_PACKAGE_REPO_PATH" && -n "$PRIVATE_PACKAGE_REPO_MIRROR_PATH" ]]
}

load_private_arch_packages() {
  local packages_file="$DOT_PRIVATE_PACKAGES_FILE"
  local raw_line
  local line

  PRIVATE_ARCH_PACKAGES=()

  if [[ ! -f "$packages_file" ]] || [[ ! -r "$packages_file" ]]; then
    return 1
  fi

  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    line="$(trim_whitespace "$raw_line")"
    [[ -z "$line" || "${line:0:1}" == '#' ]] && continue
    PRIVATE_ARCH_PACKAGES+=("$line")
  done < "$packages_file"

  return 0
}

private_package_repo_server() {
  [[ -n "$PRIVATE_PACKAGE_REPO_MIRROR_PATH" ]] || return 1
  printf 'file://%s\n' "$PRIVATE_PACKAGE_REPO_MIRROR_PATH"
}

private_package_repo_config_contents() {
  local repo_server

  repo_server="$(private_package_repo_server)" || return 1

  cat <<EOF
[$PRIVATE_PACKAGE_REPO_NAME]
SigLevel = $PRIVATE_PACKAGE_REPO_SIGLEVEL
Server = $repo_server
EOF
}

private_package_repo_config_matches() {
  local config_path="$DOT_PRIVATE_PACMAN_REPO_CONFIG"
  local expected_contents
  local current_contents

  [[ -f "$config_path" ]] || return 1

  expected_contents="$(private_package_repo_config_contents)" || return 1
  current_contents="$(<"$config_path")"

  [[ "$current_contents" == "$expected_contents" ]]
}

private_package_repo_registered() {
  local config_path="$DOT_PRIVATE_PACMAN_REPO_CONFIG"

  [[ -n "$PRIVATE_PACKAGE_REPO_NAME" ]] || return 1
  [[ -f "$config_path" ]] || return 1
  grep -Fq "[$PRIVATE_PACKAGE_REPO_NAME]" "$config_path"
}

private_package_repo_include_line() {
  printf 'Include = %s\n' "$DOT_PRIVATE_PACMAN_REPO_CONFIG"
}

private_package_repo_include_registered() {
  local include_line

  include_line="$(private_package_repo_include_line)"
  [[ -f "$DOT_PRIVATE_PACMAN_MAIN_CONFIG" ]] || return 1
  grep -Fq "$include_line" "$DOT_PRIVATE_PACMAN_MAIN_CONFIG"
}

collect_missing_private_arch_packages() {
  local package_name

  MISSING_PRIVATE_ARCH_PACKAGES=()

  if ! has_cmd pacman; then
    return 0
  fi

  load_private_arch_packages || return 0

  for package_name in "${PRIVATE_ARCH_PACKAGES[@]}"; do
    if ! package_installed "$package_name"; then
      MISSING_PRIVATE_ARCH_PACKAGES+=("$package_name")
    fi
  done
}

private_arch_repo_latest_version() {
  local package_name="$1"

  has_cmd pacman || return 1
  pacman -Si "$package_name" 2>/dev/null | sed -n 's/^Version[[:space:]]*:[[:space:]]*//p;q'
}

install_missing_private_arch_packages() {
  local confirm="${1:-false}"

  collect_missing_private_arch_packages

  if [[ "${#MISSING_PRIVATE_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    log_info 'Private Arch packages already installed'
    return 0
  fi

  if ! has_cmd omarchy-pkg-aur-add; then
    log_warn 'Cannot install missing private Arch packages automatically (omarchy-pkg-aur-add not found)'
    return 0
  fi

  log_info "Installing missing private Arch packages: ${MISSING_PRIVATE_ARCH_PACKAGES[*]}"
  install_aur_packages "$confirm" "${MISSING_PRIVATE_ARCH_PACKAGES[@]}"
}

ensure_private_package_repo_config() {
  local config_path="$DOT_PRIVATE_PACMAN_REPO_CONFIG"
  local config_dir
  local expected_contents

  load_private_package_repo_config || return 1
  expected_contents="$(private_package_repo_config_contents)" || return 1
  config_dir="$(dirname "$config_path")"

  if [[ ! -d "$config_dir" ]] && ! mkdir -p "$config_dir"; then
    log_warn "Skipping private pacman repo config write (cannot create directory as current user: $(display_path "$config_dir"))"
    return 0
  fi

  if ! printf '%s\n' "$expected_contents" > "$config_path"; then
    log_warn "Skipping private pacman repo config write (cannot write as current user: $(display_path "$config_path"))"
    return 0
  fi
}

sync_private_package_repo_mirror() {
  load_private_package_repo_config || return 1

  if [[ ! -d "$PRIVATE_PACKAGE_REPO_PATH" ]]; then
    log_warn "Skipping private package repo mirror sync (missing source clone: $(display_path "$PRIVATE_PACKAGE_REPO_PATH"))"
    return 0
  fi

  if [[ ! -d "$PRIVATE_PACKAGE_REPO_MIRROR_PATH" ]] && ! mkdir -p "$PRIVATE_PACKAGE_REPO_MIRROR_PATH"; then
    log_warn "Skipping private package repo mirror sync (cannot create mirror path as current user: $(display_path "$PRIVATE_PACKAGE_REPO_MIRROR_PATH"))"
    return 0
  fi

  if ! rsync -a --delete --exclude '.git/' "$PRIVATE_PACKAGE_REPO_PATH/" "$PRIVATE_PACKAGE_REPO_MIRROR_PATH/"; then
    log_warn "Skipping private package repo mirror sync (cannot sync as current user: $(display_path "$PRIVATE_PACKAGE_REPO_MIRROR_PATH"))"
    return 0
  fi
}

ensure_private_package_repo_include() {
  local include_line
  local temp_file

  include_line="$(private_package_repo_include_line)"
  if private_package_repo_include_registered; then
    return 0
  fi

  temp_file="$(mktemp)"
  if ! cp "$DOT_PRIVATE_PACMAN_MAIN_CONFIG" "$temp_file"; then
    log_warn "Skipping private pacman repo include update (cannot read as current user: $(display_path "$DOT_PRIVATE_PACMAN_MAIN_CONFIG"))"
    rm -f "$temp_file"
    return 0
  fi
  printf '\n%s\n' "$include_line" >> "$temp_file"
  if ! install -m 644 "$temp_file" "$DOT_PRIVATE_PACMAN_MAIN_CONFIG"; then
    log_warn "Skipping private pacman repo include update (cannot write as current user: $(display_path "$DOT_PRIVATE_PACMAN_MAIN_CONFIG"))"
    rm -f "$temp_file"
    return 0
  fi
  rm -f "$temp_file"
}

publish_private_package() {
  local package_name="$1"
  local source_repo="$2"
  local publish_git="${3:-true}"
  local build_package="${4:-true}"
  local install_package="${5:-false}"
  local dist_dir="$source_repo/dist"
  local runtime_pkg=''
  local artifact
  local -a package_artifacts=()
  local -a published_runtime_artifacts=()
  local commit_message

  load_private_package_repo_config || return 1

  if [[ ! -d "$source_repo" ]]; then
    log_error "Missing package source repo: $(display_path "$source_repo")"
    return 1
  fi

  if [[ "$build_package" == 'true' ]]; then
    log_section "Build private package: $package_name"
    if [[ -f "$source_repo/deno.json" ]] && deno task --cwd "$source_repo" 2>/dev/null | grep -Eq '(^|[[:space:]])package:arch($|[[:space:]])'; then
      deno task --cwd "$source_repo" package:arch
    elif [[ -f "$source_repo/Makefile" ]]; then
      (cd "$source_repo" && make create_arch)
    else
      log_error "Missing package build task in $(display_path "$source_repo")"
      return 1
    fi
  else
    log_section "Use existing private package artifact: $package_name"
  fi

  if [[ ! -d "$dist_dir" ]]; then
    log_error "Missing dist directory after build: $(display_path "$dist_dir")"
    return 1
  fi

  shopt -s nullglob
  for artifact in "$dist_dir/${package_name}-"*.pkg.tar.zst; do
    if [[ "$artifact" == *-debug-* ]]; then
      continue
    fi
    package_artifacts+=("$artifact")
  done
  shopt -u nullglob

  if [[ "${#package_artifacts[@]}" -gt 0 ]]; then
    runtime_pkg="${package_artifacts[-1]}"
  fi

  if [[ -z "$runtime_pkg" ]]; then
    log_error "No runtime package artifact found for $package_name in $(display_path "$dist_dir")"
    return 1
  fi

  log_section "Publish private package: $package_name"
  shopt -s nullglob
  for artifact in "$PRIVATE_PACKAGE_REPO_PATH/${package_name}-"*.pkg.tar.zst; do
    if [[ "$artifact" == *-debug-* ]]; then
      continue
    fi
    rm -f "$artifact"
  done
  cp "$runtime_pkg" "$PRIVATE_PACKAGE_REPO_PATH/"
  rm -f "$PRIVATE_PACKAGE_REPO_PATH/${package_name}-debug-"*.pkg.tar.zst
  rm -f "$PRIVATE_PACKAGE_REPO_PATH/"*.old "$PRIVATE_PACKAGE_REPO_PATH/"*.lck
  for artifact in "$PRIVATE_PACKAGE_REPO_PATH/"*.pkg.tar.zst; do
    if [[ "$artifact" == *-debug-* ]]; then
      continue
    fi
    published_runtime_artifacts+=("$artifact")
  done
  shopt -u nullglob

  repo-add "$PRIVATE_PACKAGE_REPO_PATH/timmo-private.db.tar.gz" "${published_runtime_artifacts[@]}"
  rm -f "$PRIVATE_PACKAGE_REPO_PATH/"*.old "$PRIVATE_PACKAGE_REPO_PATH/"*.lck

  log_section 'Sync private package repo mirror'
  sync_private_package_repo_mirror

  if private_package_repo_registered && private_package_repo_include_registered; then
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
      if ! pacman -Sy; then
        log_warn 'pacman database refresh failed'
      fi
    else
      log_warn 'Skipping pacman database refresh (run manually with your preferred privilege method if needed)'
    fi
  fi

  if [[ "$install_package" == 'true' ]]; then
    log_section "Install private package: $package_name"
    if is_interactive_terminal && has_cmd yay; then
      yay -Sy --noconfirm "$package_name"
    elif [[ "${EUID:-$(id -u)}" -eq 0 ]] && has_cmd pacman; then
      pacman -Sy --noconfirm "$package_name"
    elif has_cmd pkexec && has_cmd pacman; then
      pkexec pacman -Sy --noconfirm "$package_name"
    elif has_cmd yay; then
      yay -Sy --noconfirm "$package_name" --sudo pkexec --sudoflags ""
    else
      log_error 'Cannot install package automatically (pkexec/pacman not found and not running as root)'
      return 1
    fi
  fi

  if [[ "$publish_git" == 'true' ]]; then
    commit_message="publish ${package_name} package"
    log_section 'Commit private package repo'
    git -C "$PRIVATE_PACKAGE_REPO_PATH" add .
    if ! git -C "$PRIVATE_PACKAGE_REPO_PATH" diff --cached --quiet; then
      git -C "$PRIVATE_PACKAGE_REPO_PATH" commit -m "$commit_message"
    else
      log_info 'No private package repo changes to commit'
    fi

    log_section 'Push private package repo'
    git -C "$PRIVATE_PACKAGE_REPO_PATH" push
  fi
}

cmd_private_pkg_publish() {
  local package_name=''
  local source_repo=''
  local publish_git=true
  local build_package=true
  local install_package=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-git)
        publish_git=false
        ;;
      --skip-build)
        build_package=false
        ;;
      --install)
        install_package=true
        ;;
      --help|-h)
        printf 'Usage: %s private-pkg-publish [--no-git] [--skip-build] [--install] <package-name>\n' "$SCRIPT_NAME"
        return 0
        ;;
      -*)
        log_error "Unknown private-pkg-publish option: $1"
        return 1
        ;;
      *)
        if [[ -n "$package_name" ]]; then
          log_error 'Usage: dot private-pkg-publish [--no-git] [--skip-build] [--install] <package-name>'
          return 1
        fi
        package_name="$1"
        ;;
    esac
    shift
  done

  if [[ -z "$package_name" ]]; then
    log_error 'Usage: dot private-pkg-publish [--no-git] [--skip-build] [--install] <package-name>'
    return 1
  fi

  case "$package_name" in
    twitch-notifications)
      source_repo="$HOME/repos/twitch-notifications"
      ;;
    slopops)
      source_repo="$HOME/repos/slopops"
      ;;
    *)
      log_error "No private package publish mapping configured for: $package_name"
      return 1
      ;;
  esac

  publish_private_package "$package_name" "$source_repo" "$publish_git" "$build_package" "$install_package"
}

install_aur_packages() {
  local confirm="${1:-false}"
  shift || true

  if [[ $# -eq 0 ]]; then
    return 0
  fi

  if ! has_cmd omarchy-pkg-aur-add; then
    log_warn 'Cannot install AUR packages automatically (omarchy-pkg-aur-add not found)'
    return 0
  fi

  if [[ "$confirm" == 'true' ]]; then
    log_warn '--confirm is ignored for omarchy-pkg-aur-add (it is non-interactive)'
  fi

  omarchy-pkg-aur-add "$@"
}

install_missing_public_arch_packages() {
  local confirm="${1:-false}"

  collect_missing_public_arch_packages

  if [[ "${#MISSING_PUBLIC_ARCH_PACKAGES[@]}" -eq 0 ]]; then
    log_info 'Public Arch packages already installed'
    return 0
  fi

  if ! has_cmd omarchy-pkg-aur-add; then
    log_warn 'Cannot install missing public Arch packages automatically (omarchy-pkg-aur-add not found)'
    return 0
  fi

  log_info "Installing missing public Arch packages: ${MISSING_PUBLIC_ARCH_PACKAGES[*]}"
  install_aur_packages "$confirm" "${MISSING_PUBLIC_ARCH_PACKAGES[@]}"
}

chromium_extension_id_installed() {
  local profile_dir="$1"
  local extension_id="$2"
  local prefs_file="$profile_dir/Preferences"

  [[ -f "$prefs_file" ]] || return 1
  jq -e --arg id "$extension_id" '.extensions.settings[$id] // empty' "$prefs_file" >/dev/null 2>&1
}

chromium_extension_name_installed() {
  local profile_dir="$1"
  local expected_name="$2"
  local prefs_file="$profile_dir/Preferences"

  [[ -f "$prefs_file" ]] || return 1

  local ext_path
  ext_path="$(jq -r --arg name "$expected_name" '
    .extensions.settings | to_entries[]
    | select(.value.path) | .value.path as $p
    | if (.value.manifest.name // "") == $name then $p
      else empty end
  ' "$prefs_file" 2>/dev/null | head -1)"

  if [[ -n "$ext_path" ]]; then
    return 0
  fi

  # Manifest name may not be cached in Preferences; check manifest.json at each extension path
  local path
  while IFS= read -r path; do
    [[ -f "$path/manifest.json" ]] || continue
    if grep -Fq "\"name\": \"$expected_name\"" "$path/manifest.json"; then
      return 0
    fi
  done < <(jq -r '.extensions.settings | to_entries[] | select(.value.path) | .value.path' "$prefs_file" 2>/dev/null)

  return 1
}

run_private_browser_checks() {
  local report_fn="$1"
  local config_file="$DOT_PRIVATE_BROWSER_CHECKS_FILE"
  local raw_line
  local line
  local kind
  local profile_dir
  local target
  local label
  local hint

  if [[ ! -f "$config_file" ]] || [[ ! -r "$config_file" ]]; then
    return 0
  fi

  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    line="$(trim_whitespace "$raw_line")"
    [[ -z "$line" || "${line:0:1}" == '#' ]] && continue

    IFS='|' read -r kind profile_dir target label hint <<< "$line"
    kind="$(trim_whitespace "$kind")"
    profile_dir="$(expand_home_path "$(trim_whitespace "$profile_dir")")"
    target="$(trim_whitespace "$target")"
    label="$(trim_whitespace "$label")"
    hint="$(trim_whitespace "$hint")"

    [[ -z "$kind" || -z "$profile_dir" || -z "$target" || -z "$label" ]] && continue

    case "$kind" in
      chromium-id)
        "$report_fn" "$label" "$hint" chromium_extension_id_installed "$profile_dir" "$target"
        ;;
      chromium-name)
        "$report_fn" "$label" "$hint" chromium_extension_name_installed "$profile_dir" "$target"
        ;;
      *)
        log_warn "Ignoring unknown browser check type '$kind' in $(display_path "$config_file")"
        ;;
    esac
  done < "$config_file"
}

PRIVATE_EXTRA_REPO_NAMES=()
PRIVATE_EXTRA_REPO_PATHS=()
PRIVATE_EXTRA_REPO_SCHEDULES=()

cron_named_value() {
  local token="${1,,}"
  local kind="$2"

  case "$kind:$token" in
    dow:sun|dow:sunday) printf '0\n' ;;
    dow:mon|dow:monday) printf '1\n' ;;
    dow:tue|dow:tues|dow:tuesday) printf '2\n' ;;
    dow:wed|dow:wednesday) printf '3\n' ;;
    dow:thu|dow:thur|dow:thurs|dow:thursday) printf '4\n' ;;
    dow:fri|dow:friday) printf '5\n' ;;
    dow:sat|dow:saturday) printf '6\n' ;;
    month:jan|month:january) printf '1\n' ;;
    month:feb|month:february) printf '2\n' ;;
    month:mar|month:march) printf '3\n' ;;
    month:apr|month:april) printf '4\n' ;;
    month:may) printf '5\n' ;;
    month:jun|month:june) printf '6\n' ;;
    month:jul|month:july) printf '7\n' ;;
    month:aug|month:august) printf '8\n' ;;
    month:sep|month:sept|month:september) printf '9\n' ;;
    month:oct|month:october) printf '10\n' ;;
    month:nov|month:november) printf '11\n' ;;
    month:dec|month:december) printf '12\n' ;;
    *) return 1 ;;
  esac
}

cron_field_value() {
  local token="$1"
  local min="$2"
  local max="$3"
  local kind="${4:-}"
  local value

  if [[ "$token" =~ ^[0-9]+$ ]]; then
    value=$((10#$token))
  else
    value="$(cron_named_value "$token" "$kind" 2>/dev/null || true)"
    [[ -n "$value" ]] || return 1
  fi

  if [[ "$kind" == 'dow' && "$value" -eq 7 ]]; then
    value=0
  fi

  (( value >= min && value <= max )) || return 1
  printf '%d\n' "$value"
}

cron_field_is_unrestricted() {
  local expr="${1//[[:space:]]/}"

  [[ "$expr" == '*' || "$expr" == '?' ]]
}

cron_field_matches() {
  local value="$1"
  local expr="${2//[[:space:]]/}"
  local min="$3"
  local max="$4"
  local kind="${5:-}"
  local part
  local base
  local step=1
  local start_token
  local end_token
  local start_value
  local end_value
  local -a parts

  cron_field_is_unrestricted "$expr" && return 0

  IFS=',' read -r -a parts <<< "$expr"
  for part in "${parts[@]}"; do
    [[ -n "$part" ]] || continue

    base="$part"
    step=1
    if [[ "$part" == */* ]]; then
      base="${part%%/*}"
      step="${part#*/}"
      [[ "$step" =~ ^[0-9]+$ && "$step" -gt 0 ]] || continue
    fi

    if [[ "$base" == '*' || "$base" == '?' ]]; then
      start_value="$min"
      end_value="$max"
    elif [[ "$base" == *-* ]]; then
      start_token="${base%%-*}"
      end_token="${base#*-}"
      start_value="$(cron_field_value "$start_token" "$min" "$max" "$kind" 2>/dev/null || true)"
      end_value="$(cron_field_value "$end_token" "$min" "$max" "$kind" 2>/dev/null || true)"
      [[ -n "$start_value" && -n "$end_value" && "$start_value" -le "$end_value" ]] || continue
    else
      start_value="$(cron_field_value "$base" "$min" "$max" "$kind" 2>/dev/null || true)"
      [[ -n "$start_value" ]] || continue
      end_value="$start_value"
    fi

    if (( value >= start_value && value <= end_value && (value - start_value) % step == 0 )); then
      return 0
    fi
  done

  return 1
}

private_extra_repo_schedule_active() {
  local schedule="$(trim_whitespace "$1")"
  local minute_expr
  local hour_expr
  local dom_expr
  local month_expr
  local dow_expr
  local current_minute
  local current_hour
  local current_dom
  local current_month
  local current_dow
  local dom_matches
  local dow_matches

  [[ -z "$schedule" ]] && return 0

  read -r minute_expr hour_expr dom_expr month_expr dow_expr _ <<< "$schedule"
  [[ -n "$minute_expr" && -n "$hour_expr" && -n "$dom_expr" && -n "$month_expr" && -n "$dow_expr" ]] || return 0

  current_minute="$(date +%M)"
  current_hour="$(date +%H)"
  current_dom="$(date +%d)"
  current_month="$(date +%m)"
  current_dow="$(date +%w)"

  cron_field_matches $((10#$current_minute)) "$minute_expr" 0 59 || return 1
  cron_field_matches $((10#$current_hour)) "$hour_expr" 0 23 || return 1
  cron_field_matches $((10#$current_month)) "$month_expr" 1 12 month || return 1

  if cron_field_matches $((10#$current_dom)) "$dom_expr" 1 31; then
    dom_matches=1
  else
    dom_matches=0
  fi

  if cron_field_matches $((10#$current_dow)) "$dow_expr" 0 7 dow; then
    dow_matches=1
  else
    dow_matches=0
  fi

  if ! cron_field_is_unrestricted "$dom_expr" && ! cron_field_is_unrestricted "$dow_expr"; then
    (( dom_matches == 1 || dow_matches == 1 ))
    return
  fi

  (( dom_matches == 1 && dow_matches == 1 ))
}

private_extra_repo_visible_now() {
  local index="$1"
  private_extra_repo_schedule_active "${PRIVATE_EXTRA_REPO_SCHEDULES[$index]:-}"
}

load_private_extra_repos() {
  local config_file="$PRIVATE_EXTRA_REPOS_FILE"
  local raw_line
  local line
  local repo_name
  local repo_path
  local repo_schedule

  PRIVATE_EXTRA_REPO_NAMES=()
  PRIVATE_EXTRA_REPO_PATHS=()
  PRIVATE_EXTRA_REPO_SCHEDULES=()

  if [[ ! -f "$config_file" ]] || [[ ! -r "$config_file" ]]; then
    return 0
  fi

  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    line="$(trim_whitespace "$raw_line")"
    [[ -z "$line" || "${line:0:1}" == '#' ]] && continue

    if [[ "$line" == *'|'* ]]; then
      IFS='|' read -r repo_name repo_path repo_schedule _ <<< "$line"
      repo_name="$(trim_whitespace "$repo_name")"
      repo_path="$(trim_whitespace "$repo_path")"
      repo_schedule="$(trim_whitespace "${repo_schedule:-}")"
    else
      repo_name=''
      repo_path="$line"
      repo_schedule=''
    fi

    [[ -z "$repo_path" ]] && continue
    repo_path="$(expand_home_path "$repo_path")"

    if [[ -z "$repo_name" ]]; then
      repo_name="$(basename -- "$repo_path")"
    fi

    [[ -z "$repo_name" ]] && continue

    PRIVATE_EXTRA_REPO_NAMES+=("$repo_name")
    PRIVATE_EXTRA_REPO_PATHS+=("$repo_path")
    PRIVATE_EXTRA_REPO_SCHEDULES+=("$repo_schedule")
  done <"$config_file"
}

# Refresh local tracking refs for the configured upstream branch.
fetch_repo_upstream() {
  local repo_dir="$1"
  local upstream_ref
  local remote_name
  local remote_branch
  local cache_key=''
  local cache_file=''
  local now
  local last_attempt=''
  local ttl_seconds="$DOT_FETCH_TTL_SECONDS"

  if ! git -C "$repo_dir" rev-parse '@{u}' >/dev/null 2>&1; then
    return 1
  fi

  upstream_ref="$(git -C "$repo_dir" rev-parse --abbrev-ref '@{u}' 2>/dev/null || true)"
  if [[ -z "$upstream_ref" || "$upstream_ref" != */* ]]; then
    return 1
  fi

  remote_name="${upstream_ref%%/*}"
  remote_branch="${upstream_ref#*/}"
  now="$(date +%s)"

  if [[ "$ttl_seconds" =~ ^[0-9]+$ ]] && (( ttl_seconds > 0 )); then
    mkdir -p "$DOT_FETCH_CACHE_DIR" >/dev/null 2>&1 || true
    cache_key="$(printf '%s\n%s\n' "$repo_dir" "$upstream_ref" | sha1sum | awk '{print $1}')"
    cache_file="$DOT_FETCH_CACHE_DIR/$cache_key"

    if [[ -r "$cache_file" ]]; then
      last_attempt="$(< "$cache_file")"
      if [[ "$last_attempt" =~ ^[0-9]+$ ]] && (( now - last_attempt < ttl_seconds )); then
        return 0
      fi
    fi
  fi

  if git -C "$repo_dir" fetch --quiet "$remote_name" "$remote_branch" >/dev/null 2>&1 \
    || git -C "$repo_dir" fetch --quiet "$remote_name" >/dev/null 2>&1; then
    if [[ -n "$cache_file" ]]; then
      printf '%s\n' "$now" > "$cache_file" 2>/dev/null || true
    fi
    return 0
  fi

  if [[ -n "$cache_file" ]]; then
    printf '%s\n' "$now" > "$cache_file" 2>/dev/null || true
  fi

  return 1
}

# Populates DIFF_ATTENTION_ISSUES and DIFF_ATTENTION_SEGMENTS (same rules as `dot diff --waybar`).
# When DIFF_ATTENTION_VERBOSE=1, logs the per-repo status as it is checked.
_diff_attention_scan_repo() {
  local name="$1"
  local path="$2"
  local dirty=0
  local ahead=0
  local behind=0
  local fetch_upstream="${3:-1}"
  local verbose="${DIFF_ATTENTION_VERBOSE:-0}"

  if ! git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if [[ "$verbose" == "1" ]]; then
      log_info "Checking ${name}: not a git repo (skipped) — $(display_path "$path")"
    fi
    return 0
  fi

  [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]] && dirty=1
  ahead=0
  behind=0
  local has_upstream=0
  if git -C "$path" rev-parse '@{u}' >/dev/null 2>&1; then
    has_upstream=1
    if [[ "$fetch_upstream" == "1" ]]; then
      fetch_repo_upstream "$path" || true
    fi
    ahead="$(git -C "$path" rev-list --count '@{u}..HEAD' 2>/dev/null || printf '0')"
    behind="$(git -C "$path" rev-list --count 'HEAD..@{u}' 2>/dev/null || printf '0')"
  fi

  if [[ "$verbose" == "1" ]]; then
    local -a parts=()
    [[ "${behind:-0}" -gt 0 ]] && parts+=("behind ${behind}")
    [[ "${ahead:-0}" -gt 0 ]] && parts+=("ahead ${ahead}")
    [[ "$dirty" -eq 1 ]] && parts+=("dirty")
    if [[ "${#parts[@]}" -eq 0 ]]; then
      if [[ "$has_upstream" -eq 1 ]]; then
        parts+=("up to date")
      else
        parts+=("clean (no upstream)")
      fi
    fi
    local status_str="${parts[0]}"
    local p_i
    for ((p_i = 1; p_i < ${#parts[@]}; p_i++)); do
      status_str+=", ${parts[$p_i]}"
    done
    log_info "Checking ${name}: ${status_str}"
  fi

  if [[ "$dirty" -eq 1 ]] || [[ "${ahead:-0}" -gt 0 ]] || [[ "${behind:-0}" -gt 0 ]]; then
    DIFF_ATTENTION_ISSUES=$((DIFF_ATTENTION_ISSUES + 1))
    DIFF_ATTENTION_SEGMENTS+=("$name")
    DIFF_ATTENTION_PATHS+=("$path")
    [[ "$dirty" -eq 1 ]] && DIFF_ATTENTION_HAS_DIRTY=1
    [[ "${ahead:-0}" -gt 0 ]] && DIFF_ATTENTION_HAS_AHEAD=1
    [[ "${behind:-0}" -gt 0 ]] && DIFF_ATTENTION_HAS_BEHIND=1
  fi

  return 0
}

# Sort PRIVATE_EXTRA_REPO_NAMES / PRIVATE_EXTRA_REPO_PATHS together by name.
sort_private_extra_repos() {
  [[ ${#PRIVATE_EXTRA_REPO_NAMES[@]} -le 1 ]] && return 0
  local -a sorted_names=()
  local -a sorted_paths=()
  local -a sorted_schedules=()
  local name path schedule
  while IFS=$'\t' read -r name path schedule; do
    sorted_names+=("$name")
    sorted_paths+=("$path")
    sorted_schedules+=("$schedule")
  done < <(
    local j
    for j in "${!PRIVATE_EXTRA_REPO_NAMES[@]}"; do
      printf '%s\t%s\t%s\n' "${PRIVATE_EXTRA_REPO_NAMES[$j]}" "${PRIVATE_EXTRA_REPO_PATHS[$j]}" "${PRIVATE_EXTRA_REPO_SCHEDULES[$j]}"
    done | sort
  )
  PRIVATE_EXTRA_REPO_NAMES=("${sorted_names[@]}")
  PRIVATE_EXTRA_REPO_PATHS=("${sorted_paths[@]}")
  PRIVATE_EXTRA_REPO_SCHEDULES=("${sorted_schedules[@]}")
}

diff_collect_attention() {
  diff_collect_attention_with_fetch 1
}

diff_collect_attention_with_fetch() {
  local fetch_upstream="${1:-1}"
  local public_name
  local private_name
  local notes_name
  local i

  DIFF_ATTENTION_ISSUES=0
  DIFF_ATTENTION_SEGMENTS=()
  DIFF_ATTENTION_PATHS=()
  DIFF_ATTENTION_HAS_DIRTY=0
  DIFF_ATTENTION_HAS_AHEAD=0
  DIFF_ATTENTION_HAS_BEHIND=0

  public_name="$(basename -- "${PUBLIC_DOTFILES%/}")"
  _diff_attention_scan_repo "$public_name" "$PUBLIC_DOTFILES" "$fetch_upstream"

  if can_use_private; then
    private_name="$(basename -- "${PRIVATE_DOTFILES%/}")"
    notes_name="$(basename -- "${NOTES_REPO_DIR%/}")"
    _diff_attention_scan_repo "$private_name" "$PRIVATE_DOTFILES" "$fetch_upstream"
    _diff_attention_scan_repo "$notes_name" "$NOTES_REPO_DIR" "$fetch_upstream"
  fi

  if is_truthy "$INCLUDE_OMARCHY_DIFF_REPOS"; then
    local om_i
    omarchy_collect_repo_targets
    for om_i in "${!OMARCHY_TARGET_PATHS[@]}"; do
      _diff_attention_scan_repo "${OMARCHY_TARGET_NAMES[$om_i]}" "${OMARCHY_TARGET_PATHS[$om_i]}" "$fetch_upstream"
    done
  fi

  if can_use_private; then
    load_private_extra_repos
    sort_private_extra_repos
    for i in "${!PRIVATE_EXTRA_REPO_PATHS[@]}"; do
      private_extra_repo_visible_now "$i" || continue
      _diff_attention_scan_repo "extra:${PRIVATE_EXTRA_REPO_NAMES[$i]}" "${PRIVATE_EXTRA_REPO_PATHS[$i]}" "$fetch_upstream"
    done
  fi
}

require_repo_dir() {
  local repo_dir="$1"
  local name="$2"

  if [[ ! -d "$repo_dir" ]]; then
    log_error "$name directory not found: $repo_dir"
    return 1
  fi
}

list_stow_folders() {
  local repo_dir="$1"
  local include_backup="${2:-false}"
  local dir
  local folder
  local host_suffix

  shopt -s nullglob
  for dir in "$repo_dir"/*/; do
    folder="${dir%/}"
    folder="${folder##*/}"

    if [[ "$include_backup" != "true" && "$folder" == "backup" ]]; then
      continue
    fi

    # Host-specific packages use double-dash: <name>--<host>
    # Skip packages that target a different OMARCHY_HOST
    if [[ "$folder" == *--* ]]; then
      host_suffix="${folder##*--}"
      if [[ "$host_suffix" != "${OMARCHY_HOST:-}" ]]; then
        continue
      fi
    fi

    printf '%s\n' "$folder"
  done
  shopt -u nullglob
}

stow_in_repo() {
  local repo_dir="$1"
  shift

  (
    cd "$repo_dir"
    stow "$@"
  )
}

workflow_watch_configured_hook_path() {
  git config --global --get core.hooksPath 2>/dev/null || true
}

workflow_watch_hooks_path_matches() {
  local configured_path
  local resolved_configured
  local resolved_expected

  configured_path="$(workflow_watch_configured_hook_path)"
  [[ -n "$configured_path" ]] || return 1

  resolved_configured="$(readlink -f "$configured_path" 2>/dev/null || printf '%s\n' "$configured_path")"
  resolved_expected="$(readlink -f "$DOT_WORKFLOW_WATCH_HOOKS_PATH" 2>/dev/null || printf '%s\n' "$DOT_WORKFLOW_WATCH_HOOKS_PATH")"
  [[ "$resolved_configured" == "$resolved_expected" ]]
}

workflow_watch_timer_is_enabled() {
  has_cmd systemctl || return 1
  systemctl --user is-enabled "$DOT_WORKFLOW_WATCH_TIMER_UNIT" >/dev/null 2>&1
}

workflow_watch_timer_is_active() {
  has_cmd systemctl || return 1
  systemctl --user is-active "$DOT_WORKFLOW_WATCH_TIMER_UNIT" >/dev/null 2>&1
}

workflow_watch_waybar_config_path() {
  local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/waybar"
  local host="${OMARCHY_HOST:-}"
  local host_config=''

  if [[ -n "$host" ]]; then
    host_config="$config_dir/config.${host}.jsonc"
    if [[ -f "$host_config" ]]; then
      printf '%s\n' "$host_config"
      return 0
    fi
  fi

  printf '%s\n' "$config_dir/config.jsonc"
}

workflow_watch_waybar_config_contains() {
  local config_path="$1"
  local needle="$2"
  local include_line=''
  local include_body=''
  local include_entry=''
  local include_path=''
  local config_dir=''

  [[ -f "$config_path" ]] || return 1
  if grep -Fq "$needle" "$config_path"; then
    return 0
  fi

  include_line="$(grep -E '"include"[[:space:]]*:' "$config_path" 2>/dev/null || true)"
  [[ -n "$include_line" ]] || return 1

  include_body="${include_line#*[}"
  include_body="${include_body%]*}"
  config_dir="$(dirname -- "$config_path")"

  IFS=',' read -r -a workflow_watch_include_entries <<< "$include_body"
  unset IFS

  for include_entry in "${workflow_watch_include_entries[@]}"; do
    include_entry="$(trim_whitespace "$include_entry")"
    include_entry="${include_entry#\"}"
    include_entry="${include_entry%\"}"
    include_path="${include_entry/#~/$HOME}"
    if [[ "$include_path" != /* ]]; then
      include_path="$config_dir/$include_path"
    fi
    if workflow_watch_waybar_config_contains "$include_path" "$needle"; then
      return 0
    fi
  done

  return 1
}

workflow_watch_waybar_config_orders_before() {
  local config_path="$1"
  local first="$2"
  local second="$3"
  local config_text=''
  local include_line=''
  local include_body=''
  local include_entry=''
  local include_path=''
  local config_dir=''

  [[ -f "$config_path" ]] || return 1
  config_text="$(tr -d '\n\r' < "$config_path")"
  if [[ "$config_text" =~ ${first}[[:space:]]*,[[:space:]]*${second} ]]; then
    return 0
  fi

  include_line="$(grep -E '"include"[[:space:]]*:' "$config_path" 2>/dev/null || true)"
  [[ -n "$include_line" ]] || return 1

  include_body="${include_line#*[}"
  include_body="${include_body%]*}"
  config_dir="$(dirname -- "$config_path")"

  IFS=',' read -r -a workflow_watch_include_entries <<< "$include_body"
  unset IFS

  for include_entry in "${workflow_watch_include_entries[@]}"; do
    include_entry="$(trim_whitespace "$include_entry")"
    include_entry="${include_entry#\"}"
    include_entry="${include_entry%\"}"
    include_path="${include_entry/#~/$HOME}"
    if [[ "$include_path" != /* ]]; then
      include_path="$config_dir/$include_path"
    fi
    if workflow_watch_waybar_config_orders_before "$include_path" "$first" "$second"; then
      return 0
    fi
  done

  return 1
}

configure_workflow_watch() {
  local hook_path="$DOT_WORKFLOW_WATCH_HOOKS_PATH"

  log_section 'Configure workflow watch'

  if ! has_cmd git; then
    log_warn 'Skipping workflow watch configuration (git not found)'
    return 0
  fi

  if [[ ! -d "$hook_path" ]]; then
    log_warn "Skipping workflow watch configuration (missing hooks path: $(display_path "$hook_path"))"
    return 0
  fi

  if workflow_watch_hooks_path_matches; then
    log_info "Workflow watch hooksPath already configured: $(display_path "$hook_path")"
  else
    git config --global core.hooksPath "$hook_path"
    log_info "Configured global git hooksPath: $(display_path "$hook_path")"
  fi

  if [[ ! -f "$DOT_WORKFLOW_WATCH_REPOS_FILE" ]]; then
    log_warn "Workflow watch repo list not found: $(display_path "$DOT_WORKFLOW_WATCH_REPOS_FILE")"
  else
    log_info "Workflow watch repo list: $(display_path "$DOT_WORKFLOW_WATCH_REPOS_FILE")"
  fi

  if has_cmd systemctl; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    if systemctl --user enable --now "$DOT_WORKFLOW_WATCH_TIMER_UNIT" >/dev/null 2>&1; then
      log_info "Enabled workflow watch timer: $DOT_WORKFLOW_WATCH_TIMER_UNIT"
    else
      log_warn "Could not enable workflow watch timer: $DOT_WORKFLOW_WATCH_TIMER_UNIT"
    fi
  else
    log_warn 'Skipping workflow watch timer enable (systemctl not found)'
  fi
}

configure_git_config_include() {
  local git_config_file="$HOME/.config/git/config"
  local git_include_path='~/.config/git/config.dotfiles'
  local git_config_dotfiles="$HOME/.config/git/config.dotfiles"

  if [[ ! -L "$git_config_dotfiles" && ! -f "$git_config_dotfiles" ]]; then
    log_warn "Stowed git config.dotfiles not found — run: dot stow"
    return 0
  fi

  if [[ -f "$git_config_file" ]] && grep -q "path = $git_include_path" "$git_config_file" 2>/dev/null; then
    log_info "Git config already includes managed dotfiles settings"
  else
    git config --global --add include.path "$git_include_path"
    log_info "Added git config include: $git_include_path"
  fi
}

# Mirror AGENTS.md into a Cursor user rule (.mdc with alwaysApply) so it is always-on context.
# Default output: private agents package at agents/.cursor/rules/global-agents.mdc (stows into ~/.cursor/rules/).
run_agents_sync() {
  local source="${DOT_AGENTS_SYNC_SOURCE:-$HOME/.config/opencode/AGENTS.md}"
  local dest
  local rule_dir
  local tmp
  local resolved

  if [[ -n "${DOT_AGENTS_SYNC_RULE_FILE:-}" ]]; then
    dest="$DOT_AGENTS_SYNC_RULE_FILE"
  elif [[ -d "$PRIVATE_DOTFILES/agents" ]]; then
    dest="$PRIVATE_DOTFILES/agents/.cursor/rules/global-agents.mdc"
  else
    dest="$HOME/.cursor/rules/global-agents.mdc"
  fi

  rule_dir="$(dirname -- "$dest")"

  if [[ ! -e "$source" ]]; then
    log_warn "agents-sync skipped (missing source): $(display_path "$source")"
    return 1
  fi

  if [[ ! -r "$source" ]]; then
    log_warn "agents-sync skipped (not readable): $(display_path "$source")"
    return 1
  fi

  resolved="$(readlink -f "$source" 2>/dev/null || printf '%s\n' "$source")"

  tmp="$(mktemp)" || {
    log_error 'agents-sync failed (mktemp)'
    return 1
  }

  {
    printf '%s\n' '---'
    printf '%s\n' 'description: Global agent instructions mirrored from AGENTS.md; refresh with dot agents-sync.'
    printf '%s\n' 'alwaysApply: true'
    printf '%s\n' '---'
    printf '\n'
    printf '%s\n' "<!-- dot agents-sync: source=$(display_path "$resolved") synced=$(date -Iseconds) -->"
    printf '\n'
    cat "$source"
  } >"$tmp" || {
    rm -f "$tmp"
    log_error 'agents-sync failed while writing temp file'
    return 1
  }

  if ! mkdir -p "$rule_dir"; then
    rm -f "$tmp"
    log_error "agents-sync failed (mkdir $(display_path "$rule_dir"))"
    return 1
  fi

  if mv -f "$tmp" "$dest"; then
    log_info "Wrote Cursor rule: $(display_path "$dest")"
    return 0
  fi

  rm -f "$tmp"
  log_error "agents-sync failed (mv to $(display_path "$dest"))"
  return 1
}

maybe_agents_sync_after_update() {
  is_truthy "${DOT_AGENTS_SYNC_ON_UPDATE:-1}" || return 0
  log_section 'Agents rules sync'
  run_agents_sync || true
}

# Sync ~/.config/opencode/AGENTS.md durable block via dotfiles-private memory.js --update.
# soft=1: missing deps or node failure returns 0 (for dot update hook). soft=0: returns 1 on failure.
_dot_run_memory_js() {
  local soft="${1:-0}"
  local script="$PRIVATE_DOTFILES/agents/.config/opencode/plugins/memory.js"

  if [[ ! -f "$script" ]]; then
    log_warn "Skipping memory sync (missing $(display_path "$script"))"
    if [[ "$soft" -eq 1 ]]; then
      return 0
    fi
    return 1
  fi

  if ! has_cmd node; then
    log_warn 'Skipping memory sync (node not found in PATH)'
    if [[ "$soft" -eq 1 ]]; then
      return 0
    fi
    return 1
  fi

  log_info "OpenCode memory: node $(display_path "$script") --update"
  if (cd "$HOME" && node "$script" --update); then
    return 0
  fi

  log_warn 'Memory sync failed'
  if [[ "$soft" -eq 1 ]]; then
    return 0
  fi
  return 1
}

# Optional: --soft (used by dot update) — do not fail the parent workflow on skip/error.
cmd_memory() {
  local soft=0
  if [[ "${1:-}" == '--soft' ]]; then
    soft=1
    shift
  fi

  log_section 'OpenCode memory sync'

  if ! can_use_private; then
    log_warn "Memory sync requires private dotfiles ($PRIVATE_REASON)"
    if [[ "$soft" -eq 1 ]]; then
      return 0
    fi
    return 1
  fi

  _dot_run_memory_js "$soft"
}

cmd_opencode_debug() {
  local agent_name=''
  local output=''
  local status=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)
        if [[ $# -lt 2 || -z "${2:-}" ]]; then
          log_error 'opencode-debug requires a value for --agent'
          return 1
        fi
        agent_name="$2"
        shift 2
        ;;
      -h|--help)
        printf 'Usage: %s opencode-debug [--agent <name>]\n' "$SCRIPT_NAME"
        printf '\n'
        printf 'Run useful OpenCode debug commands in one place.\n'
        return 0
        ;;
      *)
        log_error "Unknown opencode-debug option: $1"
        return 1
        ;;
    esac
  done

  log_section 'OpenCode debug'

  if ! has_cmd opencode; then
    log_error 'OpenCode command not found in PATH'
    return 1
  fi

  log_info 'Running: opencode debug paths'
  if ! opencode debug paths; then
    status=1
  fi

  log_info 'Running: opencode debug config'
  if ! opencode debug config; then
    status=1
  fi

  log_info 'Running: opencode debug skill'
  if ! opencode debug skill; then
    status=1
  fi

  log_info 'Running: opencode debug info'
  if ! opencode debug info; then
    status=1
  fi

  if [[ -n "$agent_name" ]]; then
    log_info "Running: opencode debug agent $agent_name"
    if ! opencode debug agent "$agent_name"; then
      status=1
    fi
  else
    if output="$(opencode agent list 2>/dev/null)" && [[ -n "$output" ]]; then
      log_info 'Tip: add --agent <name> to inspect one configured agent'
    fi
  fi

  return "$status"
}

maybe_memory_update_after_update() {
  is_truthy "${DOT_MEMORY_UPDATE_ON_UPDATE:-1}" || return 0
  "$DOT_SELF" memory --soft || true
}

track_updated_repo() {
  local repo_name="$1"

  array_contains "$repo_name" "${UPDATED_REPO_NAMES[@]}" && return 0
  UPDATED_REPO_NAMES+=("$repo_name")
}

maybe_notify_updated_repos() {
  local count="${#UPDATED_REPO_NAMES[@]}"
  local title=''
  local message=''
  local repo_name

  [[ "$count" -gt 0 ]] || return 0
  has_cmd notify-send || return 0

  if [[ "$count" -eq 1 ]]; then
    title='Git repo updated'
    message="${UPDATED_REPO_NAMES[0]} pulled new changes"
  else
    title='Git repos updated'
    message="${count} repos pulled new changes"
    for repo_name in "${UPDATED_REPO_NAMES[@]}"; do
      message+="\n- ${repo_name}"
    done
  fi

  notify-send "$title" "$message" >/dev/null 2>&1 || true
}

safe_pull_repo() {
  local name="$1"
  local repo_dir="$2"
  local before_head=''
  local after_head=''

  if [[ ! -e "$repo_dir/.git" ]]; then
    log_warn "Skipping $name pull (not a git repo): $(display_path "$repo_dir")"
    return 0
  fi

  if ! has_cmd git; then
    log_error "Git not found; cannot pull $name"
    return 1
  fi

  if [[ -n "$(git -C "$repo_dir" status --porcelain 2>/dev/null || true)" ]]; then
    log_warn "Skipping $name pull (working tree not clean): $(display_path "$repo_dir")"
    return 0
  fi

  log_info "Pulling latest for $name: $(display_path "$repo_dir")"
  before_head="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"
  git -C "$repo_dir" pull --rebase
  after_head="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"

  if [[ -n "$before_head" && -n "$after_head" && "$before_head" != "$after_head" ]]; then
    track_updated_repo "$name"
  fi
}

repo_current_branch() {
  local repo_dir="$1"
  git -C "$repo_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || true
}

repo_upstream_ref() {
  local repo_dir="$1"

  if git -C "$repo_dir" rev-parse '@{u}' >/dev/null 2>&1; then
    git -C "$repo_dir" rev-parse --abbrev-ref '@{u}' 2>/dev/null || true
  else
    printf '\n'
  fi
}

omarchy_repo_slug() {
  local repo_name="$1"

  case "$repo_name" in
    bootstrap) printf 'timmo001/bootstrap\n' ;;
    hypr) printf 'timmo001/omarchy-hypr\n' ;;
    waybar) printf 'timmo001/omarchy-waybar\n' ;;
    ghostty) printf 'timmo001/omarchy-ghostty\n' ;;
    uwsm) printf 'timmo001/omarchy-uwsm\n' ;;
    *) return 1 ;;
  esac
}

omarchy_backup_existing_dir() {
  local repo_name="$1"
  local target_dir="$2"
  local backup_root="$OMARCHY_REPO_BASE/omarchy-backups"
  local backup_path="$backup_root/${repo_name}-$(date +%Y%m%d-%H%M%S)"

  mkdir -p "$backup_root"
  mv "$target_dir" "$backup_path"
  log_warn "Moved existing $repo_name to backup: $(display_path "$backup_path")"
}

omarchy_repo_matches_remote() {
  local target_dir="$1"
  local expected_slug="$2"
  local remote_url

  remote_url="$(git -C "$target_dir" remote get-url origin 2>/dev/null || true)"
  [[ "$remote_url" == *"$expected_slug"* ]]
}

omarchy_clone_repo() {
  local repo_slug="$1"
  local target_dir="$2"

  if has_cmd gh && gh auth status >/dev/null 2>&1; then
    log_info "Cloning $repo_slug -> $(display_path "$target_dir") (via gh)"
    gh repo clone "$repo_slug" "$target_dir"
  elif has_cmd git; then
    log_info "Cloning $repo_slug -> $(display_path "$target_dir") (via git)"
    git clone "https://github.com/${repo_slug}.git" "$target_dir"
  else
    log_error "Cannot clone $repo_slug (gh and git unavailable)"
    return 1
  fi
}

omarchy_checkout_branch_if_available() {
  local repo_name="$1"
  local target_dir="$2"
  local branch="$3"

  if [[ -z "$branch" ]]; then
    return 0
  fi

  if git -C "$target_dir" ls-remote --heads origin "$branch" | grep -q "$branch"; then
    log_info "Checking out branch '$branch' for $repo_name"
    git -C "$target_dir" fetch origin "$branch" >/dev/null 2>&1 || true
    git -C "$target_dir" checkout "$branch" >/dev/null 2>&1 || true
  else
    log_warn "Branch '$branch' not found for $repo_name; keeping current branch"
  fi
}

omarchy_collect_repo_targets() {
  local repo_name
  local repo_path
  local current_branch
  local branch_name
  local worktree_path

  OMARCHY_TARGET_NAMES=()
  OMARCHY_TARGET_PATHS=()

  for repo_name in "${OMARCHY_DIFF_REPOS[@]}"; do
    repo_path="$OMARCHY_REPO_BASE/$repo_name"
    OMARCHY_TARGET_NAMES+=("omarchy:$repo_name")
    OMARCHY_TARGET_PATHS+=("$repo_path")

    if ! omarchy_repo_has_worktree_branches "$repo_name"; then
      continue
    fi

    if ! git -C "$repo_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      continue
    fi

    current_branch="$(git -C "$repo_path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    for branch_name in "${OMARCHY_WORKTREE_BRANCHES[@]}"; do
      if [[ "$branch_name" == "$current_branch" ]]; then
        continue
      fi

      if ! omarchy_branch_ref_exists "$repo_path" "$branch_name"; then
        continue
      fi

      worktree_path="$OMARCHY_REPO_BASE/${repo_name}-${branch_name}"
      OMARCHY_TARGET_NAMES+=("omarchy:${repo_name}-${branch_name}")
      OMARCHY_TARGET_PATHS+=("$worktree_path")
    done
  done
}

omarchy_sync_repo_worktrees() {
  local repo_name="$1"
  local target_dir="$2"
  local current_branch
  local branch_name
  local worktree_path
  local worktree_branch

  if ! omarchy_repo_has_worktree_branches "$repo_name"; then
    if omarchy_repo_is_single_branch "$repo_name"; then
      log_info "Skipping branch worktree checks for $repo_name (single-branch repo)"
    fi
    return 0
  fi

  if ! git -C "$target_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return 0
  fi

  git -C "$target_dir" fetch --quiet origin >/dev/null 2>&1 || true
  current_branch="$(git -C "$target_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

  for branch_name in "${OMARCHY_WORKTREE_BRANCHES[@]}"; do
    if [[ "$branch_name" == "$current_branch" ]]; then
      continue
    fi

    if ! omarchy_branch_ref_exists "$target_dir" "$branch_name"; then
      log_info "Skipping worktree ${repo_name}-${branch_name} (branch '$branch_name' not found)"
      continue
    fi

    worktree_path="$OMARCHY_REPO_BASE/${repo_name}-${branch_name}"

    if git -C "$worktree_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      worktree_branch="$(git -C "$worktree_path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
      if [[ "$worktree_branch" != "$branch_name" ]]; then
        log_warn "Skipping $(display_path "$worktree_path") pull (expected branch '$branch_name', found '$worktree_branch')"
        continue
      fi

      safe_pull_repo "omarchy:${repo_name}-${branch_name}" "$worktree_path"
      continue
    fi

    if [[ -d "$worktree_path" ]]; then
      log_warn "Skipping worktree setup for ${repo_name}-${branch_name} (path exists and is not a git worktree): $(display_path "$worktree_path")"
      continue
    fi

    log_info "Creating worktree omarchy:${repo_name}-${branch_name} at $(display_path "$worktree_path")"
    if git -C "$target_dir" show-ref --verify --quiet "refs/heads/$branch_name"; then
      if ! git -C "$target_dir" worktree add "$worktree_path" "$branch_name" >/dev/null 2>&1; then
        log_warn "Failed to create worktree for ${repo_name}-${branch_name}"
        continue
      fi
    else
      if ! git -C "$target_dir" worktree add -b "$branch_name" "$worktree_path" "origin/$branch_name" >/dev/null 2>&1; then
        log_warn "Failed to create worktree for ${repo_name}-${branch_name} from origin/$branch_name"
        continue
      fi
    fi

    safe_pull_repo "omarchy:${repo_name}-${branch_name}" "$worktree_path"
  done
}

omarchy_sync_repo() {
  local repo_name="$1"
  local repo_slug="$2"
  local branch="$3"
  local target_dir="$OMARCHY_REPO_BASE/$repo_name"

  if omarchy_repo_is_single_branch "$repo_name"; then
    branch=''
  fi

  log_section "Omarchy sync: $repo_name"

  if [[ -d "$target_dir" ]]; then
    if [[ -e "$target_dir/.git" ]] && omarchy_repo_matches_remote "$target_dir" "$repo_slug"; then
      omarchy_checkout_branch_if_available "$repo_name" "$target_dir" "$branch"
      safe_pull_repo "omarchy:$repo_name" "$target_dir"
    else
      omarchy_backup_existing_dir "$repo_name" "$target_dir"
      omarchy_clone_repo "$repo_slug" "$target_dir"
      omarchy_checkout_branch_if_available "$repo_name" "$target_dir" "$branch"
    fi
  else
    omarchy_clone_repo "$repo_slug" "$target_dir"
    omarchy_checkout_branch_if_available "$repo_name" "$target_dir" "$branch"
  fi

  omarchy_sync_repo_worktrees "$repo_name" "$target_dir"
}

omarchy_sync_repos() {
  local branch_override="$OMARCHY_BRANCH"
  local bootstrap_branch_override="$BOOTSTRAP_BRANCH"
  local arg
  local repo_name
  local slug

  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      --branch)
        shift
        branch_override="${1:-}"
        ;;
      --branch=*)
        branch_override="${arg#*=}"
        ;;
      --bootstrap-branch)
        shift
        bootstrap_branch_override="${1:-}"
        ;;
      --bootstrap-branch=*)
        bootstrap_branch_override="${arg#*=}"
        ;;
      *)
        log_error "Unknown omarchy-sync option: $arg"
        return 1
        ;;
    esac
    shift || true
  done

  omarchy_sync_repo 'bootstrap' "$(omarchy_repo_slug bootstrap)" "$bootstrap_branch_override"

  for repo_name in hypr waybar ghostty uwsm; do
    slug="$(omarchy_repo_slug "$repo_name")"
    omarchy_sync_repo "$repo_name" "$slug" "$branch_override"
  done
}

discover_omarchy_branches() {
  if ! has_cmd gh; then
    return 1
  fi

  gh api "repos/timmo001/omarchy-hypr/branches" --jq '.[].name' 2>/dev/null
}

run_init_questionnaire() {
  INIT_SELECTED_OMARCHY_BRANCH="$OMARCHY_BRANCH"
  INIT_RUN_BOOTSTRAP=0
  INIT_INSTALL_PUBLIC_ARCH_PACKAGES=1
  INIT_INSTALL_PRIVATE_ARCH_PACKAGES=1

  if is_truthy "$INIT_NONINTERACTIVE" || ! is_interactive_terminal; then
    return 0
  fi

  if [[ -n "$INIT_SELECTED_OMARCHY_BRANCH" ]]; then
    log_info "Using preselected omarchy branch: $INIT_SELECTED_OMARCHY_BRANCH"
  elif has_cmd gum && has_cmd gh && gh auth status >/dev/null 2>&1; then
    local branches
    branches="$(discover_omarchy_branches || true)"

    if [[ -n "$branches" ]]; then
      log_section 'Select omarchy branch'
      INIT_SELECTED_OMARCHY_BRANCH="$(printf '%s\n' "$branches" | gum choose --header 'Available branches')"
      log_info "Selected omarchy branch: $INIT_SELECTED_OMARCHY_BRANCH"
    else
      log_warn 'Could not discover omarchy branches; using current/default branches'
    fi
  else
    log_warn 'Skipping branch questionnaire (requires gum + gh auth)'
  fi

  if has_cmd gum; then
    if gum confirm 'Would you like to run bootstrap init now?'; then
      INIT_RUN_BOOTSTRAP=1
    fi
  fi

  collect_missing_public_arch_packages
  if [[ "${#MISSING_PUBLIC_ARCH_PACKAGES[@]}" -gt 0 ]]; then
    if confirm_action "Install missing public Arch packages (${MISSING_PUBLIC_ARCH_PACKAGES[*]}) now?"; then
      INIT_INSTALL_PUBLIC_ARCH_PACKAGES=1
    else
      INIT_INSTALL_PUBLIC_ARCH_PACKAGES=0
    fi
  fi

  collect_missing_private_arch_packages
  if [[ "${#MISSING_PRIVATE_ARCH_PACKAGES[@]}" -gt 0 ]]; then
    if confirm_action "Install missing private Arch packages (${MISSING_PRIVATE_ARCH_PACKAGES[*]}) now?"; then
      INIT_INSTALL_PRIVATE_ARCH_PACKAGES=1
    else
      INIT_INSTALL_PRIVATE_ARCH_PACKAGES=0
    fi
  fi
}

run_bootstrap_init_if_requested() {
  local bootstrap_init="$OMARCHY_REPO_BASE/bootstrap/init.sh"

  if [[ "$INIT_RUN_BOOTSTRAP" != '1' ]]; then
    return 0
  fi

  if [[ ! -x "$bootstrap_init" ]]; then
    log_warn "Bootstrap init script not found/executable: $(display_path "$bootstrap_init")"
    return 0
  fi

  log_section 'Running bootstrap init'
  "$bootstrap_init"
}

show_repo_diffs() {
  local name="$1"
  local repo_dir="$2"
  local status_out
  local unstaged_out
  local staged_out
  local unpushed_out
  local unpulled_out

  if [[ ! -e "$repo_dir/.git" ]]; then
    log_warn "Skipping $name diff (not a git repo): $(display_path "$repo_dir")"
    return 0
  fi

  log_section "$name repo: $(display_path "$repo_dir")"

  status_out="$(cd "$repo_dir" && git status --short)"
  if [[ -n "$status_out" ]]; then
    log_info 'Git status:'
    printf '%s\n' "$status_out"
  else
    log_info 'Git status: clean'
  fi

  unstaged_out="$(cd "$repo_dir" && git diff --stat)"
  if [[ -n "$unstaged_out" ]]; then
    log_info 'Unstaged diff:'
    printf '%s\n' "$unstaged_out"
  else
    log_info 'Unstaged diff: none'
  fi

  staged_out="$(cd "$repo_dir" && git diff --cached --stat)"
  if [[ -n "$staged_out" ]]; then
    log_info 'Staged diff:'
    printf '%s\n' "$staged_out"
  else
    log_info 'Staged diff: none'
  fi

  if git -C "$repo_dir" rev-parse '@{u}' >/dev/null 2>&1; then
    fetch_repo_upstream "$repo_dir" || true

    unpushed_out="$(cd "$repo_dir" && git log '@{u}..HEAD' --oneline -20)"
    if [[ -n "$unpushed_out" ]]; then
      log_info 'Unpushed commits:'
      printf '%s\n' "$unpushed_out"
    else
      log_info 'Unpushed commits: none'
    fi

    unpulled_out="$(cd "$repo_dir" && git log 'HEAD..@{u}' --oneline -20)"
    if [[ -n "$unpulled_out" ]]; then
      log_info 'Unpulled commits:'
      printf '%s\n' "$unpulled_out"
    else
      log_info 'Unpulled commits: none'
    fi
  else
    log_info 'Unpushed / unpulled commits: no upstream configured'
  fi
}

# One-line JSON for Waybar (no log noise). Same repos as cmd_diff.
cmd_diff_status() {
  local fetch_upstream=1

  if [[ "${1:-}" == '--no-fetch' ]]; then
    fetch_upstream=0
  fi

  _diff_status_json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    printf '%s' "$s"
  }

  diff_collect_attention_with_fetch "$fetch_upstream"

  local text tooltip class json_tip only_extra_repos only_pulls_wanted only_extra_worktree_changes
  local issues="${DIFF_ATTENTION_ISSUES:-0}"
  local -a segments=("${DIFF_ATTENTION_SEGMENTS[@]}")

  if [[ "$issues" -eq 0 ]]; then
    text=''
    tooltip='All tracked repositories look up to date.'
    class='dots-ok'
  else
    text=" ${issues}"
    tooltip='Repositories with changes pending: '
    only_extra_repos=1
    only_pulls_wanted=1
    only_extra_worktree_changes=1
    local i=0
    local seg
    for seg in "${segments[@]}"; do
      [[ $i -gt 0 ]] && tooltip+='; '
      tooltip+="$seg"
      if [[ "$seg" != extra:* ]]; then
        only_extra_repos=0
      fi
      i=$((i + 1))
    done
    if [[ "$DIFF_ATTENTION_HAS_DIRTY" -eq 1 ]] || [[ "$DIFF_ATTENTION_HAS_AHEAD" -eq 1 ]] || [[ "$DIFF_ATTENTION_HAS_BEHIND" -ne 1 ]]; then
      only_pulls_wanted=0
    fi
    if [[ "$DIFF_ATTENTION_HAS_DIRTY" -ne 1 ]] || [[ "$DIFF_ATTENTION_HAS_AHEAD" -eq 1 ]] || [[ "$DIFF_ATTENTION_HAS_BEHIND" -eq 1 ]]; then
      only_extra_worktree_changes=0
    fi
    if [[ "$only_pulls_wanted" -eq 1 ]]; then
      class='dots-pull-only'
    elif [[ "$only_extra_repos" -eq 1 ]] && [[ "$only_extra_worktree_changes" -eq 1 ]]; then
      class='dots-extra-only'
    else
      class='dots-attention'
    fi
  fi

  json_tip="$(_diff_status_json_escape "$tooltip")"
  printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$text" "$json_tip" "$class"
}

# Output one "name|path" line per repo that currently has changes (dirty / ahead / behind).
cmd_diff_list_changed() {
  diff_collect_attention
  local i
  for i in "${!DIFF_ATTENTION_SEGMENTS[@]}"; do
    printf '%s|%s\n' "${DIFF_ATTENTION_SEGMENTS[$i]}" "${DIFF_ATTENTION_PATHS[$i]}"
  done
}

# Output one "name|path" line for every repo tracked by dot diff, in diff order.
# Only includes repos whose directories exist on this machine.
cmd_diff_list_all() {
  local p

  p="$PUBLIC_DOTFILES"
  [[ -d "$p" ]] && printf '%s|%s\n' "$(basename -- "${p%/}")" "$p"

  if can_use_private; then
    p="$PRIVATE_DOTFILES"
    [[ -d "$p" ]] && printf '%s|%s\n' "$(basename -- "${p%/}")" "$p"

    p="$NOTES_REPO_DIR"
    [[ -d "$p" ]] && printf '%s|%s\n' "$(basename -- "${p%/}")" "$p"
  fi

  if is_truthy "$INCLUDE_OMARCHY_DIFF_REPOS"; then
    omarchy_collect_repo_targets
    local om_i
    for om_i in "${!OMARCHY_TARGET_PATHS[@]}"; do
      p="${OMARCHY_TARGET_PATHS[$om_i]}"
      [[ -d "$p" ]] && printf '%s|%s\n' "${OMARCHY_TARGET_NAMES[$om_i]}" "$p"
    done
  fi

  if can_use_private; then
    load_private_extra_repos
    sort_private_extra_repos
    local i
    for i in "${!PRIVATE_EXTRA_REPO_PATHS[@]}"; do
      private_extra_repo_visible_now "$i" || continue
      p="${PRIVATE_EXTRA_REPO_PATHS[$i]}"
      [[ -d "$p" ]] && printf '%s|%s\n' "extra:${PRIVATE_EXTRA_REPO_NAMES[$i]}" "$p"
    done
  fi
}

can_use_private() {
  case "$PRIVATE_MODE" in
    always)
      PRIVATE_REASON='DOT_ALLOW_PRIVATE=always'
      return 0
      ;;
    never)
      PRIVATE_REASON='DOT_ALLOW_PRIVATE=never'
      return 1
      ;;
    auto)
      ;;
    *)
      log_warn "Unknown DOT_ALLOW_PRIVATE value '$PRIVATE_MODE', using auto"
      ;;
  esac

  if [[ ! -d "$PRIVATE_DOTFILES" || ! -r "$PRIVATE_DOTFILES" ]]; then
    PRIVATE_REASON="private repo not present/readable ($(display_path "$PRIVATE_DOTFILES"))"
    return 1
  fi

  if ! [[ -O "$PRIVATE_DOTFILES" ]]; then
    PRIVATE_REASON="private repo is not owned by current user ($(display_path "$PRIVATE_DOTFILES"))"
    return 1
  fi

  if has_cmd gh && gh auth status >/dev/null 2>&1; then
    local gh_login
    gh_login="$(gh api user --jq .login 2>/dev/null || true)"
    if [[ -n "$gh_login" && "$gh_login" != "$EXPECTED_GH_USER" ]]; then
      PRIVATE_REASON="gh user '$gh_login' does not match '$EXPECTED_GH_USER'"
      return 1
    fi
  fi

  PRIVATE_REASON='private repo access granted'
  return 0
}

backup_public_files_for_install() {
  local backup_root="$PUBLIC_DOTFILES/backup"

  backup_item_for_install() {
    local source_path="$1"
    local backup_parent="$2"
    local source_name
    local backup_target

    if [[ ! -e "$source_path" ]]; then
      return 0
    fi

    if [[ -L "$source_path" ]]; then
      log_info "Skip backup for symlink target: $(display_path "$source_path")"
      return 0
    fi

    mkdir -p "$backup_parent"
    source_name="${source_path##*/}"
    backup_target="$backup_parent/$source_name"

    if [[ -e "$backup_target" ]]; then
      backup_target="$backup_parent/$source_name.$(date +%Y%m%d-%H%M%S)"
    fi

    log_info "Backup: $(display_path "$source_path") -> $(display_path "$backup_target")"
    mv "$source_path" "$backup_target"
  }

  if [[ -f "$HOME/.zshrc" ]]; then
    backup_item_for_install "$HOME/.zshrc" "$backup_root"
  fi

  if [[ -f "$HOME/.editorconfig" ]]; then
    backup_item_for_install "$HOME/.editorconfig" "$backup_root"
  fi

  if [[ -f "$HOME/.config/ghostty/config.toml" ]]; then
    backup_item_for_install "$HOME/.config/ghostty/config.toml" "$backup_root/.config/ghostty"
  fi

  if [[ -d "$HOME/.config/nvim" ]]; then
    backup_item_for_install "$HOME/.config/nvim" "$backup_root/.config"
  fi
}

install_public_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PUBLIC_DOTFILES" 'public dotfiles'

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  backup_public_files_for_install

  mapfile -t folders < <(list_stow_folders "$PUBLIC_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[public] stow $folder (repo: $(display_path "$PUBLIC_DOTFILES"))"
    stow_in_repo "$PUBLIC_DOTFILES" -D "$folder"

    if [[ "$folder" == 'agents' ]]; then
      stow_in_repo "$PUBLIC_DOTFILES" --no-folding --adopt "$folder"
    else
      stow_in_repo "$PUBLIC_DOTFILES" --adopt "$folder"
    fi
  done
}

stow_public_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PUBLIC_DOTFILES" 'public dotfiles'

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  mapfile -t folders < <(list_stow_folders "$PUBLIC_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[public] stow $folder (repo: $(display_path "$PUBLIC_DOTFILES"))"
    stow_in_repo "$PUBLIC_DOTFILES" -D "$folder"
    if [[ "$folder" == 'agents' ]]; then
      stow_in_repo "$PUBLIC_DOTFILES" --no-folding "$folder"
    else
      stow_in_repo "$PUBLIC_DOTFILES" "$folder"
    fi
  done
}

clean_public_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PUBLIC_DOTFILES" 'public dotfiles'

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  mapfile -t folders < <(list_stow_folders "$PUBLIC_DOTFILES" true)
  for folder in "${folders[@]}"; do
    log_info "[public] remove $folder (repo: $(display_path "$PUBLIC_DOTFILES"))"
    stow_in_repo "$PUBLIC_DOTFILES" -D "$folder"
  done
}

install_private_agents() {
  local opencode_target="$HOME/.config/opencode/opencode.json"
  local backup_dir="$PRIVATE_DOTFILES/backup/opencode"

  if [[ -e "$opencode_target" && ! -L "$opencode_target" ]]; then
    mkdir -p "$backup_dir"
    log_info "Backup: $(display_path "$opencode_target") -> $(display_path "$backup_dir")"
    mv "$opencode_target" "$backup_dir/opencode.json.$(date +%Y%m%d-%H%M%S)"
  fi

  stow_in_repo "$PRIVATE_DOTFILES" \
    --no-folding \
    --ignore=node_modules \
    --ignore=package\.json \
    --ignore=bun\.lock \
    --ignore=\.gitignore \
    agents
}

install_private_dotfiles() {
  local -a folders
  local folder

  require_repo_dir "$PRIVATE_DOTFILES" 'private dotfiles'

  if ! has_cmd stow; then
    log_error 'Stow is required'
    return 1
  fi

  mapfile -t folders < <(list_stow_folders "$PRIVATE_DOTFILES" false)
  for folder in "${folders[@]}"; do
    log_info "[private] stow $folder (repo: $(display_path "$PRIVATE_DOTFILES"))"
    stow_in_repo "$PRIVATE_DOTFILES" -D "$folder"

    if [[ "$folder" == 'agents' ]]; then
      install_private_agents
    else
      stow_in_repo "$PRIVATE_DOTFILES" "$folder"
    fi
  done
}

