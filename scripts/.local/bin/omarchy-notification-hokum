#!/bin/bash

# Stands in for omarchy-notification-wait while Hokum serves notifications in
# place of the shell's notifications plugin, which the stock helper pings and
# so waits out its timeout without. The helper hands off here through the patch
# in ~/.local/share/omarchy-patches, which apply-omarchy-patches applies. Hokum
# reads Omarchy's own notification hints itself since 0.1.1.

set -euo pipefail

usage() {
  echo "Usage: omarchy-notification-hokum active | wait [seconds]" >&2
}

# Hokum owns notifications when it's installed and the shell's plugin is off.
active() {
  command -v hokum >/dev/null 2>&1 &&
    jq -e '(.disabledPlugins // []) | index("omarchy.notifications")' \
      "$HOME/.config/omarchy/shell.json" >/dev/null 2>&1
}

server_ready() {
  busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications \
    org.freedesktop.Notifications GetServerInformation >/dev/null 2>&1
}

wait_ready() {
  local attempts=$((${1:-10} * 10))

  while ((attempts > 0)); do
    if server_ready; then return 0; fi
    attempts=$((attempts - 1))
    sleep 0.1
  done

  return 1
}

case ${1-} in
active) active ;;
wait) wait_ready "${2:-10}" ;;
*)
  usage
  exit 1
  ;;
esac
