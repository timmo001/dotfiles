#!/bin/bash

# Wrapper around topgrade that logs the full session (mimics omarchy-update pattern).
# Log is stored at $XDG_STATE_HOME/topgrade.log (default ~/.local/state) for post-run review.
# Adds --sudoloop for steps that need root (system, firmware, containers) so credentials
# stay cached during long runs, but skips it for user-only steps.

if [[ -z $TOPGRADE_LOGGED ]]; then
  log_file="${XDG_STATE_HOME:-$HOME/.local/state}/topgrade.log"
  mkdir -p "$(dirname "$log_file")"
  script_command=$(printf '%q ' "$0" "$@")
  exec env TOPGRADE_LOGGED=1 script -qefc "$script_command" "$log_file"
fi

# A run is full unless --only restricts it to named steps.
needs_sudo=1
for arg in "$@"; do
  if [[ $arg == --only ]]; then
    needs_sudo=0
    break
  fi
done
if [[ $needs_sudo -eq 0 ]]; then
  for arg in "$@"; do
    case "$arg" in
      system|firmware|containers) needs_sudo=1 ;;
    esac
  done
fi

args=("$@")
if [[ "$needs_sudo" -eq 1 ]]; then
  args+=(--sudoloop)
fi

/usr/bin/topgrade "${args[@]}"
exit $?
