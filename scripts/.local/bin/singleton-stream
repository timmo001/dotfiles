#!/usr/bin/env bash

set -euo pipefail

KEY=""
PARENT_PID="$PPID"
PARENT_STARTTIME=""
POLL_INTERVAL="0.2"
STATE_FILE=""
LOCK_FILE=""

lock_fd=""
source_pid=""
last_line=""
COMMAND=()

usage() {
  cat <<'EOF'
Usage: singleton-stream --key <name> [options] -- <command> [args...]

Options:
  --key <name>            Unique stream key
  --parent-pid <pid>      Parent process to follow (default: caller PPID)
  --parent-starttime <t>  Parent /proc starttime tick (advanced)
  --state-file <path>     Override shared state file path
  --lock-file <path>      Override lock file path
  --poll-interval <sec>   Follower polling interval (default: 0.2)
  --help                  Show this help

Behavior:
  - Exactly one owner process runs the source command stream per key.
  - Followers replay the latest line from the shared state file.
  - Followers can promote to owner if the previous owner exits.
  - Process exits when parent-pid exits to prevent lingering workers.
EOF
}

sanitize_key() {
  local key="$1"
  key="${key//[^a-zA-Z0-9._-]/_}"
  printf '%s' "$key"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --key)
        KEY="$2"
        shift 2
        ;;
      --parent-pid)
        PARENT_PID="$2"
        shift 2
        ;;
      --parent-starttime)
        PARENT_STARTTIME="$2"
        shift 2
        ;;
      --state-file)
        STATE_FILE="$2"
        shift 2
        ;;
      --lock-file)
        LOCK_FILE="$2"
        shift 2
        ;;
      --poll-interval)
        POLL_INTERVAL="$2"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --)
        shift
        break
        ;;
      *)
        printf 'singleton-stream: unknown option: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  if [[ -z "$KEY" ]]; then
    printf 'singleton-stream: --key is required\n' >&2
    exit 1
  fi

  if [[ $# -eq 0 ]]; then
    printf 'singleton-stream: missing command after --\n' >&2
    exit 1
  fi

  if [[ ! "$PARENT_PID" =~ ^[0-9]+$ ]] || (( PARENT_PID <= 1 )); then
    printf 'singleton-stream: --parent-pid must be a positive integer\n' >&2
    exit 1
  fi

  if [[ -n "$PARENT_STARTTIME" ]] && [[ ! "$PARENT_STARTTIME" =~ ^[0-9]+$ ]]; then
    printf 'singleton-stream: --parent-starttime must be numeric\n' >&2
    exit 1
  fi

  if [[ -z "$STATE_FILE" ]]; then
    STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/singleton-stream-$(sanitize_key "$KEY").state"
  fi

  if [[ -z "$LOCK_FILE" ]]; then
    LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/singleton-stream-$(sanitize_key "$KEY").lock"
  fi

  COMMAND=("$@")
}

get_proc_starttime() {
  local pid="$1"

  [[ -r "/proc/$pid/stat" ]] || return 1
  awk '{print $22}' "/proc/$pid/stat"
}

get_proc_state() {
  local pid="$1"

  [[ -r "/proc/$pid/stat" ]] || return 1
  awk '{print $3}' "/proc/$pid/stat"
}

resolve_parent_starttime() {
  if [[ -n "$PARENT_STARTTIME" ]]; then
    return 0
  fi

  PARENT_STARTTIME="$(get_proc_starttime "$PARENT_PID" || true)"
  if [[ -z "$PARENT_STARTTIME" ]]; then
    printf 'singleton-stream: could not read parent starttime for pid %s\n' "$PARENT_PID" >&2
    exit 1
  fi
}

parent_alive() {
  local current_state=""
  local current_starttime=""

  kill -0 "$PARENT_PID" 2>/dev/null || return 1
  current_state="$(get_proc_state "$PARENT_PID" || true)"
  [[ -n "$current_state" ]] || return 1
  [[ "$current_state" != "Z" ]] || return 1

  current_starttime="$(get_proc_starttime "$PARENT_PID" || true)"
  [[ -n "$current_starttime" ]] || return 1
  [[ "$current_starttime" == "$PARENT_STARTTIME" ]]
}

stop_source() {
  if [[ -n "$source_pid" ]]; then
    kill -- "-$source_pid" 2>/dev/null || kill "$source_pid" 2>/dev/null || true
    wait "$source_pid" 2>/dev/null || true
  fi
  source_pid=""
}

cleanup() {
  local owner_pid=""

  if [[ -f "${LOCK_FILE}.owner" ]]; then
    owner_pid="$(< "${LOCK_FILE}.owner")"
    if [[ "$owner_pid" =~ ^[0-9]+$ ]] && (( owner_pid == $$ )); then
      rm -f "${LOCK_FILE}.owner"
    fi
  fi

  stop_source
  if [[ -n "$lock_fd" ]]; then
    exec {lock_fd}>&-
  fi
}

publish_line() {
  local line="$1"
  local tmp="${STATE_FILE}.tmp.$$"

  printf '%s\n' "$line" > "$tmp"
  mv "$tmp" "$STATE_FILE"
  printf '%s\n' "$line"
  last_line="$line"
}

owner_iteration() {
  local line=""
  local read_status=0
  local source_pipe
  source_pipe="${STATE_FILE}.pipe"
  local source_fd=""

  rm -f "$source_pipe"
  mkfifo "$source_pipe"

  ("${COMMAND[@]}") > "$source_pipe" &
  source_pid="$!"
  exec {source_fd}<"$source_pipe"
  rm -f "$source_pipe"

  if [[ -z "$source_fd" || ! "$source_fd" =~ ^[0-9]+$ ]]; then
    if [[ -n "$source_fd" ]]; then
      exec {source_fd}<&-
    fi
    stop_source
    return
  fi

  while parent_alive; do
    if IFS= read -r -t 1 -u "$source_fd" line; then
      publish_line "$line"
      continue
    fi

    read_status=$?
    if (( read_status == 142 )); then
      if [[ -n "$source_pid" ]] && ! kill -0 "$source_pid" 2>/dev/null; then
        break
      fi
      continue
    fi

    break
  done

  exec {source_fd}<&-
  stop_source
}

follower_step() {
  local line

  if [[ -f "$STATE_FILE" ]]; then
    line="$(< "$STATE_FILE")"
    if [[ "$line" != "$last_line" ]]; then
      printf '%s\n' "$line"
      last_line="$line"
    fi
  fi

  sleep "$POLL_INTERVAL"
}

main() {
  local owner_pid

  parse_args "$@"
  resolve_parent_starttime
  trap cleanup EXIT INT TERM

  exec {lock_fd}>"$LOCK_FILE"

  while parent_alive; do
    if flock -n "$lock_fd"; then
      printf '%s\n' "$$" > "${LOCK_FILE}.owner"
      owner_iteration
      if parent_alive; then
        sleep 1
      fi
    else
      if [[ -f "${LOCK_FILE}.owner" ]]; then
        owner_pid="$(< "${LOCK_FILE}.owner")"
        if [[ "$owner_pid" =~ ^[0-9]+$ ]] && kill -0 "$owner_pid" 2>/dev/null; then
          follower_step
          continue
        fi
      fi

      sleep 0.1
      continue
    fi

    if ! parent_alive; then
      break
    fi

    if [[ -f "${LOCK_FILE}.owner" ]]; then
      owner_pid="$(< "${LOCK_FILE}.owner")"
      if [[ "$owner_pid" =~ ^[0-9]+$ ]] && (( owner_pid == $$ )); then
        rm -f "${LOCK_FILE}.owner"
      fi
    fi
  done
}

main "$@"
