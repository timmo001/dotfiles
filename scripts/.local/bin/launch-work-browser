#!/bin/bash

tab=0
if [ "${1:-}" = "--tab" ]; then
  tab=1
  shift
fi

suffix=''
if [ "$#" -gt 0 ]; then
  printf -v suffix ' %q' "$@"
fi

tab_cmd='uwsm app -- google-chrome-stable --ozone-platform=wayland --force-device-scale-factor=0.8 --profile-directory=Profile\ 1 --user-data-dir=$HOME/.config/google-chrome-work --class=work-browser'
window_cmd='uwsm app -- google-chrome-stable --new-window --ozone-platform=wayland --force-device-scale-factor=0.8 --profile-directory=Profile\ 1 --user-data-dir=$HOME/.config/google-chrome-work --class=work-browser'

if [ "$tab" -eq 1 ]; then
  # Focusing the browser here is deliberate, so links pull focus to it.
  # Chrome puts a link in whichever of its windows was focused last. The work
  # profile also runs app windows (Slack, Discord), and when one of those was
  # last, Chrome opens a new window instead of a tab.
  # Tested 2026-10-12: an app window focused gave a new window, the main
  # browser focused gave a tab. Without this focus step, links opened from
  # Slack (Plannotator reviews included) each get their own window.
  browser_window="$({ hyprctl clients -j | jq -r '[.[] | select(.class == "work-browser")] | sort_by(.focusHistoryID) | first | .address // empty'; } 2>/dev/null || true)"

  if [ -n "$browser_window" ]; then
    hyprctl dispatch "hl.dsp.focus({ window = $(jq -Rn --arg value "address:$browser_window" '$value') })" >/dev/null
  fi

  cmd="$tab_cmd$suffix"
  hyprctl dispatch "hl.dsp.exec_cmd($(jq -Rn --arg value "$cmd" '$value'))"
  exit 0
fi

cmd="$window_cmd$suffix"
launch-on-workspace 3 '^(work-browser|google-chrome)$' "$cmd"
