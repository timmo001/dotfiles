#!/usr/bin/env bash

set -euo pipefail

run_in_terminal() {
  local command="${1:?}"
  exec setsid uwsm-app -- xdg-terminal-exec \
    --app-id=org.omarchy.terminal \
    --title='Workspace Menu' \
    -e bash -c "$command; printf '\n'; read -r -p 'Press Enter to close...'"
}

run_with_notify() {
  local label="${1:?}"
  shift
  local output
  if output="$("$@" 2>&1)"; then
    notify-send -a 'Workspace' "$label" "$output"
  else
    notify-send -u critical -a 'Workspace' "$label failed" "${output:-Unknown error}"
  fi
  exit 0
}

while true; do
  options=(
    '󰙀  Relayout current workspace'
    '󰆓  Capture all workspaces'
    '󰆓  Capture current workspace'
    '󰑓  Restore latest (dry run)'
    '󰑓  Restore latest'
  )

  if [[ ${OMARCHY_HOST:-} == 'desktop' ]]; then
    options=('󰣇  Setup workspace' "${options[@]}")
  fi

  choice="$(printf '%s\n' "${options[@]}" | omarchy-launch-walker --dmenu --width 360 --minheight 1 --maxheight 420 -p 'Workspace…' 2>/dev/null || true)"
  choice="${choice#*  }"

  case "$choice" in
    'Setup workspace')
      exec workspace-setup
      ;;
    'Relayout current workspace')
      exec workspace-relayout
      ;;
    'Capture all workspaces')
      run_with_notify 'Capture' workspace-capture
      ;;
    'Capture current workspace')
      run_with_notify 'Capture' workspace-capture --current-workspace
      ;;
    'Restore latest (dry run)')
      run_in_terminal 'workspace-restore --dry-run'
      ;;
    'Restore latest')
      run_with_notify 'Restore' workspace-restore
      ;;
    *)
      exit 0
      ;;
  esac
done
