#!/usr/bin/env bash

set -euo pipefail

while true; do
  options=(
    '󰙀  Relayout current workspace'
    '󰆓  Capture all workspaces'
    '󰆓  Capture current workspace'
    '󰑓  Restore latest (dry run)'
    '󰑓  Restore latest'
  )

  if [[ ${OMARCHY_HOST:-} == 'desktop' ]]; then
    options=('󰣇  Setup workspace' "${options[@]}")
  fi

  choice="$(printf '%s\n' "${options[@]}" | omarchy-launch-walker --dmenu --width 360 --minheight 1 --maxheight 420 -p 'Workspace…' 2>/dev/null || true)"
  choice="${choice#*  }"

  case "$choice" in
    'Setup workspace')
      exec workspace-setup
      ;;
    'Relayout current workspace')
      exec workspace-relayout
      ;;
    'Capture all workspaces')
      run-with-notify -a 'Workspace' 'Capture' workspace-capture; exit 0
      ;;
    'Capture current workspace')
      run-with-notify -a 'Workspace' 'Capture' workspace-capture --current-workspace; exit 0
      ;;
    'Restore latest (dry run)')
      exec run-in-terminal --wait 'workspace-restore --dry-run'
      ;;
    'Restore latest')
      run-with-notify -a 'Workspace' 'Restore' workspace-restore; exit 0
      ;;
    *)
      exit 0
      ;;
  esac
done
