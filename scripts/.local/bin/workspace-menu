#!/usr/bin/env bash

set -euo pipefail

menu_select() {
  local prompt="$1"
  local width="$2"
  local maxheight="$3"
  shift 3

  if command -v omarchy-menu-select >/dev/null 2>&1; then
    omarchy-menu-select "$prompt" "$@" -- --width "$width" --minheight 1 --maxheight "$maxheight" 2>/dev/null || true
    return 0
  fi

  if command -v omarchy-launch-walker >/dev/null 2>&1; then
    printf '%s\n' "$@" | omarchy-launch-walker --dmenu --width "$width" --minheight 1 --maxheight "$maxheight" -p "$prompt…" 2>/dev/null || true
  fi

  return 0
}

while true; do
  options=(
    '󰙀  Relayout current workspace'
    '󰆓  Capture all workspaces'
    '󰆓  Capture current workspace'
    '󰑓  Restore latest (dry run)'
    '󰑓  Restore latest'
  )

  if [[ ${OMARCHY_HOST:-} == 'desktop' ]]; then
    options=('󰣇  Setup workspace' "${options[@]}")
  fi

  choice="$(menu_select 'Workspace' 360 420 "${options[@]}")"
  choice="${choice#*  }"

  case "$choice" in
    'Setup workspace')
      exec workspace-setup
      ;;
    'Relayout current workspace')
      exec workspace-relayout
      ;;
    'Capture all workspaces')
      run-with-notify -a 'Workspace' 'Capture' workspace-capture; exit 0
      ;;
    'Capture current workspace')
      run-with-notify -a 'Workspace' 'Capture' workspace-capture --current-workspace; exit 0
      ;;
    'Restore latest (dry run)')
      exec run-in-terminal --wait 'workspace-restore --dry-run'
      ;;
    'Restore latest')
      run-with-notify -a 'Workspace' 'Restore' workspace-restore; exit 0
      ;;
    *)
      exit 0
      ;;
  esac
done
