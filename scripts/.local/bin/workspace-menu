#!/usr/bin/env bash

set -euo pipefail

choice="$(omarchy-menu-select 'Workspace setup' \
  '󰋜  Normal' \
  '󰣇  Work' \
  -- --width 280 --maxheight 180 2>/dev/null || true)"
choice="${choice#*  }"

case "$choice" in
  Work)
    exec workspace-setup --mode=work
    ;;
  Normal)
    exec workspace-setup --mode=normal
    ;;
  *)
    exit 0
    ;;
esac
