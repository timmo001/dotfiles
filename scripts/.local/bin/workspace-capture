#!/bin/bash

set -euo pipefail

STATE_DIR_DEFAULT="$HOME/.local/state/workspace-sessions"
STATE_DIR="$STATE_DIR_DEFAULT"
OUTPUT_FILE=""
CURRENT_WORKSPACE_ONLY=false
EXCLUDED_CLASS_RE='^workspace-menu-terminal$'
EXCLUDED_TITLE_RE='^Workspace Menu$'

usage() {
  cat <<'EOF'
Usage: workspace-capture [--current-workspace] [--output=FILE] [--state-dir=DIR]

Capture the current Hyprland workspace/window state to JSON.

Options:
  --current-workspace  Capture only visible clients on the active workspace.
  --output=FILE        Write to FILE instead of the default state directory.
  --state-dir=DIR      Directory for default captures.
  -h, --help           Show this help.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --current-workspace|--current)
      CURRENT_WORKSPACE_ONLY=true
      ;;
    --output=*)
      OUTPUT_FILE="${1#*=}"
      ;;
    --state-dir=*)
      STATE_DIR="${1#*=}"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'workspace-capture: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'workspace-capture: required command not found: %s\n' "$1" >&2
    exit 1
  fi
}

require_command hyprctl
require_command jq

mkdir -p "$STATE_DIR"

if [ -z "$OUTPUT_FILE" ]; then
  OUTPUT_FILE="$STATE_DIR/workspace-$(date +%Y%m%d-%H%M%S).json"
fi

mkdir -p "$(dirname "$OUTPUT_FILE")"

exec > >(tee "$STATE_DIR/capture.log") 2>&1

clients_tmp="$(mktemp)"
proc_tmp="$(mktemp)"
trap 'rm -f "$clients_tmp" "$proc_tmp"' EXIT

hyprctl -j clients > "$clients_tmp"

active_workspace_json="$(hyprctl -j activeworkspace)"
active_window_json="$(hyprctl -j activewindow 2>/dev/null || printf '{}')"
monitors_json="$(hyprctl -j monitors)"
active_workspace_id="$(jq -r '.id' <<< "$active_workspace_json")"

jq \
  --arg class_re "$EXCLUDED_CLASS_RE" \
  --arg title_re "$EXCLUDED_TITLE_RE" \
  'map(select(
    (((.class // "") | test($class_re)) or ((.initialClass // "") | test($class_re))
      or ((.title // "") | test($title_re)) or ((.initialTitle // "") | test($title_re)))
    | not
  ))' "$clients_tmp" > "$clients_tmp.filtered"
mv "$clients_tmp.filtered" "$clients_tmp"

if $CURRENT_WORKSPACE_ONLY; then
  jq --argjson ws "$active_workspace_id" 'map(select(.workspace.id == $ws))' "$clients_tmp" > "$clients_tmp.filtered"
  mv "$clients_tmp.filtered" "$clients_tmp"
fi

printf '[' > "$proc_tmp"
first_proc=true

while IFS=$'\t' read -r address pid; do
  [ -n "${address:-}" ] || continue
  [ -n "${pid:-}" ] || continue

  cmdline=""
  cwd=""

  if [ -r "/proc/$pid/cmdline" ]; then
    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" | sed 's/[[:space:]]*$//')"
  fi

  if [ -e "/proc/$pid/cwd" ]; then
    cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
  fi

  if $first_proc; then
    first_proc=false
  else
    printf ',' >> "$proc_tmp"
  fi

  jq -n \
    --arg address "$address" \
    --arg pid "$pid" \
    --arg cmdline "$cmdline" \
    --arg cwd "$cwd" \
    '{address: $address, pid: ($pid | tonumber? // null), cmdline: $cmdline, cwd: $cwd}' >> "$proc_tmp"
done < <(jq -r '.[] | [.address, (.pid // empty)] | @tsv' "$clients_tmp")

printf ']' >> "$proc_tmp"

# Read real URLs from the workspace-urls extension (if available)
URLS_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/browser-urls.json"
urls_tmp="$(mktemp)"
trap 'rm -f "$clients_tmp" "$proc_tmp" "$urls_tmp"' EXIT
if [ -f "$URLS_FILE" ]; then
  cp "$URLS_FILE" "$urls_tmp"
else
  printf '[]' > "$urls_tmp"
fi

jq -n \
  --arg generated_at "$(date --iso-8601=seconds)" \
  --arg scope "$($CURRENT_WORKSPACE_ONLY && printf current-workspace || printf all-workspaces)" \
  --argjson active_workspace "$active_workspace_json" \
  --argjson active_window "$active_window_json" \
  --argjson monitors "$monitors_json" \
  --slurpfile clients "$clients_tmp" \
  --slurpfile proc "$proc_tmp" \
  --slurpfile urls "$urls_tmp" \
  '{
    version: 2,
    generated_at: $generated_at,
    scope: $scope,
    active_workspace: $active_workspace,
    active_window: $active_window,
    monitors: $monitors,
    clients: ($clients[0]
      | map(. + {process: (($proc[0] | INDEX(.address))[.address] // {})})
      | map(
          if (.class | test("^chrome-|^chromium$")) then
            (.title // ""
              | sub("^\\(\\d+\\) "; "")
              | sub(" - Chromium$"; "")
              | sub(" - Google Chrome$"; "")
            ) as $clean |
            ($urls[0] | map(select((.title // "") == $clean)) | .[0].url // null) as $url |
            . + {browser_url: $url}
          else
            .
          end
        ))
  }' > "$OUTPUT_FILE"

printf 'Captured workspace session: %s\n' "$OUTPUT_FILE"
