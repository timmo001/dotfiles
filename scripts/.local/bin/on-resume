#!/bin/bash

# Called after system resume from sleep.
# Restarts services that don't recover well after suspend.

LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/on-resume.log"

log() {
  mkdir -p "$(dirname "$LOG_FILE")"
  echo "[$(date '+%H:%M:%S')] $1" >> "$LOG_FILE"
}

refresh_shell_indicators() {
  omarchy-shell -q omarchy.indicators refresh || true
}

refresh_git_modules() {
  omarchy-shell -q timmo.git-diff refresh || true
  omarchy-shell -q timmo.git-notifications refresh || true
}

if [[ "${ON_RESUME_DETACHED:-0}" != "1" ]]; then
  export ON_RESUME_DETACHED=1
  setsid "$0" "$@" >/dev/null 2>&1 &
  exit 0
fi

: > "$LOG_FILE"
log "Resume started"

# Re-arm the laptop keyboard backlight, which the EC can leave at 0 after
# suspend. No-op off the laptop (the script is a laptop-only stow package) or
# on machines with no keyboard backlight. Omarchy 4 has no host hypridle
# override for us to hook, so the re-arm rides the resume path instead.
if command -v kbd-backlight-rearm >/dev/null 2>&1; then
  kbd-backlight-rearm || true
  log "Re-armed keyboard backlight"
fi

# Restart twitch-notifications
pkill -f '/usr/bin/[t]witch-notifications( |$)' >/dev/null 2>&1 || pkill -f '(^| )[t]witch-notifications( |$)' >/dev/null 2>&1 || true
log "Killed twitch-notifications"

# Ask the shell to repaint state that may have changed while suspended.
refresh_shell_indicators
log "Requested Omarchy shell indicator refresh"

# Reload the polling git status modules so they show fresh state after wake.
refresh_git_modules
log "Requested git status module refresh"

# Restart twitch-notifications after brief delay
sleep 1
uwsm-app -- twitch-notifications >/dev/null 2>&1 &
log "twitch-notifications restarted"

# Prompt to apply core dotfiles/system updates, unless this run is a
# post-update refresh triggered by `dot update` (which would re-prompt
# immediately after a successful update).
if [[ "${1:-}" != "--post-update" ]]; then
  on-resume-update-prompt --launch >/dev/null 2>&1 || true
  log "Checked for dotfiles updates"
fi

log "Resume complete"
