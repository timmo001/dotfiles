#!/bin/bash

# Called by hypridle after_sleep_cmd on system resume from sleep.
# Restarts services that don't recover well after suspend.

LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/on-resume.log"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
WAYBAR_CACHE_DIR="$CACHE_HOME/waybar"
DOT_FETCH_CACHE_DIR="$CACHE_HOME/dot/fetch-upstream"

log() {
  mkdir -p "$(dirname "$LOG_FILE")"
  echo "[$(date '+%H:%M:%S')] $1" >> "$LOG_FILE"
}

clear_git_caches() {
  rm -f "$WAYBAR_CACHE_DIR"/git-*-waybar.json "$WAYBAR_CACHE_DIR"/git-*-waybar.json.tmp
  rmdir "$WAYBAR_CACHE_DIR"/git-*-waybar.lock 2>/dev/null || true
  rm -rf "$DOT_FETCH_CACHE_DIR"
}

if [[ "${ON_RESUME_DETACHED:-0}" != "1" ]]; then
  export ON_RESUME_DETACHED=1
  setsid "$0" "$@" >/dev/null 2>&1 &
  exit 0
fi

: > "$LOG_FILE"
log "Resume started"

# Restart twitch-notifications, auto-opening configured live channels after a real resume.
twitch_args=(--restart)
launch_args=()
if [[ "${1:-}" != "--no-auto-open" ]]; then
  twitch_args+=(--open)
  launch_args+=(--open)
fi

if ! twitch-notifications "${twitch_args[@]}" >/dev/null 2>&1; then
  pkill -f '/usr/bin/[t]witch-notifications( |$)' >/dev/null 2>&1 || pkill -f '(^| )[t]witch-notifications( |$)' >/dev/null 2>&1 || true
  sleep 1
  setsid uwsm-app -s b -- twitch-notifications "${launch_args[@]}" >/dev/null 2>&1 &
fi
log "twitch-notifications restart requested"

# Clear git caches and restart waybar so modules refresh after network resume
clear_git_caches
pkill -x waybar >/dev/null 2>&1 || true
sleep 0.2
pkill -9 -x waybar >/dev/null 2>&1 || true
log "Killed waybar, cleared git caches"

setsid uwsm-app -- waybar >/dev/null 2>&1 &
log "Waybar restarted"

log "Resume complete"
