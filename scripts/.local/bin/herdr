#!/bin/sh
# Herdr remotes look for ~/.local/bin/herdr, so this hands off to mise's Herdr: your own mise's
# on a server, or the system mise's where an image ships it, as the OpenCode app does.

for shim in "$HOME/.local/share/mise/shims/herdr" /usr/local/share/mise/shims/herdr; do
  if [ -x "$shim" ]; then
    exec "$shim" "$@"
  fi
done

printf 'herdr: not installed with mise\n' >&2
exit 127
