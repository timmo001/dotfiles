#!/bin/bash

set -euo pipefail

TEMP_WORKSPACE="${WORKSPACE_RELAYOUT_TEMP_WS:-${WORKSPACE_1_RELAYOUT_TEMP_WS:-99}}"
NOTIFY_TITLE="Workspace relayout"
PRESETS_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/workspace-relayout/presets.json"

# Layouts are ratio-based, not pixel-based, so they look identical on any
# monitor regardless of resolution, scale, reserved bars, or gaps.
#
# Each split in the dwindle tree is set with:
#   hyprctl dispatch layoutmsg splitratio <value> exact
# which sets the focused window's parent split. From the dwindle algorithm,
# the first child of a split gets `box_size / 2 * splitRatio`, so the first
# child's fraction f maps to splitRatio = 2 * f. set_split takes that fraction
# as a percentage (the same numbers shown in the menu labels) and lets
# Hyprland do all the pixel, gap, and border maths.
#
# Presets live in $PRESETS_FILE grouped by window count under .layouts.<count>
# (".layouts.2", ".layouts.3", ".layouts.4"), each a list of { family, name,
# params } records. The window count is the group key, so the menu shown is
# driven by how many tiled windows are on the workspace. Edit mode (--edit)
# captures the current window split ratios back into a preset, either
# overwriting an existing one or adding a new one.

# Set by capture_active_workspace before other logic runs.
WS_ID_JSON=""
WS_ID_STR=""
clients_json="[]"
restore_addr=""

notify() {
  notify-send "$NOTIFY_TITLE" "$1"
}

focus_addr() {
  local addr="$1"
  [ -n "$addr" ] || return 1
  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
}

move_to_workspace() {
  local workspace="$1"
  local addr="$2"
  hyprctl dispatch movetoworkspace "$workspace,address:$addr" >/dev/null 2>&1
}

# Set the dwindle split ratio for the split whose first child is the cell of
# $1 (the focused window). $2 is that first child's share of the split as a
# percentage (0-100), so 74 means the first child takes 74% of the split.
set_split() {
  local addr="$1"
  local first_pct="$2"
  local value

  [ -n "$addr" ] || return 0

  value="$(awk -v p="$first_pct" 'BEGIN { printf "%.4f", 2 * p / 100 }')"

  focus_addr "$addr" || return 1
  hyprctl dispatch layoutmsg splitratio "$value" exact >/dev/null 2>&1
  sleep 0.03
}

require_dependencies() {
  local dep
  for dep in hyprctl jq awk; do
    if ! command -v "$dep" >/dev/null 2>&1; then
      notify "$dep is not available"
      exit 1
    fi
  done

  if [ ! -f "$PRESETS_FILE" ]; then
    notify "Presets file not found: $PRESETS_FILE"
    exit 1
  fi
}

capture_active_workspace() {
  local active_json
  active_json="$(hyprctl -j activeworkspace)"
  WS_ID_JSON="$(jq -c '.id' <<< "$active_json")"
  WS_ID_STR="$(jq -r '.id | tostring' <<< "$active_json")"

  if [ -z "$WS_ID_JSON" ] || [ "$WS_ID_JSON" = "null" ]; then
    notify "Could not read active workspace"
    exit 1
  fi

  local ws_label
  ws_label="$(jq -r 'if ((.name // "") | length) > 0 then " (\(.name))" else "" end' <<< "$active_json")"
  NOTIFY_TITLE="Workspace relayout${ws_label}"
}

validate_temp_workspace() {
  if ! [[ "$TEMP_WORKSPACE" =~ ^[0-9]+$ ]] || [ "$TEMP_WORKSPACE" -le 0 ]; then
    notify "WORKSPACE_RELAYOUT_TEMP_WS must be a positive workspace id"
    exit 1
  fi

  if [ "$TEMP_WORKSPACE" = "$WS_ID_STR" ]; then
    notify "WORKSPACE_RELAYOUT_TEMP_WS must differ from the active workspace id"
    exit 1
  fi
}

load_workspace_clients() {
  clients_json="$(hyprctl -j clients | jq -c --argjson ws "$WS_ID_JSON" '
    [.[]
      | select(.mapped == true)
      | select(.hidden == false)
      | select(.floating == false)
      | select(.workspace.id == $ws)
    ]
  ')"
}

window_count() {
  jq -r 'length' <<< "$clients_json"
}

require_window_count() {
  local expected="$1"
  local count
  count="$(window_count)"

  if [ "$count" -ne "$expected" ]; then
    notify "Expected $expected visible tiled windows on this workspace, found $count"
    exit 1
  fi
}

load_restore_addr() {
  restore_addr="$(hyprctl activewindow -j | jq -r --argjson ws "$WS_ID_JSON" '
    select((.workspace.id // -1) == $ws)
    | .address // empty
  ')"
}

load_grid_addresses() {
  mapfile -t grid_addrs < <(jq -r '
    sort_by(.at[0], .at[1])
    | .[].address
  ' <<< "$clients_json")
}

load_row_addresses() {
  mapfile -t row_addrs < <(jq -r '
    sort_by(.at[1], .at[0])
    | .[].address
  ' <<< "$clients_json")
}

load_column_addresses() {
  mapfile -t column_addrs < <(jq -r '
    sort_by(.at[0], .at[1])
    | .[].address
  ' <<< "$clients_json")
}

move_windows_to_temp() {
  local addr

  for addr in "$@"; do
    move_to_workspace "$TEMP_WORKSPACE" "$addr"
  done

  sleep 0.15
}

restore_focus() {
  if [ -n "$restore_addr" ]; then
    focus_addr "$restore_addr" || true
  fi
}

# ---------------------------------------------------------------------------
# Layout families
#
# Each family has a fixed window count, a build+ratio apply function, a
# capture function that measures the current window split ratios into a
# params object, and a bracket renderer for the menu label. The params keys
# are the same percentages the apply functions and set_split consume.
# ---------------------------------------------------------------------------

family_default_name() {
  case "$1" in
    top-bottom-two) echo "1 top / 1 bottom" ;;
    left-right) echo "1 left / 1 right" ;;
    left-middle-right) echo "1 left / 1 middle / 1 right" ;;
    top-two-bottom) echo "1 top / 2 bottom" ;;
    two-left-one-right) echo "2 left / 1 right" ;;
    grid) echo "2 left / 2 right" ;;
    top-bottom) echo "1 top / 3 bottom" ;;
    *) echo "Layout" ;;
  esac
}

families_for_count() {
  case "$1" in
    2) echo "top-bottom-two left-right" ;;
    3) echo "top-two-bottom two-left-one-right left-middle-right" ;;
    4) echo "grid top-bottom" ;;
    *) echo "" ;;
  esac
}

# Round a number to a whole percentage for display.
r() {
  printf '%.0f' "$1"
}

# Complement of a percentage (100 - x), rounded.
rc() {
  awk -v x="$1" 'BEGIN { printf "%.0f", 100 - x }'
}

family_brackets() {
  local fam="$1"
  local p="$2"

  case "$fam" in
    top-bottom-two)
      local top
      top="$(jq -r '.top' <<< "$p")"
      printf '%s/%s' "$(r "$top")" "$(rc "$top")"
      ;;
    left-right)
      local left
      left="$(jq -r '.left' <<< "$p")"
      printf '%s/%s' "$(r "$left")" "$(rc "$left")"
      ;;
    left-middle-right)
      local left mid a b c
      left="$(jq -r '.left' <<< "$p")"
      mid="$(jq -r '.mid' <<< "$p")"
      a="$(r "$left")"
      b="$(awk -v l="$left" -v m="$mid" 'BEGIN { printf "%.0f", (100 - l) * m / 100 }')"
      c="$(awk -v l="$left" -v m="$mid" 'BEGIN { printf "%.0f", (100 - l) * (100 - m) / 100 }')"
      printf '%s/%s/%s' "$a" "$b" "$c"
      ;;
    top-two-bottom)
      local top bl
      top="$(jq -r '.top' <<< "$p")"
      bl="$(jq -r '.bl' <<< "$p")"
      printf '%s/%s, %s/%s' "$(r "$top")" "$(rc "$top")" "$(r "$bl")" "$(rc "$bl")"
      ;;
    two-left-one-right)
      local lc lt
      lc="$(jq -r '.left_column' <<< "$p")"
      lt="$(jq -r '.left_top' <<< "$p")"
      printf '%s/%s, %s/%s' "$(r "$lt")" "$(rc "$lt")" "$(r "$lc")" "$(rc "$lc")"
      ;;
    grid)
      local lc
      lc="$(jq -r '.left_column' <<< "$p")"
      printf '50/50, %s/%s' "$(r "$lc")" "$(rc "$lc")"
      ;;
    top-bottom)
      local top bl bm a b c
      top="$(jq -r '.top' <<< "$p")"
      bl="$(jq -r '.bl' <<< "$p")"
      bm="$(jq -r '.bm' <<< "$p")"
      a="$(r "$bl")"
      b="$(awk -v l="$bl" -v m="$bm" 'BEGIN { printf "%.0f", (100 - l) * m / 100 }')"
      c="$(awk -v l="$bl" -v m="$bm" 'BEGIN { printf "%.0f", (100 - l) * (100 - m) / 100 }')"
      printf '%s/%s, %s/%s/%s' "$(r "$top")" "$(rc "$top")" "$a" "$b" "$c"
      ;;
    *)
      printf '?'
      ;;
  esac
}

# Measure the current workspace windows into a params object for $1's family.
# Percentages are first-child shares, matching what the apply functions and
# set_split consume. Values are rounded to two decimals.
family_capture() {
  local fam="$1"

  case "$fam" in
    top-bottom-two)
      jq -c 'sort_by(.at[1])
        | (.[0].size[1]) as $a | (.[1].size[1]) as $b
        | { top: (($a / ($a + $b) * 10000 | round) / 100) }' <<< "$clients_json"
      ;;
    left-right)
      jq -c 'sort_by(.at[0])
        | (.[0].size[0]) as $a | (.[1].size[0]) as $b
        | { left: (($a / ($a + $b) * 10000 | round) / 100) }' <<< "$clients_json"
      ;;
    left-middle-right)
      jq -c 'sort_by(.at[0])
        | (.[0].size[0]) as $a | (.[1].size[0]) as $b | (.[2].size[0]) as $c
        | { left: (($a / ($a + $b + $c) * 10000 | round) / 100),
            mid: (($b / ($b + $c) * 10000 | round) / 100) }' <<< "$clients_json"
      ;;
    top-two-bottom)
      jq -c 'sort_by(.at[1])
        | .[0] as $top | (.[1:] | sort_by(.at[0])) as $bot
        | $top.size[1] as $th | $bot[0].size[1] as $bh
        | $bot[0].size[0] as $w0 | $bot[1].size[0] as $w1
        | { top: (($th / ($th + $bh) * 10000 | round) / 100),
            bl: (($w0 / ($w0 + $w1) * 10000 | round) / 100) }' <<< "$clients_json"
      ;;
    two-left-one-right)
      jq -c 'sort_by(.at[0])
        | (.[0].size[0]) as $lw | (.[2].size[0]) as $rw
        | ([.[0], .[1]] | sort_by(.at[1])) as $lc
        | $lc[0].size[1] as $th | $lc[1].size[1] as $bh
        | { left_column: (($lw / ($lw + $rw) * 10000 | round) / 100),
            left_top: (($th / ($th + $bh) * 10000 | round) / 100) }' <<< "$clients_json"
      ;;
    grid)
      jq -c 'sort_by(.at[0])
        | (.[0].size[0]) as $l | (.[3].size[0]) as $r
        | { left_column: (($l / ($l + $r) * 10000 | round) / 100) }' <<< "$clients_json"
      ;;
    top-bottom)
      jq -c 'sort_by(.at[1])
        | .[0] as $top | (.[1:] | sort_by(.at[0])) as $bot
        | $top.size[1] as $th | $bot[0].size[1] as $bh
        | $bot[0].size[0] as $w0 | $bot[1].size[0] as $w1 | $bot[2].size[0] as $w2
        | { top: (($th / ($th + $bh) * 10000 | round) / 100),
            bl: (($w0 / ($w0 + $w1 + $w2) * 10000 | round) / 100),
            bm: (($w1 / ($w1 + $w2) * 10000 | round) / 100) }' <<< "$clients_json"
      ;;
    *)
      echo "{}"
      ;;
  esac
}

apply_preset() {
  local fam="$1"
  local p="$2"

  case "$fam" in
    top-bottom-two)
      apply_top_bottom_two_layout "$(jq -r '.top' <<< "$p")"
      ;;
    left-right)
      apply_left_right_layout "$(jq -r '.left' <<< "$p")"
      ;;
    left-middle-right)
      apply_left_middle_right_layout "$(jq -r '.left' <<< "$p")" "$(jq -r '.mid' <<< "$p")"
      ;;
    top-two-bottom)
      apply_top_two_bottom_layout "$(jq -r '.top' <<< "$p")" "$(jq -r '.bl' <<< "$p")"
      ;;
    two-left-one-right)
      apply_two_left_one_right_layout "$(jq -r '.left_column' <<< "$p")" "$(jq -r '.left_top' <<< "$p")"
      ;;
    grid)
      apply_grid_layout "$(jq -r '.left_column' <<< "$p")"
      ;;
    top-bottom)
      apply_top_bottom_layout "$(jq -r '.top' <<< "$p")" "$(jq -r '.bl' <<< "$p")" "$(jq -r '.bm' <<< "$p")"
      ;;
    *)
      notify "Unknown layout family: $fam"
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Apply functions: rebuild the dwindle tree via a temp workspace and set each
# split's ratio. See the header comment for the splitratio maths.
# ---------------------------------------------------------------------------

# 2 windows, stacked top/bottom. Root split top/bottom, both children leaves.
apply_top_bottom_two_layout() {
  local top_addr bottom_addr
  local top_pct="$1"

  require_window_count 2
  load_restore_addr
  load_row_addresses

  top_addr="${row_addrs[0]}"
  bottom_addr="${row_addrs[1]}"

  move_windows_to_temp "$top_addr" "$bottom_addr"

  move_to_workspace "$WS_ID_STR" "$top_addr"
  focus_addr "$top_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_addr"
  sleep 0.15

  set_split "$top_addr" "$top_pct"

  restore_focus
  notify "Applied 1 top / 1 bottom"
}

# 2 windows, side by side left/right. Root split left/right, both leaves.
apply_left_right_layout() {
  local left_addr right_addr
  local left_pct="$1"

  require_window_count 2
  load_restore_addr
  load_column_addresses

  left_addr="${column_addrs[0]}"
  right_addr="${column_addrs[1]}"

  move_windows_to_temp "$left_addr" "$right_addr"

  move_to_workspace "$WS_ID_STR" "$left_addr"
  focus_addr "$left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$right_addr"
  sleep 0.15

  set_split "$left_addr" "$left_pct"

  restore_focus
  notify "Applied 1 left / 1 right"
}

# 3 windows side by side: root left | (middle | right). Both splits keep a
# leaf child, so each is set after the tree is built.
apply_left_middle_right_layout() {
  local left_addr mid_addr right_addr
  local left_pct="$1"
  local mid_pct="$2"

  require_window_count 3
  load_restore_addr
  load_column_addresses

  left_addr="${column_addrs[0]}"
  mid_addr="${column_addrs[1]}"
  right_addr="${column_addrs[2]}"

  move_windows_to_temp "$left_addr" "$mid_addr" "$right_addr"

  move_to_workspace "$WS_ID_STR" "$left_addr"
  focus_addr "$left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$mid_addr"
  focus_addr "$mid_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$right_addr"
  sleep 0.15

  set_split "$left_addr" "$left_pct"
  set_split "$mid_addr" "$mid_pct"

  restore_focus
  notify "Applied 1 left / 1 middle / 1 right"
}

# 4 windows, 2x2 grid. Root left/right splits the two columns, then each
# column splits top/bottom. The root split has no leaf child once the columns
# are subdivided, so its ratio is set while both columns are still single
# windows; the stored splitRatio survives subdivision.
apply_grid_layout() {
  local top_left_addr bottom_left_addr top_right_addr bottom_right_addr
  local left_column_pct="$1"

  require_window_count 4
  load_restore_addr
  load_grid_addresses

  top_left_addr="${grid_addrs[0]}"
  bottom_left_addr="${grid_addrs[1]}"
  top_right_addr="${grid_addrs[2]}"
  bottom_right_addr="${grid_addrs[3]}"

  move_windows_to_temp "$top_left_addr" "$bottom_left_addr" "$top_right_addr" "$bottom_right_addr"

  move_to_workspace "$WS_ID_STR" "$top_left_addr"
  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$top_right_addr"
  sleep 0.15

  # Root left/right ratio, set while both columns are still leaves.
  set_split "$top_left_addr" "$left_column_pct"

  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  focus_addr "$top_right_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_right_addr"
  sleep 0.15

  set_split "$top_left_addr" 50
  set_split "$top_right_addr" 50

  restore_focus
  notify "Applied 2 left / 2 right"
}

# 4 windows, 1 on top spanning full width, 3 along the bottom row.
# Bottom row nests as (left | (middle | right)); every split keeps a leaf.
apply_top_bottom_layout() {
  local top_addr bottom_left_addr bottom_middle_addr bottom_right_addr
  local top_pct="$1"
  local bottom_left_pct="$2"
  local bottom_middle_pct="$3"

  require_window_count 4
  load_restore_addr
  load_row_addresses

  top_addr="${row_addrs[0]}"
  bottom_left_addr="${row_addrs[1]}"
  bottom_middle_addr="${row_addrs[2]}"
  bottom_right_addr="${row_addrs[3]}"

  move_windows_to_temp "$top_addr" "$bottom_left_addr" "$bottom_middle_addr" "$bottom_right_addr"

  move_to_workspace "$WS_ID_STR" "$top_addr"
  focus_addr "$top_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  focus_addr "$bottom_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_middle_addr"
  focus_addr "$bottom_middle_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_right_addr"
  sleep 0.15

  set_split "$top_addr" "$top_pct"
  set_split "$bottom_left_addr" "$bottom_left_pct"
  set_split "$bottom_middle_addr" "$bottom_middle_pct"

  restore_focus
  notify "Applied 1 top / 3 bottom"
}

# 3 windows, 1 on top spanning full width, 2 along the bottom row.
# Root top/bottom (top is a leaf), then bottom splits left/right (both leaves).
apply_top_two_bottom_layout() {
  local top_addr bottom_left_addr bottom_right_addr
  local top_pct="$1"
  local bottom_left_pct="$2"

  require_window_count 3
  load_restore_addr
  load_row_addresses

  top_addr="${row_addrs[0]}"
  bottom_left_addr="${row_addrs[1]}"
  bottom_right_addr="${row_addrs[2]}"

  move_windows_to_temp "$top_addr" "$bottom_left_addr" "$bottom_right_addr"

  move_to_workspace "$WS_ID_STR" "$top_addr"
  focus_addr "$top_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  focus_addr "$bottom_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_right_addr"
  sleep 0.15

  set_split "$top_addr" "$top_pct"
  set_split "$bottom_left_addr" "$bottom_left_pct"

  restore_focus
  notify "Applied 1 top / 2 bottom"
}

# 3 windows, 2 stacked on the left, 1 filling the right.
# Root left/right (right is a leaf), then the left column splits top/bottom.
apply_two_left_one_right_layout() {
  local top_left_addr bottom_left_addr right_addr
  local left_column_pct="$1"
  local left_top_pct="$2"

  require_window_count 3
  load_restore_addr
  load_grid_addresses

  top_left_addr="${grid_addrs[0]}"
  bottom_left_addr="${grid_addrs[1]}"
  right_addr="${grid_addrs[2]}"

  move_windows_to_temp "$top_left_addr" "$bottom_left_addr" "$right_addr"

  move_to_workspace "$WS_ID_STR" "$top_left_addr"
  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$right_addr"
  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  sleep 0.15

  set_split "$right_addr" "$left_column_pct"
  set_split "$top_left_addr" "$left_top_pct"

  restore_focus
  notify "Applied 2 left / 1 right"
}

# ---------------------------------------------------------------------------
# Menu + presets
# ---------------------------------------------------------------------------

# Show a walker dmenu of the given options and echo the chosen line.
walker_pick() {
  local prompt="$1"
  shift
  printf '%s\n' "$@" | omarchy-launch-walker --dmenu --width 460 --minheight 1 --maxheight 360 -p "$prompt" 2>/dev/null || true
}

# Index of $1 in the remaining args, or -1. Used to map a picked label back to
# its preset without relying on walker's index output.
index_of() {
  local needle="$1"
  shift
  local i=0
  local item
  for item in "$@"; do
    if [ "$item" = "$needle" ]; then
      echo "$i"
      return 0
    fi
    i=$((i + 1))
  done
  echo "-1"
}

# Populate sel_fam/sel_params/sel_label for presets in the $1 window group.
sel_fam=()
sel_params=()
sel_label=()
load_presets_for_count() {
  local count="$1"
  local total gi fam params name

  sel_fam=()
  sel_params=()
  sel_label=()

  total="$(jq -r --arg c "$count" '.layouts[$c] | length' "$PRESETS_FILE")"
  for ((gi = 0; gi < total; gi++)); do
    fam="$(jq -r --arg c "$count" --argjson i "$gi" '.layouts[$c][$i].family' "$PRESETS_FILE")"
    params="$(jq -c --arg c "$count" --argjson i "$gi" '.layouts[$c][$i].params' "$PRESETS_FILE")"
    name="$(jq -r --arg c "$count" --argjson i "$gi" '.layouts[$c][$i].name' "$PRESETS_FILE")"
    sel_fam+=("$fam")
    sel_params+=("$params")
    sel_label+=("$name [$(family_brackets "$fam" "$params")]")
  done
}

# Write JSON ($1) back to the presets file through the stow symlink, leaving
# the symlink intact by truncating the resolved target in place.
save_presets() {
  local new="$1"
  local real tmp
  real="$(readlink -f "$PRESETS_FILE")"
  tmp="$(mktemp)"
  printf '%s\n' "$new" | jq '.' > "$tmp"
  cat "$tmp" > "$real"
  rm -f "$tmp"
}

apply_menu() {
  local count="$1"
  local choice idx

  load_presets_for_count "$count"
  if [ "${#sel_label[@]}" -eq 0 ]; then
    notify "No presets for $count windows"
    exit 0
  fi

  choice="$(walker_pick "$count window layout..." "${sel_label[@]}")"
  [ -n "$choice" ] || exit 0

  idx="$(index_of "$choice" "${sel_label[@]}")"
  [ "$idx" -ge 0 ] || exit 0

  apply_preset "${sel_fam[$idx]}" "${sel_params[$idx]}"
}

edit_overwrite() {
  local count="$1"
  local i="$2"
  local fam params new

  fam="${sel_fam[$i]}"
  params="$(family_capture "$fam")"

  new="$(jq --arg c "$count" --argjson i "$i" --argjson p "$params" '.layouts[$c][$i].params = $p' "$PRESETS_FILE")"
  save_presets "$new"

  notify "Updated $(family_default_name "$fam") [$(family_brackets "$fam" "$params")]"
}

edit_add_new() {
  local count="$1"
  local fams fam choice name params new
  local -a family_ids=()
  local -a family_labels=()

  read -r -a fams <<< "$(families_for_count "$count")"
  for fam in "${fams[@]}"; do
    family_ids+=("$fam")
    family_labels+=("$(family_default_name "$fam")")
  done

  choice="$(walker_pick "Layout type..." "${family_labels[@]}")"
  [ -n "$choice" ] || exit 0

  local fidx
  fidx="$(index_of "$choice" "${family_labels[@]}")"
  [ "$fidx" -ge 0 ] || exit 0
  fam="${family_ids[$fidx]}"

  params="$(family_capture "$fam")"

  name="$(omarchy-launch-walker --dmenu --inputonly --width 460 --minheight 1 --maxheight 1 -p "Layout name" 2>/dev/null || true)"
  [ -n "$name" ] || name="$(family_default_name "$fam")"

  new="$(jq --arg c "$count" --arg f "$fam" --arg n "$name" --argjson p "$params" \
    '.layouts[$c] += [{ family: $f, name: $n, params: $p }]' "$PRESETS_FILE")"
  save_presets "$new"

  notify "Added $name [$(family_brackets "$fam" "$params")]"
}

edit_menu() {
  local count="$1"
  local add_label="➕  Add new layout"
  local choice idx

  load_presets_for_count "$count"

  choice="$(walker_pick "Edit $count window layouts..." "${sel_label[@]}" "$add_label")"
  [ -n "$choice" ] || exit 0

  if [ "$choice" = "$add_label" ]; then
    edit_add_new "$count"
    return
  fi

  idx="$(index_of "$choice" "${sel_label[@]}")"
  [ "$idx" -ge 0 ] || exit 0

  edit_overwrite "$count" "$idx"
}

main() {
  local mode="apply"

  case "${1:-}" in
    --edit | edit)
      mode="edit"
      ;;
    "")
      mode="apply"
      ;;
    *)
      notify "Unknown argument: $1"
      exit 1
      ;;
  esac

  require_dependencies

  if ! command -v omarchy-launch-walker >/dev/null 2>&1; then
    notify "omarchy-launch-walker is not available"
    exit 1
  fi

  capture_active_workspace
  validate_temp_workspace
  load_workspace_clients

  local count
  count="$(window_count)"
  if [ "$count" -lt 2 ] || [ "$count" -gt 4 ]; then
    notify "Expected 2, 3, or 4 visible tiled windows on this workspace, found $count"
    exit 0
  fi

  if [ "$mode" = "edit" ]; then
    edit_menu "$count"
  else
    apply_menu "$count"
  fi
}

main "$@"
