#!/bin/bash

set -euo pipefail

TEMP_WORKSPACE="${WORKSPACE_RELAYOUT_TEMP_WS:-${WORKSPACE_1_RELAYOUT_TEMP_WS:-99}}"
NOTIFY_TITLE="Workspace relayout"
PRESETS_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/workspace-relayout/presets.json"

# Layouts are ratio-based, not pixel-based, so they look identical on any
# monitor regardless of resolution, scale, reserved bars, or gaps.
#
# Each split in the dwindle tree is set with:
#   hyprctl dispatch layoutmsg splitratio <value> exact
# which sets the focused window's parent split. From the dwindle algorithm,
# the first child of a split gets `box_size / 2 * splitRatio`, so the first
# child's fraction f maps to splitRatio = 2 * f. set_split takes that fraction
# as a percentage and lets Hyprland do all the pixel, gap, and border maths.
#
# A layout is stored as a generic guillotine split-tree, not a named family:
#   leaf  -> "w"
#   split -> { dir: "lr"|"tb", ratio: <first-child %>, a: <node>, b: <node> }
# Capture reconstructs this tree from the live window geometry (any dwindle
# layout is a recursive series of full-span cuts), and apply replays it by
# placing windows with preselect + setting each split's ratio. Because the
# engine is generic, any arrangement of any window count works with no
# per-layout code.
#
# Presets live in $PRESETS_FILE grouped by window count under .layouts.<count>,
# each a list of { name, tree } records. Edit mode (--edit) captures the
# current window arrangement back into a preset, overwriting an existing one or
# adding a new one (no layout "type" to pick).

# Set by capture_active_workspace before other logic runs.
WS_ID_JSON=""
WS_ID_STR=""
clients_json="[]"
restore_addr=""

notify() {
  notify-send "$NOTIFY_TITLE" "$1"
}

focus_addr() {
  local addr="$1"
  [ -n "$addr" ] || return 1
  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
}

move_to_workspace() {
  local workspace="$1"
  local addr="$2"
  hyprctl dispatch movetoworkspace "$workspace,address:$addr" >/dev/null 2>&1
}

# Set the dwindle split ratio for the split whose first child is the cell of
# $1 (the focused window). $2 is that first child's share of the split as a
# percentage (0-100), so 74 means the first child takes 74% of the split.
set_split() {
  local addr="$1"
  local first_pct="$2"
  local value

  [ -n "$addr" ] || return 0

  value="$(awk -v p="$first_pct" 'BEGIN { printf "%.4f", 2 * p / 100 }')"

  focus_addr "$addr" || return 1
  hyprctl dispatch layoutmsg splitratio "$value" exact >/dev/null 2>&1
  sleep 0.03
}

require_dependencies() {
  local dep
  for dep in hyprctl jq awk; do
    if ! command -v "$dep" >/dev/null 2>&1; then
      notify "$dep is not available"
      exit 1
    fi
  done

  if [ ! -f "$PRESETS_FILE" ]; then
    notify "Presets file not found: $PRESETS_FILE"
    exit 1
  fi
}

capture_active_workspace() {
  local active_json
  active_json="$(hyprctl -j activeworkspace)"
  WS_ID_JSON="$(jq -c '.id' <<< "$active_json")"
  WS_ID_STR="$(jq -r '.id | tostring' <<< "$active_json")"

  if [ -z "$WS_ID_JSON" ] || [ "$WS_ID_JSON" = "null" ]; then
    notify "Could not read active workspace"
    exit 1
  fi

  local ws_label
  ws_label="$(jq -r 'if ((.name // "") | length) > 0 then " (\(.name))" else "" end' <<< "$active_json")"
  NOTIFY_TITLE="Workspace relayout${ws_label}"
}

validate_temp_workspace() {
  if ! [[ "$TEMP_WORKSPACE" =~ ^[0-9]+$ ]] || [ "$TEMP_WORKSPACE" -le 0 ]; then
    notify "WORKSPACE_RELAYOUT_TEMP_WS must be a positive workspace id"
    exit 1
  fi

  if [ "$TEMP_WORKSPACE" = "$WS_ID_STR" ]; then
    notify "WORKSPACE_RELAYOUT_TEMP_WS must differ from the active workspace id"
    exit 1
  fi
}

load_workspace_clients() {
  clients_json="$(hyprctl -j clients | jq -c --argjson ws "$WS_ID_JSON" '
    [.[]
      | select(.mapped == true)
      | select(.hidden == false)
      | select(.floating == false)
      | select(.workspace.id == $ws)
    ]
  ')"
}

window_count() {
  jq -r 'length' <<< "$clients_json"
}

load_restore_addr() {
  restore_addr="$(hyprctl activewindow -j | jq -r --argjson ws "$WS_ID_JSON" '
    select((.workspace.id // -1) == $ws)
    | .address // empty
  ')"
}

move_windows_to_temp() {
  local addr

  for addr in "$@"; do
    move_to_workspace "$TEMP_WORKSPACE" "$addr"
  done

  sleep 0.15
}

restore_focus() {
  if [ -n "$restore_addr" ]; then
    focus_addr "$restore_addr" || true
  fi
}

# ---------------------------------------------------------------------------
# Generic guillotine split-tree engine (capture, replay, describe)
# ---------------------------------------------------------------------------

# jq library shared by capture_tree / apply_tree / describe_tree.
#   tree      : array of windows -> split-tree (leaf "w" or {dir,ratio,a,b})
#   ops($t)   : split-tree -> ordered build ops [{dir,ratio,anchor,new}]
#   describe  : split-tree -> human label ("1 top / 4 bottom", "3 columns", ...)
# shellcheck disable=SC2016  # all $-names below are jq variables, not shell.
TREE_JQ='
def _l: map(.at[0]) | min;
def _t: map(.at[1]) | min;
def _r: map(.at[0] + .size[0]) | max;
def _b: map(.at[1] + .size[1]) | max;
def _vk:
  (sort_by(.at[0])) as $s | (length) as $n
  | (first( range(1; $n) as $k
      | select( ($s[0:$k] | map(.at[0] + .size[0]) | max) <= ($s[$k:] | map(.at[0]) | min) ) | $k )) // null;
def _hk:
  (sort_by(.at[1])) as $s | (length) as $n
  | (first( range(1; $n) as $k
      | select( ($s[0:$k] | map(.at[1] + .size[1]) | max) <= ($s[$k:] | map(.at[1]) | min) ) | $k )) // null;
def tree:
  if length <= 1 then "w"
  else (_vk) as $vk
    | if $vk != null then
        (sort_by(.at[0])) as $s | ($s[0:$vk]) as $A | ($s[$vk:]) as $B
        | (($A | map(.at[0] + .size[0]) | max) - (_l)) as $ea | ((_r) - ($B | map(.at[0]) | min)) as $eb
        | { dir: "lr", ratio: (($ea / ($ea + $eb)) * 10000 | round) / 100, a: ($A | tree), b: ($B | tree) }
      else
        (_hk) as $hk | (sort_by(.at[1])) as $s
        | (if $hk != null then $hk else 1 end) as $k
        | ($s[0:$k]) as $A | ($s[$k:]) as $B
        | (($A | map(.at[1] + .size[1]) | max) - (_t)) as $ea | ((_b) - ($B | map(.at[1]) | min)) as $eb
        | { dir: "tb", ratio: (($ea / ($ea + $eb)) * 10000 | round) / 100, a: ($A | tree), b: ($B | tree) }
      end
  end;
def leaves: if type == "string" then 1 else (.a | leaves) + (.b | leaves) end;
def allcols: if type == "string" then true elif .dir == "lr" then (.a | allcols) and (.b | allcols) else false end;
def allrows: if type == "string" then true elif .dir == "tb" then (.a | allrows) and (.b | allrows) else false end;
def describe:
  (leaves) as $n
  | if type == "string" then "1 window"
    elif allcols then "\($n) columns"
    elif allrows then "\($n) rows"
    elif .dir == "tb" and (.a | allcols) and (.b | allcols) then "\(.a | leaves) top / \(.b | leaves) bottom"
    elif .dir == "lr" and (.a | allrows) and (.b | allrows) then "\(.a | leaves) left / \(.b | leaves) right"
    else "\($n) windows" end;
def strip_pcts:
  if type == "string" then [100]
  else .ratio as $r
    | ((.a | strip_pcts) | map(. * $r / 100)) + ((.b | strip_pcts) | map(. * (100 - $r) / 100))
  end;
def brackets:
  if type == "string" then ""
  elif allcols or allrows then (strip_pcts | map(round | tostring) | join("/"))
  else (["\(.ratio | round)/\(100 - .ratio | round)"] + ([.a, .b] | map(brackets) | map(select(. != "")))) | join(", ")
  end;
def preset_label: "\(.name) [\(.tree | brackets)]";
def ops($tree):
  def w(node; ai; ni):
    if (node | type) == "string" then { ops: [], next: ni }
    else (ni) as $bi
      | (w(node.a; ai; ni + 1)) as $ra
      | (w(node.b; $bi; $ra.next)) as $rb
      | { ops: ([{ dir: node.dir, ratio: node.ratio, anchor: ai, new: $bi }] + $ra.ops + $rb.ops), next: $rb.next }
    end;
  w($tree; 0; 1).ops;
# Simulate the build ops on a unit box to get each window index final box.
def _sim($ops):
  reduce $ops[] as $op ({ "0": [0, 0, 1, 1] };
    (.[$op.anchor | tostring]) as $bx | ($op.ratio / 100) as $r
    | if $op.dir == "lr"
      then .[$op.anchor | tostring] = [$bx[0], $bx[1], $bx[2] * $r, $bx[3]]
         | .[$op.new | tostring]    = [$bx[0] + $bx[2] * $r, $bx[1], $bx[2] * (1 - $r), $bx[3]]
      else .[$op.anchor | tostring] = [$bx[0], $bx[1], $bx[2], $bx[3] * $r]
         | .[$op.new | tostring]    = [$bx[0], $bx[1] + $bx[3] * $r, $bx[2], $bx[3] * (1 - $r)]
      end);
# Order the current windows (input: clients array) so that window index i is
# the window currently nearest leaf i target position, keeping windows in place
# when re-applying a layout. Output: array of addresses by index.
def assign($tree):
  . as $W | ($W | length) as $n
  | (ops($tree)) as $o | (_sim($o)) as $boxes
  | ([range(0; $n)] | map((($boxes[tostring]) // [0, 0, 1, 1]) as $b | { idx: ., cx: ($b[0] + $b[2] / 2), cy: ($b[1] + $b[3] / 2) })) as $T
  | ($W | map(.at[0]) | min) as $x0 | ($W | map(.at[1]) | min) as $y0
  | (($W | map(.at[0] + .size[0]) | max) - $x0) as $dx | (($W | map(.at[1] + .size[1]) | max) - $y0) as $dy
  | ($W | map({ addr: .address,
                cx: ((.at[0] + .size[0] / 2 - $x0) / (if $dx == 0 then 1 else $dx end)),
                cy: ((.at[1] + .size[1] / 2 - $y0) / (if $dy == 0 then 1 else $dy end)) })) as $WC
  | ($T | sort_by(.cy, .cx) | map(.idx)) as $torder
  | ($WC | sort_by(.cy, .cx) | map(.addr)) as $worder
  | (reduce range(0; $n) as $k ({}; .[$torder[$k] | tostring] = $worder[$k])) as $byidx
  | [range(0; $n) | $byidx[tostring]];
'

# Reconstruct a split-tree from the current workspace window geometry.
capture_tree() {
  jq -c "$TREE_JQ"' tree' <<< "$clients_json"
}

# Human label for a split-tree (used as the default preset name).
describe_tree() {
  jq -rn --argjson t "$1" "$TREE_JQ"' $t | describe'
}

# Rebuild the current workspace into the given split-tree. Windows are
# interchangeable, so any window fills any leaf. Each split's ratio is set
# right after it is created (while both sides are single windows), which is
# what makes balanced splits like a 2x2 grid reproduce exactly.
apply_tree() {
  local tree="$1"
  local -a win
  local n dir ratio ai ni pdir

  load_restore_addr
  mapfile -t win < <(jq -r --argjson t "$tree" "$TREE_JQ"' assign($t)[]' <<< "$clients_json")
  n="${#win[@]}"
  [ "$n" -ge 2 ] || return 0

  move_windows_to_temp "${win[@]}"

  move_to_workspace "$WS_ID_STR" "${win[0]}"
  sleep 0.1

  while IFS=$'\t' read -r dir ratio ai ni; do
    [ -n "$dir" ] || continue
    if [ "$dir" = "lr" ]; then pdir="r"; else pdir="d"; fi

    focus_addr "${win[$ai]}"
    hyprctl dispatch layoutmsg preselect "$pdir" >/dev/null 2>&1 || true
    sleep 0.05

    move_to_workspace "$WS_ID_STR" "${win[$ni]}"
    sleep 0.05

    set_split "${win[$ai]}" "$ratio"
  done < <(jq -rn --argjson t "$tree" "$TREE_JQ"' ops($t)[] | [.dir, .ratio, .anchor, .new] | @tsv')

  restore_focus
  notify "Applied $(describe_tree "$tree")"
}

# ---------------------------------------------------------------------------
# Menu + presets
# ---------------------------------------------------------------------------

# Show an option menu and echo the chosen line via omarchy-menu-select
# (Omarchy 4 shell-IPC selector). Prompts omit a trailing ellipsis;
# omarchy-menu-select appends its own.
menu_select() {
  local prompt="$1"
  local width="$2"
  local maxheight="$3"
  shift 3

  omarchy-menu-select "$prompt" "$@" -- --width "$width" --maxheight "$maxheight" 2>/dev/null || true
}

menu_selector_available() {
  command -v omarchy-menu-select >/dev/null 2>&1
}

# Free-text prompt for a layout name, defaulting to $1. Uses the Omarchy 4
# native menu input (omarchy-menu-input, which summons omarchy.menu). The native
# menu has no editable prefill, so the default is shown in the prompt label and
# an empty submit keeps it; typing overrides it.
prompt_name() {
  local default="$1"
  local out=""

  if command -v omarchy-menu-input >/dev/null 2>&1; then
    out="$(omarchy-menu-input "Layout name ($default)" --width 460 2>/dev/null || true)"
  fi

  if [ -n "$out" ]; then
    printf '%s' "$out"
  else
    printf '%s' "$default"
  fi
}

# Index of $1 in the remaining args, or -1.
index_of() {
  local needle="$1"
  shift
  local i=0
  local item
  for item in "$@"; do
    if [ "$item" = "$needle" ]; then
      echo "$i"
      return 0
    fi
    i=$((i + 1))
  done
  echo "-1"
}

# Populate sel_name/sel_tree/sel_label for presets in the $1 window group.
# sel_label is the menu line ("<name> [<ratios>]"); sel_name/sel_tree are the
# raw values used after a pick.
sel_name=()
sel_tree=()
sel_label=()
load_presets_for_count() {
  local count="$1"
  local name tree lbl

  sel_name=()
  sel_tree=()
  sel_label=()

  while IFS=$'\t' read -r name tree lbl; do
    [ -n "$name" ] || continue
    sel_name+=("$name")
    sel_tree+=("$tree")
    sel_label+=("$lbl")
  done < <(jq -r --arg c "$count" "$TREE_JQ"' (.layouts[$c] // [])[] | [.name, (.tree | tojson), preset_label] | @tsv' "$PRESETS_FILE")
}

# Write JSON ($1) back to the presets file through the stow symlink, leaving
# the symlink intact by truncating the resolved target in place.
save_presets() {
  local new="$1"
  local real tmp
  real="$(readlink -f "$PRESETS_FILE")"
  tmp="$(mktemp)"
  printf '%s\n' "$new" | jq '.' > "$tmp"
  cat "$tmp" > "$real"
  rm -f "$tmp"
}

apply_menu() {
  local count="$1"
  local choice idx

  load_presets_for_count "$count"
  if [ "${#sel_name[@]}" -eq 0 ]; then
    notify "No presets for $count windows yet - use edit mode to add one"
    exit 0
  fi

  choice="$(menu_select "$count window layout" 460 360 "${sel_label[@]}")"
  [ -n "$choice" ] || exit 0

  idx="$(index_of "$choice" "${sel_label[@]}")"
  [ "$idx" -ge 0 ] || exit 0

  apply_tree "${sel_tree[$idx]}"
}

edit_overwrite() {
  local count="$1"
  local i="$2"
  local tree new

  tree="$(capture_tree)"

  new="$(jq --arg c "$count" --argjson i "$i" --argjson t "$tree" '.layouts[$c][$i].tree = $t' "$PRESETS_FILE")"
  save_presets "$new"

  notify "Updated ${sel_name[$i]}"
}

edit_add_new() {
  local count="$1"
  local tree default name new

  tree="$(capture_tree)"
  default="$(describe_tree "$tree")"
  name="$(prompt_name "$default")"

  new="$(jq --arg c "$count" --arg n "$name" --argjson t "$tree" \
    '.layouts[$c] = ((.layouts[$c] // []) + [{ name: $n, tree: $t }])' "$PRESETS_FILE")"
  save_presets "$new"

  notify "Added $name"
}

edit_menu() {
  local count="$1"
  local add_label="➕  Add new layout"
  local choice idx

  load_presets_for_count "$count"

  choice="$(menu_select "Edit $count window layouts" 460 360 "${sel_label[@]}" "$add_label")"
  [ -n "$choice" ] || exit 0

  if [ "$choice" = "$add_label" ]; then
    edit_add_new "$count"
    return
  fi

  idx="$(index_of "$choice" "${sel_label[@]}")"
  [ "$idx" -ge 0 ] || exit 0

  edit_overwrite "$count" "$idx"
}

main() {
  local mode="apply"

  case "${1:-}" in
    --edit | edit)
      mode="edit"
      ;;
    "")
      mode="apply"
      ;;
    *)
      notify "Unknown argument: $1"
      exit 1
      ;;
  esac

  require_dependencies

  if ! menu_selector_available; then
    notify "No Omarchy menu selector is available"
    exit 1
  fi

  capture_active_workspace
  validate_temp_workspace
  load_workspace_clients

  local count
  count="$(window_count)"
  if [ "$count" -lt 2 ]; then
    notify "Need at least 2 tiled windows on this workspace, found $count"
    exit 0
  fi

  if [ "$mode" = "edit" ]; then
    edit_menu "$count"
  else
    apply_menu "$count"
  fi
}

main "$@"
