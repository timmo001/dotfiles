#!/bin/bash

set -euo pipefail

TEMP_WORKSPACE="${WORKSPACE_RELAYOUT_TEMP_WS:-${WORKSPACE_1_RELAYOUT_TEMP_WS:-99}}"
NOTIFY_TITLE="Workspace relayout"

GRID_LEFT_WIDTH=326
GRID_RIGHT_WIDTH=966
GRID_ROW_HEIGHT=390
GRID_HALF_WIDTH=647

TOP_WIDTH=1294
TOP_HEIGHT=576
BOTTOM_LEFT_WIDTH=276
BOTTOM_MIDDLE_WIDTH=276
BOTTOM_RIGHT_WIDTH=738
BOTTOM_ROW_HEIGHT=204
TOP_CURRENT_HEIGHT=424
BOTTOM_CURRENT_ROW_HEIGHT=356

THREE_BOTTOM_LEFT_WIDTH=362
THREE_BOTTOM_RIGHT_WIDTH=930

THREE_LEFT_STACK_WIDTH=326
THREE_LEFT_STACK_ROW_HEIGHT=390
THREE_RIGHT_REST_WIDTH=966
THREE_RIGHT_REST_HEIGHT=780

THREE_CURRENT_TOP_HEIGHT=492
THREE_CURRENT_BOTTOM_LEFT_WIDTH=510
THREE_CURRENT_BOTTOM_RIGHT_WIDTH=782
THREE_CURRENT_BOTTOM_ROW_HEIGHT=288

THREE_HALF_TOP_HEIGHT=392
THREE_HALF_BOTTOM_LEFT_WIDTH=330
THREE_HALF_BOTTOM_RIGHT_WIDTH=962
THREE_HALF_BOTTOM_ROW_HEIGHT=388

TWO_CURRENT_TOP_HEIGHT=576
TWO_CURRENT_BOTTOM_HEIGHT=204

TWO_ALT_TOP_HEIGHT=492
TWO_ALT_BOTTOM_HEIGHT=288

TWO_HALF_HEIGHT=390

# 50/50 side-by-side (full width TOP_WIDTH, height matches stacked 74/26 totals)
TWO_LR_HALF_WIDTH=647
TWO_LR_HEIGHT=780

# 1/3 + 2/3 left to right (1294 → 431 + 863)
TWO_LR_ONE_THIRD_WIDTH=431
TWO_LR_TWO_THIRD_WIDTH=863

# 1/4 + 3/4 left to right, matching the small-left grid widths
TWO_LR_SMALL_LEFT_WIDTH=326
TWO_LR_REST_RIGHT_WIDTH=966

# 1 left / 1 middle / 1 right — equal thirds (TOP_WIDTH 1294 → 431 + 431 + 432)
THREE_LMR_W1=431
THREE_LMR_W2=431
THREE_LMR_W3=432
THREE_LMR_HEIGHT=780

# 1 left / 1 middle / 1 right — 25/remainder/25 split, rounded with equal sides
THREE_LMR_QUARTER_SIDE_WIDTH=324
THREE_LMR_QUARTER_MIDDLE_WIDTH=646

# 1 left / 1 middle / 1 right — 28/remainder/28 split, rounded with equal sides
THREE_LMR_WIDE_SIDE_WIDTH=362
THREE_LMR_WIDE_MIDDLE_WIDTH=570
THREE_LMR_WIDE_HEIGHT=780

# Set by capture_active_workspace before other logic runs.
WS_ID_JSON=""
WS_ID_STR=""

notify() {
  notify-send "$NOTIFY_TITLE" "$1"
}

menu_select() {
  local prompt="$1"
  local width="$2"
  local maxheight="$3"
  shift 3

  if command -v omarchy-menu-select >/dev/null 2>&1; then
    omarchy-menu-select "$prompt" "$@" -- --width "$width" --minheight 1 --maxheight "$maxheight" 2>/dev/null || true
    return 0
  fi

  if command -v omarchy-launch-walker >/dev/null 2>&1; then
    printf '%s\n' "$@" | omarchy-launch-walker --dmenu --width "$width" --minheight 1 --maxheight "$maxheight" -p "$prompt…" 2>/dev/null || true
  fi

  return 0
}

menu_selector_available() {
  command -v omarchy-menu-select >/dev/null 2>&1 || command -v omarchy-launch-walker >/dev/null 2>&1
}

focus_addr() {
  local addr="$1"
  [ -n "$addr" ] || return 1
  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
}

move_to_workspace() {
  local workspace="$1"
  local addr="$2"
  hyprctl dispatch movetoworkspace "$workspace,address:$addr" >/dev/null 2>&1
}

resize_addr_exact() {
  local addr="$1"
  local width="$2"
  local height="$3"

  focus_addr "$addr" || return 1
  hyprctl dispatch resizeactive exact "$width" "$height" >/dev/null 2>&1
}

require_dependencies() {
  if ! command -v hyprctl >/dev/null 2>&1; then
    notify "hyprctl is not available"
    exit 1
  fi

  if ! command -v jq >/dev/null 2>&1; then
    notify "jq is not available"
    exit 1
  fi
}

capture_active_workspace() {
  local active_json
  active_json="$(hyprctl -j activeworkspace)"
  WS_ID_JSON="$(jq -c '.id' <<< "$active_json")"
  WS_ID_STR="$(jq -r '.id | tostring' <<< "$active_json")"

  if [ -z "$WS_ID_JSON" ] || [ "$WS_ID_JSON" = "null" ]; then
    notify "Could not read active workspace"
    exit 1
  fi

  local ws_label
  ws_label="$(jq -r 'if ((.name // "") | length) > 0 then " (\(.name))" else "" end' <<< "$active_json")"
  NOTIFY_TITLE="Workspace relayout${ws_label}"
}

validate_temp_workspace() {
  if ! [[ "$TEMP_WORKSPACE" =~ ^[0-9]+$ ]] || [ "$TEMP_WORKSPACE" -le 0 ]; then
    notify "WORKSPACE_RELAYOUT_TEMP_WS must be a positive workspace id"
    exit 1
  fi

  if [ "$TEMP_WORKSPACE" = "$WS_ID_STR" ]; then
    notify "WORKSPACE_RELAYOUT_TEMP_WS must differ from the active workspace id"
    exit 1
  fi
}

load_workspace_clients() {
  clients_json="$(hyprctl -j clients | jq -c --argjson ws "$WS_ID_JSON" '
    [.[]
      | select(.mapped == true)
      | select(.hidden == false)
      | select(.floating == false)
      | select(.workspace.id == $ws)
    ]
  ')"
}

ensure_four_windows() {
  local window_count
  window_count="$(jq -r 'length' <<< "$clients_json")"

  if [ "$window_count" -ne 4 ]; then
    notify "Expected 4 visible tiled windows on this workspace, found $window_count"
    exit 1
  fi
}

load_restore_addr() {
  restore_addr="$(hyprctl activewindow -j | jq -r --argjson ws "$WS_ID_JSON" '
    select((.workspace.id // -1) == $ws)
    | .address // empty
  ')"
}

load_grid_addresses() {
  mapfile -t grid_addrs < <(jq -r '
    sort_by(.at[0], .at[1])
    | .[].address
  ' <<< "$clients_json")
}

load_row_addresses() {
  mapfile -t row_addrs < <(jq -r '
    sort_by(.at[1], .at[0])
    | .[].address
  ' <<< "$clients_json")
}

load_column_addresses() {
  mapfile -t column_addrs < <(jq -r '
    sort_by(.at[0], .at[1])
    | .[].address
  ' <<< "$clients_json")
}

move_windows_to_temp() {
  local addr

  for addr in "$@"; do
    move_to_workspace "$TEMP_WORKSPACE" "$addr"
  done

  sleep 0.15
}

restore_focus() {
  if [ -n "$restore_addr" ]; then
    focus_addr "$restore_addr" || true
  fi
}

choose_layout() {
  local choice
  local option_count
  local prompt
  local two_label
  local two_alt_label
  local two_half_label
  local two_lr_label
  local two_lr_one_third_label
  local two_lr_small_left_label
  local grid_label
  local grid_half_label
  local top_bottom_label
  local top_bottom_current_label
  local three_label
  local three_current_label
  local three_half_label
  local three_left_stack_label
  local three_lmr_label
  local three_lmr_quarter_label
  local three_lmr_wide_label

  if ! menu_selector_available; then
    notify "No Omarchy menu selector is available"
    return 1
  fi

  option_count="$(jq -r 'length' <<< "$clients_json")"
  prompt="$option_count window layout"
  two_label='1 top / 1 bottom [74/26]'
  two_alt_label='1 top / 1 bottom [63/37]'
  two_half_label='1 top / 1 bottom [50/50]'
  two_lr_label='1 left / 1 right [50/50]'
  two_lr_one_third_label='1 left / 1 right [1/3, 2/3]'
  two_lr_small_left_label='1 left / 1 right [25/75]'
  grid_label='2 left / 2 right [50/50, 25/75]'
  grid_half_label='2 left / 2 right [50/50, 50/50]'
  top_bottom_label='1 top / 3 bottom [74/26, 21/21/57]'
  top_bottom_current_label='1 top / 3 bottom [54/46, 21/21/57]'
  three_label='1 top / 2 bottom [74/26, 28/72]'
  three_current_label='1 top / 2 bottom [63/37, 39/61]'
  three_half_label='1 top / 2 bottom [50/50, 26/74]'
  three_left_stack_label='2 left / 1 right [50/50, 25/75]'
  three_lmr_label='1 left / 1 middle / 1 right [1/3, 1/3, 1/3]'
  three_lmr_quarter_label='1 left / 1 middle / 1 right [25/50/25]'
  three_lmr_wide_label='1 left / 1 middle / 1 right [28/44/28]'

  case "$option_count" in
    2)
      choice="$(menu_select "$prompt" 400 320 "$two_label" "$two_alt_label" "$two_half_label" "$two_lr_label" "$two_lr_one_third_label" "$two_lr_small_left_label")"
      ;;
    4)
      choice="$(menu_select "$prompt" 360 240 "$grid_label" "$grid_half_label" "$top_bottom_label" "$top_bottom_current_label")"
      ;;
    3)
      choice="$(menu_select "$prompt" 420 300 "$three_label" "$three_current_label" "$three_half_label" "$three_left_stack_label" "$three_lmr_label" "$three_lmr_quarter_label" "$three_lmr_wide_label")"
      ;;
    *)
      notify "Expected 2, 3, or 4 visible tiled windows on this workspace, found $option_count"
      return 1
      ;;
  esac

  case "$choice" in
    "$two_label")
      printf 'top-bottom-two\n'
      ;;
    "$two_alt_label")
      printf 'top-bottom-two-alt\n'
      ;;
    "$two_half_label")
      printf 'top-bottom-two-half\n'
      ;;
    "$two_lr_label")
      printf 'left-right-half\n'
      ;;
    "$two_lr_one_third_label")
      printf 'left-right-one-third\n'
      ;;
    "$two_lr_small_left_label")
      printf 'left-right-small-left\n'
      ;;
    "$grid_label")
      printf 'grid\n'
      ;;
    "$grid_half_label")
      printf 'grid-half\n'
      ;;
    "$top_bottom_label")
      printf 'top-bottom\n'
      ;;
    "$top_bottom_current_label")
      printf 'top-bottom-current\n'
      ;;
    "$three_label")
      printf 'top-two-bottom\n'
      ;;
    "$three_current_label")
      printf 'top-two-bottom-current\n'
      ;;
    "$three_half_label")
      printf 'top-two-bottom-half\n'
      ;;
    "$three_left_stack_label")
      printf 'two-left-one-right\n'
      ;;
    "$three_lmr_label")
      printf 'left-middle-right-thirds\n'
      ;;
    "$three_lmr_quarter_label")
      printf 'left-middle-right-quarter\n'
      ;;
    "$three_lmr_wide_label")
      printf 'left-middle-right-wide\n'
      ;;
    *)
      return 1
      ;;
  esac
}

apply_top_bottom_two_layout() {
  local top_addr bottom_addr

  local window_count
  window_count="$(jq -r 'length' <<< "$clients_json")"
  if [ "$window_count" -ne 2 ]; then
    notify "Expected 2 visible tiled windows on this workspace, found $window_count"
    exit 1
  fi

  load_restore_addr
  load_row_addresses

  top_addr="${row_addrs[0]}"
  bottom_addr="${row_addrs[1]}"

  move_windows_to_temp "$top_addr" "$bottom_addr"

  move_to_workspace "$WS_ID_STR" "$top_addr"
  focus_addr "$top_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_addr"
  sleep 0.15

  resize_addr_exact "$top_addr" "$TOP_WIDTH" "$TWO_CURRENT_TOP_HEIGHT" || true
  resize_addr_exact "$bottom_addr" "$TOP_WIDTH" "$TWO_CURRENT_BOTTOM_HEIGHT" || true

  restore_focus
  notify "Applied 1 top / 1 bottom"
}

apply_top_bottom_two_alt_layout() {
  local top_addr bottom_addr

  local window_count
  window_count="$(jq -r 'length' <<< "$clients_json")"
  if [ "$window_count" -ne 2 ]; then
    notify "Expected 2 visible tiled windows on this workspace, found $window_count"
