  resize_addr_exact "$mid_addr" "$THREE_LMR_WIDE_MIDDLE_WIDTH" "$THREE_LMR_WIDE_HEIGHT" || true
  resize_addr_exact "$right_addr" "$THREE_LMR_WIDE_SIDE_WIDTH" "$THREE_LMR_WIDE_HEIGHT" || true

  restore_focus
  notify "Applied 1 left / 1 middle / 1 right"
}

apply_grid_layout() {
  local top_left_addr bottom_left_addr top_right_addr bottom_right_addr

  ensure_four_windows
  load_restore_addr
  load_grid_addresses

  top_left_addr="${grid_addrs[0]}"
  bottom_left_addr="${grid_addrs[1]}"
  top_right_addr="${grid_addrs[2]}"
  bottom_right_addr="${grid_addrs[3]}"

  move_windows_to_temp "$top_left_addr" "$bottom_left_addr" "$top_right_addr" "$bottom_right_addr"

  move_to_workspace "$WS_ID_STR" "$top_left_addr"
  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$top_right_addr"
  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  focus_addr "$top_right_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_right_addr"
  sleep 0.15

  resize_addr_exact "$top_left_addr" "$GRID_LEFT_WIDTH" "$GRID_ROW_HEIGHT" || true
  resize_addr_exact "$bottom_left_addr" "$GRID_LEFT_WIDTH" "$GRID_ROW_HEIGHT" || true
  resize_addr_exact "$top_right_addr" "$GRID_RIGHT_WIDTH" "$GRID_ROW_HEIGHT" || true
  resize_addr_exact "$bottom_right_addr" "$GRID_RIGHT_WIDTH" "$GRID_ROW_HEIGHT" || true

  restore_focus
  notify "Applied 2 left / 2 right"
}

apply_grid_half_layout() {
  local top_left_addr bottom_left_addr top_right_addr bottom_right_addr

  ensure_four_windows
  load_restore_addr
  load_grid_addresses

  top_left_addr="${grid_addrs[0]}"
  bottom_left_addr="${grid_addrs[1]}"
  top_right_addr="${grid_addrs[2]}"
  bottom_right_addr="${grid_addrs[3]}"

  move_windows_to_temp "$top_left_addr" "$bottom_left_addr" "$top_right_addr" "$bottom_right_addr"

  move_to_workspace "$WS_ID_STR" "$top_left_addr"
  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$top_right_addr"
  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  focus_addr "$top_right_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_right_addr"
  sleep 0.15

  resize_addr_exact "$top_left_addr" "$GRID_HALF_WIDTH" "$GRID_ROW_HEIGHT" || true
  resize_addr_exact "$bottom_left_addr" "$GRID_HALF_WIDTH" "$GRID_ROW_HEIGHT" || true
  resize_addr_exact "$top_right_addr" "$GRID_HALF_WIDTH" "$GRID_ROW_HEIGHT" || true
  resize_addr_exact "$bottom_right_addr" "$GRID_HALF_WIDTH" "$GRID_ROW_HEIGHT" || true

  restore_focus
  notify "Applied 2 left / 2 right"
}

apply_top_bottom_layout() {
  local top_addr bottom_left_addr bottom_middle_addr bottom_right_addr

  ensure_four_windows
  load_restore_addr
  load_row_addresses

  top_addr="${row_addrs[0]}"
  bottom_left_addr="${row_addrs[1]}"
  bottom_middle_addr="${row_addrs[2]}"
  bottom_right_addr="${row_addrs[3]}"

  move_windows_to_temp "$top_addr" "$bottom_left_addr" "$bottom_middle_addr" "$bottom_right_addr"

  move_to_workspace "$WS_ID_STR" "$top_addr"
  focus_addr "$top_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  focus_addr "$bottom_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_middle_addr"
  focus_addr "$bottom_middle_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_right_addr"
  sleep 0.15

  resize_addr_exact "$top_addr" "$TOP_WIDTH" "$TOP_HEIGHT" || true
  resize_addr_exact "$bottom_left_addr" "$BOTTOM_LEFT_WIDTH" "$BOTTOM_ROW_HEIGHT" || true
  resize_addr_exact "$bottom_middle_addr" "$BOTTOM_MIDDLE_WIDTH" "$BOTTOM_ROW_HEIGHT" || true
  resize_addr_exact "$bottom_right_addr" "$BOTTOM_RIGHT_WIDTH" "$BOTTOM_ROW_HEIGHT" || true

  restore_focus
  notify "Applied 1 top / 3 bottom"
}

