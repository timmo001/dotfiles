apply_left_middle_right_thirds_layout() {
  local left_addr mid_addr right_addr

  local window_count
  window_count="$(jq -r 'length' <<< "$clients_json")"
  if [ "$window_count" -ne 3 ]; then
    notify "Expected 3 visible tiled windows on this workspace, found $window_count"
    exit 1
  fi

  load_restore_addr
  load_column_addresses

  left_addr="${column_addrs[0]}"
  mid_addr="${column_addrs[1]}"
  right_addr="${column_addrs[2]}"

  move_windows_to_temp "$left_addr" "$mid_addr" "$right_addr"

  move_to_workspace "$WS_ID_STR" "$left_addr"
  focus_addr "$left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$mid_addr"
  focus_addr "$mid_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$right_addr"
  sleep 0.15

  resize_addr_exact "$left_addr" "$THREE_LMR_W1" "$THREE_LMR_HEIGHT" || true
  resize_addr_exact "$mid_addr" "$THREE_LMR_W2" "$THREE_LMR_HEIGHT" || true
  resize_addr_exact "$right_addr" "$THREE_LMR_W3" "$THREE_LMR_HEIGHT" || true

  restore_focus
  notify "Applied 1 left / 1 middle / 1 right"
}

apply_left_middle_right_quarter_layout() {
  local left_addr mid_addr right_addr

  local window_count
  window_count="$(jq -r 'length' <<< "$clients_json")"
  if [ "$window_count" -ne 3 ]; then
