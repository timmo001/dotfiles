#!/bin/bash

set -euo pipefail

TEMP_WORKSPACE="${WORKSPACE_RELAYOUT_TEMP_WS:-${WORKSPACE_1_RELAYOUT_TEMP_WS:-99}}"
NOTIFY_TITLE="Workspace relayout"

# Layouts are ratio-based, not pixel-based, so they look identical on any
# monitor regardless of resolution, scale, reserved bars, or gaps.
#
# Each split in the dwindle tree is set with:
#   hyprctl dispatch layoutmsg splitratio <value> exact
# which sets the focused window's parent split. From the dwindle algorithm,
# the first child of a split gets `box_size / 2 * splitRatio`, so the first
# child's fraction f maps to splitRatio = 2 * f. set_split takes that fraction
# as a percentage (the same numbers shown in the menu labels) and lets
# Hyprland do all the pixel, gap, and border maths.

# Set by capture_active_workspace before other logic runs.
WS_ID_JSON=""
WS_ID_STR=""

notify() {
  notify-send "$NOTIFY_TITLE" "$1"
}

focus_addr() {
  local addr="$1"
  [ -n "$addr" ] || return 1
  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
}

move_to_workspace() {
  local workspace="$1"
  local addr="$2"
  hyprctl dispatch movetoworkspace "$workspace,address:$addr" >/dev/null 2>&1
}

# Set the dwindle split ratio for the split whose first child is the cell of
# $1 (the focused window). $2 is that first child's share of the split as a
# percentage (0-100), so 74 means the first child takes 74% of the split.
set_split() {
  local addr="$1"
  local first_pct="$2"
  local value

  [ -n "$addr" ] || return 0

  value="$(awk -v p="$first_pct" 'BEGIN { printf "%.4f", 2 * p / 100 }')"

  focus_addr "$addr" || return 1
  hyprctl dispatch layoutmsg splitratio "$value" exact >/dev/null 2>&1
  sleep 0.03
}

require_dependencies() {
  if ! command -v hyprctl >/dev/null 2>&1; then
    notify "hyprctl is not available"
    exit 1
  fi

  if ! command -v jq >/dev/null 2>&1; then
    notify "jq is not available"
    exit 1
  fi

  if ! command -v awk >/dev/null 2>&1; then
    notify "awk is not available"
    exit 1
  fi
}

capture_active_workspace() {
  local active_json
  active_json="$(hyprctl -j activeworkspace)"
  WS_ID_JSON="$(jq -c '.id' <<< "$active_json")"
  WS_ID_STR="$(jq -r '.id | tostring' <<< "$active_json")"

  if [ -z "$WS_ID_JSON" ] || [ "$WS_ID_JSON" = "null" ]; then
    notify "Could not read active workspace"
    exit 1
  fi

  local ws_label
  ws_label="$(jq -r 'if ((.name // "") | length) > 0 then " (\(.name))" else "" end' <<< "$active_json")"
  NOTIFY_TITLE="Workspace relayout${ws_label}"
}

validate_temp_workspace() {
  if ! [[ "$TEMP_WORKSPACE" =~ ^[0-9]+$ ]] || [ "$TEMP_WORKSPACE" -le 0 ]; then
    notify "WORKSPACE_RELAYOUT_TEMP_WS must be a positive workspace id"
    exit 1
  fi

  if [ "$TEMP_WORKSPACE" = "$WS_ID_STR" ]; then
    notify "WORKSPACE_RELAYOUT_TEMP_WS must differ from the active workspace id"
    exit 1
  fi
}

load_workspace_clients() {
  clients_json="$(hyprctl -j clients | jq -c --argjson ws "$WS_ID_JSON" '
    [.[]
      | select(.mapped == true)
      | select(.hidden == false)
      | select(.floating == false)
      | select(.workspace.id == $ws)
    ]
  ')"
}

require_window_count() {
  local expected="$1"
  local window_count
  window_count="$(jq -r 'length' <<< "$clients_json")"

  if [ "$window_count" -ne "$expected" ]; then
    notify "Expected $expected visible tiled windows on this workspace, found $window_count"
    exit 1
  fi
}

load_restore_addr() {
  restore_addr="$(hyprctl activewindow -j | jq -r --argjson ws "$WS_ID_JSON" '
    select((.workspace.id // -1) == $ws)
    | .address // empty
  ')"
}

load_grid_addresses() {
  mapfile -t grid_addrs < <(jq -r '
    sort_by(.at[0], .at[1])
    | .[].address
  ' <<< "$clients_json")
}

load_row_addresses() {
  mapfile -t row_addrs < <(jq -r '
    sort_by(.at[1], .at[0])
    | .[].address
  ' <<< "$clients_json")
}

load_column_addresses() {
  mapfile -t column_addrs < <(jq -r '
    sort_by(.at[0], .at[1])
    | .[].address
  ' <<< "$clients_json")
}

move_windows_to_temp() {
  local addr

  for addr in "$@"; do
    move_to_workspace "$TEMP_WORKSPACE" "$addr"
  done

  sleep 0.15
}

restore_focus() {
  if [ -n "$restore_addr" ]; then
    focus_addr "$restore_addr" || true
  fi
}

choose_layout() {
  local choice
  local option_count
  local prompt
  local two_label
  local two_alt_label
  local two_half_label
  local two_lr_label
  local two_lr_one_third_label
  local two_lr_small_left_label
  local grid_label
  local grid_half_label
  local top_bottom_label
  local top_bottom_current_label
  local three_label
  local three_current_label
  local three_half_label
  local three_left_stack_label
  local three_lmr_label
  local three_lmr_quarter_label
  local three_lmr_wide_label

  if ! command -v omarchy-launch-walker >/dev/null 2>&1; then
    notify "omarchy-launch-walker is not available"
    return 1
  fi

  option_count="$(jq -r 'length' <<< "$clients_json")"
  prompt="$option_count window layout..."
  two_label='1 top / 1 bottom [74/26]'
  two_alt_label='1 top / 1 bottom [63/37]'
  two_half_label='1 top / 1 bottom [50/50]'
  two_lr_label='1 left / 1 right [50/50]'
  two_lr_one_third_label='1 left / 1 right [1/3, 2/3]'
  two_lr_small_left_label='1 left / 1 right [25/75]'
  grid_label='2 left / 2 right [50/50, 25/75]'
  grid_half_label='2 left / 2 right [50/50, 50/50]'
  top_bottom_label='1 top / 3 bottom [74/26, 21/21/57]'
  top_bottom_current_label='1 top / 3 bottom [54/46, 21/21/57]'
  three_label='1 top / 2 bottom [74/26, 28/72]'
  three_current_label='1 top / 2 bottom [63/37, 39/61]'
  three_half_label='1 top / 2 bottom [50/50, 26/74]'
  three_left_stack_label='2 left / 1 right [50/50, 25/75]'
  three_lmr_label='1 left / 1 middle / 1 right [1/3, 1/3, 1/3]'
  three_lmr_quarter_label='1 left / 1 middle / 1 right [25/50/25]'
  three_lmr_wide_label='1 left / 1 middle / 1 right [28/44/28]'

  case "$option_count" in
    2)
      choice="$(printf '%s\n' "$two_label" "$two_alt_label" "$two_half_label" "$two_lr_label" "$two_lr_one_third_label" "$two_lr_small_left_label" | omarchy-launch-walker --dmenu --width 400 --minheight 1 --maxheight 320 -p "$prompt" 2>/dev/null || true)"
      ;;
    4)
      choice="$(printf '%s\n' "$grid_label" "$grid_half_label" "$top_bottom_label" "$top_bottom_current_label" | omarchy-launch-walker --dmenu --width 360 --minheight 1 --maxheight 240 -p "$prompt" 2>/dev/null || true)"
      ;;
    3)
      choice="$(printf '%s\n' "$three_label" "$three_current_label" "$three_half_label" "$three_left_stack_label" "$three_lmr_label" "$three_lmr_quarter_label" "$three_lmr_wide_label" | omarchy-launch-walker --dmenu --width 420 --minheight 1 --maxheight 300 -p "$prompt" 2>/dev/null || true)"
      ;;
    *)
      notify "Expected 2, 3, or 4 visible tiled windows on this workspace, found $option_count"
      return 1
      ;;
  esac

  case "$choice" in
    "$two_label")
      printf 'top-bottom-two\n'
      ;;
    "$two_alt_label")
      printf 'top-bottom-two-alt\n'
      ;;
    "$two_half_label")
      printf 'top-bottom-two-half\n'
      ;;
    "$two_lr_label")
      printf 'left-right-half\n'
      ;;
    "$two_lr_one_third_label")
      printf 'left-right-one-third\n'
      ;;
    "$two_lr_small_left_label")
      printf 'left-right-small-left\n'
      ;;
    "$grid_label")
      printf 'grid\n'
      ;;
    "$grid_half_label")
      printf 'grid-half\n'
      ;;
    "$top_bottom_label")
      printf 'top-bottom\n'
      ;;
    "$top_bottom_current_label")
      printf 'top-bottom-current\n'
      ;;
    "$three_label")
      printf 'top-two-bottom\n'
      ;;
    "$three_current_label")
      printf 'top-two-bottom-current\n'
      ;;
    "$three_half_label")
      printf 'top-two-bottom-half\n'
      ;;
    "$three_left_stack_label")
      printf 'two-left-one-right\n'
      ;;
    "$three_lmr_label")
      printf 'left-middle-right-thirds\n'
      ;;
    "$three_lmr_quarter_label")
      printf 'left-middle-right-quarter\n'
      ;;
    "$three_lmr_wide_label")
      printf 'left-middle-right-wide\n'
      ;;
    *)
      return 1
      ;;
  esac
}

# 2 windows, stacked top/bottom. Root split top/bottom, both children leaves.
apply_top_bottom_two_layout() {
  local top_addr bottom_addr
  local top_pct="$1"

  require_window_count 2
  load_restore_addr
  load_row_addresses

  top_addr="${row_addrs[0]}"
  bottom_addr="${row_addrs[1]}"

  move_windows_to_temp "$top_addr" "$bottom_addr"

  move_to_workspace "$WS_ID_STR" "$top_addr"
  focus_addr "$top_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_addr"
  sleep 0.15

  set_split "$top_addr" "$top_pct"

  restore_focus
  notify "Applied 1 top / 1 bottom"
}

# 2 windows, side by side left/right. Root split left/right, both leaves.
apply_left_right_layout() {
  local left_addr right_addr
  local left_pct="$1"

  require_window_count 2
  load_restore_addr
  load_column_addresses

  left_addr="${column_addrs[0]}"
  right_addr="${column_addrs[1]}"

  move_windows_to_temp "$left_addr" "$right_addr"

  move_to_workspace "$WS_ID_STR" "$left_addr"
  focus_addr "$left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$right_addr"
  sleep 0.15

  set_split "$left_addr" "$left_pct"

  restore_focus
  notify "Applied 1 left / 1 right"
}

# 3 windows side by side: root left | (middle | right). Both splits keep a
# leaf child, so each is set after the tree is built.
apply_left_middle_right_layout() {
  local left_addr mid_addr right_addr
  local left_pct="$1"
  local mid_pct="$2"

  require_window_count 3
  load_restore_addr
  load_column_addresses

  left_addr="${column_addrs[0]}"
  mid_addr="${column_addrs[1]}"
  right_addr="${column_addrs[2]}"

  move_windows_to_temp "$left_addr" "$mid_addr" "$right_addr"

  move_to_workspace "$WS_ID_STR" "$left_addr"
  focus_addr "$left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$mid_addr"
  focus_addr "$mid_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$right_addr"
  sleep 0.15

  set_split "$left_addr" "$left_pct"
  set_split "$mid_addr" "$mid_pct"

  restore_focus
  notify "Applied 1 left / 1 middle / 1 right"
}

# 4 windows, 2x2 grid. Root left/right splits the two columns, then each
# column splits top/bottom. The root split has no leaf child once the columns
# are subdivided, so its ratio is set while both columns are still single
# windows; the stored splitRatio survives subdivision.
apply_grid_layout() {
  local top_left_addr bottom_left_addr top_right_addr bottom_right_addr
  local left_column_pct="$1"

  require_window_count 4
  load_restore_addr
  load_grid_addresses

  top_left_addr="${grid_addrs[0]}"
  bottom_left_addr="${grid_addrs[1]}"
  top_right_addr="${grid_addrs[2]}"
  bottom_right_addr="${grid_addrs[3]}"

  move_windows_to_temp "$top_left_addr" "$bottom_left_addr" "$top_right_addr" "$bottom_right_addr"

  move_to_workspace "$WS_ID_STR" "$top_left_addr"
  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$top_right_addr"
  sleep 0.15

  # Root left/right ratio, set while both columns are still leaves.
  set_split "$top_left_addr" "$left_column_pct"

  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  focus_addr "$top_right_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_right_addr"
  sleep 0.15

  set_split "$top_left_addr" 50
  set_split "$top_right_addr" 50

  restore_focus
  notify "Applied 2 left / 2 right"
}

# 4 windows, 1 on top spanning full width, 3 along the bottom row.
# Bottom row nests as (left | (middle | right)); every split keeps a leaf.
apply_top_bottom_layout() {
  local top_addr bottom_left_addr bottom_middle_addr bottom_right_addr
  local top_pct="$1"
  local bottom_left_pct="$2"
  local bottom_middle_pct="$3"

  require_window_count 4
  load_restore_addr
  load_row_addresses

  top_addr="${row_addrs[0]}"
  bottom_left_addr="${row_addrs[1]}"
  bottom_middle_addr="${row_addrs[2]}"
  bottom_right_addr="${row_addrs[3]}"

  move_windows_to_temp "$top_addr" "$bottom_left_addr" "$bottom_middle_addr" "$bottom_right_addr"

  move_to_workspace "$WS_ID_STR" "$top_addr"
  focus_addr "$top_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  focus_addr "$bottom_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_middle_addr"
  focus_addr "$bottom_middle_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_right_addr"
  sleep 0.15

  set_split "$top_addr" "$top_pct"
  set_split "$bottom_left_addr" "$bottom_left_pct"
  set_split "$bottom_middle_addr" "$bottom_middle_pct"

  restore_focus
  notify "Applied 1 top / 3 bottom"
}

# 3 windows, 1 on top spanning full width, 2 along the bottom row.
# Root top/bottom (top is a leaf), then bottom splits left/right (both leaves).
apply_top_two_bottom_layout() {
  local top_addr bottom_left_addr bottom_right_addr
  local top_pct="$1"
  local bottom_left_pct="$2"

  require_window_count 3
  load_restore_addr
  load_row_addresses

  top_addr="${row_addrs[0]}"
  bottom_left_addr="${row_addrs[1]}"
  bottom_right_addr="${row_addrs[2]}"

  move_windows_to_temp "$top_addr" "$bottom_left_addr" "$bottom_right_addr"

  move_to_workspace "$WS_ID_STR" "$top_addr"
  focus_addr "$top_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  focus_addr "$bottom_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_right_addr"
  sleep 0.15

  set_split "$top_addr" "$top_pct"
  set_split "$bottom_left_addr" "$bottom_left_pct"

  restore_focus
  notify "Applied 1 top / 2 bottom"
}

# 3 windows, 2 stacked on the left, 1 filling the right.
# Root left/right (right is a leaf), then the left column splits top/bottom.
apply_two_left_one_right_layout() {
  local top_left_addr bottom_left_addr right_addr
  local left_column_pct="$1"
  local left_top_pct="$2"

  require_window_count 3
  load_restore_addr
  load_grid_addresses

  top_left_addr="${grid_addrs[0]}"
  bottom_left_addr="${grid_addrs[1]}"
  right_addr="${grid_addrs[2]}"

  move_windows_to_temp "$top_left_addr" "$bottom_left_addr" "$right_addr"

  move_to_workspace "$WS_ID_STR" "$top_left_addr"
  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$right_addr"
  focus_addr "$top_left_addr"
  hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
  sleep 0.05

  move_to_workspace "$WS_ID_STR" "$bottom_left_addr"
  sleep 0.15

  set_split "$right_addr" "$left_column_pct"
  set_split "$top_left_addr" "$left_top_pct"

  restore_focus
  notify "Applied 2 left / 1 right"
}

main() {
  local layout="${1:-menu}"

  require_dependencies
  capture_active_workspace
  validate_temp_workspace
  load_workspace_clients

  if [ "$layout" = "menu" ]; then
    layout="$(choose_layout || true)"
    [ -n "$layout" ] || exit 0
  fi

  case "$layout" in
    top-bottom-two|top1-bottom1|1-top-1-bottom)
      apply_top_bottom_two_layout 74
      ;;
    top-bottom-two-alt|top1-bottom1-alt|1-top-1-bottom-alt)
      apply_top_bottom_two_layout 63
      ;;
    top-bottom-two-half|top1-bottom1-half|1-top-1-bottom-half)
      apply_top_bottom_two_layout 50
      ;;
    left-right-half|left-right|side-by-side|1-left-1-right|lr-half)
      apply_left_right_layout 50
      ;;
    left-right-one-third|lr-one-third|1-3-2-3|lr-1323)
      apply_left_right_layout 33.3333
      ;;
    left-right-small-left|lr-small-left|lr-2575|1-left-1-right-small-left)
      apply_left_right_layout 25
      ;;
    grid|2x2)
      apply_grid_layout 25
      ;;
    grid-half|2x2-half|2-left-2-right-half)
      apply_grid_layout 50
      ;;
    top-bottom|top3|1-top-3-bottom)
      apply_top_bottom_layout 74 21.2121 26.9231
      ;;
    top-bottom-current|top3-current|1-top-3-bottom-current)
      apply_top_bottom_layout 54 21.2121 26.9231
      ;;
    top-two-bottom|top2|1-top-2-bottom)
      apply_top_two_bottom_layout 74 28
      ;;
    top-two-bottom-current|top2-current|1-top-2-bottom-current)
      apply_top_two_bottom_layout 63 39
      ;;
    top-two-bottom-half|top2-half|1-top-2-bottom-half)
      apply_top_two_bottom_layout 50 26
      ;;
    two-left-one-right|2-left-1-right|left-stack-right)
      apply_two_left_one_right_layout 25 50
      ;;
    left-middle-right-thirds|lmr-thirds|lmr3|1-left-1-middle-1-right)
      apply_left_middle_right_layout 33.3333 50
      ;;
    left-middle-right-quarter|lmr-quarter|lmr-255025|1-left-1-middle-1-right-quarter)
      apply_left_middle_right_layout 25 66.6667
      ;;
    left-middle-right-wide|lmr-wide|lmr-current|1-left-1-middle-1-right-wide)
      apply_left_middle_right_layout 28 61.1111
      ;;
    *)
      notify "Unknown layout: $layout"
      exit 1
      ;;
  esac
}

main "$@"
