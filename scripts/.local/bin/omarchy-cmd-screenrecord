#!/bin/bash

# Wraps omarchy-cmd-screenrecord to add --region support, bypassing the portal
# for region captures (workaround for DMA-BUF failure on multi-GPU setups).
# All other arguments are passed through to the original command.

ORIGINAL=/home/aidan/.local/share/omarchy/bin/omarchy-cmd-screenrecord

if [[ " $* " != *" --region "* && "$1" != "--region" ]]; then
  exec "$ORIGINAL" "$@"
fi

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENRECORD_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}}"

if [[ ! -d $OUTPUT_DIR ]]; then
  notify-send "Screen recording directory does not exist: $OUTPUT_DIR" -u critical -t 3000
  exit 1
fi

DESKTOP_AUDIO="false"
MICROPHONE_AUDIO="false"
RECORDING_FILE="/tmp/omarchy-screenrecord-filename"

for arg in "$@"; do
  case "$arg" in
  --with-desktop-audio) DESKTOP_AUDIO="true" ;;
  --with-microphone-audio) MICROPHONE_AUDIO="true" ;;
  esac
done

toggle_screenrecording_indicator() {
  pkill -RTMIN+8 waybar
}

screenrecording_active() {
  pgrep -f "^gpu-screen-recorder" >/dev/null
}

if screenrecording_active; then
  exec "$ORIGINAL" --stop-recording
fi

selection=$(slurp 2>/dev/null)
[[ -z $selection ]] && exit 0

if [[ $selection =~ ^([0-9]+),([0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
  x="${BASH_REMATCH[1]}"
  y="${BASH_REMATCH[2]}"
  w="${BASH_REMATCH[3]}"
  h="${BASH_REMATCH[4]}"
else
  notify-send "Screen recording" "Invalid region selection" -u critical -t 3000
  exit 1
fi

filename="$OUTPUT_DIR/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S').mp4"
audio_devices=""
audio_args=()

[[ $DESKTOP_AUDIO == "true" ]] && audio_devices+="default_output"

if [[ $MICROPHONE_AUDIO == "true" ]]; then
  [[ -n $audio_devices ]] && audio_devices+="|"
  audio_devices+="default_input"
fi

[[ -n $audio_devices ]] && audio_args+=(-a "$audio_devices" -ac aac)

gpu-screen-recorder -w region -region "${w}x${h}+${x}+${y}" -k auto -f 60 -fm cfr -fallback-cpu-encoding yes -o "$filename" "${audio_args[@]}" &
pid=$!

while kill -0 $pid 2>/dev/null && [[ ! -f $filename ]]; do
  sleep 0.2
done

if kill -0 $pid 2>/dev/null; then
  echo "$filename" >"$RECORDING_FILE"
  toggle_screenrecording_indicator
fi
