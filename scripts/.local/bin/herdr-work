#!/usr/bin/env bash

set -euo pipefail

herdr_bin="${HERDR_WORK_HERDR_BIN:-herdr}"
work_root="${HERDR_WORK_ROOT:-$HOME/repos/home-assistant}"

usage() {
  cat <<'EOF'
Usage: herdr-work [core] [docs] [dev-docs]

Open the Home Assistant Frontend workspace and any additional workspaces.
EOF
}

declare -a labels=("Frontend")
declare -a directories=("frontend")

for project in "$@"; do
  case "${project,,}" in
    frontend) ;;
    core)
      labels+=("Core")
      directories+=("core")
      ;;
    docs)
      labels+=("Docs")
      directories+=("home-assistant.io")
      ;;
    dev-docs | devdocs | developer-docs)
      labels+=("Dev Docs")
      directories+=("developers.home-assistant")
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown workspace: %s\n\n' "$project" >&2
      usage >&2
      exit 64
      ;;
  esac
done

if ! "$herdr_bin" status server >/dev/null 2>&1; then
  nohup "$herdr_bin" server >/dev/null 2>&1 &

  for _ in {1..50}; do
    if "$herdr_bin" status server >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done

  if ! "$herdr_bin" status server >/dev/null 2>&1; then
    printf 'Herdr server did not start\n' >&2
    exit 1
  fi
fi

workspaces="$($herdr_bin workspace list)"
frontend_id="$(jq -r '
  (.result.workspaces // .workspaces // [])
  | map(select(.label == "Frontend"))
  | first
  | .workspace_id // empty
' <<<"$workspaces")"

for index in "${!labels[@]}"; do
  label="${labels[$index]}"
  directory="$work_root/${directories[$index]}"

  if [[ ! -d "$directory" ]]; then
    printf 'Workspace directory does not exist: %s\n' "$directory" >&2
    exit 1
  fi

  workspace_id="$(jq -r --arg label "$label" '
    (.result.workspaces // .workspaces // [])
    | map(select(.label == $label))
    | first
    | .workspace_id // empty
  ' <<<"$workspaces")"

  if [[ -z "$workspace_id" ]]; then
    created="$($herdr_bin workspace create --cwd "$directory" --label "$label" --no-focus)"
    workspace_id="$(jq -r '.result.workspace.workspace_id // .workspace.workspace_id // empty' <<<"$created")"
    if [[ -z "$workspace_id" ]]; then
      printf 'Herdr did not return an ID for workspace: %s\n' "$label" >&2
      exit 1
    fi
  fi

  if [[ "$label" == "Frontend" ]]; then
    frontend_id="$workspace_id"
  fi
done

if [[ -n "$frontend_id" ]]; then
  $herdr_bin workspace focus "$frontend_id" >/dev/null
fi

if [[ "${HERDR_ENV:-}" != 1 ]]; then
  exec "$herdr_bin"
fi
