#!/usr/bin/env bash

set -euo pipefail

herdr_bin="${HERDR_WORK_HERDR_BIN:-herdr}"
work_root="${HERDR_WORK_ROOT:-$HOME/repos/home-assistant}"

if ! "$herdr_bin" status server >/dev/null 2>&1; then
  nohup "$herdr_bin" server >/dev/null 2>&1 &

  for _ in {1..50}; do
    if "$herdr_bin" status server >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done

  if ! "$herdr_bin" status server >/dev/null 2>&1; then
    printf 'Herdr server did not start\n' >&2
    exit 1
  fi
fi

frontend_dir="$work_root/frontend"
if [[ ! -d "$frontend_dir" ]]; then
  printf 'Workspace directory does not exist: %s\n' "$frontend_dir" >&2
  exit 1
fi

workspaces="$($herdr_bin workspace list)"
frontend_id="$(jq -r '
  (.result.workspaces // .workspaces // [])
  | map(select(.label == "Frontend"))
  | first
  | .workspace_id // empty
' <<<"$workspaces")"

if [[ -z "$frontend_id" ]]; then
  created="$($herdr_bin workspace create --cwd "$frontend_dir" --label Frontend --no-focus)"
  frontend_id="$(jq -r '.result.workspace.workspace_id // .workspace.workspace_id // empty' <<<"$created")"
  if [[ -z "$frontend_id" ]]; then
    printf 'Herdr did not return an ID for workspace: Frontend\n' >&2
    exit 1
  fi
fi

"$herdr_bin" workspace focus "$frontend_id" >/dev/null

if [[ "${HERDR_ENV:-}" != 1 ]]; then
  exec "$herdr_bin"
fi
