#!/usr/bin/env bash

set -euo pipefail

hyprctl_bin="${NEW_TERMINAL_TAB_HYPRCTL_BIN:-hyprctl}"
action="${1:-}"

case "$action" in
  new | close | next | previous | ghostty-new) ;;
  *)
    printf 'usage: %s <new|close|next|previous|ghostty-new>\n' "$0" >&2
    exit 64
    ;;
esac

active_window="$($hyprctl_bin activewindow -j 2>/dev/null || true)"
active_address="$(jq -r '.address // ""' <<<"$active_window" 2>/dev/null || true)"
active_class="$(jq -r '.class // .initialClass // ""' <<<"$active_window" 2>/dev/null || true)"
active_title="$(jq -r '.title // ""' <<<"$active_window" 2>/dev/null || true)"

send_shortcut_once() {
  local mods="$1"
  local key="$2"

  exec "$hyprctl_bin" eval "
    hl.dispatch(hl.dsp.send_key_state({ mods = '$mods', key = '$key', state = 'down' }))
    hl.timer(function()
      hl.dispatch(hl.dsp.send_key_state({ mods = '$mods', key = '$key', state = 'up' }))
    end, { timeout = 50, type = 'oneshot' })
  "
}

if [[ "$action" == "ghostty-new" ]]; then
  [[ "$active_class" == "com.mitchellh.ghostty" && -n "$active_address" ]] || exit 0
  send_shortcut_once "CTRL ALT SHIFT" "N"
fi

if [[ "$active_class" == "com.mitchellh.ghostty" && "$active_title" == "herdr" ]]; then
  case "$action" in
    new) send_shortcut_once "CTRL ALT SHIFT" "T" ;;
    close) send_shortcut_once "CTRL ALT SHIFT" "W" ;;
    next) send_shortcut_once "CTRL ALT SHIFT" "RIGHT" ;;
    previous) send_shortcut_once "CTRL ALT SHIFT" "LEFT" ;;
  esac
fi

if [[ "$action" == "new" && "$active_class" == "com.mitchellh.ghostty" && -n "$active_address" ]]; then
  send_shortcut_once "CTRL ALT SHIFT" "N"
fi

case "$action" in
  new) send_shortcut_once "CTRL SHIFT" "T" ;;
  close) send_shortcut_once "CTRL SHIFT" "W" ;;
  next) send_shortcut_once "CTRL" "TAB" ;;
  previous) send_shortcut_once "CTRL SHIFT" "TAB" ;;
esac
