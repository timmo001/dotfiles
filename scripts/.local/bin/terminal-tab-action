#!/usr/bin/env bash

set -euo pipefail

hyprctl_bin="${NEW_TERMINAL_TAB_HYPRCTL_BIN:-hyprctl}"
herdr_bin="${NEW_TERMINAL_TAB_HERDR_BIN:-herdr}"
action="${1:-}"

case "$action" in
  new | close | next | previous) ;;
  *)
    printf 'usage: %s <new|close|next|previous>\n' "$0" >&2
    exit 64
    ;;
esac

active_window="$($hyprctl_bin activewindow -j 2>/dev/null || true)"
IFS=$'\t' read -r active_class active_title < <(
  jq -r '[(.class // .initialClass // ""), (.title // "")] | @tsv' <<<"$active_window" 2>/dev/null || true
)

if [[ "$active_class" == "com.mitchellh.ghostty" && "$active_title" == "herdr |"* ]] && command -v "$herdr_bin" >/dev/null 2>&1; then
  if [[ "$action" == "new" ]] && $herdr_bin tab create --focus >/dev/null 2>&1; then
    exit 0
  fi

  tab_row="$($herdr_bin tab list 2>/dev/null | jq -r --arg action "$action" '
    ((.result.tabs // .tabs // []) | sort_by(.number)) as $tabs
    | ($tabs | map(select(.focused)) | first | .tab_id) as $current
    | ($tabs | map(.tab_id) | index($current)) as $index
    | [
        ($current // ""),
        ($tabs | length),
        if ($tabs | length) < 2 or $index == null then ""
        elif $action == "next" then $tabs[($index + 1) % ($tabs | length)].tab_id
        elif $action == "previous" then $tabs[($index - 1 + ($tabs | length)) % ($tabs | length)].tab_id
        else ""
        end
      ]
    | @tsv
  ' 2>/dev/null || true)"
  IFS=$'\t' read -r tab_id tab_count target_tab <<<"$tab_row"

  if [[ "$action" == "close" && -n "$tab_id" ]]; then
    workspace_count="$($herdr_bin workspace list 2>/dev/null | jq -r '(.result.workspaces // .workspaces // []) | length' 2>/dev/null || true)"
    if $herdr_bin tab close "$tab_id" >/dev/null 2>&1; then
      if [[ "$workspace_count" == "1" && "$tab_count" == "1" ]]; then
        $herdr_bin session stop default >/dev/null 2>&1 || true
      fi
      exit 0
    fi
  fi
  if [[ ("$action" == "next" || "$action" == "previous") && -n "$target_tab" ]] && $herdr_bin tab focus "$target_tab" >/dev/null 2>&1; then
    exit 0
  fi
fi

case "$action" in
  new) exec "$hyprctl_bin" dispatch sendshortcut CTRL SHIFT, T, activewindow ;;
  close) exec "$hyprctl_bin" dispatch sendshortcut CTRL SHIFT, W, activewindow ;;
  next) exec "$hyprctl_bin" dispatch sendshortcut CTRL, TAB, activewindow ;;
  previous) exec "$hyprctl_bin" dispatch sendshortcut CTRL SHIFT, TAB, activewindow ;;
esac
