#!/usr/bin/env bash
set -euo pipefail

DEFAULT_MESSAGE="Loading..."
TARGET="timmo.popup-loading"

usage() {
  cat <<'USAGE'
Usage:
  popup-loading show [message...]
  popup-loading hide
  popup-loading [message...]

Shows or hides a singleton loading overlay on the focused Hyprland monitor.
USAGE
}

show_overlay() {
  local message="${1:-$DEFAULT_MESSAGE}"
  message="${message#"${message%%[![:space:]]*}"}"
  message="${message%"${message##*[![:space:]]}"}"
  if [[ -z $message ]]; then
    message="$DEFAULT_MESSAGE"
  fi
  omarchy-shell "$TARGET" show "$message"
}

hide_overlay() {
  omarchy-shell -q "$TARGET" hide
}

if [[ $# -eq 0 ]]; then
  show_overlay "$DEFAULT_MESSAGE"
  exit 0
fi

case "$1" in
  -h | --help | help)
    usage
    ;;
  hide)
    if [[ $# -ne 1 ]]; then
      printf 'Usage: popup-loading hide\n' >&2
      exit 2
    fi
    hide_overlay
    ;;
  show)
    shift
    if [[ $# -eq 0 ]]; then
      show_overlay "$DEFAULT_MESSAGE"
    else
      show_overlay "$*"
    fi
    ;;
  *)
    show_overlay "$*"
    ;;
esac
