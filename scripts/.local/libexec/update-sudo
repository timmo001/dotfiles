#!/bin/bash

set -e

validate=0
while (( $# > 0 )); do
  case "$1" in
    -v)
      validate=1
      shift
      ;;
    -n|-A|-E|-H|-S)
      shift
      ;;
    -k|-K)
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

(( validate )) && (( $# == 0 )) && exec /usr/bin/sudo -n /usr/bin/true
exec /usr/bin/sudo -n "$@"
