#!/bin/bash

set -e

validate=0
while (( $# > 0 )); do
  case "$1" in
    -v)
      validate=1
      shift
      ;;
    -n|-A|-E|-H|-S)
      shift
      ;;
    -k|-K)
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if /usr/bin/sudo -n /usr/bin/true 2>/dev/null; then
  (( validate )) && (( $# == 0 )) && exit 0
  exec /usr/bin/sudo -n "$@"
fi

if (( validate )) && (( $# == 0 )); then
  exec pkexec /usr/bin/true
fi

exec pkexec "$@"
