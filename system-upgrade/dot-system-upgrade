#!/bin/sh
# Upgrades the server's apt packages for `dot up system`, which runs it with
# `sudo -n`. Install it root-owned, with a sudo rule for this one path:
#
#   sudo install -o root -g root -m 0755 system-upgrade/dot-system-upgrade /usr/local/sbin/dot-system-upgrade
#   echo "$USER ALL=(root) NOPASSWD: /usr/local/sbin/dot-system-upgrade" | sudo tee /etc/sudoers.d/dot-system-upgrade
#
# It's installed by hand because an editable script that runs as root without
# a password would be root without a password.
set -eu

export DEBIAN_FRONTEND=noninteractive
apt-get -o DPkg::Lock::Timeout=600 update
apt-get -o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confold -y upgrade
apt-get -o DPkg::Lock::Timeout=600 -y autoremove --purge
apt-get autoclean

# The NVIDIA driver may have changed, so the GPU's CDI spec follows it
if command -v nvidia-ctk >/dev/null 2>&1; then
	nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
fi
