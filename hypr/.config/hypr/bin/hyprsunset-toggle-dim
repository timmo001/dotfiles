#!/bin/bash

CONFIG="$HOME/.config/hypr/host/hyprsunset.conf"
ON_GAMMA=50
OFF_GAMMA=100
STATE_DIR="$HOME/.config/hypr/.state"
STATE_FILE="$STATE_DIR/hyprsunset-dim-enabled"
LEVEL_FILE="$STATE_DIR/hyprsunset-dim-level"

if ! pgrep -x hyprsunset >/dev/null; then
  setsid uwsm-app -- hyprsunset --config "$CONFIG" &
  sleep 1
fi

CURRENT_GAMMA=$(hyprctl hyprsunset gamma 2>/dev/null | grep -oE '[0-9]+')

if [[ "$CURRENT_GAMMA" == "$OFF_GAMMA" ]]; then
  mkdir -p "$STATE_DIR"
  hyprctl hyprsunset identity
  hyprctl hyprsunset gamma $ON_GAMMA
  touch "$STATE_FILE"
  echo "$ON_GAMMA" > "$LEVEL_FILE"
  notify-send "Dim mode enabled"
else
  hyprctl hyprsunset identity
  hyprctl hyprsunset gamma $OFF_GAMMA
  rm -f "$STATE_FILE"
  notify-send "Dim mode disabled"
fi
