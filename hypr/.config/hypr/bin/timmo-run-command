#!/bin/bash
# Generic wrapper script to check if a command is installed before running it
# Usage: timmo-run-command <command> [args...]

if [[ $# -eq 0 ]]; then
    echo "Error: No command specified" >&2
    echo "Usage: timmo-run-command <command> [args...]" >&2
    exit 1
fi

COMMAND="$1"
shift

if ! command -v "$COMMAND" &>/dev/null; then
    # Try to find a package to install
    PACKAGE=""
    PACKAGES="$(yay -Ssq -- "$COMMAND" 2>/dev/null)"

    # Prefer the exact package name, then -bin, then -git
    for CANDIDATE in "$COMMAND" "${COMMAND}-bin" "${COMMAND}-git"; do
        if grep -qxF -- "$CANDIDATE" <<<"$PACKAGES"; then
            PACKAGE="$CANDIDATE"
            break
        fi
    done

    if [[ -n "$PACKAGE" ]]; then
        omarchy notification send -g "󰅖" -u normal "$COMMAND not found" "Install with: yay -S $PACKAGE" -i dialog-warning
    else
        omarchy notification send -g "󰅖" -u normal "$COMMAND not found" "Please install $COMMAND to use this feature" -i dialog-warning
    fi
    exit 1
fi

# Run the command with all arguments passed to this script
exec "$COMMAND" "$@"
