#!/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/cursor-flags.conf ]]; then
  CURSOR_USER_FLAGS="$(sed 's/#.*//' $XDG_CONFIG_HOME/cursor-flags.conf | tr '\n' ' ')"
fi

# Launch
script_path="$(readlink -f "$0")"
cursor_bin=""
cursor_candidates=(
  "${CURSOR_APPIMAGE:-}"
  "/usr/bin/cursor"
  "/usr/local/bin/cursor"
  "$HOME/apps/appimages/cursor.appimage"
)

shopt -s nullglob
cursor_candidates+=("$HOME"/Applications/Cursor-*.AppImage)
shopt -u nullglob

for candidate in "${cursor_candidates[@]}"; do
  [[ -n "$candidate" && -x "$candidate" ]] || continue
  if [[ "$(readlink -f "$candidate" 2>/dev/null)" == "$script_path" ]]; then
    continue
  fi

  cursor_bin="$candidate"
  break
done

if [[ -z "$cursor_bin" ]]; then
  echo "Cursor not found. Checked CURSOR_APPIMAGE, /usr/bin/cursor, /usr/local/bin/cursor, ~/apps/appimages/cursor.appimage, and ~/Applications/Cursor-*.AppImage." >&2
  exit 1
fi

exec "$cursor_bin" "$@" $CURSOR_USER_FLAGS > /dev/null 2>&1 &
exit 0
