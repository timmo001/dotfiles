#!/bin/bash

# A channel switch or pacman refresh copies Omarchy's template over
# /etc/pacman.conf, dropping the [timmo] and [timmo-private] includes. Put them
# back before Omarchy runs its upgrade.
dot setup public repo
dot setup private repo

# checkupdates only fetches a sync database newer than its cached copy, so after
# a switch to an older channel it keeps the old channel's and reports false
# updates. Drop the cached copies so its next run fetches this channel's.
rm -f "${CHECKUPDATES_DB:-${TMPDIR:-/tmp}/checkup-db-$UID}"/sync/*.db
