{
  "name": "dot-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --bytecode --format=esm --outfile ../scripts/.local/bin/dot",
    "test": "bun test tests --pass-with-no-tests",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\"",
    "prepare": "effect-tsgo patch --typescript --force=false"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@timmo001/effect-gh": "0.13.2",
    "@timmo001/effect-ha-bridge": "1.8.0",
    "@timmo001/effect-herdr": "0.9.0-timmo001.6",
    "@timmo001/effect-upnext": "2.3.0",
    "@timmo001/groundwork-report": "0.23.0",
    "effect": "4.1.4",
    "fuse.js": "7.5.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@types/bun": "^1.3.13",
    "@types/semver": "^7.8.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "effect": "$effect",
    "@effect/platform-node-shared": "$@effect/platform-node"
  }
}
