{
  "name": "dot-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile ../scripts/.local/bin/dot",
    "test": "bun test tests",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\"",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-beta.93",
    "@opentui/core": "^0.4.3",
    "date-fns": "^4.4.0",
    "effect": "^4.0.0-beta.93",
    "fuse.js": "^7.3.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.19.0",
    "@types/bun": "^1.3.13",
    "prettier": "^3.5.3",
    "typescript": "^7.0.0"
  }
}
