{
  "name": "dot-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --bytecode --format=esm --outfile ../scripts/.local/bin/dot",
    "test": "bun test tests --pass-with-no-tests",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\"",
    "prepare": "effect-tsgo patch --typescript --force=false"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.6",
    "@timmo001/effect-gh": "0.14.1",
    "@timmo001/effect-ha-bridge": "1.9.0",
    "@timmo001/effect-herdr": "0.9.0-timmo001.6",
    "@timmo001/effect-upnext": "2.3.0",
    "@timmo001/groundwork-report": "0.51.1",
    "effect": "4.1.6",
    "fuse.js": "7.5.0",
    "semver": "7.8.6",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.4",
    "@types/bun": "1.4.5",
    "@types/semver": "7.8.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "effect": "$effect",
    "@effect/platform-node-shared": "$@effect/platform-node"
  }
}
