{
  "name": "dot-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile ../scripts/.local/bin/dot",
    "test": "bun test tests",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\"",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-rc.112",
    "effect": "^4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.39.0",
    "@oxlint/plugins": "1.81.0",
    "@timmo001/oxlint-rules": "0.2.0",
    "@types/bun": "^1.3.13",
    "oxlint": "1.81.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.0"
  }
}
