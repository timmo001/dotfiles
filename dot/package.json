{
  "name": "dot-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile ../scripts/.local/bin/dot",
    "test": "bun test tests --pass-with-no-tests",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\"",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@herdr/sdk": "github:timmo001/herdr-ts-sdk#dd123bffd28150f70adcd984500a5c591dc6e7a3",
    "@timmo001/effect-gh": "github:timmo001/effect-gh#6b018e31342a1a56df7745e921c78150d234ef06",
    "effect": "4.0.0-rc.117",
    "fast-xml-parser": "^5.11.1",
    "handlebars": "^4.7.9",
    "jsonata": "^2.2.2",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.6",
    "semver": "^7.8.5",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.45.0",
    "@types/bun": "^1.3.13",
    "@types/semver": "^7.8.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "effect": "$effect",
    "@effect/platform-node-shared": "$@effect/platform-node"
  }
}
