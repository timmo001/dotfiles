{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dotfiles-docs-ubuntu-server",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "ubuntu-server.dotfiles.timmo.dev",
      "custom_domain": true
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }
}
