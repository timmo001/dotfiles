{
  "name": "dotfiles-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "blume dev",
    "start": "blume dev",
    "build": "blume check --strict && blume validate --strict",
    "check": "blume check --strict",
    "validate": "blume validate --strict",
    "deploy": "bun alchemy deploy --stage prod --yes --adopt",
    "deploy:preview": "bun alchemy deploy --stage preview --yes",
    "preview": "bun alchemy dev --stage dev",
    "og": "bun scripts/generate-og.mjs",
    "gen:cli": "bun scripts/generate-cli-reference.ts",
    "gen:opencode": "bun scripts/generate-opencode-reference.ts",
    "gen": "bun run gen:cli && bun run gen:opencode",
    "predev": "bun run gen"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0-rc.112",
    "@effect/platform-node": "^4.0.0-rc.112",
    "alchemy": "2.0.0-beta.76",
    "blume": "1.6.0",
    "effect": "^4.0.0-rc.112",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.76"
  },
  "trustedDependencies": ["esbuild", "sharp"]
}
