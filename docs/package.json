{
  "name": "dotfiles-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun scripts/theme.ts && blume dev",
    "start": "bun scripts/theme.ts && blume dev",
    "build": "bun scripts/theme.ts && blume build --strict",
    "check": "bun scripts/theme.ts && blume check --strict",
    "validate": "blume validate --strict",
    "deploy": "alchemy deploy --yes",
    "deploy:github": "alchemy deploy --config stacks/github.ts --stage prod --yes",
    "plan": "alchemy plan",
    "preview": "blume preview",
    "og": "bun scripts/generate-og.mjs",
    "theme": "bun scripts/theme.ts",
    "gen:cli": "bun scripts/generate-cli-reference.ts",
    "gen:opencode": "bun scripts/generate-opencode-reference.ts",
    "gen": "bun run gen:cli && bun run gen:opencode",
    "predev": "bun run gen"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@timmo001/docs-kit": "0.51.1",
    "@timmo001/groundwork-tokens": "0.51.1",
    "blume": "2.2.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/github": "2.0.0-beta.87",
    "@effect/platform-bun": "4.1.5",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.5",
    "wrangler": "4.167.0"
  },
  "overrides": {
    "effect": "$effect"
  },
  "trustedDependencies": ["esbuild", "sharp"]
}
