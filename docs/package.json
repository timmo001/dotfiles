{
  "name": "dotfiles-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "blume dev",
    "start": "blume dev",
    "build": "blume build --strict",
    "check": "blume check --strict",
    "validate": "blume validate --strict",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:preview": "wrangler versions upload --config dist/server/wrangler.json",
    "preview": "blume preview",
    "og": "bun scripts/generate-og.mjs",
    "gen:cli": "bun scripts/generate-cli-reference.ts",
    "gen:opencode": "bun scripts/generate-opencode-reference.ts",
    "gen": "bun run gen:cli && bun run gen:opencode",
    "predev": "bun run gen"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "blume": "1.5.3",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "trustedDependencies": ["esbuild", "sharp"]
}
