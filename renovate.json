{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:monorepos",
    "group:recommended"
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "minimumReleaseAge": "1 day",
  "git-submodules": {
    "enabled": true
  },
  "customDatasources": {
    "arch-quickshell": {
      "defaultRegistryUrlTemplate": "https://archlinux.org/packages/extra/x86_64/quickshell/json/",
      "transformTemplates": [
        "{\"releases\":[{\"version\":pkgver}],\"homepage\":url}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the OpenCode reference tag.",
      "managerFilePatterns": ["/^opencode\\.json$/"],
      "matchStrings": [
        "\"opencode\"\\s*:\\s*\\{\\s*\"repository\"\\s*:\\s*\"anomalyco/opencode\",\\s*\"branch\"\\s*:\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "anomalyco/opencode",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "description": "Keep the QML syntax proxy in sync with Arch's stable quickshell package",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/quickshell-lint\\.ya?ml$/"],
      "matchStrings": ["QUICKSHELL_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "arch/quickshell",
      "datasourceTemplate": "custom.arch-quickshell",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update Herdr plugin commits.",
      "managerFilePatterns": [
        "/^herdr\\/\\.config\\/herdr\\/plugins\\/config\\/herdr-lazy\\/plugins\\.list$/",
        "/^herdr\\/\\.config\\/herdr\\/plugins\\/config\\/herdr-lazy\\/plugins\\.lock$/"
      ],
      "matchStrings": [
        "(?<depName>[\\w.-]+/[\\w.-]+)@(?<currentDigest>[a-f0-9]{40})"
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}.git",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the OpenCode plugin Effect version aligned with its pinned packages.",
      "matchFileNames": ["agents/.config/opencode/plugins-v2/package.json"],
      "matchPackageNames": ["effect"],
      "enabled": false
    },
    {
      "description": "Keep OpenCode 2 packages on numeric beta builds.",
      "matchFileNames": ["agents/.config/opencode/plugins-v2/package.json"],
      "matchPackageNames": [
        "@opencode-ai/client",
        "@opencode-ai/plugin",
        "@opencode-ai/schema"
      ],
      "allowedVersions": "/^0\\.0\\.0-beta-[0-9]{5,6}$/"
    },
    {
      "description": "Keep the mise-managed OpenCode 2 CLI on numeric beta builds.",
      "matchManagers": ["mise"],
      "matchDepNames": ["npm:@opencode-ai/cli"],
      "allowedVersions": "/^0\\.0\\.0-beta-[0-9]{5,6}$/"
    },
    {
      "description": "Keep coordinated OpenCode 2 beta packages together.",
      "matchDepNames": [
        "@opencode-ai/client",
        "@opencode-ai/plugin",
        "@opencode-ai/schema",
        "npm:@opencode-ai/cli"
      ],
      "groupName": "OpenCode 2 beta",
      "groupSlug": "opencode-2-beta"
    },
    {
      "description": "Update first-party workflows without a release delay.",
      "matchPackageNames": ["timmo001/workflows"],
      "minimumReleaseAge": null
    },
    {
      "description": "Update Git submodules without a release delay.",
      "matchManagers": ["git-submodules"],
      "minimumReleaseAge": null
    },
    {
      "description": "Use the shorter release delay for fast-moving development dependencies.",
      "matchDepNames": [
        "@effect/platform-node",
        "@effect/tsgo",
        "@opentui/core",
        "aqua:herdrdev/herdr",
        "effect",
        "github:backnotprop/plannotator"
      ],
      "minimumReleaseAge": "2 hours"
    },
    {
      "description": "Use the shorter update delay for Herdr plugins.",
      "matchDatasources": ["git-refs"],
      "matchFileNames": [
        "herdr/.config/herdr/plugins/config/herdr-lazy/plugins.list",
        "herdr/.config/herdr/plugins/config/herdr-lazy/plugins.lock"
      ],
      "minimumReleaseAge": "2 hours"
    },
    {
      "description": "Use the shorter release delay for OpenCode updates.",
      "matchDepNames": [
        "@opencode-ai/client",
        "@opencode-ai/plugin",
        "@opencode-ai/schema",
        "anomalyco/opencode",
        "aqua:anomalyco/opencode",
        "npm:@opencode-ai/browser-control",
        "npm:@opencode-ai/cli"
      ],
      "minimumReleaseAge": "2 hours"
    },
    {
      "description": "Use mise's shorter release delay for Pi updates.",
      "matchDepNames": ["aqua:earendil-works/pi"],
      "minimumReleaseAge": "2 hours"
    }
  ]
}
