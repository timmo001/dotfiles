{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>timmo001/renovate-config"],
  "customDatasources": {
    "omarchy-mise": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/omacom-io/omarchy-pkgs/master/pkgbuilds/mise-bin/PKGBUILD",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [releases[$contains(version, /^pkgver=/)].{\"version\": $substringAfter(version, \"pkgver=\")}], \"sourceUrl\": \"https://github.com/omacom-io/omarchy-pkgs\"}"
      ]
    },
    "arch-quickshell": {
      "defaultRegistryUrlTemplate": "https://archlinux.org/packages/extra/x86_64/quickshell/json/",
      "transformTemplates": [
        "{\"releases\":[{\"version\":pkgver}],\"sourceUrl\":url}"
      ]
    },
    "python-precompiled": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/astral-sh/uv/main/crates/uv-python/download-metadata.json",
      "transformTemplates": [
        "($builds := $.*[name = \"cpython\" and os = \"linux\" and arch.family = \"x86_64\" and arch.variant = null and libc = \"gnu\" and variant = null and prerelease = \"\"]; $first := $builds{$string(major) & \".\" & $string(minor) & \".\" & $string(patch): $min($number(build))}; {\"releases\": [$each($first, function($b, $v) {($d := $string($b); $t := $substring($d, 0, 4) & \"-\" & $substring($d, 4, 2) & \"-\" & $substring($d, 6, 2) & \"T00:00:00Z\"; {\"version\": $v, \"date\": $t, \"releaseTimestamp\": $t})})], \"sourceUrl\": \"https://github.com/astral-sh/python-build-standalone\"})"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Python only to versions with a precompiled Linux build.",
      "managerFilePatterns": ["/^mise\\/\\.config\\/mise\\/config\\.toml$/"],
      "matchStrings": ["\\npython\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "python",
      "datasourceTemplate": "custom.python-precompiled",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Follow Omarchy's mise-bin version for CI.",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["^min_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "omarchy/mise-bin",
      "datasourceTemplate": "custom.omarchy-mise",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the OpenCode reference tag.",
      "managerFilePatterns": ["/^opencode\\.json$/"],
      "matchStrings": [
        "\"opencode\"\\s*:\\s*\\{\\s*\"repository\"\\s*:\\s*\"anomalyco/opencode\",\\s*\"branch\"\\s*:\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "anomalyco/opencode",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "description": "Keep the QML syntax proxy in sync with Arch's stable quickshell package",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/quickshell-lint\\.ya?ml$/"],
      "matchStrings": ["QUICKSHELL_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "arch/quickshell",
      "datasourceTemplate": "custom.arch-quickshell",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update Herdr plugin commits.",
      "managerFilePatterns": [
        "/^herdr\\/\\.config\\/herdr\\/plugins\\/config\\/herdr-lazy\\/plugins\\.list$/",
        "/^herdr\\/\\.config\\/herdr\\/plugins\\/config\\/herdr-lazy\\/plugins\\.lock$/"
      ],
      "matchStrings": [
        "(?<depName>[\\w.-]+/[\\w.-]+)@(?<currentDigest>[a-f0-9]{40})"
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}.git",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Update Python through the precompiled build list instead of CPython tags.",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise/.config/mise/config.toml"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Keep the OpenCode plugin Effect version aligned with its pinned packages.",
      "matchFileNames": ["agents/.config/opencode/plugins/package.json"],
      "matchPackageNames": ["effect"],
      "enabled": false
    },
    {
      "description": "Update system package versions without a release delay.",
      "matchDepNames": ["omarchy/mise-bin", "arch/quickshell"],
      "minimumReleaseAge": null
    },
    {
      "description": "Use the shorter update delay for Herdr plugins.",
      "matchDatasources": ["git-refs"],
      "matchPackageNames": [
        "!@timmo001/**",
        "!timmo001/**",
        "!https://github.com/timmo001/**"
      ],
      "matchFileNames": [
        "herdr/.config/herdr/plugins/config/herdr-lazy/plugins.list",
        "herdr/.config/herdr/plugins/config/herdr-lazy/plugins.lock"
      ],
      "minimumReleaseAge": "2 hours"
    },
    {
      "description": "Keep the dependency import runtime on a Node version Renovate supports.",
      "matchFileNames": ["dot/deps-import/mise.toml"],
      "matchDepNames": ["node"],
      "allowedVersions": "<25"
    }
  ]
}
