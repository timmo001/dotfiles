# Changes require a relaunch of Hyprland to take effect.

# Keep custom Hypr helpers available to uwsm apps.
export PATH="$HOME/.config/hypr/bin:$PATH"

# Enable OpenCode's LSP tool and long-running background subtasks.
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
