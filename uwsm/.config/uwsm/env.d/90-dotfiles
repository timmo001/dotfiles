# Changes require a relaunch of Hyprland to take effect.

# Keep custom Hypr helpers available to uwsm apps, and put ~/.local/bin ahead
# of /usr/bin so dot isn't shadowed by Graphviz's /usr/bin/dot.
export PATH="$HOME/.config/hypr/bin:$HOME/.local/bin:$PATH"

# Enable OpenCode's LSP tool and long-running background subtasks.
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true

# Reviews Plannotator opens by itself shouldn't take focus.
export PLANNOTATOR_BROWSER="$HOME/.local/bin/link-open-background"

# WebKitGTK apps (such as the Epic Games Launcher) crash with Wayland protocol
# error 71 on NVIDIA when the DMA-BUF renderer is enabled.
export WEBKIT_DISABLE_DMABUF_RENDERER=1
