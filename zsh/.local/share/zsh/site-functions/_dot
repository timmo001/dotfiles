#compdef dot
###-begin-dot-completions-###
#
# Static completion script for Zsh
#
# Installation:
#   dot --completions zsh > ~/.zsh/completions/_dot
#   then add ~/.zsh/completions to your fpath
#

_dot() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'init:Run one-time first-use machine setup'
    'install:Ensure prerequisites, then backup/adopt dotfiles'
    'update:Self-update, pull repos, stow dotfiles, rebuild. Phase flags are inclusive\: passing any of --pull, --stow, or --app runs only the selected phases. Internal --no-self-update and --post-hook-repo flags support the active self-update handoff.'
    'up:Alias for update'
    'system-update:Select and run Dotfiles, Omarchy, and Topgrade updates'
    'package-updates:Check watched package and Dotfiles updates for the status bar'
    'stow:Re-stow public/private dotfiles'
    'omarchy-plugin:Manage Omarchy plugin submodules. The manage-omarchy-plugin compatibility wrapper may pass trailing 0/1 confirmation and commit-offer values to update and remove.'
    'omarchy-shell-config:Regenerate the Omarchy shell layout'
    'firewall:Reconcile managed ufw firewall rules'
    'doctor:Run parallel health checks for dependencies, repositories, stow integrity, services, packages, browser configuration, hardware video, firewall rules, and OpenCode/Herdr integration. A timestamped report is always written under ~/.local/state/dot/logs/.'
    'clean:Unstow managed dotfiles'
    'agents-sync:Mirror AGENTS.md to agent harness instruction files'
    'notes-capture-sync:Sync watched repositories to the notes capture picker'
    'setup-private-repo:Sync and register the private pacman repository'
    'setup-public-repo:Trust and register the public timmo pacman repository'
    'git-diff:Show repository change state across all tracked repositories.'
    'diff:Alias for git-diff'
    'git-commit:Commit staged changes through the guarded gateway. Subjects must be one line, have no trailing full stop, and stay within the hard length limit. Explicit --path scopes never imply git add -A; --amend keeps the existing message unless --message is supplied.'
    'git-notifications:Open the authenticated GitHub notification inbox. Without machine-output or action flags, this opens the Omarchy shell panel. --since accepts ISO/RFC dates, epoch timestamps, compact durations such as 2d, and quoted durations such as "2 days ago".'
    'git-releases:Compare enabled repositories with their latest published stable release, explain impact and retain local reviews.'
    'mcp-sync:Regenerate MCP configs for all harnesses from the spec'
    'private-pkg-publish:Build and publish a private package'
    'skills:Maintain imported agent skills'
    'completions:Generate shell completions'
    'is-agent:Detect whether an AI coding agent is running dot'
    'repo-induct:Induct a local repository into private dot git config with a preview before committing'
    'agent-oxlint:Run the advisory generic Oxlint pass for cleanup work in an opted-in repository. Repository-owned Oxlint takes precedence. Pass changed paths normally, or use --all when explicitly requested. Pass --force to run despite those skips.'
    'launch-floating-webapp:Launch one Omarchy webapp and place its new window in the target monitor'\''s bottom-right corner, or reposition an existing window with --address. Width and height must be positive integers; margins must be non-negative.'
    'herdr:Manage the shared Herdr server and repository workspaces'
    'workspace-setup:Launch or reuse desktop apps and rebuild the workspace layout'
    'workspace-relayout:Apply or capture a Hyprland workspace layout'
    'usage:Report local-first usage analytics from NDJSON events under $XDG_STATE_HOME/tool-usage. Live events store canonical commands and recognised flag names, never positional values. Set DOT_USAGE_DISABLE=1 to disable live recording or DOT_USAGE_DIR to relocate storage.'
    'help:Show this help menu'
  )

  local -a specs
  specs=(
    '(--help -h)--help[Show help information]'
    '(--help -h)-h[Show help information]'
    '1:command:->command'
    '*::arg:->args'
  )

  _arguments -C "${specs[@]}"

  case "$state" in
    command)
      _describe -t commands 'commands' commands
      ;;
    args)
      case "$words[1]" in
        init)
          _dot_init
          ;;
        install)
          _dot_install
          ;;
        update)
          _dot_update
          ;;
        up)
          _dot_up
          ;;
        system-update)
          _dot_system_update
          ;;
        package-updates)
          _dot_package_updates
          ;;
        stow)
          _dot_stow
          ;;
        omarchy-plugin)
          _dot_omarchy_plugin
          ;;
        omarchy-shell-config)
          _dot_omarchy_shell_config
          ;;
        firewall)
          _dot_firewall
          ;;
        doctor)
          _dot_doctor
          ;;
        clean)
          _dot_clean
          ;;
        agents-sync)
          _dot_agents_sync
          ;;
        notes-capture-sync)
          _dot_notes_capture_sync
          ;;
        setup-private-repo)
          _dot_setup_private_repo
          ;;
        setup-public-repo)
          _dot_setup_public_repo
          ;;
        git-diff)
          _dot_git_diff
          ;;
        diff)
          _dot_diff
          ;;
        git-commit)
          _dot_git_commit
          ;;
        git-notifications)
          _dot_git_notifications
          ;;
        git-releases)
          _dot_git_releases
          ;;
        mcp-sync)
          _dot_mcp_sync
          ;;
        private-pkg-publish)
          _dot_private_pkg_publish
          ;;
        skills)
          _dot_skills
          ;;
        completions)
          _dot_completions
          ;;
        is-agent)
          _dot_is_agent
          ;;
        repo-induct)
          _dot_repo_induct
          ;;
        agent-oxlint)
          _dot_agent_oxlint
          ;;
        launch-floating-webapp)
          _dot_launch_floating_webapp
          ;;
        herdr)
          _dot_herdr
          ;;
        workspace-setup)
          _dot_workspace_setup
          ;;
        workspace-relayout)
          _dot_workspace_relayout
          ;;
        usage)
          _dot_usage
          ;;
        help)
          _dot_help
          ;;
      esac
      ;;
  esac
}

