# Installed root-owned by dot up (System) and dot init. Reach the networks this
# machine is directly on directly, ahead of Tailscale's subnet routes in table
# 52: suppress_prefixlength 0 ignores main's default route, so only connected
# and RA routes match here and everything else falls through to Tailscale.
[Unit]
Description=Reach directly connected networks directly, ahead of Tailscale's subnet routes
Before=network-pre.target tailscaled.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/ip -4 rule del priority 2500
ExecStart=-/usr/bin/ip -6 rule del priority 2500
ExecStart=/usr/bin/ip -4 rule add priority 2500 lookup main suppress_prefixlength 0
ExecStart=/usr/bin/ip -6 rule add priority 2500 lookup main suppress_prefixlength 0
ExecStop=-/usr/bin/ip -4 rule del priority 2500
ExecStop=-/usr/bin/ip -6 rule del priority 2500

[Install]
WantedBy=multi-user.target
