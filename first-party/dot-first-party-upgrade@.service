# Upgrades the installed packages from the signed [timmo] repository, for the
# user named by the instance. dot installs it root-owned, and the polkit rule
# beside it lets that user start their own instance without a password, so
# `dot up first-party` and Upkeep can run it headless. It takes no arguments
# and only installs packages signed by the repository's key.
[Unit]
Description=Upgrade first-party packages from the [timmo] repository for %i
Documentation=https://dotfiles.timmo.dev/dot/commands/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The packages' install scripts restart their user services for the user who
# ran the upgrade, whom they find through SUDO_USER
Environment=SUDO_USER=%i
# Only [timmo] is in this config, so the refresh leaves every other sync
# database alone and the upgrade can't become a partial system upgrade
ExecStart=/usr/bin/pacman --config /etc/dot/first-party/pacman.conf -Syu --noconfirm --noprogressbar
TimeoutStartSec=15min
