{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dot *)",
      "Bash(mise *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(jq *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/dot\" cloud session-start",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true
}
